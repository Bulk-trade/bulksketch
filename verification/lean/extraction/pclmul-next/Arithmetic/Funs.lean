def field.maps.trace
  {F : Type _} (BinaryFieldInst : field.BinaryField F) (a : Std.U64) :
  Result Std.U8
  := do
  let i ← BinaryFieldInst.MASK
  let i1 ← lift (~~~ i)
  let left_val ← lift (a &&& i1)
  if left_val = 0#u64
  then
    let i2 ← BinaryFieldInst.BITS
    if i2 = 64#u32
    then
      let i3 ← a >>> 61#i32
      let i4 ← a >>> 63#i32
      let i5 ← lift (i3 ^^^ i4)
      let i6 ← lift (i5 &&& 1#u64)
      let r ← U8.Insts.CoreConvertTryFromU64TryFromIntError.try_from i6
      core.result.Result.expect
        core.num.error.TryFromIntError.Insts.CoreFmtDebug r (toStr
        "trace is a bit")
    else field.maps.canonical_trace BinaryFieldInst a
  else
    let _ ← core.fmt.Arguments.from_str (toStr "noncanonical field operand")
    fail panic

/-- [bulksketch::backend::x86_pclmul::solve_quadratic]:
    Source: 'src/backend/x86_pclmul.rs', lines 298:0-307:1 -/
def backend.x86_pclmul.solve_quadratic
  {F : Type _} (fieldBinaryFieldInst : field.BinaryField F) (a : Std.U64) :
  Result (Option Std.U64)
  := do
  let i ← field.maps.trace fieldBinaryFieldInst a
  if i != 0#u8
  then ok none
  else
    let solution ← field.maps.quadratic_value fieldBinaryFieldInst a
    let square ←
      backend.x86_pclmul.multiply false fieldBinaryFieldInst solution solution
    let left_val ← lift (square ^^^ solution)
    if left_val = a
    then ok (some solution)
    else
      let _ ← core.fmt.Arguments.from_str (toStr "quadratic-map invariant")
      fail panic

