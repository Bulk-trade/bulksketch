{"charon_version":"0.1.304","translated":{"crate_name":"bulksketch","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["bulksketch::decode::stages::_::completed_result"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["bulksketch::decode::stages::_::completed_result"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/Users/junbug/bulk/bulksketch-proof-evidence-20261109-native-driver/completed-result/arithmetic.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-apple-darwin","value":{"arch":"X86_64","vendor":"apple","os":"MacOs","env":"Unspecified","cfg_abi":"Unspecified","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bulksketch","contents":"//! Native binary-syndrome reconciliation with bounded, deterministic GF64 decoding.\n#![deny(unsafe_code)]\n#![warn(missing_docs)]\n\nmod backend;\nmod decode;\nmod field;\nmod poly;\nmod sketch;\nmod types;\n\npub use {\n    field::{BinaryField, Gf64},\n    sketch::{\n        DecodeJob, DecodeLimits, DecodeOutcome, DecodePlan, DecodeReport, DecodeRequest, DecodeRow,\n        DecodeRowsRequest, DecodeScratch, Decoder, FrozenSketch, InsertScratch, MutableSketch,\n        ParseLimits, ScratchLayout, ShapeLimits, SketchShape, SketchView, decode_into,\n        decode_rows_into,\n    },\n    types::{\n        BackendError, BackendId, BackendRequest, CreateError, DecodeError, DecodeFailure,\n        EncodeError, FieldId, ParseError, ShapeError, ShapeMismatch, Stage, StageProgress,\n        UpdateError, WorkUnits,\n    },\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"src/decode/stages.rs"},"crate_name":"bulksketch","contents":"//! The row owns counters and stage state; every coefficient stays in the lent workspace.\n#![forbid(unsafe_code)]\n#[cfg(test)]\nuse super::{direct, probe::Probe};\nuse {\n    super::{\n        bm,\n        degree_probe::DegreeProbe,\n        probe::verified,\n        roots::Roots,\n        row::{RowBudget, RowDecoder, RowExecution, RowInput, RowProgress, RowResult},\n        scratch::RowWorkspace,\n        verify,\n        work::{Charge, WorkScheduleV1},\n    },\n    crate::{\n        backend::contract::BulkKernels,\n        field::BinaryField,\n        poly::{Dense, Polynomial},\n        types::{DecodeError, DecodeFailure, Stage, WorkMeter},\n    },\n    std::marker::PhantomData,\n};\n\n#[derive(Clone, Copy, Debug)]\npub(crate) struct BinaryDecoder;\n#[derive(Debug)]\nenum State {\n    Running(Stage),\n    Complete,\n    Failed(DecodeFailure),\n    Error(DecodeError),\n}\n\n#[derive(Debug)]\npub(crate) struct Execution<F, K> {\n    budget: RowBudget,\n    state: State,\n    degree: usize,\n    hits: usize,\n    roots: Roots,\n    v3: bool,\n    degree_probe: Option<DegreeProbe>,\n    #[cfg(test)]\n    probe: Option<Probe>,\n    #[cfg(test)]\n    pub(crate) probe_algebra: Option<(u64, u64, u64)>,\n    #[cfg(test)]\n    pub(crate) probe_fault: direct::Fault,\n    #[cfg(test)]\n    pub(crate) operation_observer: Option<std::sync::Arc<std::sync::atomic::AtomicUsize>>,\n    marker: PhantomData<(F, K)>,\n}\nimpl<F: BinaryField, K: BulkKernels<F>> RowDecoder<F, K> for BinaryDecoder {\n    type Execution = Execution<F, K>;\n    fn begin(budget: RowBudget) -> Self::Execution {\n        Execution {\n            budget,\n            state: State::Running(Stage::Reconstruction),\n            degree: 0,\n            hits: 0,\n            roots: Roots::default(),\n            v3: false,\n            degree_probe: None,\n            #[cfg(test)]\n            probe: None,\n            #[cfg(test)]\n            probe_algebra: None,\n            #[cfg(test)]\n            probe_fault: direct::Fault::None,\n            #[cfg(test)]\n            operation_observer: None,\n            marker: PhantomData,\n        }\n    }\n}\nimpl<F: BinaryField, K: BulkKernels<F>> Execution<F, K> {\n    #[cfg(test)]\n    pub(crate) fn provisional_count(&self) -> usize {\n        self.roots.count\n    }\n\n    #[cfg(test)]\n    fn observe_operation(&self) {\n        if let Some(counter) = &self.operation_observer {\n            // Each test observes entries on its own thread; no synchronization is needed.\n            counter.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n        }\n    }\n    /// A new row has the same backend but no retained counters, probes or traversal state.\n    #[inline(always)]\n    pub(crate) fn restart(&mut self, budget: RowBudget, seed: u64) {\n        *self = <BinaryDecoder as RowDecoder<F, K>>::begin(budget);\n        self.set_splitter_seed(seed);\n    }\n\n    pub(crate) fn enable_v3(&mut self) {\n        self.v3 = true;\n        self.roots.enable_v3();\n        if F::BITS == 64 {\n            self.roots.enable_closed_form();\n        }\n    }\n\n    /// Called only for a genuinely different row, after tiny probes miss/skip.\n    pub(crate) fn start_degrees(&mut self, capacity: usize) {\n        if self.v3 && F::BITS == 64 {\n            self.degree_probe = DegreeProbe::new(self.budget, capacity);\n            if let Some(probe) = &self.degree_probe {\n                self.state = State::Running(probe.next_stage().expect(\"new degree probe\"));\n            }\n        }\n    }\n\n    pub(crate) fn verification_count(&self) -> usize {\n        self.roots.count\n    }\n\n    /// Upper validation is part of Verification, before any canonicalization.\n    pub(crate) fn reject_upper(&mut self, capacity: usize) {\n        if let Some(probe) = &mut self.degree_probe {\n            probe.reject(capacity, self.budget);\n            self.roots.count = 0;\n            self.state = State::Running(probe.next_stage().expect(\"probe fallback\"));\n            if probe.next_stage() == Some(Stage::Reconstruction) {\n                self.degree_probe = None;\n            }\n        } else {\n            self.state = State::Failed(DecodeFailure::InvalidLocator);\n        }\n    }\n\n    #[cfg(test)]\n    pub(crate) fn start_probes(&mut self, difference: &[u64]) {\n        self.probe = Probe::new(self.budget, difference);\n        if let Some(probe) = &self.probe {\n            self.state = State::Running(probe.next_stage().expect(\"new probe\"));\n        }\n    }\n\n    /// Borrow only an already completed row; the upper job has drained its stages.\n    pub(crate) fn completed_result<'w>(\n        &self,\n        workspace: &'w RowWorkspace<'_>,\n    ) -> Result<RowResult<'w>, DecodeError> {\n        match self.state {\n            State::Error(error) => return Err(error),\n            State::Failed(reason) => return Ok(RowResult::Failed(reason)),\n            State::Complete => {}\n            State::Running(_) => unreachable!(\"drained execution\"),\n        }\n        if self.roots.count == 0 && self.budget.total == self.budget.nonzero {\n            Ok(RowResult::Equal)\n        } else {\n            Ok(RowResult::Decoded(&workspace.roots[..self.roots.count]))\n        }\n    }\n\n    pub(crate) fn set_splitter_seed(&mut self, seed: u64) {\n        self.roots.set_splitter_seed(seed);\n    }\n\n    fn charge(meter: &mut WorkMeter, operation: Charge) -> Result<(), DecodeError> {\n        meter.charge(WorkScheduleV1::cost(operation)?)\n    }\n    fn execute(\n        &mut self,\n        stage: Stage,\n        input: RowInput<'_>,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Option<Stage>, DecodeFailure>, DecodeError> {\n        let capacity = input.difference.len();\n        #[cfg(test)]\n        crate::types::small_degree_observer::stage(stage, false);\n        if let Some(probe) = &mut self.degree_probe {\n            let next = probe.run::<F, K>(input.difference, self.budget, workspace, meter)?;\n            self.roots.count = probe.count();\n            if next == Some(Stage::Reconstruction) {\n                self.degree_probe = None;\n            }\n            return Ok(Ok(next));\n        }\n        #[cfg(test)]\n        if let Some(probe) = &mut self.probe {\n            // Lower-layer callers use the same probe stages as the public job.\n            #[cfg(test)]\n            {\n                probe.probe_fault = self.probe_fault;\n                probe\n                    .operation_observer\n                    .clone_from(&self.operation_observer);\n            }\n            // Standalone row callers do not have request-wide scratch admission.\n            probe.charge(capacity, meter)?;\n            if matches!(stage, Stage::DirectOne | Stage::DirectTwo) {\n                check_workspace(workspace, capacity, self.budget.nonzero)?;\n            }\n            let progress = probe.run_charged::<F, K>(\n                input.difference,\n                workspace.verification,\n                workspace.roots,\n            );\n            debug_assert_eq!(progress.stage, stage);\n            self.roots.count = probe.count();\n            #[cfg(test)]\n            {\n                self.probe_algebra = probe.probe_algebra;\n            }\n            let next = probe.next_stage();\n            if next == Some(Stage::Reconstruction) {\n                self.probe = None;\n            }\n            return Ok(Ok(next));\n        }\n        match stage {\n            Stage::Reconstruction => self.reconstruct(input, workspace, meter),\n            Stage::BerlekampMassey => {\n                self.degree = match bm::locator::<F, K>(\n                    workspace.syndromes,\n                    capacity,\n                    self.budget.nonzero,\n                    workspace.bm,\n                    meter,\n                )? {\n                    Ok(d) => d,\n                    Err(e) => return Ok(Err(e)),\n                };\n                if workspace.bm[0] == 0 {\n                    return Ok(Err(DecodeFailure::InvalidLocator));\n                }\n                Ok(Ok(Some(Stage::CandidateEvaluation)))\n            }\n            Stage::CandidateEvaluation => self.candidates(input, workspace, meter),\n            Stage::Deflation => self.deflate(input, workspace, meter),\n            Stage::Verification => self.verify(input, workspace, meter),\n            Stage::Canonicalization => self.canonicalize(workspace, meter),\n            _ => Ok(self.roots.run::<F, K>(stage, workspace, meter)?.map(Some)),\n        }\n    }\n    fn reconstruct(\n        &mut self,\n        input: RowInput<'_>,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Option<Stage>, DecodeFailure>, DecodeError> {\n        let capacity = input.difference.len();\n        if self.budget.total == self.budget.nonzero\n            && input.difference.iter().all(|&value| value == 0)\n        {\n            meter.charge(crate::types::WorkUnits(0))?;\n            return Ok(Ok(None));\n        }\n        Self::charge(meter, Charge::Reconstruct { capacity })?;\n        check_workspace(workspace, capacity, self.budget.nonzero)?;\n        workspace.syndromes[0] = 0;\n        for i in 1..=2 * capacity {\n            workspace.syndromes[i] = if i.is_multiple_of(2) {\n                K::square(workspace.syndromes[i / 2])\n            } else {\n                input.difference[i / 2]\n            };\n        }\n        Ok(Ok(Some(Stage::BerlekampMassey)))\n    }\n    fn candidates(\n        &mut self,\n        input: RowInput<'_>,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Option<Stage>, DecodeFailure>, DecodeError> {\n        let capacity = input.difference.len();\n        Self::charge(\n            meter,\n            Charge::Candidates {\n                degree: self.degree,\n                inputs: input.candidates.len(),\n            },\n        )?;\n        // The BM save buffer is free now; chunking bounds evaluation storage\n        // independently of the number of normalized candidate hints.\n        let width = capacity + 1;\n        let (locator, rest) = workspace.bm.split_at_mut(width);\n        let values = &mut rest[..width];\n        for points in input.candidates.chunks(width) {\n            <Dense as Polynomial<F, K>>::eval_many_into(\n                &locator[..=self.degree],\n                points,\n                &mut values[..points.len()],\n            );\n            for (&point, &value) in points.iter().zip(values.iter()) {\n                if value == 0 {\n                    if self.hits == self.degree {\n                        return Ok(Err(DecodeFailure::InvalidLocator));\n                    }\n                    workspace.roots[self.hits] = point;\n                    self.hits += 1;\n                }\n            }\n        }\n        self.roots.count = self.hits;\n        Ok(Ok(Some(Stage::Deflation)))\n    }\n    fn deflate(\n        &mut self,\n        input: RowInput<'_>,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Option<Stage>, DecodeFailure>, DecodeError> {\n        let capacity = input.difference.len();\n        Self::charge(\n            meter,\n            Charge::Deflate {\n                degree: self.degree,\n            },\n        )?;\n        let width = capacity + 1;\n        let (locator, rest) = workspace.bm.split_at_mut(width);\n        let quotient = &mut rest[..width];\n        let mut degree = self.degree;\n        for &root in &workspace.roots[..self.hits] {\n            quotient[degree - 1] = locator[degree];\n            for i in (1..degree).rev() {\n                quotient[i - 1] = locator[i] ^ K::mul(root, quotient[i]);\n            }\n            if locator[0] ^ K::mul(root, quotient[0]) != 0 {\n                return Ok(Err(DecodeFailure::InvalidLocator));\n            }\n            locator[..degree].copy_from_slice(&quotient[..degree]);\n            degree -= 1;\n        }\n        Ok(Ok(Some(self.roots.start(degree, workspace))))\n    }\n    fn verify(\n        &mut self,\n        input: RowInput<'_>,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Option<Stage>, DecodeFailure>, DecodeError> {\n        let capacity = input.difference.len();\n        let lfsr = self.v3 && verify::use_rebuilt_lfsr(self.roots.count, capacity);\n        let operation = if lfsr {\n            Charge::VerifyLfsr {\n                capacity,\n                output_budget: self.budget.total,\n                degree: self.roots.count,\n            }\n        } else {\n            Charge::Verify {\n                capacity,\n                output_budget: self.budget.total,\n            }\n        };\n        Self::charge(meter, operation)?;\n        #[cfg(test)]\n        self.observe_operation();\n        let roots = &workspace.roots[..self.roots.count];\n        let valid = if lfsr {\n            verify::rebuilt_lfsr::<F, K>(\n                roots,\n                input.difference,\n                workspace.bm,\n                workspace.verification,\n            )\n        } else {\n            verified::<F, K>(input.difference, roots, workspace.verification)\n        };\n        if !valid {\n            return Ok(Err(DecodeFailure::VerificationFailed));\n        }\n        Ok(Ok(Some(Stage::Canonicalization)))\n    }\n    fn canonicalize(\n        &mut self,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Option<Stage>, DecodeFailure>, DecodeError> {\n        Self::charge(\n            meter,\n            Charge::Canonicalize {\n                ids: self.budget.total,\n            },\n        )?;\n        #[cfg(test)]\n        self.observe_operation();\n        if self.roots.count > self.budget.nonzero {\n            return Ok(Err(DecodeFailure::DegreeExceedsBudget));\n        }\n        let roots = &mut workspace.roots[..self.roots.count];\n        match roots {\n            [left, right] => {\n                if *left > *right {\n                    std::mem::swap(left, right);\n                }\n            }\n            [] | [_] => {}\n            _ => roots.sort_unstable(),\n        }\n        if roots.iter().any(|&root| root == 0 || root & !F::MASK != 0)\n            || roots.windows(2).any(|pair| pair[0] == pair[1])\n        {\n            return Ok(Err(DecodeFailure::InvalidLocator));\n        }\n        Ok(Ok(None))\n    }\n}\nimpl<F: BinaryField, K: BulkKernels<F>> RowExecution for Execution<F, K> {\n    fn next_stage(&self) -> Option<Stage> {\n        match self.state {\n            State::Running(stage) => Some(stage),\n            _ => None,\n        }\n    }\n    fn run_next(\n        &mut self,\n        input: RowInput<'_>,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<RowProgress, DecodeError> {\n        let stage = match self.state {\n            State::Running(stage) => stage,\n            State::Error(error) => return Err(error),\n            _ => panic!(\"unfinished row\"),\n        };\n        self.state = match self.execute(stage, input, workspace, meter) {\n            Ok(Ok(Some(next))) => State::Running(next),\n            Ok(Ok(None)) => State::Complete,\n            Ok(Err(reason)) => State::Failed(reason),\n            Err(error) => {\n                self.state = State::Error(error);\n                return Err(error);\n            }\n        };\n        Ok(RowProgress {\n            stage,\n            locator_degree: self.degree,\n            candidate_hits: self.hits,\n            trace_attempts: self.roots.attempts,\n            gcd_degree: self.roots.gcd_degree,\n        })\n    }\n    fn finish<'workspace>(\n        mut self,\n        input: RowInput<'_>,\n        workspace: &'workspace mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<RowResult<'workspace>, DecodeError> {\n        while self.next_stage().is_some() {\n            self.run_next(input, workspace, meter)?;\n        }\n        self.completed_result(workspace)\n    }\n}\nfn check_workspace(\n    workspace: &RowWorkspace<'_>,\n    capacity: usize,\n    budget: usize,\n) -> Result<(), DecodeError> {\n    let add = |a: usize, b: usize| a.checked_add(b).ok_or(DecodeError::ScratchTooSmall);\n    let mul = |a: usize, b: usize| a.checked_mul(b).ok_or(DecodeError::ScratchTooSmall);\n    let width = add(budget, 1)?;\n    let polynomials = if budget == 0 { 0 } else { mul(8, width)? };\n    let factors = if budget == 0 {\n        0\n    } else {\n        mul(2, mul(width, width)?)?\n    };\n    let raw = if budget == 0 {\n        0\n    } else {\n        mul(2, add(budget, 2)?)?\n    };\n    if workspace.syndromes.len() < add(mul(2, capacity)?, 1)?\n        || workspace.bm.len() < mul(4, add(capacity, 1)?)?\n        || workspace.polynomials.len() < polynomials\n        || workspace.factors.len() < factors\n        || workspace.square_table.len() < mul(budget, budget / 2)?\n        || workspace.verification.len() < capacity\n        || workspace.roots.len() < budget\n        || workspace.raw.len() < raw\n        || workspace.stack.len() < budget\n    {\n        Err(DecodeError::ScratchTooSmall)\n    } else {\n        Ok(())\n    }\n}\n\n#[cfg(test)]\nmod direct_tests;\n\n#[cfg(test)]\nmod fallback_tests;\n"},{"id":6,"name":{"Local":"src/decode/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical-row decoding; no sketch/shape/wire or public arena dependencies.\n#![forbid(unsafe_code)]\n\npub(crate) mod row;\npub(crate) mod scratch;\npub(crate) mod work;\n\nmod bm;\n#[cfg(test)]\nmod bm_tests;\npub(crate) mod direct;\n\nmod affine;\nmod deg34;\nmod degree_probe;\npub(crate) mod probe;\nmod roots;\npub(crate) mod stages;\nmod verify;\n\n#[cfg(test)]\nmod row_tests;\n"},{"id":7,"name":{"Local":"src/field/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical field identity, arithmetic and test-only tiny fields.\n#![forbid(unsafe_code)]\n\nuse crate::types::FieldId;\n\n#[cfg(test)]\npub(crate) mod arithmetic_tests;\n#[cfg(test)]\nmod constant_tests;\n#[cfg(any(target_arch = \"x86_64\", test))]\npub(crate) mod frobenius;\npub(crate) mod gf64;\npub(crate) mod maps;\nmod quadratic_chunks;\n#[cfg(test)]\npub(crate) mod reference;\n#[cfg(test)]\npub(crate) mod tiny;\n\npub(crate) mod sealed {\n    pub trait Sealed {}\n}\n\n/// Closed field specification. Kernels consume canonical words, never masked IDs.\npub trait BinaryField: sealed::Sealed + Copy + Eq + Send + Sync + 'static {\n    /// Extension degree over GF(2).\n    const BITS: u32;\n    /// Irreducible polynomial without its leading term.\n    const MODULUS_LOW: u64;\n    /// Registered polynomial/basis identity.\n    const WIRE_ID: FieldId;\n    /// Canonical element mask.\n    const MASK: u64;\n}\n\n/// Full-width GF(2^64) identity field.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub struct Gf64;\nimpl sealed::Sealed for Gf64 {}\nimpl BinaryField for Gf64 {\n    const BITS: u32 = 64;\n    const MODULUS_LOW: u64 = 0x1b;\n    const WIRE_ID: FieldId = FieldId::Gf64;\n    const MASK: u64 = u64::MAX;\n}\n"},{"id":8,"name":{"Local":"src/backend/mod.rs"},"crate_name":"bulksketch","contents":"//! Arithmetic capabilities and canonical-word kernels only.\n#![deny(unsafe_code)]\n\npub(crate) mod contract;\npub(crate) mod detect;\npub(crate) mod portable;\n#[cfg(target_arch = \"x86_64\")]\npub(crate) mod x86_pclmul;\n\n#[cfg(target_arch = \"x86_64\")]\npub(crate) mod x86_vpclmul512;\n\n#[cfg(all(test, target_arch = \"x86_64\"))]\nmod vpclmul512_tests;\n\n#[cfg(all(test, target_arch = \"x86_64\"))]\nmod pclmul_tests;\n#[cfg(test)]\nmod portable_tests;\n\n#[cfg(test)]\nmod difference_tests;\n\n#[cfg(test)]\npub(crate) mod test_observer;\n\n#[cfg(test)]\nmod byte_map_tests;\n"},{"id":9,"name":{"Local":"src/backend/contract.rs"},"crate_name":"bulksketch","contents":"//! Each backend implements these static, monomorphized contracts for each checked capability.\n#![forbid(unsafe_code)]\n\nuse crate::{field::BinaryField, types::RawProduct};\n\n/// All operands/results are canonical F words. Slice dimensions are internal invariants.\n/// Inverse rejects zero; raw products are unreduced polynomials, never field elements.\npub(crate) trait Arithmetic<F: BinaryField>: Copy + Send + Sync + 'static {\n    fn mul(a: u64, b: u64) -> u64;\n    fn square(a: u64) -> u64;\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"arithmetic parity contract; insertion uses fixed private maps\"\n        )\n    )]\n    fn frobenius(a: u64, power: u32) -> u64;\n    fn inverse(a: u64) -> Option<u64>;\n    /// Absolute field trace, 0 or 1. Canonical scalar maps live in the field module.\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"arithmetic parity contract; scalar map owns current trace callers\"\n        )\n    )]\n    fn trace(a: u64) -> u8;\n    /// Deterministic right inverse of z^2+z on trace-zero inputs; verify each solution.\n    /// Even-degree fields use the fixed-pivot map, never the odd-degree half trace.\n    fn solve_quadratic(a: u64) -> Option<u64>;\n    fn raw_mul(a: u64, b: u64) -> RawProduct;\n    fn reduce(product: RawProduct) -> u64;\n    /// Equal lengths; XOR raw products then reduce once, including the empty dot = 0.\n    #[cfg(test)]\n    fn dot(a: &[u64], b: &[u64]) -> u64;\n    /// Equal lengths; dst[i] ^= src[i] * scale. Aliasing follows safe Rust borrows.\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64);\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"bulk parity contract; current reconstruction squares dependent positions\"\n        )\n    )]\n    fn square_slice(dst: &mut [u64], src: &[u64]);\n}\n\n/// Bulk arithmetic, without shape, wire, request, job or complete-operation types.\npub(crate) trait BulkKernels<F: BinaryField>: Arithmetic<F> {\n    /// Optional monic square-mod kernel; false leaves both mutable slices untouched.\n    /// Degree d>=3, a.len<=d, table.len=d*floor(d/2), dst.len=d, raw.len>=2*d+1.\n    fn square_mod(_a: &[u64], _table: &[u64], _dst: &mut [u64], _raw: &mut [RawProduct]) -> bool {\n        false\n    }\n\n    /// Multiply an ascending polynomial in place by (1 + root*z). Its final\n    /// coefficient must initially be zero; the slice includes that spare word.\n    fn multiply_linear(coefficients: &mut [u64], root: u64) {\n        for index in (1..coefficients.len()).rev() {\n            coefficients[index] ^= Self::mul(coefficients[index - 1], root);\n        }\n    }\n\n    /// Check all odd-sequence continuation equations, after the caller has\n    /// independently verified its first d words. squared_locator is rebuilt\n    /// from roots, has d+1 ascending words and constant coefficient one.\n    fn odd_recurrence_matches(odd: &[u64], squared_locator: &[u64]) -> bool {\n        let degree = squared_locator.len() - 1;\n        for index in degree..odd.len() {\n            let mut sum = RawProduct::default();\n            for lag in 1..=degree {\n                let product = Self::raw_mul(odd[index - lag], squared_locator[lag]);\n                sum.lo ^= product.lo;\n                sum.hi ^= product.hi;\n            }\n            if Self::reduce(sum) != odd[index] {\n                return false;\n            }\n        }\n        true\n    }\n\n    /// Toggle nonzero canonical IDs into S1,S3,... in arrival order. Parity semantics.\n    /// Caller handles routing/zero and validates every input. No post-final multiply.\n    fn insert_nonzero(odd: &mut [u64], ids: &[u64]);\n    /// Overwrite all odd syndromes with the direct encoding of these IDs.\n    fn encode_nonzero(odd: &mut [u64], ids: &[u64]) {\n        odd.fill(0);\n        if ids.len() <= 2 {\n            for id in ids {\n                Self::insert_nonzero(odd, std::slice::from_ref(id));\n            }\n        } else {\n            Self::insert_nonzero(odd, ids);\n        }\n    }\n\n    /// Equal lengths; XOR algebraic words only, never wire metadata.\n    fn xor_assign(dst: &mut [u64], src: &[u64]);\n    /// XOR canonical local words with unaligned little-endian remote words.\n    /// Equal word lengths; returns whether any output word is nonzero.\n    fn difference(dst: &mut [u64], local: &[u64], remote: &[u8]) -> bool {\n        #[cfg(test)]\n        super::test_observer::difference();\n        assert_eq!(dst.len(), local.len(), \"difference length mismatch\");\n        assert_eq!(\n            remote.len(),\n            8 * dst.len(),\n            \"difference byte length mismatch\"\n        );\n        let mut any = 0;\n        for ((out, &word), bytes) in dst.iter_mut().zip(local).zip(remote.chunks_exact(8)) {\n            *out = word ^ u64::from_le_bytes(bytes.try_into().expect(\"complete word\"));\n            any |= *out;\n        }\n        any != 0\n    }\n    /// Ascending coefficients; empty polynomial evaluates to zero. out.len=points.len.\n    fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]);\n}\n"},{"id":10,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"src/types.rs"},"crate_name":"bulksketch","contents":"//! Value-only definitions; this module has no dependency on the engine layers.\n#![forbid(unsafe_code)]\n\n/// Polynomial-basis identity, including the irreducible polynomial.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[repr(u8)]\npub enum FieldId {\n    /// GF(2^64), modulus Z^64 + Z^4 + Z^3 + Z + 1, bit i is Z^i.\n    Gf64 = 1,\n}\n\n/// Shape admission failure, before any row storage is allocated.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ShapeError {\n    /// Unsupported field, zero/non-power-of-two row count, or zero capacity.\n    InvalidShape,\n    /// Configured storage/dimension cap or representable wire dimension exceeded.\n    InputLimitExceeded,\n}\n\n/// Bounded wire admission failure. No view is exposed on either error.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ParseError {\n    /// A caller-supplied byte or dimension limit was exceeded.\n    InputLimitExceeded,\n    /// Unknown metadata, malformed lengths, or noncanonical payload.\n    InvalidEncoding,\n}\n\nimpl std::fmt::Display for ShapeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InvalidShape => \"invalid sketch shape\",\n            Self::InputLimitExceeded => \"shape input limit exceeded\",\n        })\n    }\n}\nimpl std::error::Error for ShapeError {}\n\nimpl std::fmt::Display for ParseError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InputLimitExceeded => \"wire input limit exceeded\",\n            Self::InvalidEncoding => \"invalid sketch encoding\",\n        })\n    }\n}\nimpl std::error::Error for ParseError {}\n\n/// Runtime arithmetic capability. No complete-operation dispatch lives in this type.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub enum BackendId {\n    /// Always-available safe Rust arithmetic.\n    Portable,\n    /// Scalar x86 carryless multiplication.\n    Pclmul,\n    /// 256-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul256,\n    /// 512-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul512,\n}\n\n/// Backend selection requested at engine construction, before any decode.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum BackendRequest {\n    /// Select from capabilities detected at runtime.\n    Auto,\n    /// Require this capability; never bypass feature/OS-state validation.\n    Force(BackendId),\n}\n\n/// An explicitly requested backend is unavailable in this build or on this CPU/OS.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct BackendError(pub BackendId);\n\n/// Construction of mutable state failed before any state was returned.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CreateError {\n    /// The requested arithmetic implementation is unavailable.\n    Backend(BackendError),\n    /// The algebraic buffers could not be reserved.\n    AllocationFailed,\n}\n\n/// Batch insertion failed before changing the sketch.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum UpdateError {\n    /// The supplied insertion arena cannot hold this call's IDs or row offsets.\n    ScratchTooSmall,\n}\n\n/// XOR requires identical fields, row counts and capacities.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ShapeMismatch;\n\n/// Encoding failed without changing the destination or algebraic state.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum EncodeError {\n    /// The destination cannot hold the complete record.\n    BufferTooSmall,\n    /// The cached record could not be reserved.\n    AllocationFailed,\n}\n\nimpl std::fmt::Display for CreateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            Self::Backend(error) => error.fmt(f),\n            Self::AllocationFailed => f.write_str(\"sketch allocation failed\"),\n        }\n    }\n}\nimpl std::error::Error for CreateError {}\nimpl std::fmt::Display for UpdateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"insertion scratch is too small\")\n    }\n}\nimpl std::error::Error for UpdateError {}\nimpl std::fmt::Display for ShapeMismatch {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"sketch shapes differ\")\n    }\n}\nimpl std::error::Error for ShapeMismatch {}\nimpl std::fmt::Display for EncodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::BufferTooSmall => \"encoding buffer is too small\",\n            Self::AllocationFailed => \"encoding allocation failed\",\n        })\n    }\n}\nimpl std::error::Error for EncodeError {}\n\nimpl std::fmt::Display for BackendError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        write!(f, \"backend {:?} is unavailable\", self.0)\n    }\n}\nimpl std::error::Error for BackendError {}\n\n/// Backend-independent logical work, never elapsed time or instruction count.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]\npub struct WorkUnits(pub u64);\n\n/// A request-wide failure publishes no row report or provisional IDs.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeError {\n    /// Local and remote fields, row counts or capacities differ.\n    ShapeMismatch,\n    /// Unknown plan or an output budget larger than any row capacity.\n    InvalidPlan,\n    /// Raw candidate count exceeds the request cap, before normalization.\n    CandidateLimitExceeded,\n    /// Work arithmetic overflows or the next charge exceeds the request limit.\n    WorkLimitExceeded,\n    /// Layout overflows, exceeds its byte cap, or any supplied segment is short.\n    ScratchTooSmall,\n}\n\n/// An admitted row failed algebraically; independently successful rows remain usable.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeFailure {\n    /// Zero consumes an unavailable slot, or locator/final output exceeds beta.\n    DegreeExceedsBudget,\n    /// The locator fails required canonicality/algebraic validation.\n    InvalidLocator,\n    /// The locator does not split into distinct permitted field roots.\n    NotSplit,\n    /// Re-encoding fails any stored odd syndrome or the zero channel.\n    VerificationFailed,\n}\n\nimpl std::fmt::Display for DecodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::ShapeMismatch => \"sketch shapes differ\",\n            Self::InvalidPlan => \"invalid decode plan or output budget\",\n            Self::CandidateLimitExceeded => \"candidate input limit exceeded\",\n            Self::WorkLimitExceeded => \"decode work limit exceeded\",\n            Self::ScratchTooSmall => \"decode scratch is too small\",\n        })\n    }\n}\nimpl std::error::Error for DecodeError {}\n\n/// Deterministic stage order. Repeated trace/GCD/division/leaf stages follow factor traversal.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Stage {\n    /// Propose the nonzero root S1 before general decoding.\n    DirectOne,\n    /// Derive a distinct nonzero pair from S1 and S3 before general decoding.\n    DirectTwo,\n    /// Reject inconsistent cubic prefixes before inversion (V3).\n    GuardThree,\n    /// Normalize a passed cubic Newton guard (V3).\n    NewtonThree,\n    /// Reject inconsistent quartic prefixes before inversion (V3).\n    GuardFour,\n    /// Normalize a passed quartic Newton guard (V3).\n    NewtonFour,\n    /// Propose the roots of a cubic factor (V3).\n    LeafThree,\n    /// Propose the roots of a quartic factor (V3).\n    LeafFour,\n    /// Certify a complete distinct nonzero factor root set (V3).\n    FactorVerification,\n    /// Expand odd syndromes and reconstruct even powers.\n    Reconstruction,\n    /// Binary Berlekamp-Massey iterations.\n    BerlekampMassey,\n    /// Evaluate the original locator at normalized hints.\n    CandidateEvaluation,\n    /// Divide out confirmed candidate roots.\n    Deflation,\n    /// Build a factor's modular-square table.\n    ReducerPreparation,\n    /// Find the least affine multiple and solve its binary map (V3).\n    AffinePreparation,\n    /// Enumerate and evaluate the recovered affine solution coset (V3).\n    AffineEnumeration,\n    /// Form an annihilator splitter for the current affine coset (V3).\n    AffineSplit,\n    /// Try the next canonical trace direction and the internal split check.\n    Trace,\n    /// Compute a monic polynomial GCD.\n    Gcd,\n    /// Divide a factor exactly after a proper split.\n    FactorDivision,\n    /// Solve degree-one or degree-two leaves.\n    Leaf,\n    /// Verify every stored odd syndrome by re-encoding or rebuilt recurrence.\n    Verification,\n    /// Sort and validate the final original IDs.\n    Canonicalization,\n}\n\n/// Public stage progress contains no row outcome or provisional ID.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum StageProgress {\n    /// A deterministic stage completed; counters are cumulative for the request.\n    Completed {\n        /// Bucket whose stage completed, in deterministic request traversal order.\n        bucket: usize,\n        /// Stage just executed.\n        stage: Stage,\n        /// Logical work consumed so far.\n        work: WorkUnits,\n        /// Peak required workspace bytes, excluding unused arena capacity.\n        peak_scratch_bytes: usize,\n        /// Original BM locator degree for this row; zero until BM completes.\n        locator_degree: usize,\n        /// Confirmed candidate roots so far in this row.\n        candidate_hits: usize,\n        /// Trace directions attempted so far in this row.\n        trace_attempts: usize,\n        /// Degree returned by this row's most recent GCD; zero before the first GCD.\n        gcd_degree: usize,\n    },\n    /// Terminal request failure; finishing the job must return this error.\n    Failed(DecodeError),\n}\n\n/// Internal arithmetic product, distinct from a canonical field element.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub(crate) struct RawProduct {\n    pub(crate) lo: u64,\n    pub(crate) hi: u64,\n}\n\n/// One request meter, shared by preprocessing and all rows. A failed charge is terminal.\n#[derive(Debug)]\npub(crate) struct WorkMeter {\n    limit: WorkUnits,\n    used: WorkUnits,\n    exhausted: bool,\n}\n\nimpl WorkMeter {\n    pub(crate) fn new(limit: WorkUnits) -> Self {\n        Self {\n            limit,\n            used: WorkUnits(0),\n            exhausted: false,\n        }\n    }\n\n    pub(crate) fn charge(&mut self, charge: WorkUnits) -> Result<(), DecodeError> {\n        let next = self.used.0.checked_add(charge.0);\n        if self.exhausted || next.is_none_or(|n| n > self.limit.0) {\n            self.exhausted = true;\n            return Err(DecodeError::WorkLimitExceeded);\n        }\n        self.used = WorkUnits(next.expect(\"checked work charge\"));\n        Ok(())\n    }\n\n    pub(crate) fn used(&self) -> WorkUnits {\n        self.used\n    }\n}\n\n#[cfg(test)]\npub(crate) mod small_degree_observer;\n"},{"id":17,"name":{"Local":"src/decode/row.rs"},"crate_name":"bulksketch","contents":"//! Staged ordinary binary rows. Mapping and zero stay upstairs.\n#![forbid(unsafe_code)]\n\nuse {\n    super::scratch::RowWorkspace,\n    crate::{\n        backend::contract::BulkKernels,\n        field::BinaryField,\n        types::{DecodeError, DecodeFailure, Stage, WorkMeter},\n    },\n};\n\n/// Field roots only: distinct, nonzero, ascending, count <= the checked nonzero budget.\n/// Decoded borrows exactly the verified roots from any workspace segment; no prefix\n/// location is promised. The upper job copies this slice and prepends original zero.\npub(crate) enum RowResult<'w> {\n    Equal,\n    Decoded(&'w [u64]),\n    Failed(DecodeFailure),\n}\n\n/// Checked upstairs: nonzero <= total <= capacity, with at most one zero slot.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub(crate) struct RowBudget {\n    pub(crate) nonzero: usize,\n    pub(crate) total: usize,\n}\n\n/// Canonical odd difference and normalized nonzero hints, unchanged across stages.\n#[derive(Clone, Copy, Debug)]\npub(crate) struct RowInput<'a> {\n    pub(crate) difference: &'a [u64],\n    pub(crate) candidates: &'a [u64],\n}\n\n/// Row-local progress. The request job adds bucket, request work and complete arena size;\n/// lower code never constructs the public job's request-level progress record.\npub(crate) struct RowProgress {\n    pub(crate) stage: Stage,\n    pub(crate) locator_degree: usize,\n    pub(crate) candidate_hits: usize,\n    pub(crate) trace_attempts: usize,\n    pub(crate) gcd_degree: usize,\n}\n\n/// Execution owns only small row state, never borrowed inputs or workspace handles.\n/// Progress exposes no provisional roots. V2's private upper-job handoff validates\n/// proposed roots before canonicalization; rejection resumes the row without publication.\n/// Finish drains and borrows only completed roots.\npub(crate) trait RowExecution {\n    fn next_stage(&self) -> Option<Stage>;\n    fn run_next(\n        &mut self,\n        input: RowInput<'_>,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<RowProgress, DecodeError>;\n    /// Drain and consume execution; only a completed, verified slice may escape.\n    /// Its borrow ends before workspace reuse; callers must use the returned slice,\n    /// not infer a storage location. Drop and errors publish no roots.\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"The consuming row contract is tested directly; request jobs borrow \\\n                      completed rows\"\n        )\n    )]\n    fn finish<'w>(\n        self,\n        input: RowInput<'_>,\n        workspace: &'w mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<RowResult<'w>, DecodeError>;\n}\n\n/// One monomorphized row driver per arithmetic capability; no runtime per-multiply dispatch.\npub(crate) trait RowDecoder<F: BinaryField, K: BulkKernels<F>> {\n    type Execution: RowExecution;\n    /// difference.len=c>0; budgets checked; hints normalized/nonzero/canonical.\n    /// Each stage is lent the same row segments; no stage may grow them.\n    /// Reject BM degree beyond budget.nonzero before out-of-budget writes.\n    /// Verification and canonicalization charge budget.total, including the zero slot.\n    /// General stages retain V1 charges. V2 probes pay before materialization/algebra\n    /// and each verification; misses preserve these inputs and fresh general state.\n    /// V3 may replace roots/verification with charged affine and rebuilt-LFSR stages.\n    fn begin(budget: RowBudget) -> Self::Execution;\n}\n"},{"id":18,"name":{"Local":"src/decode/roots.rs"},"crate_name":"bulksketch","contents":"//! Depth-first factor traversal; pending factors own coefficients, never parent tables.\n#![forbid(unsafe_code)]\nuse {\n    super::{\n        affine, deg34,\n        scratch::{FactorFrame, RowWorkspace, SplitterBasis},\n        work::{Charge, WorkScheduleV1},\n    },\n    crate::{\n        backend::contract::BulkKernels,\n        field::BinaryField,\n        poly::{Dense, Polynomial},\n        types::{DecodeError, DecodeFailure, RawProduct, Stage, WorkMeter},\n    },\n};\n\n#[derive(Debug, Default)]\npub(super) struct Roots {\n    pending: usize,\n    stride: usize,\n    degree: usize,\n    direction: u32,\n    checked: bool,\n    trace_len: usize,\n    gcd_len: usize,\n    pub(super) count: usize,\n    pub(super) attempts: usize,\n    pub(super) gcd_degree: usize,\n    splitter_seed: u64,\n    v3: bool,\n    closed_form: bool,\n    solved_count: usize,\n    affine: bool,\n    affine_ready: bool,\n    affine_base: u64,\n    affine_rank: usize,\n}\n// At degree d>=3 these regions need 7d+10 words, at most 8(r+1).\nstruct FactorWork<'a> {\n    modulus: &'a mut [u64],\n    trace: &'a mut [u64],\n    gcd: &'a mut [u64],\n    work: &'a mut [u64],\n    table: &'a mut [u64],\n    raw: &'a mut [RawProduct],\n    basis: &'a mut SplitterBasis,\n}\nimpl<'a> FactorWork<'a> {\n    fn new(\n        degree: usize,\n        polynomials: &'a mut [u64],\n        table: &'a mut [u64],\n        raw: &'a mut [RawProduct],\n        basis: &'a mut SplitterBasis,\n    ) -> Self {\n        let (modulus, rest) = polynomials.split_at_mut(degree + 1);\n        let (trace, rest) = rest.split_at_mut(degree);\n        let (gcd, work) = rest.split_at_mut(degree + 1);\n        Self {\n            modulus,\n            trace,\n            gcd,\n            work,\n            table: &mut table[..degree * (degree / 2)],\n            raw,\n            basis,\n        }\n    }\n}\nfn charge(meter: &mut WorkMeter, operation: Charge) -> Result<(), DecodeError> {\n    meter.charge(WorkScheduleV1::cost(operation)?)\n}\nimpl Roots {\n    pub(super) fn enable_v3(&mut self) {\n        self.v3 = true;\n    }\n\n    pub(super) fn enable_closed_form(&mut self) {\n        self.closed_form = true;\n    }\n\n    pub(super) fn set_splitter_seed(&mut self, seed: u64) {\n        self.splitter_seed = seed;\n    }\n\n    pub(super) fn start(&mut self, degree: usize, workspace: &mut RowWorkspace<'_>) -> Stage {\n        // The cache belongs to this row, even when the scratch owner is reused.\n        workspace.basis.directions = None;\n        workspace.basis.len = 0;\n        self.degree = degree;\n        self.stride = degree + 1;\n        self.affine = self.v3 && affine::preferred::<crate::field::Gf64>(degree);\n        self.affine_ready = false;\n        if degree != 0 {\n            workspace.polynomials[..=degree].copy_from_slice(&workspace.bm[..=degree]);\n        }\n        self.stage()\n    }\n    fn stage(&self) -> Stage {\n        if self.degree < 3 {\n            Stage::Leaf\n        } else if self.closed_form && self.degree == 3 {\n            Stage::LeafThree\n        } else if self.closed_form && self.degree == 4 {\n            Stage::LeafFour\n        } else {\n            Stage::ReducerPreparation\n        }\n    }\n    fn advance(&mut self, workspace: &mut RowWorkspace<'_>) -> Stage {\n        if self.pending == 0 {\n            return Stage::Verification;\n        }\n        self.pending -= 1;\n        let frame = &workspace.stack[self.pending];\n        let start = usize::try_from(frame.coefficient_start).expect(\"admitted coefficient offset\");\n        let len = usize::try_from(frame.coefficient_len).expect(\"admitted coefficient length\");\n        workspace.polynomials[..len].copy_from_slice(&workspace.factors[start..start + len]);\n        self.degree = len - 1;\n        self.direction = frame.next_direction;\n        self.checked = frame.split_checked != 0;\n        if self.affine {\n            self.affine_base = workspace.factors[start + self.stride - 1];\n            self.affine_rank = frame.next_direction as usize;\n        }\n        self.stage()\n    }\n    pub(super) fn run<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        stage: Stage,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        #[cfg(test)]\n        crate::types::small_degree_observer::stage(stage, true);\n        if matches!(\n            stage,\n            Stage::LeafThree | Stage::LeafFour | Stage::FactorVerification\n        ) {\n            return self.closed_leaf::<F, K>(stage, workspace, meter);\n        }\n        if stage == Stage::Leaf {\n            return self.leaf::<F, K>(workspace, meter);\n        }\n        if stage == Stage::AffinePreparation {\n            return self.prepare_affine::<F, K>(workspace, meter);\n        }\n        if stage == Stage::AffineEnumeration {\n            return self.enumerate_affine::<F, K>(workspace, meter);\n        }\n        let degree = self.degree;\n        let mut buffers = FactorWork::new(\n            degree,\n            workspace.polynomials,\n            workspace.square_table,\n            workspace.raw,\n            workspace.basis,\n        );\n        match stage {\n            Stage::ReducerPreparation => {\n                charge(meter, Charge::Table { degree })?;\n                <Dense as Polynomial<F, K>>::prepare_square_table(\n                    buffers.modulus,\n                    buffers.table,\n                    buffers.work,\n                );\n                Ok(Ok(if self.affine {\n                    if self.affine_ready {\n                        Stage::AffineSplit\n                    } else {\n                        Stage::AffinePreparation\n                    }\n                } else {\n                    Stage::Trace\n                }))\n            }\n            Stage::AffineSplit => {\n                charge(\n                    meter,\n                    Charge::AffineSplit {\n                        degree,\n                        rank: self.affine_rank,\n                    },\n                )?;\n                if self.affine_rank == 0 {\n                    return Ok(Err(DecodeFailure::NotSplit));\n                }\n                let rank = self.affine_rank - 1;\n                let start = self.stride * self.stride + affine::subspace_start(rank);\n                self.trace_len = affine::splitter::<F, K>(\n                    buffers.modulus,\n                    buffers.table,\n                    &workspace.factors[start..start + rank + 1],\n                    self.affine_base,\n                    buffers.trace,\n                    buffers.work,\n                    buffers.raw,\n                );\n                Ok(Ok(Stage::Gcd))\n            }\n            Stage::Trace => self.trace::<F, K>(&mut buffers, meter),\n            Stage::Gcd => {\n                charge(meter, Charge::Gcd { degree })?;\n                self.gcd_len = <Dense as Polynomial<F, K>>::monic_gcd_into(\n                    buffers.modulus,\n                    &buffers.trace[..self.trace_len],\n                    buffers.gcd,\n                    buffers.work,\n                    buffers.raw,\n                );\n                self.gcd_degree = self.gcd_len - 1;\n                if self.gcd_degree > 0 && self.gcd_degree < degree {\n                    return Ok(Ok(Stage::FactorDivision));\n                }\n                if self.affine {\n                    self.affine_rank -= 1;\n                    if self.gcd_len == 1 {\n                        self.affine_base ^=\n                            buffers.basis.directions.as_ref().expect(\"affine basis\")\n                                [self.affine_rank];\n                    }\n                    return Ok(Ok(Stage::AffineSplit));\n                }\n                self.direction += 1;\n                if self.direction == F::BITS {\n                    Ok(Err(DecodeFailure::NotSplit))\n                } else {\n                    Ok(Ok(Stage::Trace))\n                }\n            }\n            Stage::FactorDivision => {\n                self.divide::<F, K>(&mut buffers, workspace.factors, workspace.stack, meter)\n            }\n            _ => unreachable!(\"root traversal stage\"),\n        }\n    }\n    fn closed_leaf<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        stage: Stage,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        let degree = self.degree;\n        if stage != Stage::FactorVerification {\n            charge(\n                meter,\n                if degree == 3 {\n                    Charge::LeafThree\n                } else {\n                    Charge::LeafFour\n                },\n            )?;\n            let (factor, rest) = workspace.polynomials.split_at_mut(11);\n            let Some(count) = deg34::solve::<F, K>(&factor[..=degree], &mut rest[..4]) else {\n                return Ok(Ok(Stage::ReducerPreparation));\n            };\n            self.solved_count = count;\n            return Ok(Ok(Stage::FactorVerification));\n        }\n        charge(meter, Charge::FactorVerification { degree })?;\n        let (values, product) = workspace.polynomials.split_at_mut(15);\n        let roots = &values[11..11 + self.solved_count];\n        let valid = deg34::certificate::<F, K>(&values[..=degree], roots, &mut product[..5]);\n        #[cfg(test)]\n        crate::types::small_degree_observer::certificate(valid);\n        if !valid {\n            return Ok(Ok(Stage::ReducerPreparation));\n        }\n        workspace.roots[self.count..self.count + degree].copy_from_slice(roots);\n        self.count += degree;\n        Ok(Ok(self.advance(workspace)))\n    }\n\n    fn prepare_affine<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        let degree = self.degree;\n        charge(meter, Charge::AffinePreparation { degree })?;\n        let (coefficients, work) = workspace.bm.split_at_mut(degree + 1);\n        let len = affine::multiple::<F, K>(\n            &workspace.polynomials[..=degree],\n            &workspace.square_table[..degree * (degree / 2)],\n            workspace.factors,\n            coefficients,\n            work,\n            workspace.raw,\n        );\n        // The X coefficient is the affine multiple's constant derivative.\n        // A repeated factor forces it to zero. Conversely, for a squarefree\n        // input a zero derivative would give a smaller affine multiple by\n        // taking a square root, contradicting minimality.\n        if coefficients[1] == 0 {\n            return Ok(Err(DecodeFailure::NotSplit));\n        }\n        let basis = workspace.basis.directions.insert([0; 64]);\n        let Some((base, rank)) = affine::solve_map::<F, K>(&coefficients[..len], basis) else {\n            return Ok(Err(DecodeFailure::NotSplit));\n        };\n        if rank >= len - 1\n            || 1_u64\n                .checked_shl(rank as u32)\n                .is_some_and(|n| n < degree as u64)\n        {\n            return Ok(Err(DecodeFailure::NotSplit));\n        }\n        workspace.basis.len = rank as u32;\n        self.affine_base = base;\n        self.affine_rank = rank;\n        self.affine_ready = true;\n        if affine::enumerate_preferred(degree, rank) {\n            Ok(Ok(Stage::AffineEnumeration))\n        } else {\n            let offset = self.stride * self.stride;\n            affine::subspaces::<F, K>(&basis[..rank], &mut workspace.factors[offset..]);\n            Ok(Ok(Stage::AffineSplit))\n        }\n    }\n\n    fn enumerate_affine<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        charge(\n            meter,\n            Charge::AffineEnumeration {\n                degree: self.degree,\n                rank: self.affine_rank,\n            },\n        )?;\n        let found = match affine::enumerate::<F, K>(\n            &workspace.polynomials[..=self.degree],\n            self.affine_base,\n            &workspace.basis.directions.as_ref().expect(\"affine basis\")[..self.affine_rank],\n            &mut workspace.roots[self.count..],\n            workspace.bm,\n        ) {\n            Ok(count) => count,\n            Err(reason) => return Ok(Err(reason)),\n        };\n        self.count += found;\n        Ok(Ok(self.advance(workspace)))\n    }\n\n    fn leaf<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        charge(\n            meter,\n            Charge::Leaf {\n                degree: self.degree,\n            },\n        )?;\n        let roots = match self.degree {\n            0 => [0, 0],\n            1 => [workspace.polynomials[0], 0],\n            2 => {\n                let linear = workspace.polynomials[1];\n                if linear == 0 {\n                    return Ok(Err(DecodeFailure::NotSplit));\n                }\n                let inverse = K::inverse(linear).expect(\"nonzero quadratic coefficient\");\n                let target = K::mul(workspace.polynomials[0], K::square(inverse));\n                let Some(solution) = K::solve_quadratic(target) else {\n                    return Ok(Err(DecodeFailure::NotSplit));\n                };\n                let root = K::mul(linear, solution);\n                [root, root ^ linear]\n            }\n            _ => unreachable!(\"leaf degree at most two\"),\n        };\n        if roots[..self.degree].contains(&0) {\n            return Ok(Err(DecodeFailure::InvalidLocator));\n        }\n        workspace.roots[self.count..self.count + self.degree]\n            .copy_from_slice(&roots[..self.degree]);\n        self.count += self.degree;\n        Ok(Ok(self.advance(workspace)))\n    }\n    fn trace<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        buffers: &mut FactorWork<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        let degree = self.degree;\n        charge(meter, Charge::Trace { degree })?;\n        self.attempts += 1;\n        let seed = self.splitter_seed;\n        let basis_len = &mut buffers.basis.len;\n        let basis = buffers.basis.directions.get_or_insert_with(|| {\n            let mut basis = [0; 64];\n            basis[0] = (seed & F::MASK).max(1);\n            *basis_len = 1;\n            basis\n        });\n        // Pending siblings can resume earlier directions. Retain the initialized\n        // prefix, extending it only after the requested Trace has been charged.\n        while *basis_len <= self.direction {\n            let splitter = basis[*basis_len as usize - 1];\n            let carry = splitter >> (F::BITS - 1);\n            basis[*basis_len as usize] =\n                ((splitter << 1) & F::MASK) ^ (F::MODULUS_LOW & 0u64.wrapping_sub(carry));\n            *basis_len += 1;\n        }\n        let splitter = basis[self.direction as usize];\n        buffers.trace.fill(0);\n        buffers.trace[1] = splitter;\n        self.trace_len = 2;\n        for _ in 1..F::BITS {\n            let len = <Dense as Polynomial<F, K>>::square_mod_into(\n                &buffers.trace[..self.trace_len],\n                buffers.modulus,\n                buffers.table,\n                buffers.gcd,\n                buffers.raw,\n            );\n            buffers.trace[..len].copy_from_slice(&buffers.gcd[..len]);\n            self.trace_len =\n                <Dense as Polynomial<F, K>>::xor_coefficient(buffers.trace, len, 1, splitter);\n        }\n        if !self.checked {\n            charge(meter, Charge::SplitCheck { degree })?;\n            <Dense as Polynomial<F, K>>::square_mod_into(\n                &buffers.trace[..self.trace_len],\n                buffers.modulus,\n                buffers.table,\n                buffers.gcd,\n                buffers.raw,\n            );\n            // Modular squaring writes all d output words. Pad the normalized trace\n            // to compare T^2+T, including coefficients above either normalized end.\n            buffers.trace[self.trace_len..].fill(0);\n            if buffers.gcd[..degree] != *buffers.trace {\n                return Ok(Err(DecodeFailure::NotSplit));\n            }\n            self.checked = true;\n        }\n        Ok(Ok(Stage::Gcd))\n    }\n    fn divide<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        buffers: &mut FactorWork<'_>,\n        factors: &mut [u64],\n        stack: &mut [FactorFrame],\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        let degree = self.degree;\n        charge(meter, Charge::Divide { degree })?;\n        let (quotient, remainder) = buffers.work.split_at_mut(degree + 2);\n        let Some(len) = <Dense as Polynomial<F, K>>::exact_divide_into(\n            buffers.modulus,\n            &buffers.gcd[..self.gcd_len],\n            quotient,\n            remainder,\n            buffers.raw,\n        ) else {\n            return Ok(Err(DecodeFailure::InvalidLocator));\n        };\n        charge(meter, Charge::SplitAssembly { degree })?;\n        // The pending right child owns coefficients only. The left replaces the\n        // modulus; no released parent reducer can ever be resumed.\n        let start = self\n            .pending\n            .checked_mul(self.stride)\n            .ok_or(DecodeError::ScratchTooSmall)?;\n        let end = start.checked_add(len).ok_or(DecodeError::ScratchTooSmall)?;\n        factors[start..end].copy_from_slice(&quotient[..len]);\n        stack[self.pending] = FactorFrame {\n            coefficient_start: u64::try_from(start).expect(\"admitted offset\"),\n            coefficient_len: u64::try_from(len).expect(\"admitted degree\"),\n            next_direction: self.direction + 1,\n            split_checked: 1,\n        };\n        if self.affine {\n            self.affine_rank -= 1;\n            factors[start + self.stride - 1] = self.affine_base\n                ^ buffers.basis.directions.as_ref().expect(\"affine basis\")[self.affine_rank];\n            stack[self.pending].next_direction = self.affine_rank as u32;\n        }\n        self.pending += 1;\n        buffers.modulus[..self.gcd_len].copy_from_slice(&buffers.gcd[..self.gcd_len]);\n        self.degree = self.gcd_degree;\n        self.direction += 1;\n        self.checked = true;\n        Ok(Ok(self.stage()))\n    }\n}\n#[cfg(test)]\nmod trace_tests;\n\n#[cfg(test)]\nmod affine_tests;\n"},{"id":19,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"src/decode/degree_probe.rs"},"crate_name":"bulksketch","contents":"//! Transactional whole-row degree-three/four probes. No candidate or splitter state.\n#![forbid(unsafe_code)]\nuse {\n    super::{\n        deg34,\n        probe::verified,\n        row::RowBudget,\n        scratch::RowWorkspace,\n        work::{Charge, WorkScheduleV1},\n    },\n    crate::{\n        backend::contract::BulkKernels,\n        field::BinaryField,\n        types::{DecodeError, Stage, WorkMeter},\n    },\n};\n\n#[derive(Debug)]\npub(super) struct DegreeProbe {\n    degree: u8,\n    count: u8,\n    next: Option<Stage>,\n}\nimpl DegreeProbe {\n    // Use every available check at c=3..6. Roots still need the product certificate\n    // and complete row verification; no extra stored words are required.\n    pub(super) fn new(budget: RowBudget, capacity: usize) -> Option<Self> {\n        (budget.nonzero >= 3 && capacity >= 3).then_some(Self {\n            degree: 3,\n            count: 0,\n            next: Some(Stage::GuardThree),\n        })\n    }\n    pub(super) fn next_stage(&self) -> Option<Stage> {\n        self.next\n    }\n    pub(super) fn count(&self) -> usize {\n        usize::from(self.count)\n    }\n    pub(super) fn reject(&mut self, capacity: usize, budget: RowBudget) {\n        self.count = 0;\n        self.next = Some(\n            if self.degree == 3 && capacity >= 4 && budget.nonzero >= 4 {\n                self.degree = 4;\n                Stage::GuardFour\n            } else {\n                Stage::Reconstruction\n            },\n        );\n    }\n    pub(super) fn run<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        odd: &[u64],\n        budget: RowBudget,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Option<Stage>, DecodeError> {\n        let stage = self.next.expect(\"active degree probe\");\n        let degree = usize::from(self.degree);\n        let count = self.count();\n        let operation = match stage {\n            Stage::GuardThree => Charge::GuardThree,\n            Stage::GuardFour => Charge::GuardFour,\n            Stage::NewtonThree => Charge::NewtonThree,\n            Stage::NewtonFour => Charge::NewtonFour,\n            Stage::LeafThree => Charge::LeafThree,\n            Stage::LeafFour => Charge::LeafFour,\n            Stage::FactorVerification => Charge::FactorVerification { degree },\n            Stage::Verification => Charge::Verify {\n                capacity: odd.len(),\n                output_budget: budget.total,\n            },\n            Stage::Canonicalization => Charge::Canonicalize { ids: budget.total },\n            _ => unreachable!(\"whole-row degree probe stage\"),\n        };\n        meter.charge(WorkScheduleV1::cost(operation)?)?;\n        #[cfg(test)]\n        crate::types::small_degree_observer::stage(stage, false);\n        match stage {\n            Stage::GuardThree | Stage::GuardFour => {\n                if deg34::guard::<F, K>(odd, degree, &mut workspace.polynomials[5..11]) {\n                    self.next = Some(if degree == 3 {\n                        Stage::NewtonThree\n                    } else {\n                        Stage::NewtonFour\n                    });\n                } else {\n                    self.reject(odd.len(), budget);\n                }\n            }\n            Stage::NewtonThree | Stage::NewtonFour => {\n                let (factor, rest) = workspace.polynomials.split_at_mut(5);\n                deg34::normalize::<F, K>(&rest[..6], odd[0], degree, factor);\n                self.next = Some(if degree == 3 {\n                    Stage::LeafThree\n                } else {\n                    Stage::LeafFour\n                });\n            }\n            Stage::LeafThree | Stage::LeafFour => {\n                let (factor, rest) = workspace.polynomials.split_at_mut(11);\n                if let Some(count) = deg34::solve::<F, K>(&factor[..=degree], &mut rest[..4]) {\n                    self.count = u8::try_from(count).expect(\"degree-three/four root count\");\n                    self.next = Some(Stage::FactorVerification);\n                } else {\n                    self.reject(odd.len(), budget);\n                }\n            }\n            Stage::FactorVerification => {\n                let (values, product) = workspace.polynomials.split_at_mut(15);\n                let valid = deg34::certificate::<F, K>(\n                    &values[..=degree],\n                    &values[11..11 + count],\n                    &mut product[..5],\n                );\n                #[cfg(test)]\n                crate::types::small_degree_observer::certificate(valid);\n                if valid {\n                    workspace.roots[..count].copy_from_slice(&values[11..11 + count]);\n                    self.next = Some(Stage::Verification);\n                } else {\n                    self.reject(odd.len(), budget);\n                }\n            }\n            Stage::Verification => {\n                if verified::<F, K>(odd, &workspace.roots[..count], workspace.verification) {\n                    self.next = Some(Stage::Canonicalization);\n                } else {\n                    self.reject(odd.len(), budget);\n                }\n            }\n            Stage::Canonicalization => {\n                workspace.roots[..count].sort_unstable();\n                self.next = None;\n            }\n            _ => unreachable!(\"charged degree probe\"),\n        }\n        Ok(self.next)\n    }\n}\n"},{"id":21,"name":{"Local":"src/decode/scratch.rs"},"crate_name":"bulksketch","contents":"//! Lower workspace borrows, owned by the upper request arena. The row decoder consumes these.\n#![forbid(unsafe_code)]\n\nuse crate::types::RawProduct;\n\n#[derive(Default)]\npub(crate) struct SplitterBasis {\n    pub(crate) directions: Option<[u64; 64]>,\n    pub(crate) len: u32,\n}\n\nimpl std::fmt::Debug for SplitterBasis {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.debug_struct(\"SplitterBasis\").finish_non_exhaustive()\n    }\n}\n\n/// An explicit factor-stack entry. The parent table is released before children start.\n#[derive(Clone, Debug, Default)]\n#[repr(C)]\npub(crate) struct FactorFrame {\n    pub(crate) coefficient_start: u64,\n    pub(crate) coefficient_len: u64,\n    pub(crate) next_direction: u32,\n    pub(crate) split_checked: u32,\n}\n\n/// Consecutive words, never a public arena or a replaceable scratch handle.\npub(crate) struct RowWorkspace<'w> {\n    pub(crate) syndromes: &'w mut [u64],\n    pub(crate) bm: &'w mut [u64],\n    pub(crate) polynomials: &'w mut [u64],\n    pub(crate) factors: &'w mut [u64],\n    pub(crate) square_table: &'w mut [u64],\n    pub(crate) verification: &'w mut [u64],\n    pub(crate) roots: &'w mut [u64],\n    pub(crate) raw: &'w mut [RawProduct],\n    pub(crate) stack: &'w mut [FactorFrame],\n    pub(crate) basis: &'w mut SplitterBasis,\n}\n"},{"id":22,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/core/src/panic.rs"},"crate_name":"core","contents":null},{"id":24,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":25,"name":{"Local":"/rustc/library/core/src/panicking.rs"},"crate_name":"core","contents":null},{"id":26,"name":{"Local":"/rustc/library/core/src/iter/adapters/rev.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"