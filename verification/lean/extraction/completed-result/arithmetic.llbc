4,4]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"index_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["index_mut",0]}],"span":{"Untagged":{"data":{"file_id":4,"beg":{"line":173,"col":4},"end":{"line":173,"col":59}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a mutable reference to the output at this location, panicking"},{"DocComment":" if out of bounds."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":4,"beg":{"line":172,"col":4},"end":{"line":172,"col":19}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":20},{"Deduplicated":350}],"output":{"Deduplicated":352}},"default":null},"kind":{"TraitMethod":[4,5]}}],"vtable":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":21},{"Deduplicated":49}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":5,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["IndexMut",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":170,"col":0},"end":{"line":170,"col":57}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for indexing operations (`container[index]`) in mutable contexts."},{"DocComment":""},{"DocComment":" `container[index]` is actually syntactic sugar for"},{"DocComment":" `*container.index_mut(index)`, but only when used as a mutable value. If"},{"DocComment":" an immutable value is requested, the [`Index`] trait is used instead. This"},{"DocComment":" allows nice things such as `v[index] = value`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" A very simple implementation of a `Balance` struct that has two sides, where"},{"DocComment":" each can be indexed mutably and immutably."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::{Index, IndexMut};"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" enum Side {"},{"DocComment":"     Left,"},{"DocComment":"     Right,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" enum Weight {"},{"DocComment":"     Kilogram(f32),"},{"DocComment":"     Pound(f32),"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct Balance {"},{"DocComment":"     pub left: Weight,"},{"DocComment":"     pub right: Weight,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Index<Side> for Balance {"},{"DocComment":"     type Output = Weight;"},{"DocComment":""},{"DocComment":"     fn index(&self, index: Side) -> &Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance immutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &self.left,"},{"DocComment":"             Side::Right => &self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl IndexMut<Side> for Balance {"},{"DocComment":"     fn index_mut(&mut self, index: Side) -> &mut Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance mutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &mut self.left,"},{"DocComment":"             Side::Right => &mut self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut balance = Balance {"},{"DocComment":"     right: Weight::Kilogram(2.5),"},{"DocComment":"     left: Weight::Pound(1.5),"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" // In this case, `balance[Side::Right]` is sugar for"},{"DocComment":" // `*balance.index(Side::Right)`, since we are only *reading*"},{"DocComment":" // `balance[Side::Right]`, not writing it."},{"DocComment":" assert_eq!(balance[Side::Right], Weight::Kilogram(2.5));"},{"DocComment":""},{"DocComment":" // However, in this case `balance[Side::Left]` is sugar for"},{"DocComment":" // `*balance.index_mut(Side::Left)`, since we are writing"},{"DocComment":" // `balance[Side::Left]`."},{"DocComment":" balance[Side::Left] = Weight::Kilogram(3.0);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"IndexMut","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Idx","variance":"Unknown"},{"index":2,"name":"Self_Clause0_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[318,{"data":{"file_id":12,"beg":{"line":170,"col":39},"end":{"line":170,"col":57}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":20},{"Deduplicated":21},{"Deduplicated":49}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"index_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["IndexMut",0]},{"Ident":["index_mut",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":179,"col":4},"end":{"line":179,"col":61}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the mutable indexing (`container[index]`) operation."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" May panic if the index is out of bounds."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":12,"beg":{"line":178,"col":4},"end":{"line":178,"col":19}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[357,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":20},"Mut"]}]},{"Deduplicated":21}],"output":{"Deduplicated":352}},"default":null},"kind":{"TraitMethod":[5,0]}}],"vtable":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":21},{"Deduplicated":49}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":6,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["field",0]},{"Ident":["sealed",0]},{"Ident":["Sealed",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":21,"col":4},"end":{"line":21,"col":23}},"generated_from_span":null}},"source_text":"pub trait Sealed {}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":22,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":7,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Copy",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":454,"col":0},"end":{"line":454,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types whose values can be duplicated simply by copying bits."},{"DocComment":""},{"DocComment":" By default, variable bindings have 'move semantics.' In other"},{"DocComment":" words:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Foo;"},{"DocComment":""},{"DocComment":" let x = Foo;"},{"DocComment":""},{"DocComment":" let y = x;"},{"DocComment":""},{"DocComment":" // `x` has moved into `y`, and so cannot be used"},{"DocComment":""},{"DocComment":" // println!(\"{x:?}\"); // error: use of moved value"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However, if a type implements `Copy`, it instead has 'copy semantics':"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // We can derive a `Copy` implementation. `Clone` is also required, as it's"},{"DocComment":" // a supertrait of `Copy`."},{"DocComment":" #[derive(Debug, Copy, Clone)]"},{"DocComment":" struct Foo;"},{"DocComment":""},{"DocComment":" let x = Foo;"},{"DocComment":""},{"DocComment":" let y = x;"},{"DocComment":""},{"DocComment":" // `y` is a copy of `x`"},{"DocComment":""},{"DocComment":" println!(\"{x:?}\"); // A-OK!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It's important to note that in these two examples, the only difference is whether you"},{"DocComment":" are allowed to access `x` after the assignment. Under the hood, both a copy and a move"},{"DocComment":" can result in bits being copied in memory, although this is sometimes optimized away."},{"DocComment":""},{"DocComment":" ## How can I implement `Copy`?"},{"DocComment":""},{"DocComment":" There are two ways to implement `Copy` on your type. The simplest is to use `derive`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct MyStruct;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also implement `Copy` and `Clone` manually:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct MyStruct;"},{"DocComment":""},{"DocComment":" impl Copy for MyStruct { }"},{"DocComment":""},{"DocComment":" impl Clone for MyStruct {"},{"DocComment":"     fn clone(&self) -> MyStruct {"},{"DocComment":"         *self"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There is a small difference between the two. The `derive` strategy will also place a `Copy`"},{"DocComment":" bound on type parameters:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Clone)]"},{"DocComment":" struct MyStruct<T>(T);"},{"DocComment":""},{"DocComment":" impl<T: Copy> Copy for MyStruct<T> { }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This isn't always desired. For example, shared references (`&T`) can be copied regardless of"},{"DocComment":" whether `T` is `Copy`. Likewise, a generic struct containing markers such as [`PhantomData`]"},{"DocComment":" could potentially be duplicated with a bit-wise copy."},{"DocComment":""},{"DocComment":" ## What's the difference between `Copy` and `Clone`?"},{"DocComment":""},{"DocComment":" Copies happen implicitly, for example as part of an assignment `y = x`. The behavior of"},{"DocComment":" `Copy` is not overloadable; it is always a simple bit-wise copy."},{"DocComment":""},{"DocComment":" Cloning is an explicit action, `x.clone()`. The implementation of [`Clone`] can"},{"DocComment":" provide any type-specific behavior necessary to duplicate values safely. For example,"},{"DocComment":" the implementation of [`Clone`] for [`String`] needs to copy the pointed-to string"},{"DocComment":" buffer in the heap. A simple bitwise copy of [`String`] values would merely copy the"},{"DocComment":" pointer, leading to a double free down the line. For this reason, [`String`] is [`Clone`]"},{"DocComment":" but not `Copy`."},{"DocComment":""},{"DocComment":" [`Clone`] is a supertrait of `Copy`, so everything which is `Copy` must also implement"},{"DocComment":" [`Clone`]. If a type is `Copy` then its [`Clone`] implementation only needs to return `*self`"},{"DocComment":" (see the example above)."},{"DocComment":""},{"DocComment":" ## When can my type be `Copy`?"},{"DocComment":""},{"DocComment":" A type can implement `Copy` if all of its components implement `Copy`. For example, this"},{"DocComment":" struct can be `Copy`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Point {"},{"DocComment":"    x: i32,"},{"DocComment":"    y: i32,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A struct can be `Copy`, and [`i32`] is `Copy`, therefore `Point` is eligible to be `Copy`."},{"DocComment":" By contrast, consider"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # struct Point;"},{"DocComment":" struct PointList {"},{"DocComment":"     points: Vec<Point>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The struct `PointList` cannot implement `Copy`, because [`Vec<T>`] is not `Copy`. If we"},{"DocComment":" attempt to derive a `Copy` implementation, we'll get an error:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" the trait `Copy` cannot be implemented for this type; field `points` does not implement `Copy`"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Shared references (`&T`) are also `Copy`, so a type can be `Copy`, even when it holds"},{"DocComment":" shared references of types `T` that are *not* `Copy`. Consider the following struct,"},{"DocComment":" which can implement `Copy`, because it only holds a *shared reference* to our non-`Copy`"},{"DocComment":" type `PointList` from above:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # struct PointList;"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct PointListWrapper<'a> {"},{"DocComment":"     point_list_ref: &'a PointList,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## When *can't* my type be `Copy`?"},{"DocComment":""},{"DocComment":" Some types can't be copied safely. For example, copying `&mut T` would create an aliased"},{"DocComment":" mutable reference. Copying [`String`] would duplicate responsibility for managing the"},{"DocComment":" [`String`]'s buffer, leading to a double free."},{"DocComment":""},{"DocComment":" Generalizing the latter case, any type implementing [`Drop`] can't be `Copy`, because it's"},{"DocComment":" managing some resource besides its own [`size_of::<T>`] bytes."},{"DocComment":""},{"DocComment":" If you try to implement `Copy` on a struct or enum containing non-`Copy` data, you will get"},{"DocComment":" the error [E0204]."},{"DocComment":""},{"DocComment":" [E0204]: ../../error_codes/E0204.html"},{"DocComment":""},{"DocComment":" ## When *should* my type be `Copy`?"},{"DocComment":""},{"DocComment":" Generally speaking, if your type _can_ implement `Copy`, it should. Keep in mind, though,"},{"DocComment":" that implementing `Copy` is part of the public API of your type. If the type might become"},{"DocComment":" non-`Copy` in the future, it could be prudent to omit the `Copy` implementation now, to"},{"DocComment":" avoid a breaking API change."},{"DocComment":""},{"DocComment":" ## Additional implementors"},{"DocComment":""},{"DocComment":" In addition to the [implementors listed below][impls],"},{"DocComment":" the following types also implement `Copy`:"},{"DocComment":""},{"DocComment":" * Function item types (i.e., the distinct types defined for each function)"},{"DocComment":" * Function pointer types (e.g., `fn() -> i32`)"},{"DocComment":" * Closure types, if they capture no value from the environment"},{"DocComment":"   or if all such captured values implement `Copy` themselves."},{"DocComment":"   Note that variables captured by shared reference always implement `Copy`"},{"DocComment":"   (even if the referent doesn't),"},{"DocComment":"   while variables captured by mutable reference never implement `Copy`."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`size_of::<T>`]: size_of"},{"DocComment":" [impls]: #implementors"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Copy","diagnostic_item":"Copy","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[319,{"data":{"file_id":14,"beg":{"line":454,"col":16},"end":{"line":454,"col":21}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[],"vtable":null},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["Eq",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":353,"col":0},"end":{"line":353,"col":58}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Trait for comparisons corresponding to [equivalence relations]("},{"DocComment":" https://en.wikipedia.org/wiki/Equivalence_relation)."},{"DocComment":""},{"DocComment":" The primary difference to [`PartialEq`] is the additional requirement for reflexivity. A type"},{"DocComment":" that implements [`PartialEq`] guarantees that for all `a`, `b` and `c`:"},{"DocComment":""},{"DocComment":" - symmetric: `a == b` implies `b == a`"},{"DocComment":" - transitive: `a == b` and `b == c` implies `a == c`"},{"DocComment":" - consistent: `a != b` if and only if `!(a == b)`"},{"DocComment":""},{"DocComment":" `Eq`, which builds on top of [`PartialEq`] also implies:"},{"DocComment":""},{"DocComment":" - reflexive: `a == a`"},{"DocComment":""},{"DocComment":" This property cannot be checked by the compiler, and therefore `Eq` is a trait without methods."},{"DocComment":""},{"DocComment":" Violating this property is a logic error. The behavior resulting from a logic error is not"},{"DocComment":" specified, but users of the trait must ensure that such logic errors do *not* result in"},{"DocComment":" undefined behavior. This means that `unsafe` code **must not** rely on the correctness of these"},{"DocComment":" methods."},{"DocComment":""},{"DocComment":" Floating point types such as [`f32`] and [`f64`] implement only [`PartialEq`] but *not* `Eq`"},{"DocComment":" because `NaN` != `NaN`."},{"DocComment":""},{"DocComment":" ## Derivable"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]`. When `derive`d, because `Eq` has no extra methods, it"},{"DocComment":" is only informing the compiler that this is an equivalence relation rather than a partial"},{"DocComment":" equivalence relation. Note that the `derive` strategy requires all fields are `Eq`, which isn't"},{"DocComment":" always desired."},{"DocComment":""},{"DocComment":" ## How can I implement `Eq`?"},{"DocComment":""},{"DocComment":" If you cannot use the `derive` strategy, specify that your type implements `Eq`, which has no"},{"DocComment":" extra methods:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" enum BookFormat {"},{"DocComment":"     Paperback,"},{"DocComment":"     Hardback,"},{"DocComment":"     Ebook,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct Book {"},{"DocComment":"     isbn: i32,"},{"DocComment":"     format: BookFormat,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl PartialEq for Book {"},{"DocComment":"     fn eq(&self, other: &Self) -> bool {"},{"DocComment":"         self.isbn == other.isbn"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Eq for Book {}"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Eq","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[320,{"data":{"file_id":15,"beg":{"line":353,"col":20},"end":{"line":353,"col":43}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":20},{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[null,null],"vtable":null},{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Send",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":92,"col":0},"end":{"line":92,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types that can be transferred across thread boundaries."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines it's"},{"DocComment":" appropriate."},{"DocComment":""},{"DocComment":" An example of a non-`Send` type is the reference-counting pointer"},{"DocComment":" [`rc::Rc`][`Rc`]. If two threads attempt to clone [`Rc`]s that point to the same"},{"DocComment":" reference-counted value, they might try to update the reference count at the"},{"DocComment":" same time, which is [undefined behavior][ub] because [`Rc`] doesn't use atomic"},{"DocComment":" operations. Its cousin [`sync::Arc`][arc] does use atomic operations (incurring"},{"DocComment":" some overhead) and thus is `Send`."},{"DocComment":""},{"DocComment":" See [the Nomicon](../../nomicon/send-and-sync.html) and the [`Sync`] trait for more details."},{"DocComment":""},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Send","has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":23,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sync",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":657,"col":0},"end":{"line":657,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types for which it is safe to share references between threads."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines"},{"DocComment":" it's appropriate."},{"DocComment":""},{"DocComment":" The precise definition is: a type `T` is [`Sync`] if and only if `&T` is"},{"DocComment":" [`Send`]. In other words, if there is no possibility of"},{"DocComment":" [undefined behavior][ub] (including data races) when passing"},{"DocComment":" `&T` references between threads."},{"DocComment":""},{"DocComment":" As one would expect, primitive types like [`u8`] and [`f64`]"},{"DocComment":" are all [`Sync`], and so are simple aggregate types containing them,"},{"DocComment":" like tuples, structs and enums. More examples of basic [`Sync`]"},{"DocComment":" types include \"immutable\" types like `&T`, and those with simple"},{"DocComment":" inherited mutability, such as [`Box<T>`][box], [`Vec<T>`][vec] and"},{"DocComment":" most other collection types. (Generic parameters need to be [`Sync`]"},{"DocComment":" for their container to be [`Sync`].)"},{"DocComment":""},{"DocComment":" A somewhat surprising consequence of the definition is that `&mut T`"},{"DocComment":" is `Sync` (if `T` is `Sync`) even though it seems like that might"},{"DocComment":" provide unsynchronized mutation. The trick is that a mutable"},{"DocComment":" reference behind a shared reference (that is, `& &mut T`)"},{"DocComment":" becomes read-only, as if it were a `& &T`. Hence there is no risk"},{"DocComment":" of a data race."},{"DocComment":""},{"DocComment":" A shorter overview of how [`Sync`] and [`Send`] relate to referencing:"},{"DocComment":" * `&T` is [`Send`] if and only if `T` is [`Sync`]"},{"DocComment":" * `&mut T` is [`Send`] if and only if `T` is [`Send`]"},{"DocComment":" * `&T` and `&mut T` are [`Sync`] if and only if `T` is [`Sync`]"},{"DocComment":""},{"DocComment":" Types that are not `Sync` are those that have \"interior"},{"DocComment":" mutability\" in a non-thread-safe form, such as [`Cell`][cell]"},{"DocComment":" and [`RefCell`][refcell]. These types allow for mutation of"},{"DocComment":" their contents even through an immutable, shared reference. For"},{"DocComment":" example the `set` method on [`Cell<T>`][cell] takes `&self`, so it requires"},{"DocComment":" only a shared reference [`&Cell<T>`][cell]. The method performs no"},{"DocComment":" synchronization, thus [`Cell`][cell] cannot be `Sync`."},{"DocComment":""},{"DocComment":" Another example of a non-`Sync` type is the reference-counting"},{"DocComment":" pointer [`Rc`][rc]. Given any reference [`&Rc<T>`][rc], you can clone"},{"DocComment":" a new [`Rc<T>`][rc], modifying the reference counts in a non-atomic way."},{"DocComment":""},{"DocComment":" For cases when one does need thread-safe interior mutability,"},{"DocComment":" Rust provides [atomic data types], as well as explicit locking via"},{"DocComment":" [`sync::Mutex`][mutex] and [`sync::RwLock`][rwlock]. These types"},{"DocComment":" ensure that any mutation cannot cause data races, hence the types"},{"DocComment":" are `Sync`. Likewise, [`sync::Arc`][arc] provides a thread-safe"},{"DocComment":" analogue of [`Rc`][rc]."},{"DocComment":""},{"DocComment":" Any types with interior mutability must also use the"},{"DocComment":" [`cell::UnsafeCell`][unsafecell] wrapper around the value(s) which"},{"DocComment":" can be mutated through a shared reference. Failing to doing this is"},{"DocComment":" [undefined behavior][ub]. For example, [`transmute`][transmute]-ing"},{"DocComment":" from `&T` to `&mut T` is invalid."},{"DocComment":""},{"DocComment":" See [the Nomicon][nomicon-send-and-sync] for more details about `Sync`."},{"DocComment":""},{"DocComment":" [box]: ../../std/boxed/struct.Box.html"},{"DocComment":" [vec]: ../../std/vec/struct.Vec.html"},{"DocComment":" [cell]: crate::cell::Cell"},{"DocComment":" [refcell]: crate::cell::RefCell"},{"DocComment":" [rc]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [atomic data types]: crate::sync::atomic"},{"DocComment":" [mutex]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [rwlock]: ../../std/sync/struct.RwLock.html"},{"DocComment":" [unsafecell]: crate::cell::UnsafeCell"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"},{"DocComment":" [transmute]: crate::mem::transmute"},{"DocComment":" [nomicon-send-and-sync]: ../../nomicon/send-and-sync.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Sync","diagnostic_item":"Sync","has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":24,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":11,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["Arithmetic",0]}],"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":8,"col":0},"end":{"line":47,"col":1}},"generated_from_span":null}},"source_text":"pub(crate) trait Arithmetic<F: BinaryField>: Copy + Send + Sync + 'static {\n    fn mul(a: u64, b: u64) -> u64;\n    fn square(a: u64) -> u64;\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"arithmetic parity contract; insertion uses fixed private maps\"\n        )\n    )]\n    fn frobenius(a: u64, power: u32) -> u64;\n    fn inverse(a: u64) -> Option<u64>;\n    /// Absolute field trace, 0 or 1. Canonical scalar maps live in the field module.\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"arithmetic parity contract; scalar map owns current trace callers\"\n        )\n    )]\n    fn trace(a: u64) -> u8;\n    /// Deterministic right inverse of z^2+z on trace-zero inputs; verify each solution.\n    /// Even-degree fields use the fixed-pivot map, never the odd-degree half trace.\n    fn solve_quadratic(a: u64) -> Option<u64>;\n    fn raw_mul(a: u64, b: u64) -> RawProduct;\n    fn reduce(product: RawProduct) -> u64;\n    /// Equal lengths; XOR raw products then reduce once, including the empty dot = 0.\n    #[cfg(test)]\n    fn dot(a: &[u64], b: &[u64]) -> u64;\n    /// Equal lengths; dst[i] ^= src[i] * scale. Aliasing follows safe Rust borrows.\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64);\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"bulk parity contract; current reconstruction squares dependent positions\"\n        )\n    )]\n    fn square_slice(dst: &mut [u64], src: &[u64]);\n}","attr_info":{"attributes":[{"DocComment":" All operands/results are canonical F words. Slice dimensions are internal invariants."},{"DocComment":" Inverse rejects zero; raw products are unreduced polynomials, never field elements."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":20}},"Static"]}],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[321,{"data":{"file_id":9,"beg":{"line":8,"col":45},"end":{"line":8,"col":49}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[322,{"data":{"file_id":9,"beg":{"line":8,"col":52},"end":{"line":8,"col":56}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Value":[323,{"data":{"file_id":9,"beg":{"line":8,"col":59},"end":{"line":8,"col":63}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Value":[324,{"data":{"file_id":9,"beg"