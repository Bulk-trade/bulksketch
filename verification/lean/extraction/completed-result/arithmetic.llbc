f the iterator."},{"DocComment":""},{"DocComment":" Due to each chunk having exactly `chunk_size` elements, the compiler can often optimize the"},{"DocComment":" resulting code better than in the case of [`chunks`]."},{"DocComment":""},{"DocComment":" See [`chunks`] for a variant of this iterator that also returns the remainder as a smaller"},{"DocComment":" chunk, and [`rchunks_exact`] for the same iterator but starting at the end of the slice."},{"DocComment":""},{"DocComment":" If your `chunk_size` is a constant, consider using [`as_chunks`] instead, which will"},{"DocComment":" give references to arrays of exactly that length, rather than slices."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `chunk_size` is zero."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['l', 'o', 'r', 'e', 'm'];"},{"DocComment":" let mut iter = slice.chunks_exact(2);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['l', 'o']);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['r', 'e']);"},{"DocComment":" assert!(iter.next().is_none());"},{"DocComment":" assert_eq!(iter.remainder(), &['m']);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`chunks`]: slice::chunks"},{"DocComment":" [`rchunks_exact`]: slice::rchunks_exact"},{"DocComment":" [`as_chunks`]: slice::as_chunks"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":3,"beg":{"line":1242,"col":4},"end":{"line":1242,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{