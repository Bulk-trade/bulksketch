":{"id":9,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},"trait_decl_ref":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":19}],"const_generics":[],"trait_refs":[]}}}]}}],"consts":[],"types":[],"methods":[],"vtable":"NotDynCompatible"},{"def_id":8,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["x86_pclmul",0]},{"Impl":{"Trait":8}}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":34,"col":0},"end":{"line":95,"col":1}},"generated_from_span":null}},"source_text":"impl<F: BinaryField> Arithmetic<F> for Pclmul {\n    fn mul(a: u64, b: u64) -> u64 {\n        // SAFETY: Pclmul is selected only after runtime PCLMUL detection.\n        unsafe { multiply::<F, true>(a, b) }\n    }\n\n    fn square(a: u64) -> u64 {\n        // SAFETY: checked dispatch guarantees PCLMUL; SSE2 is architectural on x86-64.\n        unsafe { multiply::<F, true>(a, a) }\n    }\n\n    fn frobenius(a: u64, power: u32) -> u64 {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { frobenius::<F>(a, power) }\n    }\n\n    fn inverse(a: u64) -> Option<u64> {\n        #[cfg(test)]\n        super::test_observer::inverse();\n        #[cfg(test)]\n        crate::types::small_degree_observer::inverse();\n        // SAFETY: checked dispatch detects PCLMULQDQ before selecting this backend.\n        unsafe { inverse::<F>(a) }\n    }\n\n    fn trace(a: u64) -> u8 {\n        maps::trace::<F>(a)\n    }\n\n    fn solve_quadratic(a: u64) -> Option<u64> {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { solve_quadratic::<F>(a) }\n    }\n\n    fn raw_mul(a: u64, b: u64) -> RawProduct {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { raw_product(a, b) }\n    }\n\n    fn reduce(product: RawProduct) -> u64 {\n        gf64::reduce::<F>(product)\n    }\n\n    #[cfg(test)]\n    fn dot(a: &[u64], b: &[u64]) -> u64 {\n        assert_eq!(a.len(), b.len(), \"dot length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { dot::<F, false>(a, b) }\n    }\n\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64) {\n        assert_eq!(dst.len(), src.len(), \"scale_xor length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { scale_xor::<F, true>(dst, src, scale) }\n    }\n\n    fn square_slice(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"square_slice length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { square_slice::<F, true>(dst, src) }\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":35},{"Deduplicated":3}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":76},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":3}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"implied_trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Value":[11,{"kind":{"TraitImpl":{"id":10,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},"trait_decl_ref":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":35}],"const_generics":[],"trait_refs":[]}}}]}},{"regions":[],"outlives":[],"skip_binder":{"Value":[12,{"kind":{"BuiltinOrAuto":{"builtin_data":"Auto","parent_trait_refs":[],"types":[],"vtable":{"id":6,"generics":{"regi