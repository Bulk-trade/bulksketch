{"charon_version":"0.1.304","translated":{"crate_name":"bulksketch","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["bulksketch::field::frobenius::square","bulksketch::field::frobenius::tables","bulksketch::field::frobenius::inverse21_table","bulksketch::field::frobenius::lookup","bulksketch::field::frobenius::inverse21"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/Users/junbug/bulk/bulksketch/verification/lean/extraction/frobenius-const/tables-lookup/arithmetic.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-apple-darwin","value":{"arch":"X86_64","vendor":"apple","os":"MacOs","env":"Unspecified","cfg_abi":"Unspecified","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bulksketch","contents":"//! Native binary-syndrome reconciliation with bounded, deterministic GF64 decoding.\n#![deny(unsafe_code)]\n#![warn(missing_docs)]\n\nmod backend;\nmod decode;\nmod field;\nmod poly;\nmod sketch;\nmod types;\n\npub use {\n    field::{BinaryField, Gf64},\n    sketch::{\n        DecodeJob, DecodeLimits, DecodeOutcome, DecodePlan, DecodeReport, DecodeRequest, DecodeRow,\n        DecodeRowsRequest, DecodeScratch, Decoder, FrozenSketch, InsertScratch, MutableSketch,\n        ParseLimits, ScratchLayout, ShapeLimits, SketchShape, SketchView, decode_into,\n        decode_rows_into,\n    },\n    types::{\n        BackendError, BackendId, BackendRequest, CreateError, DecodeError, DecodeFailure,\n        EncodeError, FieldId, ParseError, ShapeError, ShapeMismatch, Stage, StageProgress,\n        UpdateError, WorkUnits,\n    },\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"src/field/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical field identity, arithmetic and test-only tiny fields.\n#![forbid(unsafe_code)]\n\nuse crate::types::FieldId;\n\n#[cfg(test)]\npub(crate) mod arithmetic_tests;\n#[cfg(test)]\nmod constant_tests;\n#[cfg(any(target_arch = \"x86_64\", test))]\npub(crate) mod frobenius;\npub(crate) mod gf64;\npub(crate) mod maps;\nmod quadratic_chunks;\n#[cfg(test)]\npub(crate) mod reference;\n#[cfg(test)]\npub(crate) mod tiny;\n\npub(crate) mod sealed {\n    pub trait Sealed {}\n}\n\n/// Closed field specification. Kernels consume canonical words, never masked IDs.\npub trait BinaryField: sealed::Sealed + Copy + Eq + Send + Sync + 'static {\n    /// Extension degree over GF(2).\n    const BITS: u32;\n    /// Irreducible polynomial without its leading term.\n    const MODULUS_LOW: u64;\n    /// Registered polynomial/basis identity.\n    const WIRE_ID: FieldId;\n    /// Canonical element mask.\n    const MASK: u64;\n}\n\n/// Full-width GF(2^64) identity field.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub struct Gf64;\nimpl sealed::Sealed for Gf64 {}\nimpl BinaryField for Gf64 {\n    const BITS: u32 = 64;\n    const MODULUS_LOW: u64 = 0x1b;\n    const WIRE_ID: FieldId = FieldId::Gf64;\n    const MASK: u64 = u64::MAX;\n}\n"},{"id":6,"name":{"Local":"src/field/frobenius.rs"},"crate_name":"bulksketch","contents":"//! Fixed GF64 linear maps shared by insertion and the Itoh–Tsujii chain.\n#![forbid(unsafe_code)]\n\nconst POWERS: [u32; 9] = [1, 2, 3, 4, 5, 6, 7, 15, 31];\npub(crate) static TABLES: [[[u64; 16]; 16]; 9] = tables();\n\n#[inline]\npub(crate) fn lookup(word: u64, power: u32) -> Option<u64> {\n    let index = match power {\n        1..=7 => usize::try_from(power - 1).expect(\"small map index\"),\n        15 => 7,\n        31 => 8,\n        _ => return None,\n    };\n    let mut result = 0;\n    for (nibble, entries) in TABLES[index].iter().enumerate() {\n        result ^= entries[usize::try_from((word >> (4 * nibble)) & 15).expect(\"nibble index\")];\n    }\n    Some(result)\n}\n\n/// The eight-multiply inverse chain also needs the 21st Frobenius power.\n#[inline]\npub(crate) fn inverse21(word: u64) -> u64 {\n    static TABLE: [[u64; 16]; 16] = inverse21_table();\n    let mut result = 0;\n    for (nibble, entries) in TABLE.iter().enumerate() {\n        result ^= entries[usize::try_from((word >> (4 * nibble)) & 15).expect(\"nibble index\")];\n    }\n    result\n}\n\nconst fn inverse21_table() -> [[u64; 16]; 16] {\n    let mut table = [[0; 16]; 16];\n    let mut bit = 0;\n    while bit < 64 {\n        let mut column = 1_u64 << bit;\n        let mut power = 0;\n        while power < 21 {\n            column = square(column);\n            power += 1;\n        }\n        let mut value = 0;\n        while value < 16 {\n            if value & (1 << (bit % 4)) != 0 {\n                table[bit / 4][value] ^= column;\n            }\n            value += 1;\n        }\n        bit += 1;\n    }\n    table\n}\n\npub(crate) const fn square(word: u64) -> u64 {\n    let mut square = 0_u128;\n    let mut bit = 0;\n    while bit < 64 {\n        if word & (1_u64 << bit) != 0 {\n            square ^= 1_u128 << (2 * bit);\n        }\n        bit += 1;\n    }\n    let polynomial = (1_u128 << 64) | 0x1b;\n    bit = 128;\n    while bit > 64 {\n        bit -= 1;\n        if square & (1_u128 << bit) != 0 {\n            square ^= polynomial << (bit - 64);\n        }\n    }\n    // The long division above leaves exactly one canonical field word.\n    let bytes = square.to_le_bytes();\n    u64::from_le_bytes([\n        bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7],\n    ])\n}\n\n#[expect(\n    clippy::large_stack_arrays,\n    reason = \"only evaluated at compile time to initialize immutable static maps\"\n)]\nconst fn tables() -> [[[u64; 16]; 16]; 9] {\n    let mut tables = [[[0; 16]; 16]; 9];\n    let mut columns = [0_u64; 64];\n    let mut bit = 0;\n    while bit < 64 {\n        columns[bit] = 1 << bit;\n        bit += 1;\n    }\n    let mut index = 0;\n    let mut power = 0;\n    while index < POWERS.len() {\n        while power < POWERS[index] {\n            bit = 0;\n            while bit < 64 {\n                columns[bit] = square(columns[bit]);\n                bit += 1;\n            }\n            power += 1;\n        }\n        let mut nibble = 0;\n        while nibble < 16 {\n            let mut value: usize = 1;\n            while value < 16 {\n                tables[index][nibble][value] = tables[index][nibble][value & (value - 1)]\n                    ^ columns[4 * nibble + value.trailing_zeros() as usize];\n                value += 1;\n            }\n            nibble += 1;\n        }\n        index += 1;\n    }\n    tables\n}\n\n#[cfg(test)]\nmod tests {\n    use {\n        super::{POWERS, TABLES, lookup},\n        crate::field::{Gf64, gf64},\n    };\n\n    #[test]\n    fn fixed_frobenius_maps_match_scalar_regeneration() {\n        for power in POWERS {\n            for word in (0..64)\n                .map(|bit| 1_u64 << bit)\n                .chain((0_u64..4096).map(|mut word| {\n                    word = word.wrapping_add(0x9e37_79b9_7f4a_7c15);\n                    word = (word ^ (word >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);\n                    word = (word ^ (word >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);\n                    word ^ (word >> 31)\n                }))\n            {\n                let mut expected = word;\n                for _ in 0..power {\n                    expected = gf64::square::<Gf64>(expected);\n                }\n                assert_eq!(\n                    lookup(word, power),\n                    Some(expected),\n                    \"power={power} word={word:#x}\"\n                );\n            }\n            for (nibble, entries) in TABLES[match power {\n                15 => 7,\n                31 => 8,\n                _ => usize::try_from(power - 1).unwrap(),\n            }]\n            .iter()\n            .enumerate()\n            {\n                for (value, &actual) in entries.iter().enumerate() {\n                    let mut expected = u64::try_from(value).unwrap() << (4 * nibble);\n                    for _ in 0..power {\n                        expected = gf64::square::<Gf64>(expected);\n                    }\n                    assert_eq!(\n                        actual, expected,\n                        \"table power={power} nibble={nibble} value={value}\"\n                    );\n                }\n            }\n        }\n        for power in [0, 8, 14, 16, 30, 32, 63, 64] {\n            assert_eq!(lookup(u64::MAX, power), None);\n        }\n        println!(\n            \"SHARED FROBENIUS TABLE BYTES {}\",\n            std::mem::size_of_val(&TABLES)\n        );\n    }\n}\n"},{"id":7,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/intrinsics/mod.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/num/mod.rs"}