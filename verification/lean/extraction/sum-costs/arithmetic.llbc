"generics":{"regions":[],"types":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}},{"Untagged":{"Slice":[{"Untagged":{"TypeVar":{"Free":0}}},null]}},{"Untagged":{"Slice":[{"Untagged":{"TypeVar":{"Free":0}}},null]}}],"const_generics":[],"trait_refs":[]}},"item_id":3,"reuses_default":false}},"body":"Opaque"},{"def_id":20,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"Slice":[{"Untagged":{"TypeVar":{"Bound":[0,0]}}},null]}},"kind":"InherentImplBlock"}}},{"Ident":["iter",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":1041,"col":4},"end":{"line":1041,"col":43}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator over the slice."},{"DocComment":""},{"DocComment":" The iterator yields all items from start to end."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = &[1, 2, 4];"},{"DocComment":" let mut iterator = x.iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iterator.next(), Some(&1));"},{"DocComment":" assert_eq!(iterator.next(), Some(&2));"},{"DocComment":" assert_eq!(iterator.next(), Some(&4));"},{"DocComment":" assert_eq!(iterator.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"slice_iter","has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Untagged":{"TypeVar":{"Free":0}}}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Slice":[{"Untagged":{"TypeVar":{"Free":0}}},null]}},"Shared"]}}],"output":{"Untagged":{"Adt":{"id":8,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"src":"Normal","body":"Opaque"},{"def_id":21,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_fold",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":2496,"col":4},"end":{"line":2500,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator method that applies a function as long as it returns"},{"DocComment":" successfully, producing a single, final value."},{"DocComment":""},{"DocComment":" `try_fold()` takes two arguments: an initial value, and a closure with"},{"DocComment":" two arguments: an 'accumulator', and an element. The closure either"},{"DocComment":" returns successfully, with the value that the accumulator should have"},{"DocComment":" for the next iteration, or it returns failure, with an error value that"},{"DocComment":" is propagated back to the caller immediately (short-circuiting)."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call. If applying the closure succeeded against every element of the"},{"DocComment":" iterator, `try_fold()` returns the final accumulator as success."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" # Note to Implementors"},{"DocComment":""},{"DocComment":" Several of the other (forward) methods have default implementations in"},{"DocComment":" terms of this one, so try to implement this explicitly if it can"},{"DocComment":" do something better than the default `for` loop implementation."},{"DocComment":""},{"DocComment":" In particular, try to have this call `try_fold()` on the internal parts"},{"DocComment":" from which this iterator is composed. If multiple calls are needed,"},{"DocComment":" the `?` operator may be convenient for chaining the accumulator value"},{"DocComment":" along, but beware any invariants that need to be upheld before those"},{"DocComment":" early returns. This is a `&mut self` method, so iteration needs to be"},{"DocComment":" resumable after hitting an error here."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the checked sum of all of the elements of the array"},{"DocComment":" let sum = a.into_iter().try_fold(0i8, |acc, x| acc.checked_add(x));"},{"DocComment":""},{"DocComment":" assert_eq!(sum, Some(6));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Short-circuiting:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [10, 20, 30, 100, 40, 50];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" // This sum overflows when adding the 100 element"},{"DocComment":" let sum = iter.try_fold(0i8, |acc, x| acc.checked_add(x));"},{"DocComment":" assert_eq!(sum, None);"},{"DocComment":""},{"DocComment":" // Because it short-circuited, the remaining elements are still"},{"DocComment":" // available through the iterator."},{"DocComment":" assert_eq!(iter.len(), 2);"},{"DocComment":" assert_eq!(iter.next(), Some(40));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" While you cannot `break` from a closure, the [`ControlFlow`] type allows"},{"DocComment":" a similar idea:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let triangular = (1..30).try_fold(0_i8, |prev, x| {"},{"DocComment":"     if let Some(next) = prev.checked_add(x) {"},{"DocComment":"         ControlFlow::Continue(next)"},{"DocComment":"     } else {"},{"DocComment":"         ControlFlow::Break(prev)"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(triangular, ControlFlow::Break(120));"},{"DocComment":""},{"DocComment":" let triangular = (1..30).try_fold(0_u64, |prev, x| {"},{"DocComment":"     if let Some(next) = prev.checked_add(x) {"},{"DocComment":"         ControlFlow::Continue(next)"},{"DocComment":"     } else {"},{"DocComment":"         ControlFlow::Break(prev)"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(triangular, ControlFlow::Continue(435));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"B","variance":"Contravariant"},{"index":2,"name":"F","variance":"Contravariant"},{"index":3,"name":"R","variance":"Covariant"},{"index":4,"name":"Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null}},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":4}}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":2499,"col":11},"end":{"line":2499,"col":44}},"generated_from_span":null}},"origin":"WhereClauseOnFn","trait_":{"regions":[],