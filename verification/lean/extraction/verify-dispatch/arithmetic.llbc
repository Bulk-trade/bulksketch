rimitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bulksketch","contents":"//! Native binary-syndrome reconciliation with bounded, deterministic GF64 decoding.\n#![deny(unsafe_code)]\n#![warn(missing_docs)]\n\nmod backend;\nmod decode;\nmod field;\nmod poly;\nmod sketch;\nmod types;\n\npub use {\n    field::{BinaryField, Gf64},\n    sketch::{\n        DecodeJob, DecodeLimits, DecodeOutcome, DecodePlan, DecodeReport, DecodeRequest, DecodeRow,\n        DecodeRowsRequest, DecodeScratch, Decoder, FrozenSketch, InsertScratch, MutableSketch,\n        ParseLimits, ScratchLayout, ShapeLimits, SketchShape, SketchView, decode_into,\n        decode_rows_into,\n    },\n    types::{\n        BackendError, BackendId, BackendRequest, CreateError, DecodeError, DecodeFailure,\n        EncodeError, FieldId, ParseError, ShapeError, ShapeMismatch, Stage, StageProgress,\n        UpdateError, WorkUnits,\n    },\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"src/decode/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical-row decoding; no sketch/shape/wire or public arena dependencies.\n#![forbid(unsafe_code)]\n\npub(crate) mod row;\npub(crate) mod scratch;\npub(crate) mod work;\n\nmod bm;\n#[cfg(test)]\nmod bm_tests;\npub(crate) mod direct;\n\nmod affine;\nmod deg34;\nmod degree_probe;\npub(crate) mod probe;\nmod roots;\npub(crate) mod stages;\nmod verify;\n\n#[cfg(test)]\nmod row_tests;\n"},{"id":6,"name":{"Local":"src/decode/verify.rs"},"crate_name":"bulksketch","contents":"//! Exact odd-syndrome verification rebuilt only from the returned roots.\n#![forbid(unsafe_code)]\n\nuse crate::{backend::contract::BulkKernels, field::BinaryField};\n\n/// Instruction counts for the existing eight-lane native kernels. These are a\n/// dispatch model, never logical work charges or an estimate of elapsed time.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub(crate) struct ProductCounts {\n    pub(crate) raw: u64,\n    pub(crate) including_reduction: u64,\n}\n\n/// The wire admits at most u16::MAX words per row. The model is evaluated in u64\n/// after checking that bound, independently of the selected arithmetic backend.\npub(crate) fn product_counts(\n    degree: usize,\n    capacity: usize,\n) -> Option<(ProductCounts, ProductCounts)> {\n    if degree > capacity || capacity > usize::from(u16::MAX) {\n        return None;\n    }\n    let d = degree as u64;\n    let c = capacity as u64;\n    let complete_tiles = d / 32;\n    let remainder = d % 32;\n    let tail_vectors = match remainder {\n        0 => 0,\n        1..=8 => 1,\n        9..=16 => 2,\n        _ => 4,\n    };\n    let vectors = 4 * complete_tiles + tail_vectors;\n    // Complete 32-ID tiles and 17..32 tails use shift reduction. Smaller tails\n    // use two CLMUL reductions per raw product, four per eight-lane multiply.\n    let reduced_vectors = if remainder <= 16 { tail_vectors } else { 0 };\n    let current = ProductCounts {\n        raw: 2 * vectors * c,\n        including_reduction: (2 * vectors + 4 * reduced_vectors) * c,\n    };\n    let blocks = d / 8;\n    let locator_vectors = 4 * blocks * (blocks + 1) + (blocks + 1) * (d % 8);\n    let continuation_blocks = (c - d).div_ceil(8);\n    let rebuilt = ProductCounts {\n        raw: 2 * (locator_vectors + vectors * d + d * continuation_blocks) + d,\n        including_reduction: 6 * locator_vectors\n            + (2 * vectors + 4 * reduced_vectors) * d\n            + 3 * d\n            + (2 * d + 4) * continuation_blocks,\n    };\n    Some((current, rebuilt))\n}\n\n/// Preserve the established tiny paths. For larger candidates use rebuilt LFSR\n/// only when neither carryless-product count increases and at least one falls.\n/// The same dimensions select the same method on every backend.\npub(crate) fn use_rebuilt_lfsr(degree: usize, capacity: usize) -> bool {\n    if degree <= 2 {\n        return false;\n    }\n    let Some((current, rebuilt)) = product_counts(degree, capacity) else {\n        return false;\n    };\n    rebuilt.raw <= current.raw\n        && rebuilt.including_reduction <= current.including_reduction\n        && rebuilt != current\n}\n\n/// Rebuild L(z)=product(1+root*z), directly encode and compare the first d odd\n/// words, then check every remaining word against L's squared-coefficient\n/// recurrence. The BM locator is deliberately neither read nor trusted.\n///\n/// The caller charges before entering, and supplies d+1 coefficient words and\n/// min(d,c) expected-prefix words. No allocation or retained cross-row state.\npub(crate) fn rebuilt_lfsr<F: BinaryField, K: BulkKernels<F>>(\n    roots: &[u64],\n    odd: &[u64],\n    coefficients: &mut [u64],\n    expected: &mut [u64],\n) -> bool {\n    let degree = roots.len();\n    let prefix = degree.min(odd.len());\n    let coefficients = &mut coefficients[..=degree];\n    coefficients.fill(0);\n    coefficients[0] = 1;\n    for (index, &root) in roots.iter().enumerate() {\n        K::multiply_linear(&mut coefficients[..index + 2], root);\n    }\n    let expected = &mut expected[..prefix];\n    expected.fill(0);\n    K::insert_nonzero(expected, roots);\n    if expected != &odd[..prefix] {\n        return false;\n    }\n    for coefficient in &mut coefficients[1..] {\n        *coefficient = K::square(*coefficient);\n    }\n    K::odd_recurrence_matches(odd, coefficients)\n}\n\n#[cfg(test)]\nmod tests;\n"},{"id":7,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/convert/num.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/intrinsics/mod.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Imp