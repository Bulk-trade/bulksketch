     + 3 * d\n            + (2 * d + 4) * continuation_blocks,\n    };\n    Some((current, rebuilt))\n}","attr_info":{"attributes":[{"DocComment":" The wire admits at most u16::MAX words per row. The model is evaluated in u64"},{"DocComment":" after checking that bound, independently of the selected arithmetic backend."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":0},{"Deduplicated":0}],"output":{"Value":[19,{"Adt":{"id":5,"generics":{"regions":[],"types":[{"Value":[20,{"Adt":{"id":0,"generics":{"regions":[],"types":[{"Value":[21,{"Adt":{"id":6,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]},{"Deduplicated":21}],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}]}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":"Normal","body":{"Structured":{"span":{"Value":[5,{"data":{"file_id":6,"beg":{"line":16,"col":0},"end":{"line":52,"col":1}},"generated_from_span":null}]},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[6,{"data":{"file_id":6,"beg":{"line":19,"col":5},"end":{"line":19,"col":43}},"generated_from_span":null}]},"ty":{"Deduplicated":19},"drop_flag_for":null},{"index":1,"name":"degree","span":{"Value":[7,{"data":{"file_id":6,"beg":{"line":17,"col":4},"end":{"line":17,"col":10}},"generated_from_span":null}]},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":2,"name":"capacity","span":{"Value":[8,{"data":{"file_id":6,"beg":{"line":18,"col":4},"end":{"line":18,"col":12}},"generated_from_span":null}]},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":3,"name":null,"span":{"Value":[9,{"data":{"file_id":6,"b