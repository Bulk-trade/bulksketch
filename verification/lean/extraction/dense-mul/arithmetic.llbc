ore":[]}]}}},"comments_before":[]}]},"comments":[[176,["X^d = f's low coefficients modulo monic f. The first stored","exponent is d for even d, d+1 for odd d; successive rows add two."]]]}}},{"def_id":27,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["poly",0]},{"Ident":["dense",0]},{"Impl":{"Trait":6}},{"Ident":["square_mod_into",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":188,"col":4},"end":{"line":224,"col":5}},"generated_from_span":null}},"source_text":"fn square_mod_into(\n        a: &[u64],\n        modulus: &[u64],\n        table: &[u64],\n        dst: &mut [u64],\n        raw: &mut [RawProduct],\n    ) -> usize {\n        assert!(modulus.len() >= 4 && modulus.last() == Some(&1));\n        let degree = modulus.len() - 1;\n        assert!(a.len() <= degree && dst.len() >= degree && raw.len() > 2 * degree);\n        assert_eq!(table.len(), degree * (degree / 2));\n        if K::square_mod(a, table, &mut dst[..degree], raw) {\n            return normalized_len(&dst[..degree]);\n        }\n        let accumulators = &mut raw[..degree];\n        accumulators.fill(RawProduct::default());\n        let first_high = degree.div_ceil(2);\n        // The table is linear only after squaring each coefficient: Frobenius\n        // acts on coefficients as well as exponents in the extension field.\n        for (i, &coefficient) in a.iter().enumerate() {\n            let square = K::square(coefficient);\n            if i < first_high {\n                accumulators[2 * i].lo ^= square;\n            } else {\n                let start = (i - first_high) * degree;\n                for (slot, &entry) in accumulators.iter_mut().zip(&table[start..start + degree]) {\n                    let product = K::raw_mul(square, entry);\n                    slot.lo ^= product.lo;\n                    slot.hi ^= product.hi;\n                }\n            }\n        }\n        for (target, &product) in dst[..degree].iter_mut().zip(accumulators.iter()) {\n            *target = K::reduce(product);\n        }\n        normalized_len(&dst[..degree])\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":4,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Unknown"},{"index":1,"name":"K","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":5},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Deduplicated":6},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":13},{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":29},{"Deduplicated":31},{"Value":[652,{"Ref":[{"Var":{"Free":2}},{"Deduplicated":30},"Shared"]}]},{"Deduplicated":282},{"Deduplicated":283}],"output":{"Deduplicated":0}},"src":{"TraitImpl":{"impl_ref":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":13}],"const_generics":[],"trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":3}},{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":4}}]}},"trait_ref":{"id":6,"generics":{"regions":[],"types":