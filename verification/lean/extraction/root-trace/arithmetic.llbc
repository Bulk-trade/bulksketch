 = degree.min(a.len());\n        for (target, &product) in rem[..remainder_size].iter_mut().zip(raw.iter()) {\n            *target = K::reduce(product);\n        }\n        (\n            normalized_len(&q[..size]),\n            normalized_len(&rem[..remainder_size]),\n        )\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":4,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Unknown"},{"index":1,"name":"K","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":204},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Deduplicated":205},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":22},{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":174},{"Deduplicated":175},{"Deduplicated":182},{"Deduplicated":177},{"Deduplicated":178}],"output":{"Value":[608,{"Adt":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":0},{"Deduplicated":0}],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}]}},"src":{"TraitImpl":{"impl_ref":{"i