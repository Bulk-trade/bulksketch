ble, &mut dst[..degree], raw) {\n            return normalized_len(&dst[..degree]);\n        }\n        let accumulators = &mut raw[..degree];\n        accumulators.fill(RawProduct::default());\n        let first_high = degree.div_ceil(2);\n        // The table is linear only after squaring each coefficient: Frobenius\n        // acts on coefficients as well as exponents in the extension field.\n        for (i, &coefficient) in a.iter().enumerate() {\n            let square = K::square(coefficient);\n            if i < first_high {\n                accumulators[2 * i].lo ^= square;\n            } else {\n                let start = (i - first_high) * degree;\n                for (slot, &entry) in accumulators.iter_mut().zip(&table[start..start + degree]) {\n                    let product = K::raw_mul(square, entry);\n                    slot.lo ^= product.lo;\n                    slot.hi ^= product.hi;\n                }\n            }\n        }\n        for (target, &product) in dst[..degree].iter_mut().zip(accumulators.iter()) {\n            *target = K::reduce(product);\n        }\n        normalized_len(&dst[..degree])\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":4,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Unknown"},{"index":1,"name":"K","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[204,{"data"