{"charon_version":"0.1.304","translated":{"crate_name":"bulksketch","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["bulksketch::decode::roots::_::new","bulksketch::decode::roots::_::start","bulksketch::decode::roots::_::enable_v3","bulksketch::decode::roots::_::enable_closed_form","bulksketch::decode::roots::_::set_splitter_seed"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/Users/junbug/bulk/bulksketch-proof-evidence-20261109-root-traversal/root-setup/arithmetic.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-apple-darwin","value":{"arch":"X86_64","vendor":"apple","os":"MacOs","env":"Unspecified","cfg_abi":"Unspecified","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bulksketch","contents":"//! Native binary-syndrome reconciliation with bounded, deterministic GF64 decoding.\n#![deny(unsafe_code)]\n#![warn(missing_docs)]\n\nmod backend;\nmod decode;\nmod field;\nmod poly;\nmod sketch;\nmod types;\n\npub use {\n    field::{BinaryField, Gf64},\n    sketch::{\n        DecodeJob, DecodeLimits, DecodeOutcome, DecodePlan, DecodeReport, DecodeRequest, DecodeRow,\n        DecodeRowsRequest, DecodeScratch, Decoder, FrozenSketch, InsertScratch, MutableSketch,\n        ParseLimits, ScratchLayout, ShapeLimits, SketchShape, SketchView, decode_into,\n        decode_rows_into,\n    },\n    types::{\n        BackendError, BackendId, BackendRequest, CreateError, DecodeError, DecodeFailure,\n        EncodeError, FieldId, ParseError, ShapeError, ShapeMismatch, Stage, StageProgress,\n        UpdateError, WorkUnits,\n    },\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"src/decode/roots.rs"},"crate_name":"bulksketch","contents":"//! Depth-first factor traversal; pending factors own coefficients, never parent tables.\n#![forbid(unsafe_code)]\nuse {\n    super::{\n        affine, deg34,\n        scratch::{FactorFrame, RowWorkspace, SplitterBasis},\n        work::{Charge, WorkScheduleV1},\n    },\n    crate::{\n        backend::contract::BulkKernels,\n        field::BinaryField,\n        poly::{Dense, Polynomial},\n        types::{DecodeError, DecodeFailure, RawProduct, Stage, WorkMeter},\n    },\n};\n\n#[derive(Debug, Default)]\npub(super) struct Roots {\n    pending: usize,\n    stride: usize,\n    degree: usize,\n    direction: u32,\n    checked: bool,\n    trace_len: usize,\n    gcd_len: usize,\n    pub(super) count: usize,\n    pub(super) attempts: usize,\n    pub(super) gcd_degree: usize,\n    splitter_seed: u64,\n    v3: bool,\n    closed_form: bool,\n    solved_count: usize,\n    affine: bool,\n    affine_ready: bool,\n    affine_base: u64,\n    affine_rank: usize,\n}\n// At degree d>=3 these regions need 7d+10 words, at most 8(r+1).\nstruct FactorWork<'a> {\n    modulus: &'a mut [u64],\n    trace: &'a mut [u64],\n    gcd: &'a mut [u64],\n    work: &'a mut [u64],\n    table: &'a mut [u64],\n    raw: &'a mut [RawProduct],\n    basis: &'a mut SplitterBasis,\n}\nimpl<'a> FactorWork<'a> {\n    fn new(\n        degree: usize,\n        polynomials: &'a mut [u64],\n        table: &'a mut [u64],\n        raw: &'a mut [RawProduct],\n        basis: &'a mut SplitterBasis,\n    ) -> Self {\n        let (modulus, rest) = polynomials.split_at_mut(degree + 1);\n        let (trace, rest) = rest.split_at_mut(degree);\n        let (gcd, work) = rest.split_at_mut(degree + 1);\n        Self {\n            modulus,\n            trace,\n            gcd,\n            work,\n            table: &mut table[..degree * (degree / 2)],\n            raw,\n            basis,\n        }\n    }\n}\nfn charge(meter: &mut WorkMeter, operation: Charge) -> Result<(), DecodeError> {\n    meter.charge(WorkScheduleV1::cost(operation)?)\n}\nimpl Roots {\n    pub(super) fn enable_v3(&mut self) {\n        self.v3 = true;\n    }\n\n    pub(super) fn enable_closed_form(&mut self) {\n        self.closed_form = true;\n    }\n\n    pub(super) fn set_splitter_seed(&mut self, seed: u64) {\n        self.splitter_seed = seed;\n    }\n\n    pub(super) fn start(&mut self, degree: usize, workspace: &mut RowWorkspace<'_>) -> Stage {\n        // The cache belongs to this row, even when the scratch owner is reused.\n        workspace.basis.directions = None;\n        workspace.basis.len = 0;\n        self.degree = degree;\n        self.stride = degree + 1;\n        self.affine = self.v3 && affine::preferred::<crate::field::Gf64>(degree);\n        self.affine_ready = false;\n        if degree != 0 {\n            workspace.polynomials[..=degree].copy_from_slice(&workspace.bm[..=degree]);\n        }\n        self.stage()\n    }\n    fn stage(&self) -> Stage {\n        if self.degree < 3 {\n            Stage::Leaf\n        } else if self.closed_form && self.degree == 3 {\n            Stage::LeafThree\n        } else if self.closed_form && self.degree == 4 {\n            Stage::LeafFour\n        } else {\n            Stage::ReducerPreparation\n        }\n    }\n    fn advance(&mut self, workspace: &mut RowWorkspace<'_>) -> Stage {\n        if self.pending == 0 {\n            return Stage::Verification;\n        }\n        self.pending -= 1;\n        let frame = &workspace.stack[self.pending];\n        let start = usize::try_from(frame.coefficient_start).expect(\"admitted coefficient offset\");\n        let len = usize::try_from(frame.coefficient_len).expect(\"admitted coefficient length\");\n        workspace.polynomials[..len].copy_from_slice(&workspace.factors[start..start + len]);\n        self.degree = len - 1;\n        self.direction = frame.next_direction;\n        self.checked = frame.split_checked != 0;\n        if self.affine {\n            self.affine_base = workspace.factors[start + self.stride - 1];\n            self.affine_rank = frame.next_direction as usize;\n        }\n        self.stage()\n    }\n    pub(super) fn run<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        stage: Stage,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        #[cfg(test)]\n        crate::types::small_degree_observer::stage(stage, true);\n        if matches!(\n            stage,\n            Stage::LeafThree | Stage::LeafFour | Stage::FactorVerification\n        ) {\n            return self.closed_leaf::<F, K>(stage, workspace, meter);\n        }\n        if stage == Stage::Leaf {\n            return self.leaf::<F, K>(workspace, meter);\n        }\n        if stage == Stage::AffinePreparation {\n            return self.prepare_affine::<F, K>(workspace, meter);\n        }\n        if stage == Stage::AffineEnumeration {\n            return self.enumerate_affine::<F, K>(workspace, meter);\n        }\n        let degree = self.degree;\n        let mut buffers = FactorWork::new(\n            degree,\n            workspace.polynomials,\n            workspace.square_table,\n            workspace.raw,\n            workspace.basis,\n        );\n        match stage {\n            Stage::ReducerPreparation => {\n                charge(meter, Charge::Table { degree })?;\n                <Dense as Polynomial<F, K>>::prepare_square_table(\n                    buffers.modulus,\n                    buffers.table,\n                    buffers.work,\n                );\n                Ok(Ok(if self.affine {\n                    if self.affine_ready {\n                        Stage::AffineSplit\n                    } else {\n                        Stage::AffinePreparation\n                    }\n                } else {\n                    Stage::Trace\n                }))\n            }\n            Stage::AffineSplit => {\n                charge(\n                    meter,\n                    Charge::AffineSplit {\n                        degree,\n                        rank: self.affine_rank,\n                    },\n                )?;\n                if self.affine_rank == 0 {\n                    return Ok(Err(DecodeFailure::NotSplit));\n                }\n                let rank = self.affine_rank - 1;\n                let start = self.stride * self.stride + affine::subspace_start(rank);\n                self.trace_len = affine::splitter::<F, K>(\n                    buffers.modulus,\n                    buffers.table,\n                    &workspace.factors[start..start + rank + 1],\n                    self.affine_base,\n                    buffers.trace,\n                    buffers.work,\n                    buffers.raw,\n                );\n                Ok(Ok(Stage::Gcd))\n            }\n            Stage::Trace => self.trace::<F, K>(&mut buffers, meter),\n            Stage::Gcd => {\n                charge(meter, Charge::Gcd { degree })?;\n                self.gcd_len = <Dense as Polynomial<F, K>>::monic_gcd_into(\n                    buffers.modulus,\n                    &buffers.trace[..self.trace_len],\n                    buffers.gcd,\n                    buffers.work,\n                    buffers.raw,\n                );\n                self.gcd_degree = self.gcd_len - 1;\n                if self.gcd_degree > 0 && self.gcd_degree < degree {\n                    return Ok(Ok(Stage::FactorDivision));\n                }\n                if self.affine {\n                    self.affine_rank -= 1;\n                    if self.gcd_len == 1 {\n                        self.affine_base ^=\n                            buffers.basis.directions.as_ref().expect(\"affine basis\")\n                                [self.affine_rank];\n                    }\n                    return Ok(Ok(Stage::AffineSplit));\n                }\n                self.direction += 1;\n                if self.direction == F::BITS {\n                    Ok(Err(DecodeFailure::NotSplit))\n                } else {\n                    Ok(Ok(Stage::Trace))\n                }\n            }\n            Stage::FactorDivision => {\n                self.divide::<F, K>(&mut buffers, workspace.factors, workspace.stack, meter)\n            }\n            _ => unreachable!(\"root traversal stage\"),\n        }\n    }\n    fn closed_leaf<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        stage: Stage,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        let degree = self.degree;\n        if stage != Stage::FactorVerification {\n            charge(\n                meter,\n                if degree == 3 {\n                    Charge::LeafThree\n                } else {\n                    Charge::LeafFour\n                },\n            )?;\n            let (factor, rest) = workspace.polynomials.split_at_mut(11);\n            let Some(count) = deg34::solve::<F, K>(&factor[..=degree], &mut rest[..4]) else {\n                return Ok(Ok(Stage::ReducerPreparation));\n            };\n            self.solved_count = count;\n            return Ok(Ok(Stage::FactorVerification));\n        }\n        charge(meter, Charge::FactorVerification { degree })?;\n        let (values, product) = workspace.polynomials.split_at_mut(15);\n        let roots = &values[11..11 + self.solved_count];\n        let valid = deg34::certificate::<F, K>(&values[..=degree], roots, &mut product[..5]);\n        #[cfg(test)]\n        crate::types::small_degree_observer::certificate(valid);\n        if !valid {\n            return Ok(Ok(Stage::ReducerPreparation));\n        }\n        workspace.roots[self.count..self.count + degree].copy_from_slice(roots);\n        self.count += degree;\n        Ok(Ok(self.advance(workspace)))\n    }\n\n    fn prepare_affine<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        let degree = self.degree;\n        charge(meter, Charge::AffinePreparation { degree })?;\n        let (coefficients, work) = workspace.bm.split_at_mut(degree + 1);\n        let len = affine::multiple::<F, K>(\n            &workspace.polynomials[..=degree],\n            &workspace.square_table[..degree * (degree / 2)],\n            workspace.factors,\n            coefficients,\n            work,\n            workspace.raw,\n        );\n        // The X coefficient is the affine multiple's constant derivative.\n        // A repeated factor forces it to zero. Conversely, for a squarefree\n        // input a zero derivative would give a smaller affine multiple by\n        // taking a square root, contradicting minimality.\n        if coefficients[1] == 0 {\n            return Ok(Err(DecodeFailure::NotSplit));\n        }\n        let basis = workspace.basis.directions.insert([0; 64]);\n        let Some((base, rank)) = affine::solve_map::<F, K>(&coefficients[..len], basis) else {\n            return Ok(Err(DecodeFailure::NotSplit));\n        };\n        if rank >= len - 1\n            || 1_u64\n                .checked_shl(rank as u32)\n                .is_some_and(|n| n < degree as u64)\n        {\n            return Ok(Err(DecodeFailure::NotSplit));\n        }\n        workspace.basis.len = rank as u32;\n        self.affine_base = base;\n        self.affine_rank = rank;\n        self.affine_ready = true;\n        if affine::enumerate_preferred(degree, rank) {\n            Ok(Ok(Stage::AffineEnumeration))\n        } else {\n            let offset = self.stride * self.stride;\n            affine::subspaces::<F, K>(&basis[..rank], &mut workspace.factors[offset..]);\n            Ok(Ok(Stage::AffineSplit))\n        }\n    }\n\n    fn enumerate_affine<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        charge(\n            meter,\n            Charge::AffineEnumeration {\n                degree: self.degree,\n                rank: self.affine_rank,\n            },\n        )?;\n        let found = match affine::enumerate::<F, K>(\n            &workspace.polynomials[..=self.degree],\n            self.affine_base,\n            &workspace.basis.directions.as_ref().expect(\"affine basis\")[..self.affine_rank],\n            &mut workspace.roots[self.count..],\n            workspace.bm,\n        ) {\n            Ok(count) => count,\n            Err(reason) => return Ok(Err(reason)),\n        };\n        self.count += found;\n        Ok(Ok(self.advance(workspace)))\n    }\n\n    fn leaf<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        charge(\n            meter,\n            Charge::Leaf {\n                degree: self.degree,\n            },\n        )?;\n        let roots = match self.degree {\n            0 => [0, 0],\n            1 => [workspace.polynomials[0], 0],\n            2 => {\n                let linear = workspace.polynomials[1];\n                if linear == 0 {\n                    return Ok(Err(DecodeFailure::NotSplit));\n                }\n                let inverse = K::inverse(linear).expect(\"nonzero quadratic coefficient\");\n                let target = K::mul(workspace.polynomials[0], K::square(inverse));\n                let Some(solution) = K::solve_quadratic(target) else {\n                    return Ok(Err(DecodeFailure::NotSplit));\n                };\n                let root = K::mul(linear, solution);\n                [root, root ^ linear]\n            }\n            _ => unreachable!(\"leaf degree at most two\"),\n        };\n        if roots[..self.degree].contains(&0) {\n            return Ok(Err(DecodeFailure::InvalidLocator));\n        }\n        workspace.roots[self.count..self.count + self.degree]\n            .copy_from_slice(&roots[..self.degree]);\n        self.count += self.degree;\n        Ok(Ok(self.advance(workspace)))\n    }\n    fn trace<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        buffers: &mut FactorWork<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        let degree = self.degree;\n        charge(meter, Charge::Trace { degree })?;\n        self.attempts += 1;\n        let seed = self.splitter_seed;\n        let basis_len = &mut buffers.basis.len;\n        let basis = buffers.basis.directions.get_or_insert_with(|| {\n            let mut basis = [0; 64];\n            basis[0] = (seed & F::MASK).max(1);\n            *basis_len = 1;\n            basis\n        });\n        // Pending siblings can resume earlier directions. Retain the initialized\n        // prefix, extending it only after the requested Trace has been charged.\n        while *basis_len <= self.direction {\n            let splitter = basis[*basis_len as usize - 1];\n            let carry = splitter >> (F::BITS - 1);\n            basis[*basis_len as usize] =\n                ((splitter << 1) & F::MASK) ^ (F::MODULUS_LOW & 0u64.wrapping_sub(carry));\n            *basis_len += 1;\n        }\n        let splitter = basis[self.direction as usize];\n        buffers.trace.fill(0);\n        buffers.trace[1] = splitter;\n        self.trace_len = 2;\n        for _ in 1..F::BITS {\n            let len = <Dense as Polynomial<F, K>>::square_mod_into(\n                &buffers.trace[..self.trace_len],\n                buffers.modulus,\n                buffers.table,\n                buffers.gcd,\n                buffers.raw,\n            );\n            buffers.trace[..len].copy_from_slice(&buffers.gcd[..len]);\n            self.trace_len =\n                <Dense as Polynomial<F, K>>::xor_coefficient(buffers.trace, len, 1, splitter);\n        }\n        if !self.checked {\n            charge(meter, Charge::SplitCheck { degree })?;\n            <Dense as Polynomial<F, K>>::square_mod_into(\n                &buffers.trace[..self.trace_len],\n                buffers.modulus,\n                buffers.table,\n                buffers.gcd,\n                buffers.raw,\n            );\n            // Modular squaring writes all d output words. Pad the normalized trace\n            // to compare T^2+T, including coefficients above either normalized end.\n            buffers.trace[self.trace_len..].fill(0);\n            if buffers.gcd[..degree] != *buffers.trace {\n                return Ok(Err(DecodeFailure::NotSplit));\n            }\n            self.checked = true;\n        }\n        Ok(Ok(Stage::Gcd))\n    }\n    fn divide<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        buffers: &mut FactorWork<'_>,\n        factors: &mut [u64],\n        stack: &mut [FactorFrame],\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        let degree = self.degree;\n        charge(meter, Charge::Divide { degree })?;\n        let (quotient, remainder) = buffers.work.split_at_mut(degree + 2);\n        let Some(len) = <Dense as Polynomial<F, K>>::exact_divide_into(\n            buffers.modulus,\n            &buffers.gcd[..self.gcd_len],\n            quotient,\n            remainder,\n            buffers.raw,\n        ) else {\n            return Ok(Err(DecodeFailure::InvalidLocator));\n        };\n        charge(meter, Charge::SplitAssembly { degree })?;\n        // The pending right child owns coefficients only. The left replaces the\n        // modulus; no released parent reducer can ever be resumed.\n        let start = self\n            .pending\n            .checked_mul(self.stride)\n            .ok_or(DecodeError::ScratchTooSmall)?;\n        let end = start.checked_add(len).ok_or(DecodeError::ScratchTooSmall)?;\n        factors[start..end].copy_from_slice(&quotient[..len]);\n        stack[self.pending] = FactorFrame {\n            coefficient_start: u64::try_from(start).expect(\"admitted offset\"),\n            coefficient_len: u64::try_from(len).expect(\"admitted degree\"),\n            next_direction: self.direction + 1,\n            split_checked: 1,\n        };\n        if self.affine {\n            self.affine_rank -= 1;\n            factors[start + self.stride - 1] = self.affine_base\n                ^ buffers.basis.directions.as_ref().expect(\"affine basis\")[self.affine_rank];\n            stack[self.pending].next_direction = self.affine_rank as u32;\n        }\n        self.pending += 1;\n        buffers.modulus[..self.gcd_len].copy_from_slice(&buffers.gcd[..self.gcd_len]);\n        self.degree = self.gcd_degree;\n        self.direction += 1;\n        self.checked = true;\n        Ok(Ok(self.stage()))\n    }\n}\n#[cfg(test)]\nmod trace_tests;\n\n#[cfg(test)]\nmod affine_tests;\n"},{"id":6,"name":{"Local":"src/decode/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical-row decoding; no sketch/shape/wire or public arena dependencies.\n#![forbid(unsafe_code)]\n\npub(crate) mod row;\npub(crate) mod scratch;\npub(crate) mod work;\n\nmod bm;\n#[cfg(test)]\nmod bm_tests;\npub(crate) mod direct;\n\nmod affine;\nmod deg34;\nmod degree_probe;\npub(crate) mod probe;\nmod roots;\npub(crate) mod stages;\nmod verify;\n\n#[cfg(test)]\nmod row_tests;\n"},{"id":7,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"src/types.rs"},"crate_name":"bulksketch","contents":"//! Value-only definitions; this module has no dependency on the engine layers.\n#![forbid(unsafe_code)]\n\n/// Polynomial-basis identity, including the irreducible polynomial.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[repr(u8)]\npub enum FieldId {\n    /// GF(2^64), modulus Z^64 + Z^4 + Z^3 + Z + 1, bit i is Z^i.\n    Gf64 = 1,\n}\n\n/// Shape admission failure, before any row storage is allocated.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ShapeError {\n    /// Unsupported field, zero/non-power-of-two row count, or zero capacity.\n    InvalidShape,\n    /// Configured storage/dimension cap or representable wire dimension exceeded.\n    InputLimitExceeded,\n}\n\n/// Bounded wire admission failure. No view is exposed on either error.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ParseError {\n    /// A caller-supplied byte or dimension limit was exceeded.\n    InputLimitExceeded,\n    /// Unknown metadata, malformed lengths, or noncanonical payload.\n    InvalidEncoding,\n}\n\nimpl std::fmt::Display for ShapeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InvalidShape => \"invalid sketch shape\",\n            Self::InputLimitExceeded => \"shape input limit exceeded\",\n        })\n    }\n}\nimpl std::error::Error for ShapeError {}\n\nimpl std::fmt::Display for ParseError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InputLimitExceeded => \"wire input limit exceeded\",\n            Self::InvalidEncoding => \"invalid sketch encoding\",\n        })\n    }\n}\nimpl std::error::Error for ParseError {}\n\n/// Runtime arithmetic capability. No complete-operation dispatch lives in this type.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub enum BackendId {\n    /// Always-available safe Rust arithmetic.\n    Portable,\n    /// Scalar x86 carryless multiplication.\n    Pclmul,\n    /// 256-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul256,\n    /// 512-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul512,\n}\n\n/// Backend selection requested at engine construction, before any decode.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum BackendRequest {\n    /// Select from capabilities detected at runtime.\n    Auto,\n    /// Require this capability; never bypass feature/OS-state validation.\n    Force(BackendId),\n}\n\n/// An explicitly requested backend is unavailable in this build or on this CPU/OS.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct BackendError(pub BackendId);\n\n/// Construction of mutable state failed before any state was returned.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CreateError {\n    /// The requested arithmetic implementation is unavailable.\n    Backend(BackendError),\n    /// The algebraic buffers could not be reserved.\n    AllocationFailed,\n}\n\n/// Batch insertion failed before changing the sketch.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum UpdateError {\n    /// The supplied insertion arena cannot hold this call's IDs or row offsets.\n    ScratchTooSmall,\n}\n\n/// XOR requires identical fields, row counts and capacities.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ShapeMismatch;\n\n/// Encoding failed without changing the destination or algebraic state.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum EncodeError {\n    /// The destination cannot hold the complete record.\n    BufferTooSmall,\n    /// The cached record could not be reserved.\n    AllocationFailed,\n}\n\nimpl std::fmt::Display for CreateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            Self::Backend(error) => error.fmt(f),\n            Self::AllocationFailed => f.write_str(\"sketch allocation failed\"),\n        }\n    }\n}\nimpl std::error::Error for CreateError {}\nimpl std::fmt::Display for UpdateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"insertion scratch is too small\")\n    }\n}\nimpl std::error::Error for UpdateError {}\nimpl std::fmt::Display for ShapeMismatch {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"sketch shapes differ\")\n    }\n}\nimpl std::error::Error for ShapeMismatch {}\nimpl std::fmt::Display for EncodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::BufferTooSmall => \"encoding buffer is too small\",\n            Self::AllocationFailed => \"encoding allocation failed\",\n        })\n    }\n}\nimpl std::error::Error for EncodeError {}\n\nimpl std::fmt::Display for BackendError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        write!(f, \"backend {:?} is unavailable\", self.0)\n    }\n}\nimpl std::error::Error for BackendError {}\n\n/// Backend-independent logical work, never elapsed time or instruction count.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]\npub struct WorkUnits(pub u64);\n\n/// A request-wide failure publishes no row report or provisional IDs.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeError {\n    /// Local and remote fields, row counts or capacities differ.\n    ShapeMismatch,\n    /// Unknown plan or an output budget larger than any row capacity.\n    InvalidPlan,\n    /// Raw candidate count exceeds the request cap, before normalization.\n    CandidateLimitExceeded,\n    /// Work arithmetic overflows or the next charge exceeds the request limit.\n    WorkLimitExceeded,\n    /// Layout overflows, exceeds its byte cap, or any supplied segment is short.\n    ScratchTooSmall,\n}\n\n/// An admitted row failed algebraically; independently successful rows remain usable.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeFailure {\n    /// Zero consumes an unavailable slot, or locator/final output exceeds beta.\n    DegreeExceedsBudget,\n    /// The locator fails required canonicality/algebraic validation.\n    InvalidLocator,\n    /// The locator does not split into distinct permitted field roots.\n    NotSplit,\n    /// Re-encoding fails any stored odd syndrome or the zero channel.\n    VerificationFailed,\n}\n\nimpl std::fmt::Display for DecodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::ShapeMismatch => \"sketch shapes differ\",\n            Self::InvalidPlan => \"invalid decode plan or output budget\",\n            Self::CandidateLimitExceeded => \"candidate input limit exceeded\",\n            Self::WorkLimitExceeded => \"decode work limit exceeded\",\n            Self::ScratchTooSmall => \"decode scratch is too small\",\n        })\n    }\n}\nimpl std::error::Error for DecodeError {}\n\n/// Deterministic stage order. Repeated trace/GCD/division/leaf stages follow factor traversal.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Stage {\n    /// Propose the nonzero root S1 before general decoding.\n    DirectOne,\n    /// Derive a distinct nonzero pair from S1 and S3 before general decoding.\n    DirectTwo,\n    /// Reject inconsistent cubic prefixes before inversion (V3).\n    GuardThree,\n    /// Normalize a passed cubic Newton guard (V3).\n    NewtonThree,\n    /// Reject inconsistent quartic prefixes before inversion (V3).\n    GuardFour,\n    /// Normalize a passed quartic Newton guard (V3).\n    NewtonFour,\n    /// Propose the roots of a cubic factor (V3).\n    LeafThree,\n    /// Propose the roots of a quartic factor (V3).\n    LeafFour,\n    /// Certify a complete distinct nonzero factor root set (V3).\n    FactorVerification,\n    /// Expand odd syndromes and reconstruct even powers.\n    Reconstruction,\n    /// Binary Berlekamp-Massey iterations.\n    BerlekampMassey,\n    /// Evaluate the original locator at normalized hints.\n    CandidateEvaluation,\n    /// Divide out confirmed candidate roots.\n    Deflation,\n    /// Build a factor's modular-square table.\n    ReducerPreparation,\n    /// Find the least affine multiple and solve its binary map (V3).\n    AffinePreparation,\n    /// Enumerate and evaluate the recovered affine solution coset (V3).\n    AffineEnumeration,\n    /// Form an annihilator splitter for the current affine coset (V3).\n    AffineSplit,\n    /// Try the next canonical trace direction and the internal split check.\n    Trace,\n    /// Compute a monic polynomial GCD.\n    Gcd,\n    /// Divide a factor exactly after a proper split.\n    FactorDivision,\n    /// Solve degree-one or degree-two leaves.\n    Leaf,\n    /// Verify every stored odd syndrome by re-encoding or rebuilt recurrence.\n    Verification,\n    /// Sort and validate the final original IDs.\n    Canonicalization,\n}\n\n/// Public stage progress contains no row outcome or provisional ID.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum StageProgress {\n    /// A deterministic stage completed; counters are cumulative for the request.\n    Completed {\n        /// Bucket whose stage completed, in deterministic request traversal order.\n        bucket: usize,\n        /// Stage just executed.\n        stage: Stage,\n        /// Logical work consumed so far.\n        work: WorkUnits,\n        /// Peak required workspace bytes, excluding unused arena capacity.\n        peak_scratch_bytes: usize,\n        /// Original BM locator degree for this row; zero until BM completes.\n        locator_degree: usize,\n        /// Confirmed candidate roots so far in this row.\n        candidate_hits: usize,\n        /// Trace directions attempted so far in this row.\n        trace_attempts: usize,\n        /// Degree returned by this row's most recent GCD; zero before the first GCD.\n        gcd_degree: usize,\n    },\n    /// Terminal request failure; finishing the job must return this error.\n    Failed(DecodeError),\n}\n\n/// Internal arithmetic product, distinct from a canonical field element.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub(crate) struct RawProduct {\n    pub(crate) lo: u64,\n    pub(crate) hi: u64,\n}\n\n/// One request meter, shared by preprocessing and all rows. A failed charge is terminal.\n#[derive(Debug)]\npub(crate) struct WorkMeter {\n    limit: WorkUnits,\n    used: WorkUnits,\n    exhausted: bool,\n}\n\nimpl WorkMeter {\n    pub(crate) fn new(limit: WorkUnits) -> Self {\n        Self {\n            limit,\n            used: WorkUnits(0),\n            exhausted: false,\n        }\n    }\n\n    pub(crate) fn charge(&mut self, charge: WorkUnits) -> Result<(), DecodeError> {\n        let next = self.used.0.checked_add(charge.0);\n        if self.exhausted || next.is_none_or(|n| n > self.limit.0) {\n            self.exhausted = true;\n            return Err(DecodeError::WorkLimitExceeded);\n        }\n        self.used = WorkUnits(next.expect(\"checked work charge\"));\n        Ok(())\n    }\n\n    pub(crate) fn used(&self) -> WorkUnits {\n        self.used\n    }\n}\n\n#[cfg(test)]\npub(crate) mod small_degree_observer;\n"},{"id":12,"name":{"Local":"src/decode/scratch.rs"},"crate_name":"bulksketch","contents":"//! Lower workspace borrows, owned by the upper request arena. The row decoder consumes these.\n#![forbid(unsafe_code)]\n\nuse crate::types::RawProduct;\n\n#[derive(Default)]\npub(crate) struct SplitterBasis {\n    pub(crate) directions: Option<[u64; 64]>,\n    pub(crate) len: u32,\n}\n\nimpl std::fmt::Debug for SplitterBasis {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.debug_struct(\"SplitterBasis\").finish_non_exhaustive()\n    }\n}\n\n/// An explicit factor-stack entry. The parent table is released before children start.\n#[derive(Clone, Debug, Default)]\n#[repr(C)]\npub(crate) struct FactorFrame {\n    pub(crate) coefficient_start: u64,\n    pub(crate) coefficient_len: u64,\n    pub(crate) next_direction: u32,\n    pub(crate) split_checked: u32,\n}\n\n/// Consecutive words, never a public arena or a replaceable scratch handle.\npub(crate) struct RowWorkspace<'w> {\n    pub(crate) syndromes: &'w mut [u64],\n    pub(crate) bm: &'w mut [u64],\n    pub(crate) polynomials: &'w mut [u64],\n    pub(crate) factors: &'w mut [u64],\n    pub(crate) square_table: &'w mut [u64],\n    pub(crate) verification: &'w mut [u64],\n    pub(crate) roots: &'w mut [u64],\n    pub(crate) raw: &'w mut [RawProduct],\n    pub(crate) stack: &'w mut [FactorFrame],\n    pub(crate) basis: &'w mut SplitterBasis,\n}\n"},{"id":13,"name":{"Local":"/rustc/library/core/src/intrinsics/mod.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"src/decode/affine.rs"},"crate_name":"bulksketch","contents":"//! Least affine multiple and exact affine-coset root recovery.\n//!\n//! All input-dependent coefficients use the existing row arena. The only fixed\n//! local arrays are the binary map's three 64-word columns; immutable Frobenius\n//! columns depend on the registered field, never a request.\n#![forbid(unsafe_code)]\n\nuse crate::{\n    backend::contract::BulkKernels,\n    field::BinaryField,\n    poly::{Dense, Polynomial},\n    types::{DecodeFailure, RawProduct},\n};\n\n/// Native carryless-product predictor, independent of the selected backend.\n/// A full in-row square costs 3d scalar square/reduction instructions plus\n/// two vector products for each high input and eight-output block. Gaussian\n/// scale-XOR uses two products per eight words; pivot normalization is scalar.\n/// The mapped inverse uses eight three-product multiplies and four raw squares.\n/// Table lookups, binary-map XORs, loads and shift reductions are not CLMULs;\n/// this selector is neither a work bound nor a cycle estimate.\nconst fn square_products(degree: u64) -> u64 {\n    3 * degree + 2 * (degree / 2) * degree.div_ceil(8)\n}\n\nconst fn predicted_affine(degree: usize) -> bool {\n    if degree < 3 || degree >= 64 {\n        return false;\n    }\n    let d = degree as u64;\n    let unit_columns = 1 + (usize::BITS - (degree - 1).leading_zeros()) as u64;\n    let pivots = d.saturating_sub(unit_columns);\n    let mut gaussian = 0;\n    let mut column = unit_columns;\n    while column <= d {\n        let mut pivot = 0;\n        while pivot < column {\n            gaussian += 2 * ((d - pivot).div_ceil(8) + (column + 1).div_ceil(8));\n            pivot += 1;\n        }\n        column += 1;\n    }\n    let normalization = 3 * d * (d + 1);\n    let inverses = 28 * pivots;\n    let map = 16 * d;\n    let subspaces = 6 * d * (d - 1);\n    gaussian + normalization + inverses + map + subspaces < (64 - d) * square_products(d)\n}\n\n// Derive the mask at compile time; row dispatch is one bounded bit test,\n// never the Gaussian predictor's nested loops on the decode hot path.\nconst PREFERRED_MASK: u64 = {\n    let mut degree = 3;\n    let mut mask = 0;\n    while degree < 64 {\n        if predicted_affine(degree) {\n            mask |= 1_u64 << degree;\n        }\n        degree += 1;\n    }\n    mask\n};\n\npub(super) const fn preferred<F: BinaryField>(degree: usize) -> bool {\n    degree < F::BITS as usize && degree < 64 && PREFERRED_MASK & (1_u64 << degree) != 0\n}\n\n/// Largest degree admitted by the GF64 operation predictor, derived at compile\n/// time so request admission never scans degree candidates.\npub(crate) const MAX_PREFERRED_DEGREE: usize = {\n    let mut degree = 3;\n    let mut maximum = 0;\n    while degree < 64 {\n        if preferred::<crate::field::Gf64>(degree) {\n            maximum = degree;\n        }\n        degree += 1;\n    }\n    maximum\n};\n\n/// Compare eight-lane Horner products with the split predictor after the\n/// actual rank is known. Splitting reserves rank full modular squares, three\n/// mapped inverses per root and one raw quadratic-check square per root.\n/// As above, this counts CLMUL instructions, not elapsed time or logical work.\npub(super) fn enumerate_preferred(degree: usize, rank: usize) -> bool {\n    let Some(points) = 1_u64.checked_shl(rank as u32) else {\n        return false;\n    };\n    let d = degree as u64;\n    let Some(enumeration) = points.div_ceil(8).checked_mul(6 * d) else {\n        return false;\n    };\n    enumeration <= rank as u64 * square_products(d) + (3 * 28 + 1) * d\n}\n\n/// Return c+sum(a_i X^(2^i)) divisible by the monic input polynomial.\n/// `affine`, `residue`, `vector`, and `witness` need d+1,d,d,d+1 words.\n/// Rows and witnesses together need 2*d*d+d words.\npub(super) fn multiple<F: BinaryField, K: BulkKernels<F>>(\n    polynomial: &[u64],\n    table: &[u64],\n    factors: &mut [u64],\n    affine: &mut [u64],\n    work: &mut [u64],\n    raw: &mut [RawProduct],\n) -> usize {\n    let d = polynomial.len() - 1;\n    let width = d + 1;\n    let (rows, rest) = factors.split_at_mut(d * d);\n    let witnesses = &mut rest[..d * width];\n    rows.fill(0);\n    witnesses.fill(0);\n    let (residue, rest) = work.split_at_mut(d);\n    let (vector, rest) = rest.split_at_mut(d);\n    let witness = &mut rest[..width];\n    residue.fill(0);\n    residue[0] = 1;\n    for column in 0..=d {\n        vector.copy_from_slice(residue);\n        witness.fill(0);\n        witness[column] = 1;\n        let mut pivot = None;\n        for i in 0..d {\n            let scale = vector[i];\n            if scale == 0 {\n                continue;\n            }\n            if rows[i * d + i] == 0 {\n                pivot = Some(i);\n                break;\n            }\n            K::scale_xor(&mut vector[i..], &rows[i * d + i..(i + 1) * d], scale);\n            K::scale_xor(\n                &mut witness[..=column],\n                &witnesses[i * width..i * width + column + 1],\n                scale,\n            );\n        }\n        let Some(pivot) = pivot else {\n            affine[..=column].copy_from_slice(&witness[..=column]);\n            return column + 1;\n        };\n        let inverse = if vector[pivot] == 1 {\n            1\n        } else {\n            K::inverse(vector[pivot]).expect(\"nonzero affine pivot\")\n        };\n        for (dst, &value) in rows[pivot * d + pivot..(pivot + 1) * d]\n            .iter_mut()\n            .zip(&vector[pivot..])\n        {\n            *dst = K::mul(value, inverse);\n        }\n        for (dst, &value) in witnesses[pivot * width..pivot * width + column + 1]\n            .iter_mut()\n            .zip(&witness[..=column])\n        {\n            *dst = K::mul(value, inverse);\n        }\n        if column == 0 {\n            residue.fill(0);\n            residue[1] = 1;\n        } else if column != d {\n            <Dense as Polynomial<F, K>>::square_mod_into(residue, polynomial, table, vector, raw);\n            residue.copy_from_slice(vector);\n        }\n    }\n    unreachable!(\"d+1 vectors in dimension d are dependent\")\n}\n\n/// Column elimination preserves a preimage witness for every image pivot.\n/// Every dependent column gives one independent kernel direction. The returned\n/// base plus that kernel is exactly the complete solution set of L(X)=c.\npub(super) fn solve_map<F: BinaryField, K: BulkKernels<F>>(\n    affine: &[u64],\n    kernel: &mut [u64; 64],\n) -> Option<(u64, usize)> {\n    let bits = F::BITS as usize;\n    let mut columns = [0; 64];\n    for (power, &coefficient) in affine[1..].iter().enumerate() {\n        if coefficient == 0 {\n            continue;\n        }\n        if F::BITS == 64 {\n            let row = &FROBENIUS_COLUMNS[power];\n            if coefficient == 1 {\n                for (dst, &value) in columns.iter_mut().zip(row) {\n                    *dst ^= value;\n                }\n            } else {\n                K::scale_xor(&mut columns, row, coefficient);\n            }\n        } else {\n            for (bit, dst) in columns[..bits].iter_mut().enumerate() {\n                *dst ^= K::mul(coefficient, K::frobenius(1_u64 << bit, power as u32));\n            }\n        }\n    }\n    let mut images = [0; 64];\n    let mut preimages = [0; 64];\n    let mut rank = 0;\n    for (bit, &column) in columns[..bits].iter().enumerate() {\n        let mut original = 1_u64 << bit;\n        let mut image = column;\n        while image != 0 {\n            let pivot = image.trailing_zeros() as usize;\n            if images[pivot] == 0 {\n                images[pivot] = image;\n                preimages[pivot] = original;\n                break;\n            }\n            image ^= images[pivot];\n            original ^= preimages[pivot];\n        }\n        if image == 0 {\n            kernel[rank] = original;\n            rank += 1;\n        }\n    }\n    let mut target = affine[0];\n    let mut solution = 0;\n    while target != 0 {\n        let pivot = target.trailing_zeros() as usize;\n        if images[pivot] == 0 {\n            return None;\n        }\n        target ^= images[pivot];\n        solution ^= preimages[pivot];\n    }\n    Some((solution, rank))\n}\n\nfn linear_eval<F: BinaryField, K: BulkKernels<F>>(linear: &[u64], mut x: u64) -> u64 {\n    let mut out = 0;\n    for (i, &coefficient) in linear.iter().enumerate() {\n        out ^= K::mul(coefficient, x);\n        if i + 1 != linear.len() {\n            x = K::square(x);\n        }\n    }\n    out\n}\n\npub(super) fn subspace_start(rank: usize) -> usize {\n    rank * (rank + 1) / 2\n}\n\n/// Prefix annihilators A_0=X, A_(j+1)=A_j^2+A_j(b_j)*A_j.\n/// The triangular table takes (rank+1)(rank+2)/2 words.\npub(super) fn subspaces<F: BinaryField, K: BulkKernels<F>>(basis: &[u64], table: &mut [u64]) {\n    table[0] = 1;\n    for (rank, &direction) in basis.iter().enumerate() {\n        let start = subspace_start(rank);\n        let next = subspace_start(rank + 1);\n        let (previous, rest) = table.split_at_mut(next);\n        let previous = &previous[start..next];\n        let output = &mut rest[..rank + 2];\n        let at_direction = linear_eval::<F, K>(previous, direction);\n        output.fill(0);\n        for (i, &coefficient) in previous.iter().enumerate() {\n            output[i] ^= K::mul(at_direction, coefficient);\n            output[i + 1] ^= K::square(coefficient);\n        }\n    }\n}\n\n/// A_(rank-1)(X)+A_(rank-1)(base) modulo the current monic factor.\n/// Its zero set partitions the current coset into exactly the two child cosets.\npub(super) fn splitter<F: BinaryField, K: BulkKernels<F>>(\n    polynomial: &[u64],\n    table: &[u64],\n    linear: &[u64],\n    base: u64,\n    output: &mut [u64],\n    work: &mut [u64],\n    raw: &mut [RawProduct],\n) -> usize {\n    let d = polynomial.len() - 1;\n    output[..d].fill(0);\n    output[0] = linear_eval::<F, K>(linear, base);\n    let (residue, rest) = work.split_at_mut(d);\n    let squared = &mut rest[..d];\n    residue.fill(0);\n    residue[1] = 1;\n    for (i, &coefficient) in linear.iter().enumerate() {\n        K::scale_xor(&mut output[..d], residue, coefficient);\n        if i + 1 != linear.len() {\n            <Dense as Polynomial<F, K>>::square_mod_into(residue, polynomial, table, squared, raw);\n            residue.copy_from_slice(squared);\n        }\n    }\n    output[..d]\n        .iter()\n        .rposition(|&x| x != 0)\n        .map_or(0, |i| i + 1)\n}\n\n/// Enumerate the exact solution coset in Gray order and test the original\n/// residual polynomial. Distinct d roots of a monic degree-d polynomial prove\n/// complete splitting, so no extra polynomial reconstruction is necessary.\npub(super) fn enumerate<F: BinaryField, K: BulkKernels<F>>(\n    polynomial: &[u64],\n    base: u64,\n    basis: &[u64],\n    roots: &mut [u64],\n    work: &mut [u64],\n) -> Result<usize, DecodeFailure> {\n    let d = polynomial.len() - 1;\n    let (points, values) = work.split_at_mut(work.len() / 2);\n    let batch = points.len().min(values.len());\n    // Keep all interior batches complete native vectors. Otherwise each arena-\n    // sized batch repeats a padded tail outside the selector's product count.\n    let batch = if batch >= 8 { batch / 8 * 8 } else { batch };\n    let count = 1_usize\n        .checked_shl(basis.len() as u32)\n        .expect(\"charged enumeration rank\");\n    let mut x = base;\n    let mut found = 0;\n    for start in (0..count).step_by(batch) {\n        let len = batch.min(count - start);\n        for (offset, point) in points[..len].iter_mut().enumerate() {\n            let index = start + offset;\n            if index != 0 {\n                x ^= basis[index.trailing_zeros() as usize];\n            }\n            *point = x;\n        }\n        K::horner_many(polynomial, &points[..len], &mut values[..len]);\n        for (&point, &value) in points[..len].iter().zip(&values[..len]) {\n            if value == 0 {\n                if point == 0 {\n                    return Err(DecodeFailure::InvalidLocator);\n                }\n                if found == d {\n                    return Err(DecodeFailure::NotSplit);\n                }\n                roots[found] = point;\n                found += 1;\n            }\n        }\n    }\n    if found != d {\n        return Err(DecodeFailure::NotSplit);\n    }\n    Ok(found)\n}\n\n// All GF64 basis images are immutable field data, built at compile time. This\n// avoids input-dependent map caches and their uncharged first-use work.\nstatic FROBENIUS_COLUMNS: [[u64; 64]; 64] = frobenius_columns();\n\nconst fn frobenius_columns() -> [[u64; 64]; 64] {\n    let mut rows = [[0; 64]; 64];\n    let mut bit = 0;\n    while bit < 64 {\n        rows[0][bit] = 1_u64 << bit;\n        bit += 1;\n    }\n    let mut power = 1;\n    while power < 64 {\n        bit = 0;\n        while bit < 64 {\n            rows[power][bit] = square_column(rows[power - 1][bit]);\n            bit += 1;\n        }\n        power += 1;\n    }\n    rows\n}\n\nconst fn square_column(word: u64) -> u64 {\n    let mut result = 0_u128;\n    let mut bit = 0;\n    while bit < 64 {\n        result ^= (((word >> bit) & 1) as u128) << (2 * bit);\n        bit += 1;\n    }\n    let polynomial = (1_u128 << 64) | 0x1b;\n    bit = 128;\n    while bit > 64 {\n        bit -= 1;\n        if result & (1_u128 << bit) != 0 {\n            result ^= polynomial << (bit - 64);\n        }\n    }\n    result as u64\n}\n"},{"id":17,"name":{"Local":"src/field/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical field identity, arithmetic and test-only tiny fields.\n#![forbid(unsafe_code)]\n\nuse crate::types::FieldId;\n\n#[cfg(test)]\npub(crate) mod arithmetic_tests;\n#[cfg(test)]\nmod constant_tests;\n#[cfg(any(target_arch = \"x86_64\", test))]\npub(crate) mod frobenius;\npub(crate) mod gf64;\npub(crate) mod maps;\nmod quadratic_chunks;\n#[cfg(test)]\npub(crate) mod reference;\n#[cfg(test)]\npub(crate) mod tiny;\n\npub(crate) mod sealed {\n    pub trait Sealed {}\n}\n\n/// Closed field specification. Kernels consume canonical words, never masked IDs.\npub trait BinaryField: sealed::Sealed + Copy + Eq + Send + Sync + 'static {\n    /// Extension degree over GF(2).\n    const BITS: u32;\n    /// Irreducible polynomial without its leading term.\n    const MODULUS_LOW: u64;\n    /// Registered polynomial/basis identity.\n    const WIRE_ID: FieldId;\n    /// Canonical element mask.\n    const MASK: u64;\n}\n\n/// Full-width GF(2^64) identity field.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub struct Gf64;\nimpl sealed::Sealed for Gf64 {}\nimpl BinaryField for Gf64 {\n    const BITS: u32 = 64;\n    const MODULUS_LOW: u64 = 0x1b;\n    const WIRE_ID: FieldId = FieldId::Gf64;\n    const MASK: u64 = u64::MAX;\n}\n"},{"id":18,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Value":[1,{"Array":[{"Value":[2,{"TypeVar":{"Bound":[0,0]}}]},{"Value":[0,[{"Var":{"Bound":[0,0]}},{"Deduplicated":0}]]},null]}]},"kind":"InherentImplBlock"}}},{"Ident":["as_slice",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1},"kind":"InherentImplBlock"}}},{"Ident":["as_mut_slice",0]}]},{"key":{"Fun":2},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["repeat",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}}]},{"key":{"Fun":3},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}},{"Ident":["index",0]}]},{"key":{"TraitImpl":1},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{