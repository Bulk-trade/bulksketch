\n            degree_probe: None,\n            #[cfg(test)]\n            probe: None,\n            #[cfg(test)]\n            probe_algebra: None,\n            #[cfg(test)]\n            probe_fault: direct::Fault::None,\n            #[cfg(test)]\n            operation_observer: None,\n            marker: PhantomData,\n        }\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":71},{"Deduplicated":13},{"Deduplicated":25},{"Deduplicated":78}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Unknown"},{"index":1,"name":"K","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":9},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Deduplicated":10},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":25},{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"implied_trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":5}},{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":6}},{"regions":[],"outlives":[],"skip_binder":{"Value":[164,{"kind":{"TraitImpl":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":13},{"Deduplicated":25}],"const_generics":[],"trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":5}},{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":6}}]}}},"trait_decl_ref":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":78}