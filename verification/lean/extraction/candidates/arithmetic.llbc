a: &[u64],\n        modulus: &[u64],\n        table: &[u64],\n        dst: &mut [u64],\n        raw: &mut [RawProduct],\n    ) -> usize;\n}","attr_info":{"attributes":[{"DocComment":" Canonical ascending slices: empty is zero; nonempty has no trailing zero."},{"DocComment":" Output slices are caller-owned, sufficiently sized, and return their normalized length."},{"DocComment":" Input/output aliasing follows Rust borrows. Zero divisors violate internal invariants."},{"DocComment":" The row driver charges `WorkScheduleV1` *before* invoking these unmetered kernels."},{"Unknown":{"path":"expect","args":"dead_code, reason =\n\"test polynomial oracles consume the remaining private primitives\""}}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"F","variance":"Unknown"},{"index":2,"name":"K","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[1641,{"data":{"file_id":36,"beg":{"line":32,"col":31},"end":{"line":32,"col":42}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":25}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[1642,{"data":{"file_id":36,"beg":{"line":32,"col":47},"end":{"line":32,"col":61}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":52},{"Deduplicated":25}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bou