    for (target, &coefficient) in raw[..a.len()].iter_mut().zip(a) {\n            *target = RawProduct {\n                lo: coefficient,\n                hi: 0,\n            };\n        }\n        let degree = b.len() - 1;\n        // Lower slots retain raw XOR sums. Only a reduced leading slot may\n        // enter field multiplication; eliminated slots are never read again.\n        for top in (degree..a.len()).rev() {\n            let mut factor = K::reduce(raw[top]);\n            if inverse != 1 {\n                factor = K::mul(factor, inverse);\n            }\n            let offset = top - degree;\n            q[offset] = factor;\n            if factor == 0 {\n                continue;\n            }\n            if factor == 1 {\n                for (slot, &coefficient) in raw[offset..top].iter_mut().zip(&b[..degree]) {\n                    slot.lo ^= coefficient;\n                }\n                continue;\n            }\n            for (slot, &coefficient) in raw[offset..top].iter_mut().zip(&b[..degree]) {\n                let product = K::raw_mul(factor, coefficient);\n                slot.lo ^= product.lo;\n                slot.hi ^= product.hi;\n            }\n        }\n        let remainder_size = degree.min(a.len());\n        for (target, &product) in rem[..remainder_size].iter_mut().zip(raw.iter()) {\n            *target = K::reduce(product);\n        }\n        (\n            normalized_len(&q[..size]),\n            normalized_len(&rem[..remainder_size]),\n        )\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknow