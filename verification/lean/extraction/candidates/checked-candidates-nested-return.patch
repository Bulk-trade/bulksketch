+    Move each exit's ordered StorageDead epilogue before the corresponding
+    loop join, where the borrowed iterator is already semantically dead. *)
+let lower_candidates_nested_return (crate : crate) (f : fun_decl) : fun_decl =
+  let span = f.item_meta.span in
+  let site = span.data in
+  let target =
+    NameMatcher.parse_pattern
+      "bulksketch::decode::stages::{bulksketch::decode::stages::Execution<@F, @K>}::candidates"
+  in
+  let scoped =
+    !Config.sanity_checks && span.generated_from_span = None
+    && (match site.file.name with Local "src/decode/stages.rs" -> true | _ -> false)
+    && (site.beg_loc.line, site.beg_loc.col, site.end_loc.line, site.end_loc.col)
+         = (266, 4, 303, 5)
+    && ExtractName.match_name crate target f.item_meta.name
+  in
+  let id (st : statement) = StatementId.to_int st.statement_id in
+  let ids = List.map id in
+  let rec split n = function
+    | [] -> None
+    | st :: rest when id st = n -> Some ([], st, rest)
+    | st :: rest ->
+        Option.map (fun (before, found, after) -> (st :: before, found, after))
+          (split n rest)
+  in
+  let storage_dead expected statements =
+    List.map
+      (fun st ->
+        match st.kind with StorageDead i -> LocalId.to_int i | _ -> -1)
+      statements = expected
+  in
+  let ctor type_id variant destination source (st : statement) =
+    let operands_match = function
+      | [] -> source = None
+      | [Move place] ->
+          Option.fold ~none:false
+            ~some:(fun i -> place.kind = PlaceLocal (LocalId.of_int i)) source
+      | _ -> false
+    in
+    match st.kind with
+    | Assign
+        (place, Aggregate (AggregatedAdt (decl, Some tag, None), operands)) ->
+        place.kind = PlaceLocal (LocalId.of_int destination)
+        && decl.id = TypeDeclId.of_int type_id
+        && tag = VariantId.of_int variant && operands_match operands
+    | _ -> false
+  in
+  let take n xs = List.filteri (fun i _ -> i < n) xs in
+  let drop n xs = List.filteri (fun i _ -> i >= n) xs in
