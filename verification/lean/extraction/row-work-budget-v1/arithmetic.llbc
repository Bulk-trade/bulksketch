, 1)?)? / 6;\n        let linear = mul(r, next)? / 2;\n        let squares = squares\n            .checked_sub(5)\n            .ok_or(DecodeError::WorkLimitExceeded)?;\n        let linear = linear\n            .checked_sub(3)\n            .ok_or(DecodeError::WorkLimitExceeded)?;\n        let nodes = r.checked_sub(2).ok_or(DecodeError::WorkLimitExceeded)?;\n        let total = add(\n            add(mul(12812, squares)?, mul(17486, linear)?)?,\n            mul(16968, nodes)?,\n        )?;\n        Ok(WorkUnits(add(leaves, total)?))\n    }","attr_info":{"attributes":[{"DocComment":" Worst proper split tree. For increasing convex node costs, an unbalanced"},{"DocComment":" chain maximizes their sum: at most one node of each size 3..=r is sufficient"},{"DocComment":" as a bound. At each node all 64 trace directions and split checks are charged."},{"DocComment":" 160*r additionally bounds every possible degree-one/two leaf partition."},{"Builtin":{"Inline":["Always",{"Untagged":{"data":{"file_id":5,"beg":{"line":203,"col":4},"end":{"line":203,"col":21}},"generated_from_span":null}}]}}],"inline":"Always","rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":0}],"output":{"Deduplicated":30}},"src":"Normal","body":{"Structured":{"span":{"Value":[1125,{"data":{"file_id":5,"beg":{"line":204,"col":4},"end":{"line":227,"col":5}},"generated_from_span":null}]},"bound_body_regions":0,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"Value":[1126,{"data":{"file_id":5,"beg":{"line":204,"col":48},"end":{"line":204,"col":78}},"generated_from_span":null}]},"ty":{"Deduplicated":30},"drop_flag_for":null},{"index":1,"name":"budget","span":{"Value":[1127,{"d