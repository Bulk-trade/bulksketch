ve to promise that if the argument"},{"DocComment":" to `get_unchecked(_mut)` is a safe reference, then so is the result."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"SliceIndex","has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"},{"index":2,"name":"Self_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"get","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["get",0]}],"span":{"Untagged":{"data":{"file_id":4,"beg":{"line":132,"col":4},"end":{"line":132,"col":53}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a shared reference to the output at this location, if in"},{"DocComment":" bounds."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":5},{"Value":[115,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":17},"Shared"]}]}],"output":{"Value":[116,{"Adt":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":114}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"default":null},"kind":{"TraitMethod":[2,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generic