DocComment":" assert_eq!(src, [1, 2, 3, 4]);"},{"DocComment":" assert_eq!(dst, [3, 4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Rust enforces that there can only be one mutable reference with no"},{"DocComment":" immutable references to a particular piece of data in a particular"},{"DocComment":" scope. Because of this, attempting to use `copy_from_slice` on a"},{"DocComment":" single slice will result in a compile failure:"},{"DocComment":""},{"DocComment":" ```compile_fail"},{"DocComment":" let mut slice = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" slice[..2].copy_from_slice(&slice[3..]); // compile fail!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" To work around this, we can use [`split_at_mut`] to create two distinct"},{"DocComment":" sub-slices from a slice:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut slice = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"     let (left, right) = slice.split_at_mut(2);"},{"DocComment":"     left.copy_from_slice(&right[1..]);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(slice, [4, 5, 3, 4, 5]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`clone_from_slice`]: slice::clone_from_slice"},{"DocComment":" [`split_at_mut`]: slice::split_at_mut"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":3,"beg":{"line":4340,"col":4},"end":{"line":4340,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[146,{"data":{"file_id":3,"beg":{"line":4343,"col":11},"end":{"line":4343,"col":15}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":4}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":4}},{"Var":{"Free":0}}]},{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":4}},{"Var":{"Free":1}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":36},{"Value":[188,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":34},"Shared"]}]}],"output":{"Deduplicated":26}},"src":"Normal","body":"Opaque"},{"def_id":32,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":3},"kind":"InherentImplBlock"}}},{"Ident":["sort_unstable",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":3150,"col":4},"end":{"line":3152,"col":15}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Sorts the slice in ascending order **without** preserving the initial order of equal elements."},{"DocComment":""},{"DocComment":" This sort is unstable (i.e., may reorder equal elements), in-place (i.e., does not"},{"DocComment":" allocate), and *O*(*n* \\* log(*n*)) worst-case."},{"DocComment":""},{"DocComment":" If the implementation of [`Ord`] for `T` does not implement a [total order], the function"},{"DocComment":" may panic; even if the function exits normally, the resulting order of elements in the slice"},{"DocComment":" is unspecified. See also the note on panicking below."},{"DocComment":""},{"DocComment":" For example `|a, b| (a - b).cmp(a)` is a comparison function that is neither transitive nor"},{"DocComment":" reflexive nor total, `a < b < c < a` with `a = 1, b = 2, c = 3`. For more information and"},{"DocComment":" examples see the [`Ord`] documentation."},{"DocComment":""},{"DocComment":""},{"DocComment":" All original elements will remain in the slice and any possible modifications via interior"},{"DocComment":" mutability are observed in the input. Same is true if the implementation of [`Ord`] for `T` panics."},{"DocComment":""},{"DocComment":" Sorting types that only implement [`PartialOrd`] such as [`f32`] and [`f64`] require"},{"DocComment":" additional precautions. For example, `f32::NAN != f32::NAN`, which doesn't fulfill the"},{"DocComment":" reflexivity requirement of [`Ord`]. By using an alternative comparison function with"},{"DocComment":" `slice::sort_unstable_by` such as [`f32::total_cmp`] or [`f64::total_cmp`] that defines a"},{"DocComment":" [total order] users can sort slices containing floating-point values. Alternatively, if all"},{"DocComment":" values in the slice are guaranteed to be in a subset for which [`PartialOrd::partial_cmp`]"},{"DocComment":" forms a [total order], it's possible to sort the slice with `sort_unstable_by(|a, b|"},{"DocComment":" a.partial_cmp(b).unwrap())`."},{"DocComment":""},{"DocComment":" # Current implementation"},{"DocComment":""},{"DocComment":" The current implementation is based on [ipnsort] by Lukas Bergdoll and Orson Peters, which"},{"DocComment":" combines the fast average case of quicksort with the fast worst case of heapsort, achieving"},{"DocComment":" linear time on fully sorted and reversed inputs. On inputs with k distinct elements, the"},{"DocComment":" expected time to sort the data is *O*(*n* \\* log(*k*))."},{"DocComment":""},{"DocComment":" It is typically faster than stable sorting, except in a few special cases, e.g., when the"},{"DocComment":" slice is partially sorted."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" May panic if the implementation of [`Ord`] for `T` does not implement a [total order], or if"},{"DocComment":" the [`Ord`] implementation panics."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut v = [4, -5, 1, -3, 2];"},{"DocComment":""},{"DocComment":" v.sort_unstable();"},{"DocComment":" assert_eq!(v, [-5, -3, 1, 2, 4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [ipnsort]: https://github.com/Voultapher/sort-research-rs/tree/main/ipnsort"},{"DocComment":" [total order]: https://en.wikipedia.org/wiki/Total_order"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[147,{"data":{"file_id":3,"beg":{"line":3152,"col":11},"end":{"line":3152,"col":14}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":4}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":4}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":36}],"output":{"Deduplicated":26}},"src":"Normal","body":"Opaque"},{"def_id":33,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["range",0]},{"Impl":{"Trait":16}},{"Ident":["next",0]}],"span":{"Untagged":{"data":{"file_id":28,"beg":{"line":1188,"col":4},"end":{"line":1188,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null