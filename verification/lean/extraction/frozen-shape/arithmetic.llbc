Deduplicated":2}]}]},"variant_layouts":[{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Deduplicated":19}},"chosen":null},{"guarantee":{"GuaranteedAlignment":{"Deduplicated":19}},"chosen":null}],"inhabited":{"Deduplicated":1},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},{"def_id":6,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["types",0]},{"Ident":["FieldId",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":7,"col":0},"end":{"line":10,"col":1}},"generated_from_span":null}},"source_text":"pub enum FieldId {\n    /// GF(2^64), modulus Z^64 + Z^4 + Z^3 + Z + 1, bit i is Z^i.\n    Gf64 = 1,\n}","attr_info":{"attributes":[{"DocComment":" Polynomial-basis identity, including the irreducible polynomial."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":9,"col":4},"end":{"line":9,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" GF(2^64), modulus Z^64 + Z^4 + Z^3 + Z + 1, bit i is Z^i."}],"inline":null,"rename":null,"public":true},"name":"Gf64","fields":[],"discriminant":{"Unsigned":["U8","1"]}}]},"layout":[{"key":"x86_64-apple-darwin","value":{"size":{"chosen":{"Deduplicated":1},"guarantee":{"Value":[21,{"Constant":{"Value":[11,[{"SizeOf":{"Value":[8,{"Scalar":{"Integer":{"Unsigned":"U8"}}}]}},{"Deduplicated":0}]]}}]}},"align":{"chosen":{"Deduplicated":1},"guarantee":{"Value":[22,{"Constant":{"Value":[12,[{"AlignOf":{"Deduplicated":8}},{"Deduplicated":0}]]}}]}},"discriminator":{"Branch":{"offset":{"guarantee":null,"chosen":0},"int_ty":{"Unsigned":"U8"},"children":[[{"start":{"Unsigned":["U8","1"]},"end":{"Unsigned":["U8","1"]}},{"Known":0}]],"fallback":"Invalid"}},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[[0,{"Unsigned":["U8","1"]}]]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":{"Unsigned":"U8"}}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":7,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["sync",0]},{"Ident":["Arc",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":274,"col":0},"end":{"line":277,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A thread-safe reference-counting pointer. 'Arc' stands for 'Atomically"},{"DocComment":" Reference Counted'."},{"DocComment":""},{"DocComment":" The type `Arc<T>` provides shared ownership of a value of type `T`,"},{"DocComment":" allocated in the heap. Invoking [`clone`][clone] on `Arc` produces"},{"DocComment":" a new `Arc` instance, which points to the same allocation on the heap as the"},{"DocComment":" source `Arc`, while increasing a reference count. When the last `Arc`"},{"DocComment":" pointer to a given allocation is destroyed, the value stored in that allocation (often"},{"DocComment":" referred to as \"inner value\") is also dropped."},{"DocComment":""},{"DocComment":" Shared references in Rust disallow mutation by default, and `Arc` is no"},{"DocComment":" exception: you cannot generally obtain a mutable reference to something"},{"DocComment":" inside an `Arc`. If you do need to mutate through an `Arc`, you have several options:"},{"DocComment":""},{"DocComment":" 1. Use interior mutability with synchronization primitives like [`Mutex`][mutex],"},{"DocComment":"    [`RwLock`][rwlock], or one of the [`Atomic`][atomic] types."},{"DocComment":""},{"DocComment":" 2. Use clone-on-write semantics with [`Arc::make_mut`] which provides efficient mutation"},{"DocComment":"    without requiring interior mutability. This approach clones the data only when"},{"DocComment":"    needed (when there are multiple references) and can be more efficient when mutations"},{"DocComment":"    are infrequent."},{"DocComment":""},{"DocComment":" 3. Use [`Arc::get_mut`] when you know your `Arc` is not shared (has a reference count of 1),"},{"DocComment":"    which provides direct mutable access to the inner value without any cloning."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let mut data = Arc::new(vec![1, 2, 3]);"},{"DocComment":""},{"DocComment":" // This will clone the vector only if there are other references to it"},{"DocComment":" Arc::make_mut(&mut data).push(4);"},{"DocComment":""},{"DocComment":" assert_eq!(*data, vec![1, 2, 3, 4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" **Note**: This type is only available on platforms that support atomic"},{"DocComment":" loads and stores of pointers, which includes all platforms that support"},{"DocComment":" the `std` crate but not all those which only support [`alloc`](crate)."},{"DocComment":" This may be detected at compile time using `#[cfg(target_has_atomic = \"ptr\")]`."},{"DocComment":""},{"DocComment":" ## Thread Safety"},{"DocComment":""},{"DocComment":" Unlike [`Rc<T>`], `Arc<T>` uses atomic operations for its reference"},{"DocComment":" counting. This means that it is thread-safe. The disadvantage is that"},{"DocComment":" atomic operations are more expensive than ordinary memory accesses. If you"},{"DocComment":" are not sharing reference-counted allocations between threads, consider using"},{"DocComment":" [`Rc<T>`] for lower overhead. [`Rc<T>`] is a safe default, because the"},{"DocComment":" compiler will catch any attempt to send an [`Rc<T>`] between threads."},{"DocComment":" However, a library might choose `Arc<T>` in order to give library consumers"},{"DocComment":" more flexibility."},{"DocComment":""},{"DocComment":" `Arc<T>` will implement [`Send`] and [`Sync`] as long as the `T` implements"},{"DocComment":" [`Send`] and [`Sync`]. Why can't you put a non-thread-safe type `T` in an"},{"DocComment":" `Arc<T>` to make it thread-safe? This may be a bit counter-intuitive at"},{"DocComment":" first: after all, isn't the point of `Arc<T>` thread safety? The key is"},{"DocComment":" this: `Arc<T>` makes it thread safe to have multiple ownership of the same"},{"DocComment":" data, but it  doesn't add thread safety to its data. Consider"},{"DocComment":" <code>Arc<[RefCell\\<T>]></code>. [`RefCell<T>`] isn't [`Sync`], and if `Arc<T>` was always"},{"DocComment":" [`Send`], <code>Arc<[RefCell\\<T>]></code> would be as well. But then we'd have a problem:"},{"DocComment":" [`RefCell<T>`] is not thread safe; it keeps track of the borrowing count using"},{"DocComment":" non-atomic operations."},{"DocComment":""},{"DocComment":" In the end, this means that you may need to pair `Arc<T>` with some sort of"},{"DocComment":" [`std::sync`] type, usually [`Mutex<T>`][mutex]."},{"DocComment":""},{"DocComment":" ## Breaking cycles with `Weak`"},{"DocComment":""},{"DocComment":" The [`downgrade`][downgrade] method can be used to create a non-owning"},{"DocComment":" [`Weak`] pointer. A [`Weak`] pointer can be [`upgrade`][upgrade]d"},{"DocComment":" to an `Arc`, but this will return [`None`] if the value stored in the allocation has"},{"DocComment":" already been dropped. In other words, `Weak` pointers do not keep the value"},{"DocComment":" inside the allocation alive; however, they *do* keep the allocation"},{"DocComment":" (the backing store for the value) alive."},{"DocComment":""},{"DocComment":" A cycle between `Arc` pointers will never be deallocated. For this reason,"},{"DocComment":" [`Weak`] is used to break cycles. For example, a tree could have"},{"DocComment":" strong `Arc` pointers from parent nodes to children, and [`Weak`]"},{"DocComment":" pointers from children back to their parents."},{"DocComment":""},{"DocComment":" # Cloning references"},{"DocComment":""},{"DocComment":" Creating a new reference from an existing reference-counted pointer is done using the"},{"DocComment":" `Clone` trait implemented for [`Arc<T>`][Arc] and [`Weak<T>`][Weak]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" let foo = Arc::new(vec![1.0, 2.0, 3.0]);"},{"DocComment":" // The two syntaxes below are equivalent."},{"DocComment":" let a = foo.clone();"},{"DocComment":" let b = Arc::clone(&foo);"},{"DocComment":" // a, b, and foo are all Arcs that point to the same memory location"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Deref` behavior"},{"DocComment":""},{"DocComment":" `Arc<T>` automatically dereferences to `T` (via the [`Deref`] trait),"},{"DocComment":" so you can call `T`'s methods on a value of type `Arc<T>`. To avoid name"},{"DocComment":" clashes with `T`'s methods, the methods of `Arc<T>` itself are associated"},{"DocComment":" functions, called using [fully qualified syntax]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let my_arc = Arc::new(());"},{"DocComment":" let my_weak = Arc::downgrade(&my_arc);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Arc<T>`'s implementations of traits like `Clone` may also be called using"},{"DocComment":" fully qualified syntax. Some people prefer to use fully qualified syntax,"},{"DocComment":" while others prefer using method-call syntax."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let arc = Arc::new(());"},{"DocComment":" // Method-call syntax"},{"DocComment":" let arc2 = arc.clone();"},{"DocComment":" // Fully qualified syntax"},{"DocComment":" let arc3 = Arc::clone(&arc);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Weak<T>`][Weak] does not auto-dereference to `T`, because the inner value may have"},{"DocComment":" already been dropped."},{"DocComment":""},{"DocComment":" [`Rc<T>`]: crate::rc::Rc"},{"DocComment":" [clone]: Clone::clone"},{"DocComment":" [mutex]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [rwlock]: ../../std/sync/struct.RwLock.html"},{"DocComment":" [atomic]: core::sync::atomic"},{"DocComment":" [downgrade]: Arc::downgrade"},{"DocComment":" [upgrade]: Weak::upgrade"},{"DocComment":" [RefCell\\<T>]: core::cell::RefCell"},{"DocComment":" [`RefCell<T>`]: core::cell::RefCell"},{"DocComment":" [`std::sync`]: ../../std/sync/index.html"},{"DocComment":" [`Arc::clone(&from)`]: Arc::clone"},{"DocComment":" [fully qualified syntax]: https://doc.rust-lang.org/book/ch19-03-advanced-traits.html#fully-qualified-syntax-for-disambiguation-calling-methods-with-the-same-name"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Sharing some immutable data between threads:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let five = Arc::new(5);"},{"DocComment":""},{"DocComment":" for _ in 0..10 {"},{"DocComment":"     let five = Arc::clone(&five);"},{"DocComment":""},{"DocComment":"     thread::spawn(move || {"},{"DocComment":"         println!(\"{five:?}\");"},{"DocComment":"     });"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Sharing a mutable [`AtomicUsize`]:"},{"DocComment":""},{"DocComment":" [`AtomicUsize`]: core::sync::atomic::AtomicUsize \"sync::atomic::AtomicUsize\""},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" use std::sync::atomic::{AtomicUsize, Ordering};"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let val = Arc::new(AtomicUsize::new(5));"},{"DocComment":""},{"DocComment":" for _ in 0..10 {"},{"DocComment":"     let val = Arc::clone(&val);"},{"DocComment":""},{"DocComment":"     thread::spawn(move || {"},{"DocComment":"         let v = val.fetch_add(1, Ordering::Relaxed);"},{"DocComment":"         println!(\"{v:?}\");"},{"DocComment":"     });"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" See the [`rc` documentation][rc_examples] for more examples of reference"},{"DocComment":" counting in general."},{"DocComment":""},{"DocComment":" [rc_examples]: crate::rc#examples"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Arc","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":8,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["sketch",0]},{"Ident":["state",0]},{"Ident":["State",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":23,"col":0},"end":{"line":28,"col":1}},"generated_from_span":null}},"source_text":"pub(crate) struct State<F: BinaryField> {\n    pub(crate) shape: Arc<SketchShape<F>>,\n    pub(crate) words: Vec<u64>,\n    pub(crate) zero_words: Vec<u64>,\n    pub(crate) encoded_v1: OnceLock<Arc<[u8]>>,\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":24,"col":4},"end":{"line":24,"col":41}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},