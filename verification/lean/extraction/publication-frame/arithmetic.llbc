{"charon_version":"0.1.304","translated":{"crate_name":"bulksketch","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["bulksketch::sketch::api::_::new","bulksketch::sketch::api::_::fail","bulksketch::sketch::api::_::finish"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["bulksketch::sketch::api::_::new","bulksketch::sketch::api::_::fail","bulksketch::sketch::api::_::finish"],"opaque":["bulksketch::sketch::api::_::write"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/workspace/bulk/bulksketch-proof-evidence-20261109-native-closure/publication/frame/arithmetic.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-apple-darwin","value":{"arch":"X86_64","vendor":"apple","os":"MacOs","env":"Unspecified","cfg_abi":"Unspecified","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bulksketch","contents":"//! Native binary-syndrome reconciliation with bounded, deterministic GF64 decoding.\n#![deny(unsafe_code)]\n#![warn(missing_docs)]\n\nmod backend;\nmod decode;\nmod field;\nmod poly;\nmod sketch;\nmod types;\n\npub use {\n    field::{BinaryField, Gf64},\n    sketch::{\n        DecodeJob, DecodeLimits, DecodeOutcome, DecodePlan, DecodeReport, DecodeRequest, DecodeRow,\n        DecodeRowsRequest, DecodeScratch, Decoder, FrozenSketch, InsertScratch, MutableSketch,\n        ParseLimits, ScratchLayout, ShapeLimits, SketchShape, SketchView, decode_into,\n        decode_rows_into,\n    },\n    types::{\n        BackendError, BackendId, BackendRequest, CreateError, DecodeError, DecodeFailure,\n        EncodeError, FieldId, ParseError, ShapeError, ShapeMismatch, Stage, StageProgress,\n        UpdateError, WorkUnits,\n    },\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"src/sketch/api.rs"},"crate_name":"bulksketch","contents":"//! Shared request admission and transactional publication for the decode job.\n#![forbid(unsafe_code)]\n\nuse {\n    super::{\n        input::RequestInput,\n        plan::DecodePlan,\n        scratch::{DecodeScratch, ResultStorage, ScratchLayout},\n        state::FrozenSketch,\n        wire::SketchView,\n    },\n    crate::{\n        decode::work::{Charge, WorkScheduleV1},\n        field::BinaryField,\n        types::{DecodeError, DecodeFailure, WorkMeter, WorkUnits},\n    },\n};\n\n/// Request-wide resource caps; beta is also each row's total output budget, including zero.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct DecodeLimits {\n    /// Must be at most every row capacity.\n    pub max_output_per_bucket: usize,\n    /// Raw hints, before routing, removal of zero or deduplication.\n    pub max_candidate_inputs: usize,\n    /// One meter for preprocessing and all rows.\n    pub max_work: WorkUnits,\n    /// Required typed arena bytes, including all outcomes and results.\n    pub max_scratch_bytes: usize,\n}\n\n/// Explicit immutable reference and already parsed remote view. Hints never authorize output.\n#[derive(Clone, Copy, Debug)]\npub struct DecodeRequest<'a, F: BinaryField> {\n    /// Owned immutable local generation.\n    pub local: &'a FrozenSketch<F>,\n    /// Borrowed, fully admitted remote bytes.\n    pub remote: SketchView<'a, F>,\n    /// Original-ID hints, including possible repeats/zero.\n    pub candidates: &'a [u64],\n    /// Explicit versioned algorithm and charge schedule.\n    pub plan: &'a DecodePlan,\n    /// Request and row budget caps.\n    pub limits: &'a DecodeLimits,\n}\n\n/// A completed row. Failure never denotes empty membership.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeOutcome<'a> {\n    /// The complete difference representation, including zero, was zero.\n    Equal,\n    /// Nonempty, strictly ascending original IDs, all fully verified.\n    Decoded {\n        /// Borrowed result storage; reuse requires dropping the report.\n        ids: &'a [u64],\n    },\n    /// No provisional IDs escape this row.\n    Failed {\n        /// Algebraic failure within a request that completed successfully.\n        reason: DecodeFailure,\n    },\n}\n\n/// Atomic request result, borrowing preallocated output storage in bucket order.\n#[derive(Debug)]\npub struct DecodeReport<'s> {\n    outcomes: &'s [StoredOutcome],\n    ids: &'s [u64],\n    /// Deterministic request-wide logical work.\n    pub work: WorkUnits,\n    /// Peak required arena size; unused reusable capacity is excluded.\n    pub peak_scratch_bytes: usize,\n}\n\nimpl DecodeReport<'_> {\n    #[cfg(test)]\n    pub(super) fn result_offsets(&self) -> Vec<(u64, u64)> {\n        self.outcomes\n            .iter()\n            .map(|row| (row.start, row.len))\n            .collect()\n    }\n\n    /// Number of admitted rows, including failed and equal rows.\n    #[must_use]\n    pub fn bucket_count(&self) -> usize {\n        self.outcomes.len()\n    }\n\n    /// Read a completed row by bucket index.\n    ///\n    /// # Panics\n    /// Only if internal publication invariants admit an unfinished or invalid row.\n    #[must_use]\n    #[inline(always)]\n    pub fn outcome(&self, bucket: usize) -> Option<DecodeOutcome<'_>> {\n        let row = self.outcomes.get(bucket)?;\n        Some(match row.status {\n            OutcomeStatus::Unset => panic!(\"unpublished row in a finished report\"),\n            OutcomeStatus::Equal => DecodeOutcome::Equal,\n            OutcomeStatus::Decoded => {\n                let start = usize::try_from(row.start).expect(\"admitted result offset\");\n                let len = usize::try_from(row.len).expect(\"admitted result length\");\n                DecodeOutcome::Decoded {\n                    ids: &self.ids[start..start + len],\n                }\n            }\n            OutcomeStatus::DegreeExceedsBudget => DecodeOutcome::Failed {\n                reason: DecodeFailure::DegreeExceedsBudget,\n            },\n            OutcomeStatus::InvalidLocator => DecodeOutcome::Failed {\n                reason: DecodeFailure::InvalidLocator,\n            },\n            OutcomeStatus::NotSplit => DecodeOutcome::Failed {\n                reason: DecodeFailure::NotSplit,\n            },\n            OutcomeStatus::VerificationFailed => DecodeOutcome::Failed {\n                reason: DecodeFailure::VerificationFailed,\n            },\n        })\n    }\n}\n\n// Fixed-width metadata keeps scratch admission independent of pointer width/backend.\n#[derive(Clone, Copy, Debug, Default)]\n#[repr(u64)]\npub(crate) enum OutcomeStatus {\n    #[default]\n    Unset,\n    Equal,\n    Decoded,\n    DegreeExceedsBudget,\n    InvalidLocator,\n    NotSplit,\n    VerificationFailed,\n}\n\n#[derive(Clone, Copy, Debug, Default)]\n#[repr(C)]\npub(crate) struct StoredOutcome {\n    status: OutcomeStatus,\n    start: u64,\n    len: u64,\n}\n\n#[derive(Debug)]\npub(crate) struct AdmittedRequest {\n    pub(crate) layout: ScratchLayout,\n    pub(crate) meter: WorkMeter,\n    pub(crate) zero_failures: usize,\n}\n\n/// Strict error precedence: shape, plan, candidates, work, then scratch. Preflight is bounded and allocation-free. Recomputing row\n/// budgets avoids needing a temporary vector before scratch admission, including a short outcome segment.\npub(super) fn admit_request<F: BinaryField>(\n    request: &impl RequestInput<F>,\n    scratch: &DecodeScratch<F>,\n) -> Result<AdmittedRequest, DecodeError> {\n    request.validate_shape()?;\n    let beta = request.limits().max_output_per_bucket;\n    if !request.plan().is_supported()\n        || (0..request.bucket_count()).any(|b| beta > request.capacity(b))\n    {\n        return Err(DecodeError::InvalidPlan);\n    }\n    let rows = || {\n        (0..request.bucket_count()).map(|b| {\n            (\n                request.capacity(b),\n                beta.checked_sub(usize::from(request.zero(b))),\n            )\n        })\n    };\n    let zero_failures = if beta == 0 {\n        (0..request.bucket_count())\n            .filter(|&b| request.zero(b))\n            .count()\n    } else {\n        0\n    };\n    let candidates = request.candidate_count()?;\n    if candidates > request.limits().max_candidate_inputs {\n        return Err(DecodeError::CandidateLimitExceeded);\n    }\n    let cached_shape = request.cached_shape(beta);\n    if request.plan().has_probes()\n        && candidates == 0\n        && beta == request.capacity(0)\n        && let Some(shape) = cached_shape\n        && let Some(layout) = scratch.no_hint_layout(shape, request.bucket_count(), *request.plan())\n    {\n        let mut meter = WorkMeter::new(request.limits().max_work);\n        meter.charge(WorkScheduleV1::cost(Charge::Admission {\n            rows: request.bucket_count(),\n        })?)?;\n        if layout.total_bytes() > request.limits().max_scratch_bytes || !scratch.covers(layout) {\n            return Err(DecodeError::ScratchTooSmall);\n        }\n        return Ok(AdmittedRequest {\n            layout: layout.clone(),\n            meter,\n            zero_failures,\n        });\n    }\n    // Complete-bound overflow is rejected before work and scratch admission.\n    request.plan().work_bound(rows(), beta, candidates)?;\n    let mut meter = WorkMeter::new(request.limits().max_work);\n    meter.charge(WorkScheduleV1::cost(Charge::Admission {\n        rows: request.bucket_count(),\n    })?)?;\n    let layout = ScratchLayout::from_rows(rows(), beta, candidates)?;\n    if layout.total_bytes() > request.limits().max_scratch_bytes || !scratch.covers(&layout) {\n        return Err(DecodeError::ScratchTooSmall);\n    }\n    Ok(AdmittedRequest {\n        layout,\n        meter,\n        zero_failures,\n    })\n}\n\n#[cfg(test)]\npub(super) fn admit<F: BinaryField>(\n    request: &DecodeRequest<'_, F>,\n    scratch: &DecodeScratch<F>,\n) -> Result<AdmittedRequest, DecodeError> {\n    admit_request(request, scratch)\n}\n\n/// Only finish publishes. The job retains the disjoint workspace borrow, while\n/// this result borrow transfers to the report and prevents premature arena reuse.\npub(crate) struct Publication<'s> {\n    results: ResultStorage<'s>,\n    rows: usize,\n    written: usize,\n    used_ids: usize,\n    id_capacity: usize,\n    failure: Option<DecodeError>,\n}\n\nimpl<'s> Publication<'s> {\n    #[inline(always)]\n    pub(crate) fn new(results: ResultStorage<'s>, layout: &ScratchLayout) -> Self {\n        assert!(\n            results.ids.len() >= layout.result_ids && results.outcomes.len() >= layout.outcomes,\n            \"publication requires admitted results\"\n        );\n        results.outcomes[..layout.outcomes].fill(StoredOutcome::default());\n        Self {\n            results,\n            rows: layout.outcomes,\n            written: 0,\n            used_ids: 0,\n            id_capacity: layout.result_ids,\n            failure: None,\n        }\n    }\n\n    /// Decoded IDs are verified nonzero roots; prepend original-ID zero when present.\n    /// The returned row slice may occupy any workspace segment and is copied before reuse.\n    #[inline(always)]\n    pub(crate) fn write(&mut self, bucket: usize, outcome: DecodeOutcome<'_>, zero: bool) {\n        assert!(self.failure.is_none(), \"cannot write after request failure\");\n        assert!(\n            bucket == self.written && bucket < self.rows,\n            \"rows must complete in bucket order\"\n        );\n        let mut start = 0;\n        let mut len = 0;\n        let status = match outcome {\n            DecodeOutcome::Equal => OutcomeStatus::Equal,\n            DecodeOutcome::Failed { reason } => match reason {\n                DecodeFailure::DegreeExceedsBudget => OutcomeStatus::DegreeExceedsBudget,\n                DecodeFailure::InvalidLocator => OutcomeStatus::InvalidLocator,\n                DecodeFailure::NotSplit => OutcomeStatus::NotSplit,\n                DecodeFailure::VerificationFailed => OutcomeStatus::VerificationFailed,\n            },\n            DecodeOutcome::Decoded { ids } => {\n                assert!(\n                    (!ids.is_empty() || zero)\n                        && ids.first() != Some(&0)\n                        && ids.windows(2).all(|w| w[0] < w[1]),\n                    \"decoded roots must be nonzero and strictly ascending; output must be nonempty\"\n                );\n                let prefix = usize::from(zero);\n                let end = self\n                    .used_ids\n                    .checked_add(prefix)\n                    .and_then(|start| start.checked_add(ids.len()))\n                    .expect(\"admitted result offsets\");\n                assert!(end <= self.id_capacity, \"admitted result storage exhausted\");\n                if zero {\n                    self.results.ids[self.used_ids] = 0;\n                }\n                let destination = &mut self.results.ids[self.used_ids + prefix..end];\n                match ids {\n                    [id] => destination[0] = *id,\n                    [first, second] => {\n                        destination[0] = *first;\n                        destination[1] = *second;\n                    }\n                    _ => destination.copy_from_slice(ids),\n                }\n                start = u64::try_from(self.used_ids).expect(\"result offset fits u64\");\n                len = u64::try_from(end - self.used_ids).expect(\"result length fits u64\");\n                self.used_ids = end;\n                OutcomeStatus::Decoded\n            }\n        };\n        self.results.outcomes[bucket] = StoredOutcome { status, start, len };\n        self.written += 1;\n    }\n\n    pub(crate) fn fail(&mut self, error: DecodeError) {\n        if self.failure.is_none() {\n            self.failure = Some(error);\n        }\n    }\n\n    #[inline(always)]\n    pub(crate) fn finish(\n        self,\n        work: WorkUnits,\n        peak: usize,\n    ) -> Result<DecodeReport<'s>, DecodeError> {\n        if let Some(error) = self.failure {\n            return Err(error);\n        }\n        assert_eq!(\n            self.written, self.rows,\n            \"finish requires every row to complete\"\n        );\n        Ok(DecodeReport {\n            outcomes: &self.results.outcomes[..self.rows],\n            ids: &self.results.ids[..self.used_ids],\n            work,\n            peak_scratch_bytes: peak,\n        })\n    }\n}\n"},{"id":6,"name":{"Local":"src/sketch/mod.rs"},"crate_name":"bulksketch","contents":"//! Request-level shape, wire, admission and ownership.\n#![forbid(unsafe_code)]\n\npub(crate) mod api;\nmod candidates;\npub(crate) mod contract;\nmod dispatch;\nmod input;\nmod job;\nmod plan;\npub(crate) mod scratch;\nmod shape;\nmod state;\nmod wire;\n\npub use {\n    api::{DecodeLimits, DecodeOutcome, DecodeReport, DecodeRequest},\n    dispatch::Decoder,\n    input::{DecodeRow, DecodeRowsRequest},\n    job::{DecodeJob, decode_into, decode_rows_into},\n    plan::DecodePlan,\n    scratch::{DecodeScratch, InsertScratch, ScratchLayout},\n    shape::{ShapeLimits, SketchShape},\n    state::{FrozenSketch, MutableSketch},\n    wire::{ParseLimits, SketchView},\n};\n\n#[cfg(test)]\nmod tests;\n\n#[cfg(test)]\nmod state_tests;\n\n#[cfg(test)]\nmod wire_tests;\n\n#[cfg(test)]\nmod decode_tests;\n\n#[cfg(test)]\nmod v1_plan_tests;\n\n#[cfg(test)]\nmod forced_dispatch_tests;\n\n#[cfg(test)]\nmod backend_work_tests;\n#[cfg(test)]\nmod forced_backend_tests;\n"},{"id":7,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"src/sketch/scratch.rs"},"crate_name":"bulksketch","contents":"//! Typed arenas: no unsafe allocation/alignment, growth during decode, or implicit scratch.\n#![forbid(unsafe_code)]\n\nuse {\n    super::{api::StoredOutcome, plan::DecodePlan, shape::SketchShape},\n    crate::{\n        decode::scratch::{FactorFrame, RowWorkspace, SplitterBasis},\n        field::BinaryField,\n        types::{DecodeError, RawProduct, UpdateError},\n    },\n    std::{\n        marker::PhantomData,\n        mem::size_of,\n        sync::{Arc, OnceLock},\n    },\n};\n\n/// Reusable stable partition storage for one insertion call.\n#[derive(Clone, Debug)]\npub struct InsertScratch {\n    pub(super) ids: Vec<u64>,\n    pub(super) offsets: Vec<usize>,\n    pub(super) cursors: Vec<usize>,\n}\n\nimpl InsertScratch {\n    /// Reserve room for at most `max_ids` inputs and `max_buckets` rows per call.\n    ///\n    /// # Errors\n    /// An offset overflows or one of the buffers cannot be reserved.\n    pub fn new(max_ids: usize, max_buckets: usize) -> Result<Self, UpdateError> {\n        let offsets = max_buckets\n            .checked_add(1)\n            .ok_or(UpdateError::ScratchTooSmall)?;\n        Ok(Self {\n            ids: buffer(max_ids).map_err(|_| UpdateError::ScratchTooSmall)?,\n            offsets: buffer(offsets).map_err(|_| UpdateError::ScratchTooSmall)?,\n            cursors: buffer(max_buckets).map_err(|_| UpdateError::ScratchTooSmall)?,\n        })\n    }\n\n    pub(super) fn covers(&self, inputs: usize, buckets: usize) -> bool {\n        self.ids.len() >= inputs && self.offsets.len() > buckets && self.cursors.len() >= buckets\n    }\n}\n\nconst _: () = {\n    assert!(size_of::<RawProduct>() == 16);\n    assert!(size_of::<FactorFrame>() == 24);\n    assert!(size_of::<StoredOutcome>() == 24);\n};\n\n/// Required lengths of typed buffers, excluding unused reusable capacity and fixed handles.\n/// Rows run sequentially and reuse the largest row workspace; outputs survive all rows.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct ScratchLayout {\n    pub(crate) words: usize,\n    pub(crate) raw_products: usize,\n    pub(crate) factor_frames: usize,\n    pub(crate) result_ids: usize,\n    pub(crate) outcomes: usize,\n    row_start: usize,\n    bytes: usize,\n}\n\nimpl ScratchLayout {\n    /// Compute layout from validated row budgets. This sizes storage, never admits work.\n    /// Request execution must check candidate/work admission before using this result.\n    ///\n    /// # Errors\n    /// Invalid dimensions/budgets or checked segment/byte arithmetic overflow.\n    pub fn for_plan(\n        plan: &DecodePlan,\n        capacities: &[u16],\n        row_budgets: &[Option<usize>],\n        beta: usize,\n        candidate_count: usize,\n    ) -> Result<Self, DecodeError> {\n        plan.validate(capacities, row_budgets, beta)?;\n        Self::from_rows(\n            capacities\n                .iter()\n                .zip(row_budgets)\n                .map(|(&c, &r)| (usize::from(c), r)),\n            beta,\n            candidate_count,\n        )\n    }\n\n    #[inline]\n    pub(super) fn from_rows(\n        rows: impl ExactSizeIterator<Item = (usize, Option<usize>)>,\n        beta: usize,\n        candidates: usize,\n    ) -> Result<Self, DecodeError> {\n        let outcomes = rows.len();\n        let mut row_words = 0;\n        let mut raw_products = 0;\n        let mut factor_frames = 0;\n        let mut result_ids = 0;\n        let mut previous = None;\n        for (c, r) in rows {\n            if let Some(r) = r {\n                let (words, raw) = match previous {\n                    Some((capacity, budget, words, raw)) if capacity == c && budget == r => {\n                        (words, raw)\n                    }\n                    _ => {\n                        let row = RowLayout::new(c, r)?;\n                        previous = Some((c, r, row.words, row.raw_products));\n                        (row.words, row.raw_products)\n                    }\n                };\n                row_words = row_words.max(words);\n                raw_products = raw_products.max(raw);\n                factor_frames = factor_frames.max(r);\n                result_ids = checked_add(result_ids, beta)?;\n            }\n        }\n        // Two candidate arrays support a deterministic merge sort. Offsets route rows.\n        let row_start = checked_add(checked_mul(2, candidates)?, checked_add(outcomes, 1)?)?;\n        let words = checked_add(row_start, row_words)?;\n        let bytes = [\n            checked_mul(words, 8)?,\n            checked_mul(raw_products, 16)?,\n            checked_mul(factor_frames, 24)?,\n            checked_mul(result_ids, 8)?,\n            checked_mul(outcomes, 24)?,\n        ]\n        .into_iter()\n        .try_fold(0, checked_add)?;\n        Ok(Self {\n            words,\n            raw_products,\n            factor_frames,\n            result_ids,\n            outcomes,\n            row_start,\n            bytes,\n        })\n    }\n\n    /// Required arena bytes, including outcome metadata and persistent result IDs.\n    #[must_use]\n    pub fn total_bytes(&self) -> usize {\n        self.bytes\n    }\n}\n\n#[derive(Debug)]\nstruct NoHintLayout<F: BinaryField> {\n    shape: Arc<SketchShape<F>>,\n    rows: usize,\n    plan: DecodePlan,\n    layout: Option<ScratchLayout>,\n}\n\n/// Safe owned storage. A job must borrow the entire arena exclusively until its report drops.\n#[derive(Debug)]\npub struct DecodeScratch<F: BinaryField> {\n    pub(crate) words: Vec<u64>,\n    pub(crate) raw: Vec<RawProduct>,\n    pub(crate) factors: Vec<FactorFrame>,\n    pub(crate) ids: Vec<u64>,\n    pub(crate) outcomes: Vec<StoredOutcome>,\n    basis: SplitterBasis,\n    no_hint_layout: OnceLock<NoHintLayout<F>>,\n    field: PhantomData<F>,\n}\n\nimpl<F: BinaryField> DecodeScratch<F> {\n    /// Preallocate all initialized segments outside steady-state decoding.\n    ///\n    /// # Errors\n    /// An allocation cannot be reserved; no partial arena is returned.\n    pub fn new(layout: &ScratchLayout) -> Result<Self, DecodeError> {\n        Ok(Self {\n            words: buffer(layout.words)?,\n            raw: buffer(layout.raw_products)?,\n            factors: buffer(layout.factor_frames)?,\n            ids: buffer(layout.result_ids)?,\n            outcomes: buffer(layout.outcomes)?,\n            basis: SplitterBasis::default(),\n            no_hint_layout: OnceLock::new(),\n            field: PhantomData,\n        })\n    }\n\n    // Memoize one exact shape, row count and plan without adding metadata to algebra.\n    // A different key uses normal admission; arena reuse stays bounded.\n    pub(super) fn no_hint_layout(\n        &self,\n        shape: &Arc<SketchShape<F>>,\n        rows: usize,\n        plan: DecodePlan,\n    ) -> Option<&ScratchLayout> {\n        let cached = self.no_hint_layout.get_or_init(|| NoHintLayout {\n            shape: Arc::clone(shape),\n            rows,\n            plan,\n            layout: no_hint_layout(shape, rows, plan),\n        });\n        if cached.rows == rows && cached.plan == plan && cached.shape == *shape {\n            cached.layout.as_ref()\n        } else {\n            None\n        }\n    }\n\n    pub(super) fn covers(&self, layout: &ScratchLayout) -> bool {\n        self.words.len() >= layout.words\n            && self.raw.len() >= layout.raw_products\n            && self.factors.len() >= layout.factor_frames\n            && self.ids.len() >= layout.result_ids\n            && self.outcomes.len() >= layout.outcomes\n    }\n\n    /// Both borrows retain the job's exclusive arena lifetime; publication needs\n    /// only results, so completed row roots can be copied without aliasing workspace.\n    pub(crate) fn split(\n        &mut self,\n        layout: &ScratchLayout,\n    ) -> (DecodeWorkspace<'_>, ResultStorage<'_>) {\n        assert!(self.covers(layout), \"split requires admitted scratch\");\n        let (preprocessing, row) = self.words[..layout.words].split_at_mut(layout.row_start);\n        (\n            DecodeWorkspace {\n                preprocessing,\n                row,\n                raw: &mut self.raw[..layout.raw_products],\n                stack: &mut self.factors[..layout.factor_frames],\n                basis: &mut self.basis,\n            },\n            ResultStorage {\n                ids: &mut self.ids[..layout.result_ids],\n                outcomes: &mut self.outcomes[..layout.outcomes],\n            },\n        )\n    }\n}\n\npub(crate) struct DecodeWorkspace<'s> {\n    pub(crate) preprocessing: &'s mut [u64],\n    row: &'s mut [u64],\n    raw: &'s mut [RawProduct],\n    stack: &'s mut [FactorFrame],\n    basis: &'s mut SplitterBasis,\n}\n\npub(crate) struct ResultStorage<'s> {\n    pub(crate) ids: &'s mut [u64],\n    pub(crate) outcomes: &'s mut [StoredOutcome],\n}\n\nimpl DecodeWorkspace<'_> {\n    /// Tiny probes only borrow the original difference, verification and root slices.\n    /// General decoder buffers stay untouched until a probe miss needs them.\n    #[inline]\n    pub(crate) fn probe_row(&mut self, layout: &RowLayout) -> (&[u64], &mut [u64], &mut [u64]) {\n        let words = &mut self.row[..layout.words];\n        let verification_start = layout.words - layout.roots - layout.verification;\n        let (prefix, outputs) = words.split_at_mut(verification_start);\n        let (verification, roots) = outputs.split_at_mut(layout.verification);\n        (&prefix[..layout.difference], verification, roots)\n    }\n\n    /// Reborrow the maximum-row allocation for one row; roots must be published\n    /// before this borrow ends and the next row overwrites the same allocation.\n    #[inline]\n    pub(crate) fn row(&mut self, layout: &RowLayout) -> (&mut [u64], &mut [u64], RowWorkspace<'_>) {\n        let words = &mut self.row[..layout.words];\n        let (difference, words) = words.split_at_mut(layout.difference);\n        let (syndromes, words) = words.split_at_mut(layout.syndromes);\n        let (bm, words) = words.split_at_mut(layout.bm);\n        let (polynomials, words) = words.split_at_mut(layout.polynomials);\n        let (factors, words) = words.split_at_mut(layout.factors);\n        let (square_table, words) = words.split_at_mut(layout.square_table);\n        let (verification, roots) = words.split_at_mut(layout.verification);\n        (\n            self.preprocessing,\n            difference,\n            RowWorkspace {\n                syndromes,\n                bm,\n                polynomials,\n                factors,\n                square_table,\n                verification,\n                roots,\n                raw: &mut self.raw[..layout.raw_products],\n                stack: &mut self.stack[..layout.roots],\n                basis: self.basis,\n            },\n        )\n    }\n}\n\n/// Segment lengths inside the reusable row section, in physical storage order.\n#[derive(Clone, Debug)]\npub(crate) struct RowLayout {\n    pub(crate) difference: usize,\n    pub(crate) syndromes: usize,\n    pub(crate) bm: usize,\n    pub(crate) polynomials: usize,\n    pub(crate) factors: usize,\n    pub(crate) square_table: usize,\n    pub(crate) verification: usize,\n    pub(crate) roots: usize,\n    pub(crate) words: usize,\n    pub(crate) raw_products: usize,\n}\n\nimpl RowLayout {\n    #[inline]\n    pub(crate) fn new(c: usize, r: usize) -> Result<Self, DecodeError> {\n        let mut end = 0;\n        let mut segment = |len| {\n            end = checked_add(end, len)?;\n            Ok::<_, DecodeError>(len)\n        };\n        let difference = segment(c)?;\n        let syndromes = segment(checked_add(checked_mul(2, c)?, 1)?)?;\n        let bm = segment(checked_mul(4, checked_add(c, 1)?)?)?;\n        let width = checked_add(r, 1)?;\n        let polynomials = segment(if r == 0 { 0 } else { checked_mul(8, width)? })?;\n        let factors = segment(if r == 0 {\n            0\n        } else {\n            checked_mul(2, checked_mul(width, width)?)?\n        })?;\n        let square_table = segment(checked_mul(r, r / 2)?)?;\n        let verification = segment(c)?;\n        let roots = segment(r)?;\n        let raw_products = if r == 0 {\n            0\n        } else {\n            checked_mul(2, checked_add(r, 2)?)?\n        };\n        Ok(Self {\n            difference,\n            syndromes,\n            bm,\n            polynomials,\n            factors,\n            square_table,\n            verification,\n            roots,\n            words: end,\n            raw_products,\n        })\n    }\n}\n\nfn buffer<T: Default + Clone>(len: usize) -> Result<Vec<T>, DecodeError> {\n    let mut values = Vec::new();\n    values\n        .try_reserve_exact(len)\n        .map_err(|_| DecodeError::ScratchTooSmall)?;\n    values.resize(len, T::default());\n    Ok(values)\n}\nfn checked_add(a: usize, b: usize) -> Result<usize, DecodeError> {\n    a.checked_add(b).ok_or(DecodeError::ScratchTooSmall)\n}\nfn checked_mul(a: usize, b: usize) -> Result<usize, DecodeError> {\n    a.checked_mul(b).ok_or(DecodeError::ScratchTooSmall)\n}\n\n// Only immutable dimensions are cached. Admission still checks peer shape, plan,\n// candidates, zero membership, limits and actual scratch coverage on every call.\nfn no_hint_layout<F: BinaryField>(\n    shape: &SketchShape<F>,\n    count: usize,\n    plan: DecodePlan,\n) -> Option<ScratchLayout> {\n    let beta = usize::from(shape.capacities()[0]);\n    if shape.capacities().iter().any(|&c| usize::from(c) != beta) {\n        return None;\n    }\n    let rows = || std::iter::repeat_n((beta, Some(beta)), count);\n    plan.work_bound(rows(), beta, 0).ok()?;\n    ScratchLayout::from_rows(rows(), beta, 0).ok()\n}\n\n#[cfg(test)]\nmod v3_cache_tests;\n"},{"id":12,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"src/types.rs"},"crate_name":"bulksketch","contents":"//! Value-only definitions; this module has no dependency on the engine layers.\n#![forbid(unsafe_code)]\n\n/// Polynomial-basis identity, including the irreducible polynomial.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[repr(u8)]\npub enum FieldId {\n    /// GF(2^64), modulus Z^64 + Z^4 + Z^3 + Z + 1, bit i is Z^i.\n    Gf64 = 1,\n}\n\n/// Shape admission failure, before any row storage is allocated.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ShapeError {\n    /// Unsupported field, zero/non-power-of-two row count, or zero capacity.\n    InvalidShape,\n    /// Configured storage/dimension cap or representable wire dimension exceeded.\n    InputLimitExceeded,\n}\n\n/// Bounded wire admission failure. No view is exposed on either error.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ParseError {\n    /// A caller-supplied byte or dimension limit was exceeded.\n    InputLimitExceeded,\n    /// Unknown metadata, malformed lengths, or noncanonical payload.\n    InvalidEncoding,\n}\n\nimpl std::fmt::Display for ShapeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InvalidShape => \"invalid sketch shape\",\n            Self::InputLimitExceeded => \"shape input limit exceeded\",\n        })\n    }\n}\nimpl std::error::Error for ShapeError {}\n\nimpl std::fmt::Display for ParseError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InputLimitExceeded => \"wire input limit exceeded\",\n            Self::InvalidEncoding => \"invalid sketch encoding\",\n        })\n    }\n}\nimpl std::error::Error for ParseError {}\n\n/// Runtime arithmetic capability. No complete-operation dispatch lives in this type.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub enum BackendId {\n    /// Always-available safe Rust arithmetic.\n    Portable,\n    /// Scalar x86 carryless multiplication.\n    Pclmul,\n    /// 256-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul256,\n    /// 512-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul512,\n}\n\n/// Backend selection requested at engine construction, before any decode.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum BackendRequest {\n    /// Select from capabilities detected at runtime.\n    Auto,\n    /// Require this capability; never bypass feature/OS-state validation.\n    Force(BackendId),\n}\n\n/// An explicitly requested backend is unavailable in this build or on this CPU/OS.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct BackendError(pub BackendId);\n\n/// Construction of mutable state failed before any state was returned.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CreateError {\n    /// The requested arithmetic implementation is unavailable.\n    Backend(BackendError),\n    /// The algebraic buffers could not be reserved.\n    AllocationFailed,\n}\n\n/// Batch insertion failed before changing the sketch.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum UpdateError {\n    /// The supplied insertion arena cannot hold this call's IDs or row offsets.\n    ScratchTooSmall,\n}\n\n/// XOR requires identical fields, row counts and capacities.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ShapeMismatch;\n\n/// Encoding failed without changing the destination or algebraic state.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum EncodeError {\n    /// The destination cannot hold the complete record.\n    BufferTooSmall,\n    /// The cached record could not be reserved.\n    AllocationFailed,\n}\n\nimpl std::fmt::Display for CreateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            Self::Backend(error) => error.fmt(f),\n            Self::AllocationFailed => f.write_str(\"sketch allocation failed\"),\n        }\n    }\n}\nimpl std::error::Error for CreateError {}\nimpl std::fmt::Display for UpdateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"insertion scratch is too small\")\n    }\n}\nimpl std::error::Error for UpdateError {}\nimpl std::fmt::Display for ShapeMismatch {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"sketch shapes differ\")\n    }\n}\nimpl std::error::Error for ShapeMismatch {}\nimpl std::fmt::Display for EncodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::BufferTooSmall => \"encoding buffer is too small\",\n            Self::AllocationFailed => \"encoding allocation failed\",\n        })\n    }\n}\nimpl std::error::Error for EncodeError {}\n\nimpl std::fmt::Display for BackendError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        write!(f, \"backend {:?} is unavailable\", self.0)\n    }\n}\nimpl std::error::Error for BackendError {}\n\n/// Backend-independent logical work, never elapsed time or instruction count.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]\npub struct WorkUnits(pub u64);\n\n/// A request-wide failure publishes no row report or provisional IDs.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeError {\n    /// Local and remote fields, row counts or capacities differ.\n    ShapeMismatch,\n    /// Unknown plan or an output budget larger than any row capacity.\n    InvalidPlan,\n    /// Raw candidate count exceeds the request cap, before normalization.\n    CandidateLimitExceeded,\n    /// Work arithmetic overflows or the next charge exceeds the request limit.\n    WorkLimitExceeded,\n    /// Layout overflows, exceeds its byte cap, or any supplied segment is short.\n    ScratchTooSmall,\n}\n\n/// An admitted row failed algebraically; independently successful rows remain usable.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeFailure {\n    /// Zero consumes an unavailable slot, or locator/final output exceeds beta.\n    DegreeExceedsBudget,\n    /// The locator fails required canonicality/algebraic validation.\n    InvalidLocator,\n    /// The locator does not split into distinct permitted field roots.\n    NotSplit,\n    /// Re-encoding fails any stored odd syndrome or the zero channel.\n    VerificationFailed,\n}\n\nimpl std::fmt::Display for DecodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::ShapeMismatch => \"sketch shapes differ\",\n            Self::InvalidPlan => \"invalid decode plan or output budget\",\n            Self::CandidateLimitExceeded => \"candidate input limit exceeded\",\n            Self::WorkLimitExceeded => \"decode work limit exceeded\",\n            Self::ScratchTooSmall => \"decode scratch is too small\",\n        })\n    }\n}\nimpl std::error::Error for DecodeError {}\n\n/// Deterministic stage order. Repeated trace/GCD/division/leaf stages follow factor traversal.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Stage {\n    /// Propose the nonzero root S1 before general decoding.\n    DirectOne,\n    /// Derive a distinct nonzero pair from S1 and S3 before general decoding.\n    DirectTwo,\n    /// Reject inconsistent cubic prefixes before inversion (V3).\n    GuardThree,\n    /// Normalize a passed cubic Newton guard (V3).\n    NewtonThree,\n    /// Reject inconsistent quartic prefixes before inversion (V3).\n    GuardFour,\n    /// Normalize a passed quartic Newton guard (V3).\n    NewtonFour,\n    /// Propose the roots of a cubic factor (V3).\n    LeafThree,\n    /// Propose the roots of a quartic factor (V3).\n    LeafFour,\n    /// Certify a complete distinct nonzero factor root set (V3).\n    FactorVerification,\n    /// Expand odd syndromes and reconstruct even powers.\n    Reconstruction,\n    /// Binary Berlekamp-Massey iterations.\n    BerlekampMassey,\n    /// Evaluate the original locator at normalized hints.\n    CandidateEvaluation,\n    /// Divide out confirmed candidate roots.\n    Deflation,\n    /// Build a factor's modular-square table.\n    ReducerPreparation,\n    /// Find the least affine multiple and solve its binary map (V3).\n    AffinePreparation,\n    /// Enumerate and evaluate the recovered affine solution coset (V3).\n    AffineEnumeration,\n    /// Form an annihilator splitter for the current affine coset (V3).\n    AffineSplit,\n    /// Try the next canonical trace direction and the internal split check.\n    Trace,\n    /// Compute a monic polynomial GCD.\n    Gcd,\n    /// Divide a factor exactly after a proper split.\n    FactorDivision,\n    /// Solve degree-one or degree-two leaves.\n    Leaf,\n    /// Verify every stored odd syndrome by re-encoding or rebuilt recurrence.\n    Verification,\n    /// Sort and validate the final original IDs.\n    Canonicalization,\n}\n\n/// Public stage progress contains no row outcome or provisional ID.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum StageProgress {\n    /// A deterministic stage completed; counters are cumulative for the request.\n    Completed {\n        /// Bucket whose stage completed, in deterministic request traversal order.\n        bucket: usize,\n        /// Stage just executed.\n        stage: Stage,\n        /// Logical work consumed so far.\n        work: WorkUnits,\n        /// Peak required workspace bytes, excluding unused arena capacity.\n        peak_scratch_bytes: usize,\n        /// Original BM locator degree for this row; zero until BM completes.\n        locator_degree: usize,\n        /// Confirmed candidate roots so far in this row.\n        candidate_hits: usize,\n        /// Trace directions attempted so far in this row.\n        trace_attempts: usize,\n        /// Degree returned by this row's most recent GCD; zero before the first GCD.\n        gcd_degree: usize,\n    },\n    /// Terminal request failure; finishing the job must return this error.\n    Failed(DecodeError),\n}\n\n/// Internal arithmetic product, distinct from a canonical field element.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub(crate) struct RawProduct {\n    pub(crate) lo: u64,\n    pub(crate) hi: u64,\n}\n\n/// One request meter, shared by preprocessing and all rows. A failed charge is terminal.\n#[derive(Debug)]\npub(crate) struct WorkMeter {\n    limit: WorkUnits,\n    used: WorkUnits,\n    exhausted: bool,\n}\n\nimpl WorkMeter {\n    pub(crate) fn new(limit: WorkUnits) -> Self {\n        Self {\n            limit,\n            used: WorkUnits(0),\n            exhausted: false,\n        }\n    }\n\n    pub(crate) fn charge(&mut self, charge: WorkUnits) -> Result<(), DecodeError> {\n        let next = self.used.0.checked_add(charge.0);\n        if self.exhausted || next.is_none_or(|n| n > self.limit.0) {\n            self.exhausted = true;\n            return Err(DecodeError::WorkLimitExceeded);\n        }\n        self.used = WorkUnits(next.expect(\"checked work charge\"));\n        Ok(())\n    }\n\n    pub(crate) fn used(&self) -> WorkUnits {\n        self.used\n    }\n}\n\n#[cfg(test)]\npub(crate) mod small_degree_observer;\n"},{"id":14,"name":{"Local":"/rustc/library/core/src/panic.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/panicking.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/libra