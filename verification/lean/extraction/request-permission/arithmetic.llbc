()` can be used to sum any type implementing [`Sum`][`core::iter::Sum`],"},{"DocComment":" including [`Option`][`Option::sum`] and [`Result`][`Result::sum`]."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" When calling `sum()` and a primitive integer type is being returned, this"},{"DocComment":" method will panic if the computation overflows and overflow checks are"},{"DocComment":" enabled."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let sum: i32 = a.iter().sum();"},{"DocComment":""},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":""},{"DocComment":" let b: Vec<f32> = vec![];"},{"DocComment":" let sum: f32 = b.iter().sum();"},{"DocComment":" assert_eq!(sum, -0.0_f32);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"S","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":403},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[477,{"data":{"file_id":26,"beg":{"line":3692,"col":11},"end":{"line":3692,"col":34}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":27,"generics":{"regions":[],"types":[{"Deduplicated":54},{"Deduplicated":58}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":15}],"output":{"Deduplicated":54}},"src":{"TraitDefault":{"trait_ref":{"id":11,"generics":{"regions":[],"types":[{"