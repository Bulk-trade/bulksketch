rrors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":29,"beg":{"line":602,"col":4},"end":{"line":602,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" No value."}],"inline":null,"rename":null,"public":true},"name":"None","fields":[],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":29,"beg":{"line":606,"col":4},"end":{"line":606,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Some value of type `T`."}],"inline":null,"rename":null,"public":true},"name":"Some","fields":[{"span":{"Untagged":{"data":{"file_id":29,"beg":{"line":606,"col":55},"end":{"line":606,"col":56}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Deduplicated":15}}],"discriminant":{"Signed":["Isize","1"]}}]},"layout":[{"key":"x86_64-apple-darwin","value":{"size":{"chosen":null,"guarantee":{"Value":[152,{"AtLeast":{"Value":[153,{"AlignTo":{"base":{"Value":[154,{"Plus":[{"Value":[155,{"Constant":{"Value":[78,[{"OffsetOf":[{"id":19,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]},"builtin":null},1,0]},{"Deduplicated":0}]]}}]},{"Deduplicated":15}]}]},"target_align":{"Deduplicated":19}}}]}}]}},"align":{"chosen":null,"guarantee":{"Value":[156,{"AtLeast":{"Deduplicated":19}}]}},"discriminator":null,"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[]},{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Deduplicated":19}},"chosen":null}],"inhabited":{"Deduplicated":2},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},null,null,null,{"def_id":23,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Ident":["Vec",0]}],"span":{"Untagged":{"data":{"file_id":30,"beg":{"line":439,"col":0},"end":{"line":439,"col":96}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A contiguous growable array type, written as `Vec<T>`, short for 'vector'."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec = Vec::new();"},{"DocComment":" vec.push(1);"},{"DocComment":" vec.push(2);"},{"DocComment":""},{"DocComment":" assert_eq!(vec.len(), 2);"},{"DocComment":" assert_eq!(vec[0], 1);"},{"DocComment":""},{"DocComment":" assert_eq!(vec.pop(), Some(2));"},{"DocComment":" assert_eq!(vec.len(), 1);"},{"DocComment":""},{"DocComment":" vec[0] = 7;"},{"DocComment":" assert_eq!(vec[0], 7);"},{"DocComment":""},{"DocComment":" vec.extend([1, 2, 3]);"},{"DocComment":""},{"DocComment":" for x in &vec {"},{"DocComment":"     println!(\"{x}\");"},{"DocComment":" }"},{"DocComment":" assert_eq!(vec, [7, 1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The [`vec!`] macro is provided for convenient initialization:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec1 = vec![1, 2, 3];"},{"DocComment":" vec1.push(4);"},{"DocComment":" let vec2 = Vec::from([1, 2, 3, 4]);"},{"DocComment":" assert_eq!(vec1, vec2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It can also initialize each element of a `Vec<T>` with a given value."},{"DocComment":" This may be more efficient than performing allocation and initialization"},{"DocComment":" in separate steps, especially when initializing a vector of zeros:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let vec = vec![0; 5];"},{"DocComment":" assert_eq!(vec, [0, 0, 0, 0, 0]);"},{"DocComment":""},{"DocComment":" // The following is equivalent, but potentially slower:"},{"DocComment":" let mut vec = Vec::with_capacity(5);"},{"DocComment":" vec.resize(5, 0);"},{"DocComment":" assert_eq!(vec, [0, 0, 0, 0, 0]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For more information, see"},{"DocComment":" [Capacity and Reallocation](#capacity-and-reallocation)."},{"DocComment":""},{"DocComment":" Use a `Vec<T>` as an efficient stack:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut stack = Vec::new();"},{"DocComment":""},{"DocComment":" stack.push(1);"},{"DocComment":" stack.push(2);"},{"DocComment":" stack.push(3);"},{"DocComment":""},{"DocComment":" while let Some(top) = stack.pop() {"},{"DocComment":"     // Prints 3, 2, 1"},{"DocComment":"     println!(\"{top}\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Indexing"},{"DocComment":""},{"DocComment":" The `Vec` type allows access to values by index, because it implements the"},{"DocComment":" [`Index`] trait. An example will be more explicit:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = vec![0, 2, 4, 6];"},{"DocComment":" println!(\"{}\", v[1]); // it will display '2'"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However be careful: if you try to access an index which isn't in the `Vec`,"},{"DocComment":" your software will panic! You cannot do this:"},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let v = vec![0, 2, 4, 6];"},{"DocComment":" println!(\"{}\", v[6]); // it will panic!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use [`get`] and [`get_mut`] if you want to check whether the index is in"},{"DocComment":" the `Vec`."},{"DocComment":""},{"DocComment":" # Slicing"},{"DocComment":""},{"DocComment":" A `Vec` can be mutable. On the other hand, slices are read-only objects."},{"DocComment":" To get a [slice][prim@slice], use [`&`]. Example:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn read_slice(slice: &[usize]) {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let v = vec![0, 1];"},{"DocComment":" read_slice(&v);"},{"DocComment":""},{"DocComment":" // ... and that's all!"},{"DocComment":" // you can also do it like this:"},{"DocComment":" let u: &[usize] = &v;"},{"DocComment":" // or like this:"},{"DocComment":" let u: &[_] = &v;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In Rust, it's more common to pass slices as arguments rather than vectors"},{"DocComment":" when you just want to provide read access. The same goes for [`String`] and"},{"DocComment":" [`&str`]."},{"DocComment":""},{"DocComment":" # Capacity and reallocation"},{"DocComment":""},{"DocComment":" The capacity of a vector is the amount of space allocated for any future"},{"DocComment":" elements that will be added onto the vector. This is not to be confused with"},{"DocComment":" the *length* of a vector, which specifies the number of actual elements"},{"DocComment":" within the vector. If a vector's length exceeds its capacity, its capacity"},{"DocComment":" will automatically be increased, but its elements will have to be"},{"DocComment":" reallocated."},{"DocComment":""},{"DocComment":" For example, a vector with capacity 10 and length 0 would be an empty vector"},{"DocComment":" with space for 10 more elements. Pushing 10 or fewer elements onto the"},{"DocComment":" vector will not change its capacity or cause reallocation to occur. However,"},{"DocComment":" if the vector's length is increased to 11, it will have to reallocate, which"},{"DocComment":" can be slow. For this reason, it is recommended to use [`Vec::with_capacity`]"},{"DocComment":" whenever possible to specify how big the vector is expected to get."},{"DocComment":""},{"DocComment":" # Guarantees"},{"DocComment":""},{"DocComment":" Due to its incredibly fundamental nature, `Vec` makes a lot of guarantees"},{"DocComment":" about its design. This ensures that it's as low-overhead as possible in"},{"DocComment":" the general case, and can be correctly manipulated in primitive ways"},{"DocComment":" by unsafe code. Note that these guarantees refer to an unqualified `Vec<T>`."},{"DocComment":" If additional type parameters are added (e.g., to support custom allocators),"},{"DocComment":" overriding their defaults may change the behavior."},{"DocComment":""},{"DocComment":" Most fundamentally, `Vec` is and always will be a (pointer, capacity, length)"},{"DocComment":" triplet. No more, no less. The order of these fields is completely"},{"DocComment":" unspecified, and you should use the appropriate methods to modify these."},{"DocComment":" The pointer will never be null, so this type is null-pointer-optimized."},{"DocComment":""},{"DocComment":" However, the pointer might not actually point to allocated memory. In particular,"},{"DocComment":" if you construct a `Vec` with capacity 0 via [`Vec::new`], [`vec![]`][`vec!`],"},{"DocComment":" [`Vec::with_capacity(0)`][`Vec::with_capacity`], or by calling [`shrink_to_fit`]"},{"DocComment":" on an empty Vec, it will not allocate memory. Similarly, if you store zero-sized"},{"DocComment":" types inside a `Vec`, it will not allocate space for them. *Note that in this case"},{"DocComment":" the `Vec` might not report a [`capacity`] of 0*. `Vec` will allocate if and only"},{"DocComment":" if <code>[size_of::\\<T>]\\() * [capacity]\\() > 0</code>. In general, `Vec`'s allocation"},{"DocComment":" details are very subtle --- if you intend to allocate memory using a `Vec`"},{"DocComment":" and use it for something else (either to pass to unsafe code, or to build your"},{"DocComment":" own memory-backed collection), be sure to deallocate this memory by using"},{"DocComment":" `from_raw_parts` to recover the `Vec` and then dropping it."},{"DocComment":""},{"DocComment":" If a `Vec` *has* allocated memory, then the memory it points to is on the heap"},{"DocComment":" (as defined by the allocator Rust is configured to use by default), and its"},{"DocComment":" pointer points to [`len`] initialized, contiguous elements in order (what"},{"DocComment":" you would see if you coerced it to a slice), followed by <code>[capacity] - [len]</code>"},{"DocComment":" logically uninitialized, contiguous elements."},{"DocComment":""},{"DocComment":" A vector containing the elements `'a'` and `'b'` with capacity 4 can be"},{"DocComment":" visualized as below. The top part is the `Vec` struct, it contains a"},{"DocComment":" pointer to the head of the allocation in the heap, length and capacity."},{"DocComment":" The bottom part is the allocation on the heap, a contiguous memory block."},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":"             ptr      len  capacity"},{"DocComment":"        +--------+--------+--------+"},{"DocComment":"        | 0x0123 |      2 |      4 |"},{"DocComment":"        +--------+--------+--------+"},{"DocComment":"             |"},{"DocComment":"             v"},{"DocComment":" Heap   +--------+--------+--------+--------+"},{"DocComment":"        |    'a' |    'b' | uninit | uninit |"},{"DocComment":"        +--------+--------+--------+--------+"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" - **uninit** represents memory that is not initialized, see [`MaybeUninit`]."},{"DocComment":" - Note: the ABI is not stable and `Vec` makes no guarantees about its memory"},{"DocComment":"   layout (including the order of fields)."},{"DocComment":""},{"DocComment":" `Vec` will never perform a \"small optimization\" where elements are actually"},{"DocComment":" stored on the stack for two reasons:"},{"DocComment":""},{"DocComment":" * It would make it more difficult for unsafe code to correctly manipulate"},{"DocComment":"   a `Vec`. The contents of a `Vec` wouldn't have a stable address if it were"},{"DocComment":"   only moved, and it would be more difficult to determine if a `Vec` had"},{"DocComment":"   actually allocated memory."},{"DocComment":""},{"DocComment":" * It would penalize the general case, incurring an additional branch"},{"DocComment":"   on every access."},{"DocComment":""},{"DocComment":" `Vec` will never automatically shrink itself, even if completely empty. This"},{"DocComment":" ensures no unnecessary allocations or deallocations occur. Emptying a `Vec`"},{"DocComment":" and then filling it back up to the same [`len`] should incur no calls to"},{"DocComment":" the allocator. If you wish to free up unused memory, use"},{"DocComment":" [`shrink_to_fit`] or [`shrink_to`]."},{"DocComment":""},{"DocComment":" [`push`] and [`insert`] will never (re)allocate if the reported capacity is"},{"DocComment":" sufficient. [`push`] and [`insert`] *will* (re)allocate if"},{"DocComment":" <code>[len] == [capacity]</code>. That is, the reported capacity is completely"},{"DocComment":" accurate, and can be relied on. It can even be used to manually free the memory"},{"DocComment":" allocated by a `Vec` if desired. Bulk insertion methods *may* reallocate, even"},{"DocComment":" when not necessary."},{"DocComment":""},{"DocComment":" `Vec` does not guarantee any particular growth strategy when reallocating"},{"DocComment":" when full, nor when [`reserve`] is called. The current strategy is basic"},{"DocComment":" and it may prove desirable to use a non-constant growth factor. Whatever"},{"DocComment":" strategy is used will of course guarantee *O*(1) amortized [`push`]."},{"DocComment":""},{"DocComment":" It is guaranteed, in order to respect the intentions of the programmer, that"},{"DocComment":" all of `vec![e_1, e_2, ..., e_n]`, `vec![x; n]`, and [`Vec::with_capacity(n)`] produce a `Vec`"},{"DocComment":" that requests an allocation of the exact size needed for precisely `n` elements from the allocator,"},{"DocComment":" and no other size (such as, for example: a size rounded up to the nearest power of 2)."},{"DocComment":" The allocator will return an allocation that is at least as large as requested, but it may be larger."},{"DocComment":""},{"DocComment":" It is guaranteed that the [`Vec::capacity`] method returns a value that is at least the requested capacity"},{"DocComment":" and not more than the allocated capacity."},{"DocComment":""},{"DocComment":" The method [`Vec::shrink_to_fit`] will attempt to discard excess capacity an allocator has given to a `Vec`."},{"DocComment":" If <code>[len] == [capacity]</code>, then a `Vec<T>` can be converted"},{"DocComment":" to and from a [`Box<[T]>`][owned slice] without reallocating or moving the elements."},{"DocComment":" `Vec` exploits this fact as much as reasonable when implementing common conversions"},{"DocComment":" such as [`into_boxed_slice`]."},{"DocComment":""},{"DocComment":" `Vec` will not specifically overwrite any data that is removed from it,"},{"DocComment":" but also won't specifically preserve it. Its uninitialized memory is"},{"DocComment":" scratch space that it may use however it wants. It will generally just do"},{"DocComment":" whatever is most efficient or otherwise easy to implement. Do not rely on"},{"DocComment":" removed data to be erased for security purposes. Even if you drop a `Vec`, its"},{"DocComment":" buffer may simply be reused by another allocation. Even if you zero a `Vec`'s memory"},{"DocComment":" first, that might not actually happen because the optimizer does not consider"},{"DocComment":" this a side-effect that must be preserved. There is one case which we will"},{"DocComment":" not break, however: using `unsafe` code to write to the excess capacity,"},{"DocComment":" and then increasing the length to match, is always valid."},{"DocComment":""},{"DocComment":" Currently, `Vec` does not guarantee the order in which elements are dropped."},{"DocComment":" The order has changed in the past and may change again."},{"DocComment":""},{"DocComment":" [`get`]: slice::get"},{"DocComment":" [`get_mut`]: slice::get_mut"},{"DocComment":" [`String`]: crate::string::String"},{"DocComment":" [`&str`]: type@str"},{"DocComment":" [`shrink_to_fit`]: Vec::shrink_to_fit"},{"DocComment":" [`shrink_to`]: Vec::shrink_to"},{"DocComment":" [capacity]: Vec::capacity"},{"DocComment":" [`capacity`]: Vec::capacity"},{"DocComment":" [`Vec::capacity`]: Vec::capacity"},{"DocComment":" [size_of::\\<T>]: size_of"},{"DocComment":" [len]: Vec::len"},{"DocComment":" [`len`]: Vec::len"},{"DocComment":" [`push`]: Vec::push"},{"DocComment":" [`insert`]: Vec::insert"},{"DocComment":" [`reserve`]: Vec::reserve"},{"DocComment":" [`Vec::with_capacity(n)`]: Vec::with_capacity"},{"DocComment":" [`MaybeUninit`]: core::mem::MaybeUninit"},{"DocComment":" [owned slice]: Box"},{"DocComment":" [`into_boxed_slice`]: Vec::into_boxed_slice"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Vec","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":24,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["sync",0]},{"Ident":["once_lock",0]},{"Ident":["OnceLock",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":109,"col":0},"end":{"line":109,"col":22}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A synchronization primitive which can nominally be written to only once."},{"DocComment":""},{"DocComment":" This type is a thread-safe [`OnceCell`], and can be used in statics."},{"DocComment":" In many simple cases, you can use [`LazyLock<T, F>`] instead to get the benefits of this type"},{"DocComment":" with less effort: `LazyLock<T, F>` \"looks like\" `&T` because it initializes with `F` on deref!"},{"DocComment":" Where OnceLock shines is when LazyLock is too simple to support a given case, as LazyLock"},{"DocComment":" doesn't allow additional inputs to its function after you call [`LazyLock::new(|| ...)`]."},{"DocComment":""},{"DocComment":" A `OnceLock` can be thought of as a safe abstraction over uninitialized data that becomes"},{"DocComment":" initialized once written."},{"DocComment":""},{"DocComment":" Unlike [`Mutex`](crate::sync::Mutex), `OnceLock` is never poisoned on panic."},{"DocComment":""},{"DocComment":" [`OnceCell`]: crate::cell::OnceCell"},{"DocComment":" [`LazyLock<T, F>`]: crate::sync::LazyLock"},{"DocComment":" [`LazyLock::new(|| ...)`]: crate::sync::LazyLock::new"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Writing to a `OnceLock` from a separate thread:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::OnceLock;"},{"DocComment":""},{"DocComment":" static CELL: OnceLock<usize> = OnceLock::new();"},{"DocComment":""},{"DocComment":" // `OnceLock` has not been written to yet."},{"DocComment":" assert!(CELL.get().is_none());"},{"DocComment":""},{"DocComment":" // Spawn a thread and write to `OnceLock`."},{"DocComment":" std::thread::spawn(|| {"},{"DocComment":"     let value = CELL.get_or_init(|| 12345);"},{"DocComment":"     assert_eq!(value, &12345);"},{"DocComment":" })"},{"DocComment":" .join()"},{"DocComment":" .unwrap();"},{"DocComment":""},{"DocComment":" // `OnceLock` now contains the value."},{"DocComment":" assert_eq!("},{"DocComment":"     CELL.get(),"},{"DocComment":"     Some(&12345),"},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can use `OnceLock` to implement a type that requires \"append-only\" logic:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::{OnceLock, atomic::{AtomicU32, Ordering}};"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" struct OnceList<T> {"},{"DocComment":"     data: OnceLock<T>,"},{"DocComment":"     next: OnceLock<Box<OnceList<T>>>,"},{"DocComment":" }"},{"DocComment":" impl<T> OnceList<T> {"},{"DocComment":"     const fn new() -> OnceList<T> {"},{"DocComment":"         OnceList { data: OnceLock::new(), next: OnceLock::new() }"},{"DocComment":"     }"},{"DocComment":"     fn push(&self, value: T) {"},{"DocComment":"         // FIXME: this impl is concise, but is also slow for long lists or many threads."},{"DocComment":"         // as an exercise, consider how you might improve on it while preserving the behavior"},{"DocComment":"         if let Err(value) = self.data.set(value) {"},{"DocComment":"             let next = self.next.get_or_init(|| Box::new(OnceList::new()));"},{"DocComment":"             next.push(value)"},{"DocComment":"         };"},{"DocComment":"     }"},{"DocComment":"     fn contains(&self, example: &T) -> bool"},{"DocComment":"     where"},{"DocComment":"         T: PartialEq,"},{"DocComment":"     {"},{"DocComment":"         self.data.get().map(|item| item == example).filter(|v| *v).unwrap_or_else(|| {"},{"DocComment":"             self.next.get().map(|next| next.contains(example)).unwrap_or(false)"},{"DocComment":"         })"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Let's exercise this new Sync append-only list by doing a little counting"},{"DocComment":" static LIST: OnceList<u32> = OnceList::new();"},{"DocComment":" static COUNTER: AtomicU32 = AtomicU32::new(0);"},{"DocComment":""},{"DocComment":" # const LEN: u32 = if cfg!(miri) { 50 } else { 1000 };"},{"DocComment":" # /*"},{"DocComment":" const LEN: u32 = 1000;"},{"DocComment":" # */"},{"DocComment":" thread::scope(|s| {"},{"DocComment":"     for _ in 0..thread::available_parallelism().unwrap().get() {"},{"DocComment":"         s.spawn(|| {"},{"DocComment":"             while let i @ 0..LEN = COUNTER.fetch_add(1, Ordering::Relaxed) {"},{"DocComment":"                 LIST.push(i);"},{"DocComment":"             }"},{"DocComment":"         });"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" for i in 0..LEN {"},{"DocComment":"     assert!(LIST.contains(&i));"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":25,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["sync",0]},{"Ident":["atomic",0]},{"Ident":["private",0]},{"Ident":["Align8",0]}],"span":{"Untagged":{"data":{"file_id":34,"beg":{"line":270,"col":4},"end":{"line":270,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":26,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["boxed",0]},{"Ident":["Box",0]}],"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":236,"col":0},"end":{"line":239,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A pointer type that uniquely owns a heap allocation of type `T`."},{"DocComment":""},{"DocComment":" See the [module-level documentation](../../std/boxed/index.html) for more."},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"OwnedBox","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":{"Builtin":"Box"},"kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":27,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["PhantomData",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":811,"col":0},"end":{"line":811,"col":39}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Zero-sized type used to mark things that \"act like\" they own a `T`."},{"DocComment":""},{"DocComment":" Adding a `PhantomData<T>` field to your type tells the compiler that your"},{"DocComment":" type acts as though it stores a value of type `T`, even though it doesn't"},{"DocComment":" really. This information is used when computing certain safety properties."},{"DocComment":""},{"DocComment":" For a more in-depth explanation of how to use `PhantomData<T>`, please see"},{"DocComment":" [the Nomicon](../../nomicon/phantom-data.html)."},{"DocComment":""},{"DocComment":" # A ghastly note 👻👻👻"},{"DocComment":""},{"DocComment":" Though they both have scary names, `PhantomData` and 'phantom types' are"},{"DocComment":" related, but not identical. A phantom type parameter is simply a type"},{"DocComment":" parameter which is never used. In Rust, this often causes the compiler to"},{"DocComment":" complain, and the solution is to add a \"dummy\" use by way of `PhantomData`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## Unused lifetime parameters"},{"DocComment":""},{"DocComment":" Perhaps the most common use case for `PhantomData` is a struct that has an"},{"DocComment":" unused lifetime parameter, typically as part of some unsafe code. For"},{"DocComment":" example, here is a struct `Slice` that has two pointers of type `*const T`,"},{"DocComment":" presumably pointing into an array somewhere:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0392"},{"DocComment":" struct Slice<'a, T> {"},{"DocComment":"     start: *const T,"},{"DocComment":"     end: *const T,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The intention is that the underlying data is only valid for the"},{"DocComment":" lifetime `'a`, so `Slice` should not outlive `'a`. However, this"},{"DocComment":" intent is not expressed in the code, since there are no uses of"},{"DocComment":" the lifetime `'a` and hence it is not clear what data it applies"},{"DocComment":" to. We can correct this by telling the compiler to act *as if* the"},{"DocComment":" `Slice` struct contained a reference `&'a T`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":""},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" struct Slice<'a, T> {"},{"DocComment":"     start: *const T,"},{"DocComment":"     end: *const T,"},{"DocComment":"     phantom: PhantomData<&'a T>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This also in turn infers the lifetime bound `T: 'a`, indicating"},{"DocComment":" that any references in `T` are valid over the lifetime `'a`."},{"DocComment":""},{"DocComment":" When initializing a `Slice` you simply provide the value"},{"DocComment":" `PhantomData` for the field `phantom`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # use std::marker::PhantomData;"},{"DocComment":" # struct Slice<'a, T> {"},{"DocComment":" #     start: *const T,"},{"DocComment":" #     end: *const T,"},{"DocComment":" #     phantom: PhantomData<&'a T>,"},{"DocComment":" # }"},{"DocComment":" fn borrow_vec<T>(vec: &Vec<T>) -> Slice<'_, T> {"},{"DocComment":"     let ptr = vec.as_ptr();"},{"DocComment":"     Slice {"},{"DocComment":"         start: ptr,"},{"DocComment":"         end: unsafe { ptr.add(vec.len()) },"},{"DocComment":"         phantom: PhantomData,"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Unused type parameters"},{"DocComment":""},{"DocComment":" It sometimes happens that you have unused type parameters which"},{"DocComment":" indicate what type of data a struct is \"tied\" to, even though that"},{"DocComment":" data is not actually found in the struct itself. Here is an"},{"DocComment":" example where this arises with [FFI]. The foreign interface uses"},{"DocComment":" handles of type `*mut ()` to refer to Rust values of different"},{"DocComment":" types. We track the Rust type using a phantom type parameter on"},{"DocComment":" the struct `ExternalResource` which wraps a handle."},{"DocComment":""},{"DocComment":" [FFI]: ../../book/ch19-01-unsafe-rust.html#using-extern-functions-to-call-external-code"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # trait ResType { }"},{"DocComment":" # struct ParamType;"},{"DocComment":" # mod foreign_lib {"},{"DocComment":" #     pub fn new(_: usize) -> *mut () { 42 as *mut () }"},{"DocComment":" #     pub fn do_stuff(_: *mut (), _: usize) {}"},{"DocComment":" # }"},{"DocComment":" # fn convert_params(_: ParamType) -> usize { 42 }"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":""},{"DocComment":" struct ExternalResource<R> {"},{"DocComment":"    resource_handle: *mut (),"},{"DocComment":"    resource_type: PhantomData<R>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<R: ResType> ExternalResource<R> {"},{"DocComment":"     fn new() -> Self {"},{"DocComment":"         let size_of_res = size_of::<R>();"},{"DocComment":"         Self {"},{"DocComment":"             resource_handle: foreign_lib::new(size_of_res),"},{"DocComment":"             resource_type: PhantomData,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     fn do_stuff(&self, param: ParamType) {"},{"DocComment":"         let foreign_params = convert_params(param);"},{"DocComment":"         foreign_lib::do_stuff(self.resource_handle, foreign_params);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Ownership and the drop check"},{"DocComment":""},{"DocComment":" The exact interaction of `PhantomData` with drop check **may change in the future**."},{"DocComment":""},{"DocComment":" Currently, adding a field of type `PhantomData<T>` indicates that your type *owns* data of type"},{"DocComment":" `T` in very rare circumstances. This in turn has effects on the Rust compiler's [drop check]"},{"DocComment":" analysis. For the exact rules, see the [drop check] documentation."},{"DocComment":""},{"DocComment":" ## Layout"},{"DocComment":""},{"DocComment":" For all `T`, the following are guaranteed:"},{"DocComment":" * `size_of::<PhantomData<T>>() == 0`"},{"DocComment":" * `align_of::<PhantomData<T>>() == 1`"},{"DocComment":""},{"DocComment":" [drop check]: Drop#drop-check"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"PhantomData","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[]},"layout":[{"key":"x86_64-apple-darwin","value":{"size":{"chosen":{"Deduplicated":0},"guarantee":{"Deduplicated":43}},"align":{"chosen":{"Deduplicated":1},"guarantee":{"Deduplicated":44}},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},null,{"def_id":29,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["sketch",0]},{"Ident":["plan",0]},{"Ident":["DecodePlan",0]}],"span":{"Untagged":{"data":{"file_id":38,"beg":{