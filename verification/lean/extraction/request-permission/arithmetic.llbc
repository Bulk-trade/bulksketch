{"charon_version":"0.1.304","translated":{"crate_name":"bulksketch","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["bulksketch::sketch::state::_::shape","{impl bulksketch::sketch::input::RequestInput for bulksketch::sketch::api::DecodeRequest}::permits_id","{impl bulksketch::sketch::input::RequestInput for bulksketch::sketch::input::DecodeRowsRequest}::permits_id"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["bulksketch::sketch::state::_::shape","{impl bulksketch::sketch::input::RequestInput for bulksketch::sketch::api::DecodeRequest}::permits_id","{impl bulksketch::sketch::input::RequestInput for bulksketch::sketch::input::DecodeRowsRequest}::permits_id"],"opaque":["bulksketch::sketch::shape::_::permits_id","bulksketch::sketch::input::RequestInput"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["core::ops::deref::Deref","core::slice::index::SliceIndex"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/Users/junbug/bulk/bulksketch-proof-evidence-20261109-publication-readback/request-permits-checked/arithmetic.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":null},"target_information":[{"key":"x86_64-apple-darwin","value":{"arch":"X86_64","vendor":"apple","os":"MacOs","env":"Unspecified","cfg_abi":"Unspecified","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bulksketch","contents":"//! Native binary-syndrome reconciliation with bounded, deterministic GF64 decoding.\n#![deny(unsafe_code)]\n#![warn(missing_docs)]\n\nmod backend;\nmod decode;\nmod field;\nmod poly;\nmod sketch;\nmod types;\n\npub use {\n    field::{BinaryField, Gf64},\n    sketch::{\n        DecodeJob, DecodeLimits, DecodeOutcome, DecodePlan, DecodeReport, DecodeRequest, DecodeRow,\n        DecodeRowsRequest, DecodeScratch, Decoder, FrozenSketch, InsertScratch, MutableSketch,\n        ParseLimits, ScratchLayout, ShapeLimits, SketchShape, SketchView, decode_into,\n        decode_rows_into,\n    },\n    types::{\n        BackendError, BackendId, BackendRequest, CreateError, DecodeError, DecodeFailure,\n        EncodeError, FieldId, ParseError, ShapeError, ShapeMismatch, Stage, StageProgress,\n        UpdateError, WorkUnits,\n    },\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"src/sketch/state.rs"},"crate_name":"bulksketch","contents":"//! Copy-on-write algebra with immutable snapshots and generation-local encoding caches.\n#![forbid(unsafe_code)]\n\nuse {\n    super::{\n        dispatch::InsertDispatch,\n        scratch::InsertScratch,\n        shape::{ShapeLimits, SketchShape},\n        wire::{SketchView, encode},\n    },\n    crate::{\n        backend::detect,\n        field::BinaryField,\n        types::{\n            BackendError, BackendRequest, CreateError, EncodeError, ShapeError, ShapeMismatch,\n            UpdateError,\n        },\n    },\n    std::sync::{Arc, OnceLock},\n};\n\n#[derive(Debug)]\npub(crate) struct State<F: BinaryField> {\n    pub(crate) shape: Arc<SketchShape<F>>,\n    pub(crate) words: Vec<u64>,\n    pub(crate) zero_words: Vec<u64>,\n    pub(crate) encoded_v1: OnceLock<Arc<[u8]>>,\n}\n\nimpl<F: BinaryField> Clone for State<F> {\n    fn clone(&self) -> Self {\n        Self {\n            shape: Arc::clone(&self.shape),\n            words: self.words.clone(),\n            zero_words: self.zero_words.clone(),\n            encoded_v1: OnceLock::new(),\n        }\n    }\n}\n\n/// Parity sketch. Clones share immutable state until their first mutation.\n#[derive(Clone, Debug)]\npub struct MutableSketch<F: BinaryField> {\n    state: Arc<State<F>>,\n    insert_dispatch: InsertDispatch<F>,\n}\n\nimpl<F: BinaryField> MutableSketch<F> {\n    /// Allocate empty algebra for an already admitted shape and resolve insertion once.\n    ///\n    /// # Errors\n    /// The requested backend is unavailable or algebra storage cannot be reserved.\n    #[inline]\n    pub fn new(shape: Arc<SketchShape<F>>, backend: BackendRequest) -> Result<Self, CreateError> {\n        let insert_dispatch =\n            InsertDispatch::new(detect::resolve(backend).map_err(CreateError::Backend)?);\n        let allocate = |len| {\n            let mut words = Vec::new();\n            words\n                .try_reserve_exact(len)\n                .map_err(|_| CreateError::AllocationFailed)?;\n            words.resize(len, 0);\n            Ok::<_, CreateError>(words)\n        };\n        let words = allocate(shape.total_syndrome_words())?;\n        let zero_words = allocate(shape.bucket_count().div_ceil(64))?;\n        Ok(Self {\n            state: Arc::new(State {\n                shape,\n                words,\n                zero_words,\n                encoded_v1: OnceLock::new(),\n            }),\n            insert_dispatch,\n        })\n    }\n\n    /// Toggle one original ID, including zero. Two toggles cancel.\n    #[inline]\n    pub fn toggle(&mut self, id: u64) {\n        let operation = self.insert_dispatch.toggle;\n        let state = self.mutate();\n        operation(&state.shape, &mut state.words, &mut state.zero_words, id);\n    }\n\n    /// Partition this call's arrivals once and toggle each row in arrival order.\n    ///\n    /// # Errors\n    /// Insertion scratch is short; the sketch and cached encoding remain unchanged.\n    pub fn toggle_batch(\n        &mut self,\n        ids: &[u64],\n        scratch: &mut InsertScratch,\n    ) -> Result<(), UpdateError> {\n        if !scratch.covers(ids.len(), self.state.shape.bucket_count()) {\n            return Err(UpdateError::ScratchTooSmall);\n        }\n        let operation = self.insert_dispatch.batch;\n        let state = self.mutate();\n        operation(\n            &state.shape,\n            &mut state.words,\n            &mut state.zero_words,\n            ids,\n            scratch,\n        );\n        Ok(())\n    }\n\n    /// XOR algebra and zero membership from exactly the same shape.\n    ///\n    /// # Errors\n    /// A shape mismatch leaves the state and cached encoding unchanged.\n    pub fn xor_assign(&mut self, other: &FrozenSketch<F>) -> Result<(), ShapeMismatch> {\n        if self.state.shape != other.state.shape {\n            return Err(ShapeMismatch);\n        }\n        let operation = self.insert_dispatch.xor;\n        let state = self.mutate();\n        operation(&mut state.words, &other.state.words);\n        operation(&mut state.zero_words, &other.state.zero_words);\n        Ok(())\n    }\n\n    /// Snapshot the current generation in constant time.\n    #[must_use]\n    pub fn freeze(&self) -> FrozenSketch<F> {\n        FrozenSketch {\n            state: Arc::clone(&self.state),\n        }\n    }\n\n    fn mutate(&mut self) -> &mut State<F> {\n        let state = Arc::make_mut(&mut self.state);\n        // A populated cache can outlive every snapshot; unique ownership still needs invalidation.\n        state.encoded_v1.take();\n        state\n    }\n}\n\n/// Immutable, cheaply cloned state. Backend identity is deliberately absent.\n#[derive(Clone, Debug)]\npub struct FrozenSketch<F: BinaryField> {\n    pub(crate) state: Arc<State<F>>,\n}\n\nimpl<F: BinaryField> FrozenSketch<F> {\n    /// Share this immutable generation until the mutable handle first changes it.\n    ///\n    /// # Errors\n    /// The requested insertion backend is unavailable in this build or on this CPU/OS.\n    #[inline]\n    pub fn thaw(&self, backend: BackendRequest) -> Result<MutableSketch<F>, BackendError> {\n        Ok(MutableSketch {\n            state: Arc::clone(&self.state),\n            insert_dispatch: InsertDispatch::new(detect::resolve(backend)?),\n        })\n    }\n\n    /// Borrow this generation's cached canonical record.\n    ///\n    /// # Errors\n    /// Record storage cannot be reserved.\n    ///\n    /// # Panics\n    /// Only if the internally validated record size is inconsistent.\n    pub fn encoded_v1(&self) -> Result<&[u8], EncodeError> {\n        if let Some(bytes) = self.state.encoded_v1.get() {\n            return Ok(bytes);\n        }\n        let mut bytes = Vec::new();\n        let len = self.shape().wire_bytes();\n        bytes\n            .try_reserve_exact(len)\n            .map_err(|_| EncodeError::AllocationFailed)?;\n        bytes.resize(len, 0);\n        self.encode_into(&mut bytes)?;\n        // Concurrent readers may finish first; either canonical encoding is identical.\n        let _ = self.state.encoded_v1.set(Arc::from(bytes));\n        Ok(self.state.encoded_v1.get().expect(\"encoding initialized\"))\n    }\n\n    /// Write one complete canonical record; leave any destination suffix untouched.\n    ///\n    /// # Errors\n    /// A short destination is rejected before any write.\n    pub fn encode_into(&self, dst: &mut [u8]) -> Result<usize, EncodeError> {\n        encode::encode_into(self.shape(), &self.state.words, &self.state.zero_words, dst)\n    }\n\n    /// Allocate an owned immutable snapshot only after wire and shape admission.\n    /// Owned import of a parsed view; no arithmetic or decode runs here.\n    ///\n    /// # Errors\n    /// The supplied shape/storage limits are stricter than the parsed view's dimensions.\n    ///\n    /// # Panics\n    /// Only if the validated view violates its internal dimension/word invariants.\n    pub fn from_view(view: SketchView<'_, F>, limits: &ShapeLimits) -> Result<Self, ShapeError> {\n        // Check caller storage caps before allocating even the temporary descriptors.\n        if view.bucket_count() > limits.max_buckets\n            || view.as_bytes().len() > limits.max_wire_bytes\n            || view.total_syndrome_words() > limits.max_total_syndrome_words\n            || (0..view.bucket_count())\n                .any(|b| view.capacity(b).expect(\"validated row\") > limits.max_capacity_per_bucket)\n        {\n            return Err(ShapeError::InputLimitExceeded);\n        }\n        let capacities: Vec<_> = (0..view.bucket_count())\n            .map(|b| view.capacity(b).expect(\"validated row\"))\n            .collect();\n        let shape = Arc::new(SketchShape::new(&capacities, limits)?);\n        let words = view\n            .syndrome_bytes()\n            .chunks_exact(8)\n            .map(|w| u64::from_le_bytes(w.try_into().expect(\"validated GF64 word\")))\n            .collect();\n        let mut zero_words = vec![0; shape.bucket_count().div_ceil(64)];\n        zero_words[0] = u64::from(view.zero(0).expect(\"validated row zero\"));\n        let encoded_v1 = OnceLock::from(Arc::from(view.as_bytes()));\n        Ok(Self {\n            state: Arc::new(State {\n                shape,\n                words,\n                zero_words,\n                encoded_v1,\n            }),\n        })\n    }\n\n    /// Validated fixed identity/modulo layout.\n    #[must_use]\n    pub fn shape(&self) -> &SketchShape<F> {\n        &self.state.shape\n    }\n}\n"},{"id":6,"name":{"Local":"src/sketch/mod.rs"},"crate_name":"bulksketch","contents":"//! Request-level shape, wire, admission and ownership.\n#![forbid(unsafe_code)]\n\npub(crate) mod api;\nmod candidates;\npub(crate) mod contract;\nmod dispatch;\nmod input;\nmod job;\nmod plan;\npub(crate) mod scratch;\nmod shape;\nmod state;\nmod wire;\n\npub use {\n    api::{DecodeLimits, DecodeOutcome, DecodeReport, DecodeRequest},\n    dispatch::Decoder,\n    input::{DecodeRow, DecodeRowsRequest},\n    job::{DecodeJob, decode_into, decode_rows_into},\n    plan::DecodePlan,\n    scratch::{DecodeScratch, InsertScratch, ScratchLayout},\n    shape::{ShapeLimits, SketchShape},\n    state::{FrozenSketch, MutableSketch},\n    wire::{ParseLimits, SketchView},\n};\n\n#[cfg(test)]\nmod tests;\n\n#[cfg(test)]\nmod state_tests;\n\n#[cfg(test)]\nmod wire_tests;\n\n#[cfg(test)]\nmod decode_tests;\n\n#[cfg(test)]\nmod v1_plan_tests;\n\n#[cfg(test)]\nmod forced_dispatch_tests;\n\n#[cfg(test)]\nmod backend_work_tests;\n#[cfg(test)]\nmod forced_backend_tests;\n"},{"id":7,"name":{"Local":"src/field/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical field identity, arithmetic and test-only tiny fields.\n#![forbid(unsafe_code)]\n\nuse crate::types::FieldId;\n\n#[cfg(test)]\npub(crate) mod arithmetic_tests;\n#[cfg(test)]\nmod constant_tests;\n#[cfg(any(target_arch = \"x86_64\", test))]\npub(crate) mod frobenius;\npub(crate) mod gf64;\npub(crate) mod maps;\nmod quadratic_chunks;\n#[cfg(test)]\npub(crate) mod reference;\n#[cfg(test)]\npub(crate) mod tiny;\n\npub(crate) mod sealed {\n    pub trait Sealed {}\n}\n\n/// Closed field specification. Kernels consume canonical words, never masked IDs.\npub trait BinaryField: sealed::Sealed + Copy + Eq + Send + Sync + 'static {\n    /// Extension degree over GF(2).\n    const BITS: u32;\n    /// Irreducible polynomial without its leading term.\n    const MODULUS_LOW: u64;\n    /// Registered polynomial/basis identity.\n    const WIRE_ID: FieldId;\n    /// Canonical element mask.\n    const MASK: u64;\n}\n\n/// Full-width GF(2^64) identity field.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub struct Gf64;\nimpl sealed::Sealed for Gf64 {}\nimpl BinaryField for Gf64 {\n    const BITS: u32 = 64;\n    const MODULUS_LOW: u64 = 0x1b;\n    const WIRE_ID: FieldId = FieldId::Gf64;\n    const MASK: u64 = u64::MAX;\n}\n"},{"id":8,"name":{"Local":"src/sketch/input.rs"},"crate_name":"bulksketch","contents":"//! Borrowed independent rows share the ordinary staged request driver.\n#![forbid(unsafe_code)]\n\nuse {\n    super::{\n        api::{DecodeLimits, DecodeRequest},\n        candidates,\n        plan::DecodePlan,\n        shape::SketchShape,\n        state::{FrozenSketch, State},\n    },\n    crate::{field::BinaryField, types::DecodeError},\n    std::sync::Arc,\n};\n\n/// One independent, nonzero-only GF64 row. Payload words are little-endian and\n/// may be unaligned. No framing is copied or synthesized during decoding.\n#[derive(Clone, Copy, Debug)]\npub struct DecodeRow<'a, F: BinaryField> {\n    /// Immutable local sketch, which must have exactly one row.\n    pub local: &'a FrozenSketch<F>,\n    /// Exactly eight bytes per local odd syndrome; no zero-membership channel.\n    pub remote: &'a [u8],\n    /// Hints for this row only, before zero removal or deduplication.\n    pub candidates: &'a [u64],\n}\n\n/// One request over independently routed rows, in caller order. IDs are checked\n/// against each local one-row shape, rather than against the batch row count.\n/// A request error suppresses every result; an algebraic failure affects one row.\n#[derive(Clone, Copy, Debug)]\npub struct DecodeRowsRequest<'a, F: BinaryField> {\n    /// Nonempty borrowed rows. Each remote row has implicit zero membership false.\n    pub rows: &'a [DecodeRow<'a, F>],\n    /// Explicit algorithm and charge schedule, shared by all rows.\n    pub plan: &'a DecodePlan,\n    /// Aggregate request limits; the output budget still applies to each row.\n    pub limits: &'a DecodeLimits,\n}\n\n// The two entry points share one driver, specialized at compile time. A native\n// request must not carry a borrowed-row discriminator through every row/stage.\npub trait RequestInput<F: BinaryField> {\n    fn plan(&self) -> &DecodePlan;\n    fn limits(&self) -> &DecodeLimits;\n    fn bucket_count(&self) -> usize;\n    fn capacity(&self, bucket: usize) -> usize;\n    fn validate_shape(&self) -> Result<(), DecodeError>;\n    fn candidate_count(&self) -> Result<usize, DecodeError>;\n    fn zero(&self, bucket: usize) -> bool;\n    fn remaining_rows(\n        &self,\n        bucket: usize,\n        word_offset: usize,\n    ) -> impl Iterator<Item = (usize, InputRow<'_, F>)>;\n    fn normalize(&self, storage: &mut [u64]);\n    fn permits_id(&self, bucket: usize, id: u64) -> bool;\n    fn cached_shape(&self, beta: usize) -> Option<&Arc<SketchShape<F>>>;\n}\n\npub struct InputRow<'a, F: BinaryField> {\n    pub(super) local: &'a State<F>,\n    pub(super) word_offset: usize,\n    pub(super) remote: &'a [u8],\n    pub(super) zero: bool,\n}\n\nimpl<F: BinaryField> RequestInput<F> for DecodeRequest<'_, F> {\n    fn plan(&self) -> &DecodePlan {\n        self.plan\n    }\n    fn limits(&self) -> &DecodeLimits {\n        self.limits\n    }\n    fn bucket_count(&self) -> usize {\n        self.local.shape().bucket_count()\n    }\n    fn capacity(&self, bucket: usize) -> usize {\n        usize::from(self.local.shape().capacities()[bucket])\n    }\n    fn validate_shape(&self) -> Result<(), DecodeError> {\n        if self.local.shape().bucket_count() == self.remote.bucket_count()\n            && self\n                .local\n                .shape()\n                .capacities()\n                .iter()\n                .enumerate()\n                .all(|(b, &c)| Some(usize::from(c)) == self.remote.capacity(b))\n        {\n            Ok(())\n        } else {\n            Err(DecodeError::ShapeMismatch)\n        }\n    }\n    fn candidate_count(&self) -> Result<usize, DecodeError> {\n        Ok(self.candidates.len())\n    }\n    fn zero(&self, bucket: usize) -> bool {\n        bucket == 0\n            && (self.local.state.zero_words[0] & 1 != 0)\n                != self.remote.zero(0).expect(\"admitted row zero\")\n    }\n    #[inline(always)]\n    fn remaining_rows(\n        &self,\n        bucket: usize,\n        mut word_offset: usize,\n    ) -> impl Iterator<Item = (usize, InputRow<'_, F>)> {\n        let local = self.local.state.as_ref();\n        let remote = self.remote.syndrome_bytes();\n        let mut zero = bucket == 0 && self.zero(0);\n        local.shape.capacities()[bucket..]\n            .iter()\n            .map(move |&capacity| {\n                let capacity = usize::from(capacity);\n                let start = word_offset;\n                word_offset += capacity;\n                let row = InputRow {\n                    local,\n                    word_offset: start,\n                    remote: &remote[8 * start..8 * word_offset],\n                    zero,\n                };\n                zero = false;\n                (capacity, row)\n            })\n    }\n    fn normalize(&self, storage: &mut [u64]) {\n        candidates::normalize(self.local.shape(), self.candidates, storage);\n    }\n    fn permits_id(&self, bucket: usize, id: u64) -> bool {\n        self.local.shape().permits_id(bucket, id)\n    }\n    fn cached_shape(&self, _beta: usize) -> Option<&Arc<SketchShape<F>>> {\n        (!self.zero(0)).then_some(&self.local.state.shape)\n    }\n}\n\nimpl<F: BinaryField> RequestInput<F> for DecodeRowsRequest<'_, F> {\n    fn plan(&self) -> &DecodePlan {\n        self.plan\n    }\n    fn limits(&self) -> &DecodeLimits {\n        self.limits\n    }\n    fn bucket_count(&self) -> usize {\n        self.rows.len()\n    }\n    fn capacity(&self, bucket: usize) -> usize {\n        usize::from(self.rows[bucket].local.shape().capacities()[0])\n    }\n    fn validate_shape(&self) -> Result<(), DecodeError> {\n        if !self.rows.is_empty()\n            && self.rows.iter().all(|row| {\n                row.local.shape().bucket_count() == 1\n                    && row.remote.len() == 8 * row.local.shape().total_syndrome_words()\n            })\n        {\n            Ok(())\n        } else {\n            Err(DecodeError::ShapeMismatch)\n        }\n    }\n    fn candidate_count(&self) -> Result<usize, DecodeError> {\n        self.rows.iter().try_fold(0usize, |n, row| {\n            n.checked_add(row.candidates.len())\n                .ok_or(DecodeError::WorkLimitExceeded)\n        })\n    }\n    fn zero(&self, bucket: usize) -> bool {\n        self.rows[bucket].local.state.zero_words[0] & 1 != 0\n    }\n    #[inline(always)]\n    fn remaining_rows(\n        &self,\n        bucket: usize,\n        _word_offset: usize,\n    ) -> impl Iterator<Item = (usize, InputRow<'_, F>)> {\n        self.rows[bucket..].iter().map(|row| {\n            let local = row.local.state.as_ref();\n            (\n                usize::from(local.shape.capacities()[0]),\n                InputRow {\n                    local,\n                    word_offset: 0,\n                    remote: row.remote,\n                    zero: local.zero_words[0] & 1 != 0,\n                },\n            )\n        })\n    }\n    fn normalize(&self, storage: &mut [u64]) {\n        candidates::normalize_rows(self.rows, storage);\n    }\n    fn permits_id(&self, bucket: usize, id: u64) -> bool {\n        self.rows[bucket].local.shape().permits_id(0, id)\n    }\n    fn cached_shape(&self, beta: usize) -> Option<&Arc<SketchShape<F>>> {\n        (0..self.rows.len())\n            .all(|b| self.capacity(b) == beta && !self.zero(b))\n            .then_some(&self.rows[0].local.state.shape)\n    }\n}\n"},{"id":9,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"src/types.rs"},"crate_name":"bulksketch","contents":"//! Value-only definitions; this module has no dependency on the engine layers.\n#![forbid(unsafe_code)]\n\n/// Polynomial-basis identity, including the irreducible polynomial.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[repr(u8)]\npub enum FieldId {\n    /// GF(2^64), modulus Z^64 + Z^4 + Z^3 + Z + 1, bit i is Z^i.\n    Gf64 = 1,\n}\n\n/// Shape admission failure, before any row storage is allocated.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ShapeError {\n    /// Unsupported field, zero/non-power-of-two row count, or zero capacity.\n    InvalidShape,\n    /// Configured storage/dimension cap or representable wire dimension exceeded.\n    InputLimitExceeded,\n}\n\n/// Bounded wire admission failure. No view is exposed on either error.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ParseError {\n    /// A caller-supplied byte or dimension limit was exceeded.\n    InputLimitExceeded,\n    /// Unknown metadata, malformed lengths, or noncanonical payload.\n    InvalidEncoding,\n}\n\nimpl std::fmt::Display for ShapeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InvalidShape => \"invalid sketch shape\",\n            Self::InputLimitExceeded => \"shape input limit exceeded\",\n        })\n    }\n}\nimpl std::error::Error for ShapeError {}\n\nimpl std::fmt::Display for ParseError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InputLimitExceeded => \"wire input limit exceeded\",\n            Self::InvalidEncoding => \"invalid sketch encoding\",\n        })\n    }\n}\nimpl std::error::Error for ParseError {}\n\n/// Runtime arithmetic capability. No complete-operation dispatch lives in this type.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub enum BackendId {\n    /// Always-available safe Rust arithmetic.\n    Portable,\n    /// Scalar x86 carryless multiplication.\n    Pclmul,\n    /// 256-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul256,\n    /// 512-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul512,\n}\n\n/// Backend selection requested at engine construction, before any decode.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum BackendRequest {\n    /// Select from capabilities detected at runtime.\n    Auto,\n    /// Require this capability; never bypass feature/OS-state validation.\n    Force(BackendId),\n}\n\n/// An explicitly requested backend is unavailable in this build or on this CPU/OS.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct BackendError(pub BackendId);\n\n/// Construction of mutable state failed before any state was returned.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CreateError {\n    /// The requested arithmetic implementation is unavailable.\n    Backend(BackendError),\n    /// The algebraic buffers could not be reserved.\n    AllocationFailed,\n}\n\n/// Batch insertion failed before changing the sketch.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum UpdateError {\n    /// The supplied insertion arena cannot hold this call's IDs or row offsets.\n    ScratchTooSmall,\n}\n\n/// XOR requires identical fields, row counts and capacities.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ShapeMismatch;\n\n/// Encoding failed without changing the destination or algebraic state.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum EncodeError {\n    /// The destination cannot hold the complete record.\n    BufferTooSmall,\n    /// The cached record could not be reserved.\n    AllocationFailed,\n}\n\nimpl std::fmt::Display for CreateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            Self::Backend(error) => error.fmt(f),\n            Self::AllocationFailed => f.write_str(\"sketch allocation failed\"),\n        }\n    }\n}\nimpl std::error::Error for CreateError {}\nimpl std::fmt::Display for UpdateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"insertion scratch is too small\")\n    }\n}\nimpl std::error::Error for UpdateError {}\nimpl std::fmt::Display for ShapeMismatch {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"sketch shapes differ\")\n    }\n}\nimpl std::error::Error for ShapeMismatch {}\nimpl std::fmt::Display for EncodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::BufferTooSmall => \"encoding buffer is too small\",\n            Self::AllocationFailed => \"encoding allocation failed\",\n        })\n    }\n}\nimpl std::error::Error for EncodeError {}\n\nimpl std::fmt::Display for BackendError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        write!(f, \"backend {:?} is unavailable\", self.0)\n    }\n}\nimpl std::error::Error for BackendError {}\n\n/// Backend-independent logical work, never elapsed time or instruction count.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]\npub struct WorkUnits(pub u64);\n\n/// A request-wide failure publishes no row report or provisional IDs.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeError {\n    /// Local and remote fields, row counts or capacities differ.\n    ShapeMismatch,\n    /// Unknown plan or an output budget larger than any row capacity.\n    InvalidPlan,\n    /// Raw candidate count exceeds the request cap, before normalization.\n    CandidateLimitExceeded,\n    /// Work arithmetic overflows or the next charge exceeds the request limit.\n    WorkLimitExceeded,\n    /// Layout overflows, exceeds its byte cap, or any supplied segment is short.\n    ScratchTooSmall,\n}\n\n/// An admitted row failed algebraically; independently successful rows remain usable.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeFailure {\n    /// Zero consumes an unavailable slot, or locator/final output exceeds beta.\n    DegreeExceedsBudget,\n    /// The locator fails required canonicality/algebraic validation.\n    InvalidLocator,\n    /// The locator does not split into distinct permitted field roots.\n    NotSplit,\n    /// Re-encoding fails any stored odd syndrome or the zero channel.\n    VerificationFailed,\n}\n\nimpl std::fmt::Display for DecodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::ShapeMismatch => \"sketch shapes differ\",\n            Self::InvalidPlan => \"invalid decode plan or output budget\",\n            Self::CandidateLimitExceeded => \"candidate input limit exceeded\",\n            Self::WorkLimitExceeded => \"decode work limit exceeded\",\n            Self::ScratchTooSmall => \"decode scratch is too small\",\n        })\n    }\n}\nimpl std::error::Error for DecodeError {}\n\n/// Deterministic stage order. Repeated trace/GCD/division/leaf stages follow factor traversal.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Stage {\n    /// Propose the nonzero root S1 before general decoding.\n    DirectOne,\n    /// Derive a distinct nonzero pair from S1 and S3 before general decoding.\n    DirectTwo,\n    /// Reject inconsistent cubic prefixes before inversion (V3).\n    GuardThree,\n    /// Normalize a passed cubic Newton guard (V3).\n    NewtonThree,\n    /// Reject inconsistent quartic prefixes before inversion (V3).\n    GuardFour,\n    /// Normalize a passed quartic Newton guard (V3).\n    NewtonFour,\n    /// Propose the roots of a cubic factor (V3).\n    LeafThree,\n    /// Propose the roots of a quartic factor (V3).\n    LeafFour,\n    /// Certify a complete distinct nonzero factor root set (V3).\n    FactorVerification,\n    /// Expand odd syndromes and reconstruct even powers.\n    Reconstruction,\n    /// Binary Berlekamp-Massey iterations.\n    BerlekampMassey,\n    /// Evaluate the original locator at normalized hints.\n    CandidateEvaluation,\n    /// Divide out confirmed candidate roots.\n    Deflation,\n    /// Build a factor's modular-square table.\n    ReducerPreparation,\n    /// Find the least affine multiple and solve its binary map (V3).\n    AffinePreparation,\n    /// Enumerate and evaluate the recovered affine solution coset (V3).\n    AffineEnumeration,\n    /// Form an annihilator splitter for the current affine coset (V3).\n    AffineSplit,\n    /// Try the next canonical trace direction and the internal split check.\n    Trace,\n    /// Compute a monic polynomial GCD.\n    Gcd,\n    /// Divide a factor exactly after a proper split.\n    FactorDivision,\n    /// Solve degree-one or degree-two leaves.\n    Leaf,\n    /// Verify every stored odd syndrome by re-encoding or rebuilt recurrence.\n    Verification,\n    /// Sort and validate the final original IDs.\n    Canonicalization,\n}\n\n/// Public stage progress contains no row outcome or provisional ID.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum StageProgress {\n    /// A deterministic stage completed; counters are cumulative for the request.\n    Completed {\n        /// Bucket whose stage completed, in deterministic request traversal order.\n        bucket: usize,\n        /// Stage just executed.\n        stage: Stage,\n        /// Logical work consumed so far.\n        work: WorkUnits,\n        /// Peak required workspace bytes, excluding unused arena capacity.\n        peak_scratch_bytes: usize,\n        /// Original BM locator degree for this row; zero until BM completes.\n        locator_degree: usize,\n        /// Confirmed candidate roots so far in this row.\n        candidate_hits: usize,\n        /// Trace directions attempted so far in this row.\n        trace_attempts: usize,\n        /// Degree returned by this row's most recent GCD; zero before the first GCD.\n        gcd_degree: usize,\n    },\n    /// Terminal request failure; finishing the job must return this error.\n    Failed(DecodeError),\n}\n\n/// Internal arithmetic product, distinct from a canonical field element.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub(crate) struct RawProduct {\n    pub(crate) lo: u64,\n    pub(crate) hi: u64,\n}\n\n/// One request meter, shared by preprocessing and all rows. A failed charge is terminal.\n#[derive(Debug)]\npub(crate) struct WorkMeter {\n    limit: WorkUnits,\n    used: WorkUnits,\n    exhausted: bool,\n}\n\nimpl WorkMeter {\n    pub(crate) fn new(limit: WorkUnits) -> Self {\n        Self {\n            limit,\n            used: WorkUnits(0),\n            exhausted: false,\n        }\n    }\n\n    pub(crate) fn charge(&mut self, charge: WorkUnits) -> Result<(), DecodeError> {\n        let next = self.used.0.checked_add(charge.0);\n        if self.exhausted || next.is_none_or(|n| n > self.limit.0) {\n            self.exhausted = true;\n            return Err(DecodeError::WorkLimitExceeded);\n        }\n        self.used = WorkUnits(next.expect(\"checked work charge\"));\n        Ok(())\n    }\n\n    pub(crate) fn used(&self) -> WorkUnits {\n        self.used\n    }\n}\n\n#[cfg(test)]\npub(crate) mod small_degree_observer;\n"},{"id":16,"name":{"Local":"/rustc/library/alloc/src/sync.rs"},"crate_name":"alloc","contents":null},{"id":17,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":18,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":19,"name":{"Local":"src/sketch/shape.rs"},"crate_name":"bulksketch","contents":"//! Fixed identity/modulo mapping with checked storage admission.\n#![forbid(unsafe_code)]\n\nuse {\n    crate::{\n        field::BinaryField,\n        types::{FieldId, ShapeError},\n    },\n    std::marker::PhantomData,\n};\n\n/// Explicit allocation caps. There is deliberately no unbounded default.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ShapeLimits {\n    /// Maximum complete `CoreWireV1` record size, including framing.\n    pub max_wire_bytes: usize,\n    /// Maximum number of rows.\n    pub max_buckets: usize,\n    /// Maximum odd-syndrome words per row.\n    pub max_capacity_per_bucket: usize,\n    /// Maximum aggregate odd-syndrome words.\n    pub max_total_syndrome_words: usize,\n}\n\n/// Validated power-of-two GF64 row layout. All original u64 IDs are permitted.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct SketchShape<F: BinaryField> {\n    capacities: Box<[u16]>,\n    total_words: usize,\n    wire_bytes: usize,\n    field: PhantomData<F>,\n}\n\nimpl<F: BinaryField> SketchShape<F> {\n    /// Admit dimensions and storage before allocating the capacity descriptors.\n    ///\n    /// # Errors\n    /// Rejects invalid mapping dimensions or exceeded caller/wire limits.\n    ///\n    /// # Panics\n    /// Only if an internal capacity-admission invariant is broken.\n    pub fn new(capacities: &[usize], limits: &ShapeLimits) -> Result<Self, ShapeError> {\n        if F::BITS != 64 || F::WIRE_ID != FieldId::Gf64 || !capacities.len().is_power_of_two() {\n            return Err(ShapeError::InvalidShape);\n        }\n        if capacities.len() > limits.max_buckets || capacities.len() > usize::from(u16::MAX) {\n            return Err(ShapeError::InputLimitExceeded);\n        }\n        let mut total_words = 0usize;\n        for &capacity in capacities {\n            if capacity > limits.max_capacity_per_bucket || capacity > usize::from(u16::MAX) {\n                return Err(ShapeError::InputLimitExceeded);\n            }\n            total_words = total_words\n                .checked_add(capacity)\n                .ok_or(ShapeError::InputLimitExceeded)?;\n            if total_words > limits.max_total_syndrome_words {\n                return Err(ShapeError::InputLimitExceeded);\n            }\n        }\n        if capacities.contains(&0) {\n            return Err(ShapeError::InvalidShape);\n        }\n        let wire_bytes =\n            record_bytes(capacities.len(), total_words).ok_or(ShapeError::InputLimitExceeded)?;\n        if wire_bytes > limits.max_wire_bytes {\n            return Err(ShapeError::InputLimitExceeded);\n        }\n        Ok(Self {\n            capacities: capacities\n                .iter()\n                .map(|&c| u16::try_from(c).expect(\"admitted capacity\"))\n                .collect(),\n            total_words,\n            wire_bytes,\n            field: PhantomData,\n        })\n    }\n\n    /// Row capacities in bucket order.\n    #[must_use]\n    pub fn capacities(&self) -> &[u16] {\n        &self.capacities\n    }\n\n    /// Row count, including empty-membership rows.\n    #[must_use]\n    pub fn bucket_count(&self) -> usize {\n        self.capacities.len()\n    }\n\n    /// Aggregate number of stored odd syndromes.\n    #[must_use]\n    pub fn total_syndrome_words(&self) -> usize {\n        self.total_words\n    }\n\n    /// Exact complete `CoreWireV1` record length.\n    #[must_use]\n    pub fn wire_bytes(&self) -> usize {\n        self.wire_bytes\n    }\n\n    /// Total modulo routing; the field value is exactly `id`.\n    ///\n    /// # Panics\n    /// Only if the previously validated shape is internally inconsistent.\n    #[must_use]\n    pub fn bucket_for(&self, id: u64) -> usize {\n        usize::try_from(id % self.bucket_count() as u64).expect(\"remainder fits row count\")\n    }\n\n    /// Validate an original ID recovered from the given row. Zero belongs only to row 0.\n    #[must_use]\n    pub fn permits_id(&self, bucket: usize, id: u64) -> bool {\n        bucket < self.bucket_count() && self.bucket_for(id) == bucket\n    }\n}\n\npub(super) fn record_bytes(buckets: usize, words: usize) -> Option<usize> {\n    let descriptors = buckets.checked_mul(2)?;\n    let zero_bytes = buckets.checked_add(7)?.checked_div(8)?;\n    let payload = words.checked_mul(8)?.checked_add(zero_bytes)?;\n    u32::try_from(descriptors).ok()?;\n    u32::try_from(payload).ok()?;\n    24usize.checked_add(descriptors)?.checked_add(payload)\n}\n"},{"id":20,"name":{"Local":"src/sketch/api.rs"},"crate_name":"bulksketch","contents":"//! Shared request admission and transactional publication for the decode job.\n#![forbid(unsafe_code)]\n\nuse {\n    super::{\n        input::RequestInput,\n        plan::DecodePlan,\n        scratch::{DecodeScratch, ResultStorage, ScratchLayout},\n        state::FrozenSketch,\n        wire::SketchView,\n    },\n    crate::{\n        decode::work::{Charge, WorkScheduleV1},\n        field::BinaryField,\n        types::{DecodeError, DecodeFailure, WorkMeter, WorkUnits},\n    },\n};\n\n/// Request-wide resource caps; beta is also each row's total output budget, including zero.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct DecodeLimits {\n    /// Must be at most every row capacity.\n    pub max_output_per_bucket: usize,\n    /// Raw hints, before routing, removal of zero or deduplication.\n    pub max_candidate_inputs: usize,\n    /// One meter for preprocessing and all rows.\n    pub max_work: WorkUnits,\n    /// Required typed arena bytes, including all outcomes and results.\n    pub max_scratch_bytes: usize,\n}\n\n/// Explicit immutable reference and already parsed remote view. Hints never authorize output.\n#[derive(Clone, Copy, Debug)]\npub struct DecodeRequest<'a, F: BinaryField> {\n    /// Owned immutable local generation.\n    pub local: &'a FrozenSketch<F>,\n    /// Borrowed, fully admitted remote bytes.\n    pub remote: SketchView<'a, F>,\n    /// Original-ID hints, including possible repeats/zero.\n    pub candidates: &'a [u64],\n    /// Explicit versioned algorithm and charge schedule.\n    pub plan: &'a DecodePlan,\n    /// Request and row budget caps.\n    pub limits: &'a DecodeLimits,\n}\n\n/// A completed row. Failure never denotes empty membership.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeOutcome<'a> {\n    /// The complete difference representation, including zero, was zero.\n    Equal,\n    /// Nonempty, strictly ascending original IDs, all fully verified.\n    Decoded {\n        /// Borrowed result storage; reuse requires dropping the report.\n        ids: &'a [u64],\n    },\n    /// No provisional IDs escape this row.\n    Failed {\n        /// Algebraic failure within a request that completed successfully.\n        reason: DecodeFailure,\n    },\n}\n\n/// Atomic request result, borrowing preallocated output storage in bucket order.\n#[derive(Debug)]\npub struct DecodeReport<'s> {\n    outcomes: &'s [StoredOutcome],\n    ids: &'s [u64],\n    /// Deterministic request-wide logical work.\n    pub work: WorkUnits,\n    /// Peak required arena size; unused reusable capacity is excluded.\n    pub peak_scratch_bytes: usize,\n}\n\nimpl DecodeReport<'_> {\n    #[cfg(test)]\n    pub(super) fn result_offsets(&self) -> Vec<(u64, u64)> {\n        self.outcomes\n            .iter()\n            .map(|row| (row.start, row.len))\n            .collect()\n    }\n\n    /// Number of admitted rows, including failed and equal rows.\n    #[must_use]\n    pub fn bucket_count(&self) -> usize {\n        self.outcomes.len()\n    }\n\n    /// Read a completed row by bucket index.\n    ///\n    /// # Panics\n    /// Only if internal publication invariants admit an unfinished or invalid row.\n    #[must_use]\n    #[inline(always)]\n    pub fn outcome(&self, bucket: usize) -> Option<DecodeOutcome<'_>> {\n        let row = self.outcomes.get(bucket)?;\n        Some(match row.status {\n            OutcomeStatus::Unset => panic!(\"unpublished row in a finished report\"),\n            OutcomeStatus::Equal => DecodeOutcome::Equal,\n            OutcomeStatus::Decoded => {\n                let start = usize::try_from(row.start).expect(\"admitted result offset\");\n                let len = usize::try_from(row.len).expect(\"admitted result length\");\n                DecodeOutcome::Decoded {\n                    ids: &self.ids[start..start + len],\n                }\n            }\n            OutcomeStatus::DegreeExceedsBudget => DecodeOutcome::Failed {\n                reason: DecodeFailure::DegreeExceedsBudget,\n            },\n            OutcomeStatus::InvalidLocator => DecodeOutcome::Failed {\n                reason: DecodeFailure::InvalidLocator,\n            },\n            OutcomeStatus::NotSplit => DecodeOutcome::Failed {\n                reason: DecodeFailure::NotSplit,\n            },\n            OutcomeStatus::VerificationFailed => DecodeOutcome::Failed {\n                reason: DecodeFailure::VerificationFailed,\n            },\n        })\n    }\n}\n\n// Fixed-width metadata keeps scratch admission independent of pointer width/backend.\n#[derive(Clone, Copy, Debug, Default)]\n#[repr(u64)]\npub(crate) enum OutcomeStatus {\n    #[default]\n    Unset,\n    Equal,\n    Decoded,\n    DegreeExceedsBudget,\n    InvalidLocator,\n    NotSplit,\n    VerificationFailed,\n}\n\n#[derive(Clone, Copy, Debug, Default)]\n#[repr(C)]\npub(crate) struct StoredOutcome {\n    status: OutcomeStatus,\n    start: u64,\n    len: u64,\n}\n\n#[derive(Debug)]\npub(crate) struct AdmittedRequest {\n    pub(crate) layout: ScratchLayout,\n    pub(crate) meter: WorkMeter,\n    pub(crate) zero_failures: usize,\n}\n\n/// Strict error precedence: shape, plan, candidates, work, then scratch. Preflight is bounded and allocation-free. Recomputing row\n/// budgets avoids needing a temporary vector before scratch admission, including a short outcome segment.\npub(super) fn admit_request<F: BinaryField>(\n    request: &impl RequestInput<F>,\n    scratch: &DecodeScratch<F>,\n) -> Result<AdmittedRequest, DecodeError> {\n    request.validate_shape()?;\n    let beta = request.limits().max_output_per_bucket;\n    if !request.plan().is_supported()\n        || (0..request.bucket_count()).any(|b| beta > request.capacity(b))\n    {\n        return Err(DecodeError::InvalidPlan);\n    }\n    let rows = || {\n        (0..request.bucket_count()).map(|b| {\n            (\n                request.capacity(b),\n                beta.checked_sub(usize::from(request.zero(b))),\n            )\n        })\n    };\n    let zero_failures = if beta == 0 {\n        (0..request.bucket_count())\n            .filter(|&b| request.zero(b))\n            .count()\n    } else {\n        0\n    };\n    let candidates = request.candidate_count()?;\n    if candidates > request.limits().max_candidate_inputs {\n        return Err(DecodeError::CandidateLimitExceeded);\n    }\n    let cached_shape = request.cached_shape(beta);\n    if request.plan().has_probes()\n        && candidates == 0\n        && beta == request.capacity(0)\n        && let Some(shape) = cached_shape\n        && let Some(layout) = scratch.no_hint_layout(shape, request.bucket_count(), *request.plan())\n    {\n        let mut meter = WorkMeter::new(request.limits().max_work);\n        meter.charge(WorkScheduleV1::cost(Charge::Admission {\n            rows: request.bucket_count(),\n        })?)?;\n        if layout.total_bytes() > request.limits().max_scratch_bytes || !scratch.covers(layout) {\n            return Err(DecodeError::ScratchTooSmall);\n        }\n        return Ok(AdmittedRequest {\n            layout: layout.clone(),\n            meter,\n            zero_failures,\n        });\n    }\n    // Complete-bound overflow is rejected before work and scratch admission.\n    request.plan().work_bound(rows(), beta, candidates)?;\n    let mut meter = WorkMeter::new(request.limits().max_work);\n    meter.charge(WorkScheduleV1::cost(Charge::Admission {\n        rows: request.bucket_count(),\n    })?)?;\n    let layout = ScratchLayout::from_rows(rows(), beta, candidates)?;\n    if layout.total_bytes() > request.limits().max_scratch_bytes || !scratch.covers(&layout) {\n        return Err(DecodeError::ScratchTooSmall);\n    }\n    Ok(AdmittedRequest {\n        layout,\n        meter,\n        zero_failures,\n    })\n}\n\n#[cfg(test)]\npub(super) fn admit<F: BinaryField>(\n    request: &DecodeRequest<'_, F>,\n    scratch: &DecodeScratch<F>,\n) -> Result<AdmittedRequest, DecodeError> {\n    admit_request(request, scratch)\n}\n\n/// Only finish publishes. The job retains the disjoint workspace borrow, while\n/// this result borrow transfers to the report and prevents premature arena reuse.\npub(crate) struct Publication<'s> {\n    results: ResultStorage<'s>,\n    rows: usize,\n    written: usize,\n    used_ids: usize,\n    id_capacity: usize,\n    failure: Option<DecodeError>,\n}\n\nimpl<'s> Publication<'s> {\n    #[inline(always)]\n    pub(crate) fn new(results: ResultStorage<'s>, layout: &ScratchLayout) -> Self {\n        assert!(\n            results.ids.len() >= layout.result_ids && results.outcomes.len() >= layout.outcomes,\n            \"publication requires admitted results\"\n        );\n        results.outcomes[..layout.outcomes].fill(StoredOutcome::default());\n        Self {\n            results,\n            rows: layout.outcomes,\n            written: 0,\n            used_ids: 0,\n            id_capacity: layout.result_ids,\n            failure: None,\n        }\n    }\n\n    /// Decoded IDs are verified nonzero roots; prepend original-ID zero when present.\n    /// The returned row slice may occupy any workspace segment and is copied before reuse.\n    #[inline(always)]\n    pub(crate) fn write(&mut self, bucket: usize, outcome: DecodeOutcome<'_>, zero: bool) {\n        assert!(self.failure.is_none(), \"cannot write after request failure\");\n        assert!(\n            bucket == self.written && bucket < self.rows,\n            \"rows must complete in bucket order\"\n        );\n        let mut start = 0;\n        let mut len = 0;\n        let status = match outcome {\n            DecodeOutcome::Equal => OutcomeStatus::Equal,\n            DecodeOutcome::Failed { reason } => match reason {\n                DecodeFailure::DegreeExceedsBudget => OutcomeStatus::DegreeExceedsBudget,\n                DecodeFailure::InvalidLocator => OutcomeStatus::InvalidLocator,\n                DecodeFailure::NotSplit => OutcomeStatus::NotSplit,\n                DecodeFailure::VerificationFailed => OutcomeStatus::VerificationFailed,\n            },\n            DecodeOutcome::Decoded { ids } => {\n                assert!(\n                    (!ids.is_empty() || zero)\n                        && ids.first() != Some(&0)\n                        && ids.windows(2).all(|w| w[0] < w[1]),\n                    \"decoded roots must be nonzero and strictly ascending; output must be nonempty\"\n                );\n                let prefix = usize::from(zero);\n                let end = self\n                    .used_ids\n                    .checked_add(prefix)\n                    .and_then(|start| start.checked_add(ids.len()))\n                    .expect(\"admitted result offsets\");\n                assert!(end <= self.id_capacity, \"admitted result storage exhausted\");\n                if zero {\n                    self.results.ids[self.used_ids] = 0;\n                }\n                let destination = &mut self.results.ids[self.used_ids + prefix..end];\n                match ids {\n                    [id] => destination[0] = *id,\n                    [first, second] => {\n                        destination[0] = *first;\n                        destination[1] = *second;\n                    }\n                    _ => destination.copy_from_slice(ids),\n                }\n                start = u64::try_from(self.used_ids).expect(\"result offset fits u64\");\n                len = u64::try_from(end - self.used_ids).expect(\"result length fits u64\");\n                self.used_ids = end;\n                OutcomeStatus::Decoded\n            }\n        };\n        self.results.outcomes[bucket] = StoredOutcome { status, start, len };\n        self.written += 1;\n    }\n\n    pub(crate) fn fail(&mut self, error: DecodeError) {\n        if self.failure.is_none() {\n            self.failure = Some(error);\n        }\n    }\n\n    #[inline(always)]\n    pub(crate) fn finish(\n        self,\n        work: WorkUnits,\n        peak: usize,\n    ) -> Result<DecodeReport<'s>, DecodeError> {\n        if let Some(error) = self.failure {\n            return Err(error);\n        }\n        assert_eq!(\n            self.written, self.rows,\n            \"finish requires every row to complete\"\n        );\n        Ok(DecodeReport {\n            outcomes: &self.results.outcomes[..self.rows],\n            ids: &self.results.ids[..self.used_ids],\n            work,\n            peak_scratch_bytes: peak,\n        })\n    }\n}\n"},{"id":21,"name":{"Local":"/rustc/library/core/src/iter/adapters/map.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/core/src/iter/adapters/mod.rs"},"crate_name":"core","contents":null},{"id":24,"name":{"Local":"/rustc/library/core/src/slice/iter.rs"},"crate_name":"core","contents":null},{"id":25,"name":{"Local":"/rustc/library/core/src/iter/traits/mod.rs"},"crate_name":"core","contents":null},{"id":26,"name":{"Local":"/rustc/library/core/src/iter/traits/iterator.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"/rustc/library/core/src/slice/iter/macros.rs"},"crate_name":"core","contents":null},{"id":28,"name":{"Local":"/rustc/library/core/src/ops/function.rs"},"crate_name":"core","contents":null},{"id":29,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":30,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":31,"name":{"Local":"/rustc/library/std/src/sync/once_lock.rs"},"crate_name":"std","contents":null},{"id":32,"name":{"Local":"/rustc/library/std/src/lib.rs"},"crate_name":"std","contents":null},{"id":33,"name":{"Local":"/rustc/library/std/src/sync/mod.rs"},"crate_name":"std","contents":null},{"id":34,"name":{"Local":"/rustc/library/core/src/sync/atomic.rs"},"crate_name":"core","contents":null},{"id":35,"name":{"Local":"/rustc/library/core/src/sync/mod.rs"},"crate_name":"core","contents":null},{"id":36,"name":{"Local":"/rustc/library/alloc/src/boxed.rs"},"crate_name":"alloc","contents":null},{"id":37,"name":{"Local":"/rustc/library/core/src/ops/deref.rs"},"crate_name":"core","contents":null},{"id":38,"name":{"Local":"src/sketch/plan.rs"},"crate_name":"bulksketch","contents":"//! Request bounds consume checked row dimensions, never lower-layer shape imports.\n#![forbid(unsafe_code)]\n\nuse {\n    super::scratch::ScratchLayout,\n    crate::{\n        decode::work::{Charge, WorkScheduleV1, WorkScheduleV2, WorkScheduleV3, add},\n        types::{DecodeError, WorkUnits},\n    },\n};\n\n/// An explicitly selected algorithm and logical charging policy, with no stage tuning.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct DecodePlan {\n    pub(super) version: u8,\n}\n\nimpl DecodePlan {\n    /// Select direct tiny-difference probes with full verification and general fallback.\n    #[must_use]\n    pub const fn v2() -> Self {\n        Self { version: 2 }\n    }\n\n    /// Select the proposed affine-root and rebuilt-LFSR logical schedule.\n    #[must_use]\n    pub const fn v3() -> Self {\n        Self { version: 3 }\n    }\n\n    /// Retain the general-only schedule as a test oracle.\n    #[cfg(test)]\n    #[must_use]\n    pub(crate) const fn v1() -> Self {\n        Self { version: 1 }\n    }\n\n    /// Conservative work and complete scratch bounds after checked zero subtraction.\n    /// `None` means zero subtraction underflowed for that row: metadata only.\n    /// `beta` includes zero; every `Some(r)` must be beta or beta-1 and at most c.\n    /// Candidate count is raw, before routing/deduplication.\n    ///\n    /// # Errors\n    /// Invalid dimensions/budgets, work arithmetic overflow, or layout overflow.\n    #[inline]\n    pub fn complete_bound(\n        &self,\n        capacities: &[u16],\n        row_budgets: &[Option<usize>],\n        beta: usize,\n        candidate_count: usize,\n    ) -> Result<(WorkUnits, ScratchLayout), DecodeError> {\n        self.validate(capacities, row_budgets, beta)?;\n        let rows = capacities\n            .iter()\n            .zip(row_budgets)\n            .map(|(&c, &r)| (usize::from(c), r));\n        let work = self.work_bound(rows.clone(), beta, candidate_count)?;\n        let layout = ScratchLayout::from_rows(rows, beta, candidate_count)?;\n        Ok((work, layout))\n    }\n\n    pub(super) fn validate(\n        self,\n        capacities: &[u16],\n        budgets: &[Option<usize>],\n        beta: usize,\n    ) -> Result<(), DecodeError> {\n        if !self.is_supported()\n            || capacities.is_empty()\n            || capacities.len() != budgets.len()\n            || capacities.iter().zip(budgets).any(|(&c, &r)| {\n                c == 0\n                    || beta > usize::from(c)\n                    || r.is_some_and(|r| r > beta || beta - r > 1)\n                    || (r.is_none() && beta != 0)\n            })\n        {\n            return Err(DecodeError::InvalidPlan);\n        }\n        Ok(())\n    }\n\n    pub(super) fn is_supported(self) -> bool {\n        self.version == 3 || self.version == 2 || (cfg!(test) && self.version == 1)\n    }\n\n    pub(super) fn is_v2(self) -> bool {\n        self.version == 2\n    }\n\n    pub(super) fn is_v3(self) -> bool {\n        self.version == 3\n    }\n    pub(super) fn has_probes(self) -> bool {\n        self.version >= 2\n    }\n\n    pub(super) fn work_bound(\n        self,\n        rows: impl ExactSizeIterator<Item = (usize, Option<usize>)>,\n        beta: usize,\n        candidates: usize,\n    ) -> Result<WorkUnits, DecodeError> {\n        let mut total = WorkScheduleV1::cost(Charge::Admission { rows: rows.len() })?.0;\n        total = add(\n            total,\n            WorkScheduleV1::cost(Charge::Normalize { inputs: candidates })?.0,\n        )?;\n        let mut previous = None;\n        for (capacity, budget) in rows {\n            if let Some(budget) = budget {\n                let bound = match previous {\n                    Some((c, r, bound)) if c == capacity && r == budget => bound,\n                    _ => {\n                        let bound = if self.is_v3() {\n                            WorkScheduleV3::row_bound(capacity, budget, beta, candidates)?\n                        } else if self.is_v2() {\n                            WorkScheduleV2::row_bound(capacity, budget, beta, candidates)?\n                        } else {\n                            WorkScheduleV1::row_bound(capacity, budget, beta, candidates)?\n                        };\n                        previous = Some((capacity, budget, bound));\n                        bound\n                    }\n                };\n                total = add(total, bound.0)?;\n            }\n        }\n        Ok(WorkUnits(total))\n    }\n}\n"},{"id":39,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":40,"name":{"Local":"src/sketch/wire/mod.rs"},"crate_name":"bulksketch","contents":"//! Experimental `CoreWireV1`: SKNC, version/field/identity = 1/1/1.\n#![forbid(unsafe_code)]\n\npub(crate) mod encode;\n\nuse {\n    crate::{\n        field::BinaryField,\n        types::{FieldId, ParseError},\n    },\n    std::marker::PhantomData,\n};\n\n/// Explicit untrusted-input caps; no unbounded default is provided.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ParseLimits {\n    /// Maximum complete input slice size.\n    pub max_wire_bytes: usize,\n    /// Maximum row count.\n    pub max_buckets: usize,\n    /// Maximum capacity in any row.\n    pub max_capacity_per_bucket: usize,\n    /// Maximum sum of row capacities.\n    pub max_total_syndrome_words: usize,\n}\n\n/// Borrowed, completely validated GF64 identity representation. Parsing never allocates.\n#[derive(Clone, Copy, Debug)]\npub struct SketchView<'a, F: BinaryField> {\n    bytes: &'a [u8],\n    buckets: usize,\n    words: usize,\n    payload_start: usize,\n    field: PhantomData<F>,\n}\n\nimpl<'a, F: BinaryField> SketchView<'a, F> {\n    /// Validate bytes, fixed metadata/framing, dimension caps, then payload canonicality.\n    ///\n    /// # Errors\n    /// Returns `InputLimitExceeded` or `InvalidEncoding` in a fixed order: size limit, then framing, then dimension caps, then payload canonicality.\n    pub fn parse(bytes: &'a [u8], limits: &ParseLimits) -> Result<Self, ParseError> {\n        use ParseError::{InputLimitExceeded, InvalidEncoding};\n        if bytes.len() > limits.max_wire_bytes {\n            return Err(InputLimitExceeded);\n        }\n        if bytes.len() < 24\n            || &bytes[..4] != b\"SKNC\"\n            || bytes[4] != 1\n            || bytes[5] != FieldId::Gf64 as u8\n            || bytes[6] != 1\n            || bytes[7] != 0\n            || bytes[10..12] != [0; 2]\n            || bytes[20..24] != [0; 4]\n            || F::BITS != 64\n            || F::WIRE_ID != FieldId::Gf64\n        {\n            return Err(InvalidEncoding);\n        }\n        let buckets = usize::from(u16::from_le_bytes([bytes[8], bytes[9]]));\n        if !buckets.is_power_of_two() {\n            return Err(InvalidEncoding);\n        }\n        let descriptor_len = read_u32(bytes, 12)?;\n        let payload_len = read_u32(bytes, 16)?;\n        let payload_start = 24usize.checked_add(descriptor_len).ok_or(InvalidEncoding)?;\n        if descriptor_len != buckets.checked_mul(2).ok_or(InvalidEncoding)?\n            || payload_start.checked_add(payload_len) != Some(bytes.len())\n        {\n            return Err(InvalidEncoding);\n        }\n        if buckets > limits.max_buckets {\n            return Err(InputLimitExceeded);\n        }\n        let mut words = 0usize;\n        for descriptor in bytes[24..payload_start].chunks_exact(2) {\n            let capacity = usize::from(u16::from_le_bytes([descriptor[0], descriptor[1]]));\n            if capacity > limits.max_capacity_per_bucket {\n                return Err(InputLimitExceeded);\n            }\n            words = words.checked_add(capacity).ok_or(InvalidEncoding)?;\n            if words > limits.max_total_syndrome_words {\n                return Err(InputLimitExceeded);\n            }\n        }\n        let zero_bytes = buckets.checked_add(7).ok_or(InvalidEncoding)? / 8;\n        if words.checked_mul(8).and_then(|n| n.checked_add(zero_bytes)) != Some(payload_len)\n            || bytes[24..payload_start]\n                .chunks_exact(2)\n                .any(|c| c == [0, 0])\n        {\n            return Err(InvalidEncoding);\n        }\n        let zero = &bytes[payload_start..payload_start + zero_bytes];\n        if zero[0] & !1 != 0 || zero[1..].iter().any(|&b| b != 0) {\n            return Err(InvalidEncoding);\n        }\n        Ok(Self {\n            bytes,\n            buckets,\n            words,\n            payload_start,\n            field: PhantomData,\n        })\n    }\n\n    /// Original canonical encoding.\n    #[must_use]\n    pub fn as_bytes(&self) -> &'a [u8] {\n        self.bytes\n    }\n\n    pub(crate) fn syndrome_bytes(&self) -> &'a [u8] {\n        &self.bytes[self.payload_start + self.buckets.div_ceil(8)..]\n    }\n\n    /// Number of rows.\n    #[must_use]\n    pub fn bucket_count(&self) -> usize {\n        self.buckets\n    }\n\n    /// Aggregate odd-syndrome count.\n    #[must_use]\n    pub fn total_syndrome_words(&self) -> usize {\n        self.words\n    }\n\n    /// Capacity of a row, or `None` outside the admitted shape.\n    #[must_use]\n    pub fn capacity(&self, bucket: usize) -> Option<usize> {\n        if bucket >= self.buckets {\n            return None;\n        }\n        let offset = 24 + 2 * bucket;\n        Some(usize::from(u16::from_le_bytes([\n            self.bytes[offset],\n            self.bytes[offset + 1],\n        ])))\n    }\n\n    /// Zero membership; only row zero can carry it.\n    #[must_use]\n    pub fn zero(&self, bucket: usize) -> Option<bool> {\n        (bucket < self.buckets).then(|| bucket == 0 && self.bytes[self.payload_start] & 1 != 0)\n    }\n\n    /// Read a canonical odd-syndrome word without assuming byte alignment.\n    ///\n    /// # Panics\n    /// Only if parser-admitted offsets or dimensions are internally inconsistent.\n    /// Out-of-range indices return `None`.\n    #[must_use]\n    pub fn odd_syndrome(&self, bucket: usize, index: usize) -> Option<u64> {\n        if index >= self.capacity(bucket)? {\n            return None;\n        }\n        let prior: usize = (0..bucket)\n            .map(|b| self.capacity(b).expect(\"admitted row\"))\n            .sum();\n        let offset = self.payload_start + self.buckets.div_ceil(8) + 8 * (prior + index);\n        Some(u64::from_le_bytes(\n            self.bytes[offset..offset + 8]\n                .try_into()\n                .expect(\"admitted word\"),\n        ))\n    }\n}\n\nfn read_u32(bytes: &[u8], offset: usize) -> Result<usize, ParseError> {\n    usize::try_from(u32::from_le_bytes(\n        bytes[offset..offset + 4].try_into().expect(\"fixed header\"),\n    ))\n    .map_err(|_| ParseError::InvalidEncoding)\n}\n"},{"id":41,"name":{"Local":"/rustc/library/core/src/convert/num.rs"},"crate_name":"core","contents":null},{"id":42,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":43,"name":{"Local":"/rustc/library/core/src/iter/adapters/enumerate.rs"},"crate_name":"core","contents":null},{"id":44,"name":{"Local":"/rustc/library/core/src/array/iter.rs"},"crate_name":"core","contents":null},{"id":45,"name":{"Local":"/rustc/library/core/src/num/nonzero.rs"},"crate_name":"core","contents":null},{"id":46,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":47,"name":{"Local":"/rustc/library/core/src/iter/adapters/step_by.rs"},"crate_name":"core","contents":null},{"id":48,"name":{"Local":"/rustc/library/core/src/iter/traits/collect.rs"},"crate_name":"core","contents":null},{"id":49,"name":{"Local":"/rustc/library/core/src/iter/adapters/chain.rs"},"crate_name":"core","contents":null},{"id":50,"name":{"Local":"/rustc/library/core/src/iter/adapters/zip.rs"},"crate_name":"core","contents":null},{"id":51,"name":{"Local":"/rustc/library/core/src/iter/adapters/intersperse.rs"},"crate_name":"core","contents":null},{"id":52,"name":{"Local":"/rustc/library/core/src/iter/adapters/filter.rs"},"crate_name":"core","contents":null},{"id":53,"name":{"Local":"/rustc/library/core/src/iter/adapters/filter_map.rs"},"crate_name":"core","contents":null},{"id":54,"name":{"Local":"/rustc/library/core/src/iter/adapters/peekable.rs"},"crate_name":"core","contents":null},{"id":55,"name":{"Local":"/rustc/library/core/src/iter/adapters/skip_while.rs"},"crate_name":"core","contents":null},{"id":56,"name":{"Local":"/rustc/library/core/src/iter/adapters/take_while.rs"},"crate_name":"core","contents":null},{"id":57,"name":{"Local":"/rustc/library/core/src/iter/adapters/map_while.rs"},"crate_name":"core","contents":null},{"id":58,"name":{"Local":"/rustc/library/core/src/iter/adapters/skip.rs"},"crate_name":"core","contents":null},{"id":59,"name":{"Local":"/rustc/library/core/src/iter/adapters/take.rs"},"crate_name":"core","contents":null},{"id":60,"name":{"Local":"/rustc/library/core/src/iter/adapters/scan.rs"},"crate_name":"core","contents":null},{"id":61,"name":{"Local":"/rustc/library/core/src/iter/adapters/flatten.rs"},"crate_name":"core","contents":null},{"id":62,"name":{"Local":"/rustc/library/core/src/iter/adapters/map_windows.rs"},"crate_name":"core","contents":null},{"id":63,"name":{"Local":"/rustc/library/core/src/iter/adapters/fuse.rs"},"crate_name":"core","contents":null},{"id":64,"name":{"Local":"/rustc/library/core/src/iter/adapters/inspect.rs"},"crate_name":"core","contents":null},{"id":65,"name":{"Local":"/rustc/library/core/src/ops/try_trait.rs"},"crate_name":"core","contents":null},{"id":66,"name":{"Local":"/rustc/library/core/src/default.rs"},"crate_name":"core","contents":null},{"id":67,"name":{"Local":"/rustc/library/core/src/iter/traits/double_ended.rs"},"crate_name":"core","contents":null},{"id":68,"name":{"Local":"/rustc/library/core/src/iter/traits/exact_size.rs"},"crate_name":"core","contents":null},{"id":69,"name":{"Local":"/rustc/library/core/src/iter/adapters/rev.rs"},"crate_name":"core","contents":null},{"id":70,"name":{"Local":"/rustc/library/core/src/iter/adapters/copied.rs"},"crate_name":"core","contents":null},{"id":71,"name":{"Local":"/rustc/library/core/src/iter/adapters/cloned.rs"},"crate_name":"core","contents":null},{"id":72,"name":{"Local":"/rustc/library/core/src/iter/adapters/cycle.rs"},"crate_name":"core","contents":null},{"id":73,"name":{"Local":"/rustc/library/core/src/iter/adapters/array_chunks.rs"},"crate_name":"core","contents":null},{"id":74,"name":{"Local":"/rustc/library/core/src/iter/traits/accum.rs"},"crate_name":"core","contents":null},{"id":75,"name":{"Local":"src/sketch/candidates.rs"},"crate_name":"bulksketch","contents":"//! Bounded, allocation-free normalization into row-major nonzero identity hints.\n#![forbid(unsafe_code)]\n\nuse {super::shape::SketchShape, crate::field::BinaryField};\n\npub(super) fn normalize<F: BinaryField>(\n    shape: &SketchShape<F>,\n    inputs: &[u64],\n    storage: &mut [u64],\n) {\n    if inputs.is_empty() {\n        storage.fill(0);\n        return;\n    }\n    let count = inputs.len();\n    let (arrays, offsets) = storage.split_at_mut(2 * count);\n    let (mut ids, mut temporary) = arrays.split_at_mut(count);\n    ids.copy_from_slice(inputs);\n    let key = |id| (shape.bucket_for(id), id);\n    let mut width = 1;\n    let mut flipped = false;\n    while width < count {\n        let mut start = 0;\n        while start < count {\n            let middle = start + width.min(count - start);\n            let end = middle + width.min(count - middle);\n            let (mut left, mut right) = (start, middle);\n            for target in &mut temporary[start..end] {\n                if left < middle && (right == end || key(ids[left]) <= key(ids[right])) {\n                    *target = ids[left];\n                    left += 1;\n                } else {\n                    *target = ids[right];\n                    right += 1;\n                }\n            }\n            start = end;\n        }\n        std::mem::swap(&mut ids, &mut temporary);\n        flipped = !flipped;\n        if width >= count - width {\n            break;\n        }\n        width *= 2;\n    }\n    if flipped {\n        temporary.copy_from_slice(ids);\n        std::mem::swap(&mut ids, &mut temporary);\n    }\n    offsets.fill(0);\n    let mut used = 0;\n    for index in 0..count {\n        let id = ids[index];\n        if id != 0 && (used == 0 || ids[used - 1] != id) {\n            ids[used] = id;\n            used += 1;\n            offsets[shape.bucket_for(id) + 1] += 1;\n        }\n    }\n    for bucket in 0..shape.bucket_count() {\n        offsets[bucket + 1] += offsets[bucket];\n    }\n}\n\npub(super) fn row(storage: &[u64], raw_count: usize, bucket: usize) -> &[u64] {\n    if raw_count == 0 {\n        return &storage[..0];\n    }\n    let offsets = &storage[2 * raw_count..];\n    let start = usize::try_from(offsets[bucket]).expect(\"admitted candidate offset\");\n    let end = usize::try_from(offsets[bucket + 1]).expect(\"admitted candidate offset\");\n    &storage[start..end]\n}\n\n/// Row-local normalization: repeats in different rows remain separate hints.\npub(super) fn normalize_rows<F: BinaryField>(\n    rows: &[super::input::DecodeRow<'_, F>],\n    storage: &mut [u64],\n) {\n    let count: usize = rows.iter().map(|row| row.candidates.len()).sum();\n    if count == 0 {\n        storage.fill(0);\n        return;\n    }\n    let (arrays, offsets) = storage.split_at_mut(2 * count);\n    let (ids, _) = arrays.split_at_mut(count);\n    offsets.fill(0);\n    let mut used = 0;\n    for (bucket, row) in rows.iter().enumerate() {\n        let start = used;\n        ids[start..start + row.candidates.len()].copy_from_slice(row.candidates);\n        ids[start..start + row.candidates.len()].sort_unstable();\n        for index in start..start + row.candidates.len() {\n            let id = ids[index];\n            if id != 0 && (used == start || ids[used - 1] != id) {\n                ids[used] = id;\n                used += 1;\n            }\n        }\n        offsets[bucket + 1] = used as u64;\n    }\n}\n"},{"id":76,"name":{"Local":"/rustc/library/core/src/bool.rs"},"crate_name":"core","contents":null},{"id":77,"name":{"Local":"/rustc/library/core/src/iter/range.rs"},"crate_name":"core","contents":null},{"id":78,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":79,"name":{"Local":"/rustc/library/core/src/intrinsics/mod.rs"},"crate_name":"core","contents":null},{"id":80,"name":{"Local":"/rustc/library/core/src/num/niche_types.rs"},"crate_name":"core","contents":null},{"id":81,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":82,"name":{"Local":"/rustc/library/core/src/cmp/clamp.rs"},"crate_name":"core","contents":null},{"id":83,"name":{"Local":"/rustc/library/core/src/mem/mod.rs"},"crate_name":"core","contents":null},{"id":84,"name":{"Local":"/rustc/library/core/src/tuple.rs"},"crate_name":"core","contents":null},{"id":85,"name":{"Local":"/rustc/library/core/src/num/error.rs"},"crate_name":"core","contents":null},{"id":86,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Intege