ne":126,"col":30},"end":{"line":126,"col":31}},"generated_from_span":null}]},"id":1019,"kind":{"StorageDead":26},"comments_before":[]},{"span":{"Deduplicated":471},"id":1020,"kind":{"StorageDead":25},"comments_before":[]},{"span":{"Value":[472,{"data":{"file_id":8,"beg":{"line":127,"col":12},"end":{"line":127,"col":13}},"generated_from_span":null}]},"id":1021,"kind":{"StorageDead":15},"comments_before":[]},{"span":{"Deduplicated":472},"id":1022,"kind":{"StorageDead":10},"comments_before":[]},{"span":{"Deduplicated":472},"id":1023,"kind":{"StorageDead":7},"comments_before":[]},{"span":{"Deduplicated":472},"id":1024,"kind":{"StorageDead":5},"comments_before":[]},{"span":{"Deduplicated":472},"id":1025,"kind":{"StorageDead":4},"comments_before":[]},{"span":{"Value":[473,{"data":{"file_id":8,"beg":{"line":127,"col":13},"end":{"line":127,"col":13}},"generated_from_span":null}]},"id":1026,"kind":{"StorageDead":23},"comments_before":[]},{"span":{"Deduplicated":473},"id":1027,"kind":{"StorageDead":20},"comments_before":[]},{"span":{"Deduplicated":473},"id":1028,"kind":{"StorageDead":9},"comments_before":[]},{"span":{"Deduplicated":473},"id":1029,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"Deduplicated":473},"id":1030,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"Deduplicated":473},"id":1031,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":473},"id":1032,"kind":"Return","comments_before":[]}]},"comments":[]}}},null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,{"def_id":95,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_fold",0]}],"span":{"Untagged":{"data":{"file_id":26,"beg":{"line":2496,"col":4},"end":{"line":2500,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator method that applies a function as long as it returns"},{"DocComment":" successfully, producing a single, final value."},{"DocComment":""},{"DocComment":" `try_fold()` takes two arguments: an initial value, and a closure with"},{"DocComment":" two arguments: an 'accumulator', and an element. The closure either"},{"DocComment":" returns successfully, with the value that the accumulator should have"},{"DocComment":" for the next iteration, or it returns failure, with an error value that"},{"DocComment":" is propagated back to the caller immediately (short-circuiting)."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call. If applying the closure succeeded against every element of the"},{"DocComment":" iterator, `try_fold()` returns the final accumulator as success."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" # Note to Implementors"},{"DocComment":""},{"DocComment":" Several of the other (forward) methods have default implementations in"},{"DocComment":" terms of this one, so try to implement this explicitly if it can"},{"DocComment":" do something better than the default `for` loop implementation."},{"DocComment":""},{"DocComment":" In particular, try to have this call `try_fold()` on the internal parts"},{"DocComment":" from which this iterator is composed. If multiple calls are needed,"},{"DocComment":" the `?` operator may be convenient for chaining the accumulator value"},{"DocComment":" along, but beware any invariants that need to be upheld before those"},{"DocComment":" early returns. This is a `&mut self` method, so iteration needs to be"},{"DocComment":" resumable after hitting an error here."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the checked sum of all of the elements of the array"},{"DocComment":" let sum = a.into_iter().try_fold(0i8, |acc, x| acc.checked_add(x));"},{"DocComment":""},{"DocComment":" assert_eq!(sum, Some(6));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Short-circuiting:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [10, 20, 30, 100, 40, 50];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" // This sum overflows when adding the 100 element"},{"DocComment":" let sum = iter.try_fold(0i8, |acc, x| acc.checked_add(x));"},{"DocComment":" assert_eq!(sum, None);"},{"DocComment":""},{"DocComment":" // Because it short-circuited, the remaining elements are still"},{"DocComment":" // available through the iterator."},{"DocComment":" assert_eq!(iter.len(), 2);"},{"DocComment":" assert_eq!(iter.next(), Some(40));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" While you cannot `break` from a closure, the [`ControlFlow`] type allows"},{"DocComment":" a similar idea:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let triangular = (1..30).try_fold(0_i8, |prev, x| {"},{"DocComment":"     if let Some(next) = prev.checked_add(x) {"},{"DocComment":"         ControlFlow::Continue(next)"},{"DocComment":"     } else {"},{"DocComment":"         ControlFlow::Break(prev)"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(triangular, ControlFlow::Break(120));"},{"DocComment":""},{"DocComment":" let triangular = (1..30).try_fold(0_u64, |prev, x| {"},{"DocComment":"     if let Some(next) = prev.checked_add(x) {"},{"DocComment":"         ControlFlow::Continue(next)"},{"DocComment":"     } else {"},{"DocComment":"         ControlFlow::Break(prev)"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(triangular, ControlFlow::Continue(435));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"B","variance":"Contravariant"},{"index":2,"name":"F","variance":"Contravariant"},{"index":3,"name":"R","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":403},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[474,{"data":{"file_id":26,"beg":{"line":2499,"col":11},"end":{"line":2499,"col":44}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":81},{"Value":[451,{"Adt":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":54},{"Deduplicated":58}],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}]}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Value":[475,{"data":{"file_id":26,"beg":{"line":2499,"col":47},"end":{"line":2499,"col":63}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":81}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Value":[476,{"data":{"file_id":26,"beg":{"line":2500,"col":11},"end":{"line":2500,"col":34}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":20,"generics":{"regions":[],"types":[{"Deduplicated":410}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"D