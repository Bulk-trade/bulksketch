sets[shape.bucket_for(id) + 1] += 1;\n        }\n    }\n    for bucket in 0..shape.bucket_count() {\n        offsets[bucket + 1] += offsets[bucket];\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[483,{"data":{"file_id":75,"beg":{"line":6,"col":27},"end":{"line":6,"col":38}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":15}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":70},{"Value":[461,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":34},"Shared"]}]},{"Deduplicated":229}],"output":{"Deduplicated":26}},"src":"Normal","body":{"Structured":{"span":{"Value":[484,{"data":{"file_id":75,"beg":{"line":6,"col":0},"end":{"line":63,"col":1}},"generated_from_span":null}]},"bound_body_regions":160,"locals":{"arg_count":3,"locals":[{"index":0,"name":null,"span":{"Value":[485,{"data":{"file_id":75,"beg":{"line":10,"col":1},"end":{"line":10,"col":1}},"generated_from_span":null}]},"ty":{"Deduplicated":26},"drop_flag_for":null},{"index":1,"name":"shape","span":{"Value":[486,{"data":{"file_id":75,"beg":{"line":7,"col":4},"end":{"line":7,"col":9}},"generated_from_span":null}]}