1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.iter().map(|x| 2 * x);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), Some(6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you're doing some sort of side effect, prefer [`for`] to `map()`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(unused_must_use)]"},{"DocComment":" // don't do this:"},{"DocComment":" (0..5).map(|x| println!(\"{x}\"));"},{"DocComment":""},{"DocComment":" // it won't even execute, as it is lazy. Rust will warn you about this."},{"DocComment":""},{"DocComment":" // Instead, use a for-loop:"},{"DocComment":" for x in 0..5 {"},{"DocComment":"     println!(\"{x}\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"IteratorMap","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"B","variance":"Invariant"},{"index":2,"name":"F","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":403},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[437,{"data":{"file_id":26,"beg":{"line":848,"col":11},"end":{"line":848,"col":33}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":81},{"Deduplicated":409}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[{"regions":[],"outlives":[],"skip_binder":{"trait_ref":{"Value":[45,{"kind":{"ParentCla