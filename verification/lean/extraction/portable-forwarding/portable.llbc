tMethod":[2,3]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"id":9,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[2,4]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"id":10,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[2,5]}}],"vtable":"Lazy"},{"def_id":6,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["portable",0]},{"Impl":{"Trait":6}}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":13,"col":0},"end":{"line":82,"col":1}},"generated_from_span":null}},"source_text":"impl<F: BinaryField> Arithmetic<F> for Portable {\n    fn mul(a: u64, b: u64) -> u64 {\n        gf64::mul::<F>(a, b)\n    }\n\n    fn square(a: u64) -> u64 {\n        gf64::square::<F>(a)\n    }\n\n    fn frobenius(a: u64, power: u32) -> u64 {\n        gf64::frobenius::<F>(a, power)\n    }\n\n    fn inverse(a: u64) -> Option<u64> {\n        #[cfg(test)]\n        super::test_observer::inverse();\n        #[cfg(test)]\n        crate::types::small_degree_observer::inverse();\n        maps::inverse::<F>(a)\n    }\n\n    fn trace(a: u64) -> u8 {\n        maps::trace::<F>(a)\n    }\n\n    fn solve_quadratic(a: u64) -> Option<u64> {\n        maps::solve_quadratic::<F>(a)\n    }\n\n    fn raw_mul(a: u64, b: u64) -> RawProduct {\n        gf64::raw_mul::<F>(a, b)\n    }\n\n    fn reduce(product: RawProduct) -> u64 {\n        gf64::reduce::<F>(product)\n    }\n\n    #[cfg(test)]\n    fn dot(a: &[u64], b: &[u64]) -> u64 {\n        assert_eq!(a.len(), b.len(), \"dot length mismatch\");\n        let mut sum = RawProduct::default();\n        for (&left, &right) in a.iter().zip(b) {\n            let product = <Self as Arithmetic<F>>::raw_mul(left, right);\n            sum.lo ^= product.lo;\n            sum.hi ^= product.hi;\n        }\n        <Self as Arithmetic<F>>::reduce(sum)\n    }\n\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64) {\n        assert_eq!(dst.len(), src.len(), \"scale_xor length mismatch\");\n        if scale == 0 {\n            return;\n        }\n        if scale == 1 {\n            <Self as BulkKernels<F>>::xor_assign(dst, src);\n            return;\n        }\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target ^= <Self as Arithmetic<F>>::mul(source, scale);\n        }\n    }\n\n    fn square_slice(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"square_slice length mismatch\");\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target = <Self as Arithmetic<F>>::square(source);\n        }\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":31},{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":5},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"implied_trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Value":[126,{"kind":{"TraitImpl":{"id":8,"generics":{"regions":[],"types"