wer, square);\n                *syndrome ^= power;\n            }\n        }\n    }\n\n    fn xor_assign(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"xor_assign length mismatch\");\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target ^= source;\n        }\n    }\n\n    fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]) {\n        assert_eq!(out.len(), points.len(), \"horner_many length mismatch\");\n        let Some((&leading, rest)) = coefficients.split_last() else {\n            out.fill(0);\n            return;\n        };\n        for (target, &point) in out.iter_mut().zip(points) {\n            *target = rest.iter().rev().fold(leading, |value, &coefficient| {\n                <Self as Arithmetic<F>>::mul(value, point) ^ coefficient\n            });\n        }\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":19,"generics":{"regions":[],"types":[{"Deduplicated":31},{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":616},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"implied_trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Value":[137,{"kind":{"TraitImpl":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":17}}]}}},"trait_decl_ref":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":31},{"Dedupl