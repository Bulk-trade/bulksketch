`, which may or may not be"},{"DocComment":" expensive."},{"DocComment":""},{"DocComment":" Library authors should usually not directly implement this trait,"},{"DocComment":" but should prefer implementing the [`TryFrom`] trait, which offers"},{"DocComment":" greater flexibility and provides an equivalent `TryInto`"},{"DocComment":" implementation for free, thanks to a blanket implementation in the"},{"DocComment":" standard library. For more information on this, see the"},{"DocComment":" documentation for [`Into`]."},{"DocComment":""},{"DocComment":" Prefer using [`TryInto`] over [`TryFrom`] when specifying trait bounds on a generic function"},{"DocComment":" to ensure that types that only implement [`TryInto`] can be used as well."},{"DocComment":""},{"DocComment":" # Implementing `TryInto`"},{"DocComment":""},{"DocComment":" This suffers the same restrictions and reasoning as implementing"},{"DocComment":" [`Into`], see there for details."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"TryInto","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"},{"index":2,"name":"Self_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_into","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["TryInto",0]},{"Ident":["try_into",0]}],"span":{"Untagged":{"data":{"file_id":36,"beg":{"line":624,"col":4},"end":{"line":624,"col":48}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the conversion."}],"inline":null,"rena