ource_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the contained [`Ok`] value, consuming the `self` value."},{"DocComment":""},{"DocComment":" Because this function may panic, its use is generally discouraged."},{"DocComment":" Instead, prefer to use pattern matching and handle the [`Err`]"},{"DocComment":" case explicitly, or call [`unwrap_or`], [`unwrap_or_else`], or"},{"DocComment":" [`unwrap_or_default`]."},{"DocComment":""},{"DocComment":" [`unwrap_or`]: Result::unwrap_or"},{"DocComment":" [`unwrap_or_else`]: Result::unwrap_or_else"},{"DocComment":" [`unwrap_or_default`]: Result::unwrap_or_default"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the value is an [`Err`], with a panic message including the"},{"DocComment":" passed message, and the content of the [`Err`]."},{"DocComment":""},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let x: Result<u32, &str> = Err(\"emergency failure\");"},{"DocComment":" x.expect(\"Testing expect\"); // panics with `Testing expect: emergency failure`"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Recommended Message Style"},{"DocComment":""},{"DocComment":" We recommend that `expect` messages are used to describe the reason you"},{"DocComment":" _expect_ the `Result` should be `Ok`."},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let path = std::env::var(\"IMPORTANT_PATH\")"},{"DocComment":"     .expect(\"env variable `IMPORTANT_PATH` should be set by `wrapper_script.sh`\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" **Hint**: If you're having trouble remembering how to phrase expect"},{"DocComment":" error messages remember to focus on the word \"should\" as in \"env"},{"DocComment":" variable should be set by blah\" or \"the given binary should be available"},{"DocComment":" and executable by the current user\"."},{"DocComment":""},{"DocComment":" For more detail on expect message styles and the reasoning behind our recommendation please"},{"DocComment":" refer to the section on [\"Common Message"},{"DocComment":" Styles\"](../../std/error/index.html#common-message-styles) in the"},{"DocComment":" [`std::error`](../../std/error/index.html) module docs."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":34,"beg":{"line":1176,"col":4},"end":{"line":1176,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"E","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[264,{"data":{"file_id":34,"beg":{"line":1180,"col":11},"end":{"line":1180,"col":21}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":11}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[275,{"Adt":{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":9},{"Deduplicated":11}],"const_generics":[],"trait_refs":[]},"builtin":null}}]},{"Value":[276,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":173},"Shared"]}]}],"output":{"Deduplicated":9}},"src":"Normal","body":"Opaque"},{"def_id":55,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":8},"kind":"InherentImplBlock"}}},{"Ident":["from_le_bytes",0]}],"span":{"Untagged":{"data":{"file_id":38,"beg":{"line":1324,"col":4