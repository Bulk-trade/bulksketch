gions":[],"outlives":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":9}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Value":[280,{"data":{"file_id":13,"beg":{"line":25,"col":52},"end":{"line":25,"col":56}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":9}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":4,"span":{"Value":[281,{"data":{"file_id":13,"beg":{"line":25,"col":59},"end":{"line":25,"col":63}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":9}],"const_generics":[],"trait_refs":[]}}}}],"consts":[{"name":"BITS","attr_info":{"attributes":[{"DocComment":" Extension degree over GF(2)."}],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":277},"default":null},{"name":"MODULUS_LOW","attr_info":{"attributes":[{"DocComment":" Irreducible polynomial without its leading term."}],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":8},"default":null},{"name":"WIRE_ID","attr_info":{"attributes":[{"DocComment":" Registered polynomial/basis identity."}],"inline":null,"rename":null,"public":true},"ty":{"Value":[315,{"Adt":{"id":9,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]},"default":null},{"name":"MASK","attr_info":{"attributes":[{"DocComment":" Canonical element mask."}],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":8},"default":null}],"types":[],"methods":[],"vtable":null},{"def_id":7,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":1063,"col":0},"end":{"line":1063,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A marker for types that can be dropped."},{"DocComment":""},{"DocComment":" This should be used for `[const]` bounds,"},{"DocComment":" as non-const bounds will always hold for every type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Destruct","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":false}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"drop_glue","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]},{"Ident":["drop_glue",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":1063,"col":0},"end":{"line":1063,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":314}],"output":{"Deduplicated":53}},"default":null},"kind":{"TraitMethod":[7,0]}}],"vtable":null},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Copy",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":454,"col":0},"end":{"line":454,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types whose values can be duplicated simply by copying bits."},{"DocComment":""},{"DocComment":" By default, variable bindings have 'move semantics.' In other"},{"DocComment":" words:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Foo;"},{"DocComment":""},{"DocComment":" let x = Foo;"},{"DocComment":""},{"DocComment":" let y = x;"},{"DocComment":""},{"DocComment":" // `x` has moved into `y`, and so cannot be used"},{"DocComment":""},{"DocComment":" // println!(\"{x:?}\"); // error: use of moved value"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However, if a type implements `Copy`, it instead has 'copy semantics':"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // We can derive a `Copy` implementation. `Clone` is also required, as it's"},{"DocComment":" // a supertrait of `Copy`."},{"DocComment":" #[derive(Debug, Copy, Clone)]"},{"DocComment":" struct Foo;"},{"DocComment":""},{"DocComment":" let x = Foo;"},{"DocComment":""},{"DocComment":" let y = x;"},{"DocComment":""},{"DocComment":" // `y` is a copy of `x`"},{"DocComment":""},{"DocComment":" println!(\"{x:?}\"); // A-OK!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It's important to note that in these two examples, the only difference is whether you"},{"DocComment":" are allowed to access `x` after the assignment. Under the hood, both a copy and a move"},{"DocComment":" can result in bits being copied in memory, although this is sometimes optimized away."},{"DocComment":""},{"DocComment":" ## How can I implement `Copy`?"},{"DocComment":""},{"DocComment":" There are two ways to implement `Copy` on your type. The simplest is to use `derive`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct MyStruct;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also implement `Copy` and `Clone` manually:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct MyStruct;"},{"DocComment":""},{"DocComment":" impl Copy for MyStruct { }"},{"DocComment":""},{"DocComment":" impl Clone for MyStruct {"},{"DocComment":"     fn clone(&self) -> MyStruct {"},{"DocComment":"         *self"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There is a small difference between the two. The `derive` strategy will also place a `Copy`"},{"DocComment":" bound on type parameters:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Clone)]"},{"DocComment":" struct MyStruct<T>(T);"},{"DocComment":""},{"DocComment":" impl<T: Copy> Copy for MyStruct<T> { }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This isn't always desired. For example, shared references (`&T`) can be copied regardless of"},{"DocComment":" whether `T` is `Copy`. Likewise, a generic struct containing markers such as [`PhantomData`]"},{"DocComment":" could potentially be duplicated with a bit-wise copy."},{"DocComment":""},{"DocComment":" ## What's the difference between `Copy` and `Clone`?"},{"DocComment":""},{"DocComment":" Copies happen implicitly, for example as part of an assignment `y = x`. The behavior of"},{"DocComment":" `Copy` is not overloadable; it is always a simple bit-wise copy."},{"DocComment":""},{"DocComment":" Cloning is an explicit action, `x.clone()`. The implementation of [`Clone`] can"},{"DocComment":" provide any type-specific behavior necessary to duplicate values safely. For example,"},{"DocComment":" the implementation of [`Clone`] for [`String`] needs to copy the pointed-to string"},{"DocComment":" buffer in the heap. A simple bitwise copy of [`String`] values would merely copy the"},{"DocComment":" pointer, leading to a double free down the line. For this reason, [`String`] is [`Clone`]"},{"DocComment":" but not `Copy`."},{"DocComment":""},{"DocComment":" [`Clone`] is a supertrait of `Copy`, so everything which is `Copy` must also implement"},{"DocComment":" [`Clone`]. If a type is `Copy` then its [`Clone`] implementation only needs to return `*self`"},{"DocComment":" (see the example above)."},{"DocComment":""},{"DocComment":" ## When can my type be `Copy`?"},{"DocComment":""},{"DocComment":" A type can implement `Copy` if all of its components implement `Copy`. For example, this"},{"DocComment":" struct can be `Copy`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Point {"},{"DocComment":"    x: i32,"},{"DocComment":"    y: i32,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A struct can be `Copy`, and [`i32`] is `Copy`, therefore `Point` is eligible to be `Copy`."},{"DocComment":" By contrast, consider"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # struct Point;"},{"DocComment":" struct PointList {"},{"DocComment":"     points: Vec<Point>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The struct `PointList` cannot implement `Copy`, because [`Vec<T>`] is not `Copy`. If we"},{"DocComment":" attempt to derive a `Copy` implementation, we'll get an error:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" the trait `Copy` cannot be implemented for this type; field `points` does not implement `Copy`"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Shared references (`&T`) are also `Copy`, so a type can be `Copy`, even when it holds"},{"DocComment":" shared references of types `T` that are *not* `Copy`. Consider the following struct,"},{"DocComment":" which can implement `Copy`, because it only holds a *shared reference* to our non-`Copy`"},{"DocComment":" type `PointList` from above:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # struct PointList;"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct PointListWrapper<'a> {"},{"DocComment":"     point_list_ref: &'a PointList,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## When *can't* my type be `Copy`?"},{"DocComment":""},{"DocComment":" Some types can't be copied safely. For example, copying `&mut T` would create an aliased"},{"DocComment":" mutable reference. Copying [`String`] would duplicate responsibility for managing the"},{"DocComment":" [`String`]'s buffer, leading to a double free."},{"DocComment":""},{"DocComment":" Generalizing the latter case, any type implementing [`Drop`] can't be `Copy`, because it's"},{"DocComment":" managing some resource besides its own [`size_of::<T>`] bytes."},{"DocComment":""},{"DocComment":" If you try to implement `Copy` on a struct or enum containing non-`Copy` data, you will get"},{"DocComment":" the error [E0204]."},{"DocComment":""},{"DocComment":" [E0204]: ../../error_codes/E0204.html"},{"DocComment":""},{"DocComment":" ## When *should* my type be `Copy`?"},{"DocComment":""},{"DocComment":" Generally speaking, if your type _can_ implement `Copy`, it should. Keep in mind, though,"},{"DocComment":" that implementing `Copy` is part of the public API of your type. If the type might become"},{"DocComment":" non-`Copy` in the future, it could be prudent to omit the `Copy` implementation now, to"},{"DocComment":" avoid a breaking API change."},{"DocComment":""},{"DocComment":" ## Additional implementors"},{"DocComment":""},{"DocComment":" In addition to the [implementors listed below][impls],"},{"DocComment":" the following types also implement `Copy`:"},{"DocComment":""},{"DocComment":" * Function item types (i.e., the distinct types defined for each function)"},{"DocComment":" * Function pointer types (e.g., `fn() -> i32`)"},{"DocComment":" * Closure types, if they capture no value from the environment"},{"DocComment":"   or if all such captured values implement `Copy` themselves."},{"DocComment":"   Note that variables captured by shared reference always implement `Copy`"},{"DocComment":"   (even if the referent doesn't),"},{"DocComment":"   while variables captured by mutable reference never implement `Copy`."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`size_of::<T>`]: size_of"},{"DocComment":" [impls]: #implementors"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Copy","diagnostic_item":"Copy","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[282,{"data":{"file_id":15,"beg":{"line":454,"col":16},"end":{"line":454,"col":21}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":9}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[],"vtable":null},{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Send",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":92,"col":0},"end":{"line":92,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types that can be transferred across thread boundaries."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines it's"},{"DocComment":" appropriate."},{"DocComment":""},{"DocComment":" An example of a non-`Send` type is the reference-counting pointer"},{"DocComment":" [`rc::Rc`][`Rc`]. If two threads attempt to clone [`Rc`]s that point to the same"},{"DocComment":" reference-counted value, they might try to update the reference count at the"},{"DocComment":" same time, which is [undefined behavior][ub] because [`Rc`] doesn't use atomic"},{"DocComment":" operations. Its cousin [`sync::Arc`][arc] does use atomic operations (incurring"},{"DocComment":" some overhead) and thus is `Send`."},{"DocComment":""},{"DocComment":" See [the Nomicon](../../nomicon/send-and-sync.html) and the [`Sync`] trait for more details."},{"DocComment":""},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Send","has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":21,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sync",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":657,"col":0},"end":{"line":657,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types for which it is safe to share references between threads."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines"},{"DocComment":" it's appropriate."},{"DocComment":""},{"DocComment":" The precise definition is: a type `T` is [`Sync`] if and only if `&T` is"},{"DocComment":" [`Send`]. In other words, if there is no possibility of"},{"DocComment":" [undefined behavior][ub] (including data races) when passing"},{"DocComment":" `&T` references between threads."},{"DocComment":""},{"DocComment":" As one would expect, primitive types like [`u8`] and [`f64`]"},{"DocComment":" are all [`Sync`], and so are simple aggregate types containing them,"},{"DocComment":" like tuples, structs and enums. More examples of basic [`Sync`]"},{"DocComment":" types include \"immutable\" types like `&T`, and those with simple"},{"DocComment":" inherited mutability, such as [`Box<T>`][box], [`Vec<T>`][vec] and"},{"DocComment":" most other collection types. (Generic parameters need to be [`Sync`]"},{"DocComment":" for their container to be [`Sync`].)"},{"DocComment":""},{"DocComment":" A somewhat surprising consequence of the definition is that `&mut T`"},{"DocComment":" is `Sync` (if `T` is `Sync`) even though it seems like that might"},{"DocComment":" provide unsynchronized mutation. The trick is that a mutable"},{"DocComment":" reference behind a shared reference (that is, `& &mut T`)"},{"DocComment":" becomes read-only, as if it were a `& &T`. Hence there is no risk"},{"DocComment":" of a data race."},{"DocComment":""},{"DocComment":" A shorter overview of how [`Sync`] and [`Send`] relate to referencing:"},{"DocComment":" * `&T` is [`Send`] if and only if `T` is [`Sync`]"},{"DocComment":" * `&mut T` is [`Send`] if and only if `T` is [`Send`]"},{"DocComment":" * `&T` and `&mut T` are [`Sync`] if and only if `T` is [`Sync`]"},{"DocComment":""},{"DocComment":" Types that are not `Sync` are those that have \"interior"},{"DocComment":" mutability\" in a non-thread-safe form, such as [`Cell`][cell]"},{"DocComment":" and [`RefCell`][refcell]. These types allow for mutation of"},{"DocComment":" their contents even through an immutable, shared reference. For"},{"DocComment":" example the `set` method on [`Cell<T>`][cell] takes `&self`, so it requires"},{"DocComment":" only a shared reference [`&Cell<T>`][cell]. The method performs no"},{"DocComment":" synchronization, thus [`Cell`][cell] cannot be `Sync`."},{"DocComment":""},{"DocComment":" Another example of a non-`Sync` type is the reference-counting"},{"DocComment":" pointer [`Rc`][rc]. Given any reference [`&Rc<T>`][rc], you can clone"},{"DocComment":" a new [`Rc<T>`][rc], modifying the reference counts in a non-atomic way."},{"DocComment":""},{"DocComment":" For cases when one does need thread-safe interior mutability,"},{"DocComment":" Rust provides [atomic data types], as well as explicit locking via"},{"DocComment":" [`sync::Mutex`][mutex] and [`sync::RwLock`][rwlock]. These types"},{"DocComment":" ensure that any mutation cannot cause data races, hence the types"},{"DocComment":" are `Sync`. Likewise, [`sync::Arc`][arc] provides a thread-safe"},{"DocComment":" analogue of [`Rc`][rc]."},{"DocComment":""},{"DocComment":" Any types with interior mutability must also use the"},{"DocComment":" [`cell::UnsafeCell`][unsafecell] wrapper around the value(s) which"},{"DocComment":" can be mutated through a shared reference. Failing to doing this is"},{"DocComment":" [undefined behavior][ub]. For example, [`transmute`][transmute]-ing"},{"DocComment":" from `&T` to `&mut T` is invalid."},{"DocComment":""},{"DocComment":" See [the Nomicon][nomicon-send-and-sync] for more details about `Sync`."},{"DocComment":""},{"DocComment":" [box]: ../../std/boxed/struct.Box.html"},{"DocComment":" [vec]: ../../std/vec/struct.Vec.html"},{"DocComment":" [cell]: crate::cell::Cell"},{"DocComment":" [refcell]: crate::cell::RefCell"},{"DocComment":" [rc]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [atomic data types]: crate::sync::atomic"},{"DocComment":" [mutex]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [rwlock]: ../../std/sync/struct.RwLock.html"},{"DocComment":" [unsafecell]: crate::cell::UnsafeCell"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"},{"DocComment":" [transmute]: crate::mem::transmute"},{"DocComment":" [nomicon-send-and-sync]: ../../nomicon/send-and-sync.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Sync","diagnostic_item":"Sync","has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":22,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":11,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["field",0]},{"Ident":["sealed",0]},{"Ident":["Sealed",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":21,"col":4},"end":{"line":21,"col":23}},"generated_from_span":null}},"source_text":"pub trait Sealed {}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":23,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["Eq",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":353,"col":0},"end":{"line":353,"col":58}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Trait for comparisons corresponding to [equivalence relations]("},{"DocComment":" https://en.wikipedia.org/wiki/Equivalence_relation)."},{"DocComment":""},{"DocComment":" The primary difference to [`PartialEq`] is the additional requirement for reflexivity. A type"},{"DocComment":" that implements [`PartialEq`] guarantees that for all `a`, `b` and `c`:"},{"DocComment":""},{"DocComment":" - symmetric: `a == b` implies `b == a`"},{"DocComment":" - transitive: `a == b` and `b == c` implies `a == c`"},{"DocComment":" - consistent: `a != b` if and only if `!(a == b)`"},{"DocComment":""},{"DocComment":" `Eq`, which builds on top of [`PartialEq`] also implies:"},{"DocComment":""},{"DocComment":" - reflexive: `a == a`"},{"DocComment":""},{"DocComment":" This property cannot be checked by the compiler, and therefore `Eq` is a trait without methods."},{"DocComment":""},{"DocComment":" Violating this property is a logic error. The behavior resulting from a logic error is not"},{"DocComment":" specified, but users of the trait must ensure that such logic errors do *not* result in"},{"DocComment":" undefined behavior. This means that `unsafe` code **must not** rely on the correctness of these"},{"DocComment":" methods."},{"DocComment":""},{"DocComment":" Floating point types such as [`f32`] and [`f64`] implement only [`PartialEq`] but *not* `Eq`"},{"DocComment":" because `NaN` != `NaN`."},{"DocComment":""},{"DocComment":" ## Derivable"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]`. When `derive`d, because `Eq` has no extra methods, it"},{"DocComment":" is only informing the compiler that this is an equivalence relation rather than a partial"},{"DocComment":" equivalence relation. Note that the `derive` strategy requires all fields are `Eq`, which isn't"},{"DocComment":" always desired."},{"DocComment":""},{"DocComment":" ## How can I implement `Eq`?"},{"DocComment":""},{"DocComment":" If you cannot use the `derive` strategy, specify that your type implements `Eq`, which has no"},{"DocComment":" extra methods:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" enum BookFormat {"},{"DocComment":"     Paperback,"},{"DocComment":"     Hardback,"},{"DocComment":"     Ebook,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct Book {"},{"DocComment":"     isbn: i32,"},{"DocComment":"     format: BookFormat,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl PartialEq for Book {"},{"DocComment":"     fn eq(&self, other: &Self) -> bool {"},{"DocComment":"         self.isbn == other.isbn"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Eq for Book {}"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Eq","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[283,{"data":{"file_id":17,"beg":{"line":353,"col":20},"end":{"line":353,"col":43}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":19,"generics":{"regions":[],"types":[{"Deduplicated":9},{"Deduplicated":9}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[null,null],"vtable":null},{"def_id":13,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":42,"col":0},"end":{"line":42,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for dealing with iterators."},{"DocComment":""},{"DocComment":" This is the main iterator trait. For more about the concept of iterators"},{"DocComment":" generally, please see the [module-level documentation]. In particular, you"},{"DocComment":" may want to know how to [implement `Iterator`][impl]."},{"DocComment":""},{"DocComment":" [module-level documentation]: crate::iter"},{"DocComment":" [impl]: crate::iter#implementing-iterator"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Iterator","diagnostic_item":"Iterator","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"next","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["next",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":78,"col":4},"end":{"line":78,"col":45}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Advances the iterator and returns the next value."},{"DocComment":""},{"DocComment":" Returns [`None`] when iteration is finished. Individual iterator"},{"DocComment":" implementations may choose to resume iteration, and so calling `next()`"},{"DocComment":" again may or may not eventually start returning [`Some(Item)`] again at some"},{"DocComment":" point."},{"DocComment":""},{"DocComment":" [`Some(Item)`]: Some"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" // A call to next() returns the next value..."},{"DocComment":" assert_eq!(Some(1), iter.next());"},{"DocComment":" assert_eq!(Some(2), iter.next());"},{"DocComment":" assert_eq!(Some(3), iter.next());"},{"DocComment":""},{"DocComment":" // ... and then None once it's over."},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":""},{"DocComment":" // More calls may or may not return `None`. Here, they always will."},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"IteratorNext","diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":314}],"output":{"Deduplicated":250}},"default":null},"kind":{"TraitMethod":[13,0]}},null,null,null,null,null,null,null,null,{"params":{"regions":[],"types":[{"index":0,"name":"U","variance":"Invariant"},{"index":1,"name":"Clause0_Item","variance":"Invariant"},{"index":2,"name":"Clause0_IntoIter","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":260},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Value":[316,{"TypeVar":{"Bound":[1,0]}}]},{"Value":[317,{"TypeVar":{"Bound":[1,1]}}]},{"Value":[318,{"TypeVar":{"Bound":[1,2]}}]}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"zip","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["zip",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":643,"col":4},"end":{"line":646,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" 'Zips up' two iterators into a single iterator of pairs."},{"DocComment":""},{"DocComment":" `zip()` returns a new iterator that will iterate over two other"},{"DocComment":" iterators, returning a tuple where the first element comes from the"},{"DocComment":" first iterator, and the second element comes from the second iterator."},{"DocComment":""},{"DocComment":" In other words, it zips two iterators together, into a single one."},{"DocComment":""},{"DocComment":" If either iterator returns [`None`], [`next`] from the zipped iterator"},{"DocComment":" will return [`None`]."},{"DocComment":" If the zipped iterator has no more elements to return then each further attempt to advance"},{"DocComment":" it will first try to advance the first iterator at most one time and if it still yielded an item"},{"DocComment":" try to advance the second iterator at most one time."},{"DocComment":""},{"DocComment":" To 'undo' the result of zipping up two iterators, see [`unzip`]."},{"DocComment":""},{"DocComment":" [`unzip`]: Iterator::unzip"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s1 = \"abc\".chars();"},{"DocComment":" let s2 = \"def\".chars();"},{"DocComment":""},{"DocComment":" let mut iter = s1.zip(s2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(('a', 'd')));"},{"DocComment":" assert_eq!(iter.next(), Some(('b', 'e')));"},{"DocComment":" assert_eq!(iter.next(), Some(('c', 'f')));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the argument to `zip()` uses [`IntoIterator`], we can pass"},{"DocComment":" anything that can be converted into an [`Iterator`], not just an"},{"DocComment":" [`Iterator`] itself. For example, arrays (`[T]`) implement"},{"DocComment":" [`IntoIterator`], and so can be passed to `zip()` directly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a1 = [1, 2, 3];"},{"DocComment":" let a2 = [4, 5, 6];"},{"DocComment":""},{"DocComment":" let mut iter = a1.into_iter().zip(a2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some((1, 4)));"},{"DocComment":" assert_eq!(iter.next(), Some((2, 5)));"},{"DocComment":" assert_eq!(iter.next(), Some((3, 6)));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `zip()` is often used to zip an infinite iterator to a finite one."},{"DocComment":" This works because the finite iterator will eventually return [`None`],"},{"DocComment":" ending the zipper. Zipping with `(0..)` can look a lot like [`enumerate`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let enumerate: Vec<_> = \"foo\".chars().enumerate().collect();"},{"DocComment":""},{"DocComment":" let zipper: Vec<_> = (0..).zip(\"foo\".chars()).collect();"},{"DocComment":""},{"DocComment":" assert_eq!((0, 'f'), enumerate[0]);"},{"DocComment":" assert_eq!((0, 'f'), zipper[0]);"},{"DocComment":""},{"DocComment":" assert_eq!((1, 'o'), enumerate[1]);"},{"DocComment":" assert_eq!((1, 'o'), zipper[1]);"},{"DocComment":""},{"DocComment":" assert_eq!((2, 'o'), enumerate[2]);"},{"DocComment":" assert_eq!((2, 'o'), zipper[2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If both iterators have roughly equivalent syntax, it may be more readable to use [`zip`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::iter::zip;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let b = [2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut zipped = zip("},{"DocComment":"     a.into_iter().map(|x| x * 2).skip(1),"},{"DocComment":"     b.into_iter().map(|x| x * 2).skip(1),"},{"DocComment":" );"},{"DocComment":""},{"DocComment":" assert_eq!(zipped.next(), Some((4, 6)));"},{"DocComment":" assert_eq!(zipped.next(), Some((6, 8)));"},{"DocComment":" assert_eq!(zipped.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" compared to:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # let a = [1, 2, 3];"},{"DocComment":" # let b = [2, 3, 4];"},{"DocComment":" #"},{"DocComment":" let mut zipped = a"},{"DocComment":"     .into_iter()"},{"DocComment":"     .map(|x| x * 2)"},{"DocComment":"     .skip(1)"},{"DocComment":"     .zip(b.into_iter().map(|x| x * 2).skip(1));"},{"DocComment":" #"},{"DocComment":" # assert_eq!(zipped.next(), Some((4, 6)));"},{"DocComment":" # assert_eq!(zipped.next(), Some((6, 8)));"},{"DocComment":" # assert_eq!(zipped.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`enumerate`]: Iterator::enumerate"},{"DocComment":" [`next`]: Iterator::next"},{"DocComment":" [`zip`]: crate::iter::zip"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":9},{"Deduplicated":2}],"output":{"Value":[319,{"Adt":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":9},{"Value":[320,{"TypeVar":{"Bound":[0,2]}}]}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"default":{"id":50,"generics":{"regions":[],"types":[{"Deduplicated":9},{"Deduplicated":2},{"Deduplicated":11},{"Deduplicated":7},{"Deduplicated":320}],"const_generics":[],"trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Value":[41,{"kind":"SelfId","trait_decl_ref":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":9},{"Deduplicated":11}],"const_generics":[],"trait_refs":[]}}}]}},{"regions":[],"outlives":[],"skip_binder":{"Value":[42,{"kind":{"Clause":[{"Bound":[1,0]},{"regions":[]}]},"trait_decl_ref":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":316},{"Deduplicated":317},{"Deduplicated":318}],"const_generics":[],"trait_refs":[]}}}]}}]}}},"kind":{"TraitMethod":[13,9]}},null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,{"params":{"regions":[],"types":[{"index":0,"name":"Clause0_Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":244},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":9},{"Deduplicated":316}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"rev","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0