{"charon_version":"0.1.304","translated":{"crate_name":"bulksketch","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["bulksketch::backend::contract::BulkKernels::difference","{impl bulksketch::backend::contract::BulkKernels for bulksketch::backend::portable::Portable}","{impl bulksketch::backend::contract::BulkKernels for bulksketch::backend::x86_pclmul::Pclmul}","{impl core::clone::Clone for bulksketch::backend::portable::Portable}::clone","{impl core::clone::Clone for bulksketch::backend::x86_pclmul::Pclmul}::clone"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["bulksketch::backend::contract::BulkKernels::difference","{impl bulksketch::backend::contract::BulkKernels for bulksketch::backend::portable::Portable}","{impl bulksketch::backend::contract::BulkKernels for bulksketch::backend::x86_pclmul::Pclmul}","bulksketch::backend::portable::Portable","bulksketch::backend::x86_pclmul::Pclmul","{impl core::clone::Clone for bulksketch::backend::portable::Portable}::clone","{impl core::clone::Clone for bulksketch::backend::x86_pclmul::Pclmul}::clone"],"opaque":["{impl bulksketch::backend::contract::BulkKernels for bulksketch::backend::portable::Portable}::insert_nonzero","{impl bulksketch::backend::contract::BulkKernels for bulksketch::backend::portable::Portable}::xor_assign","{impl bulksketch::backend::contract::BulkKernels for bulksketch::backend::portable::Portable}::horner_many","{impl bulksketch::backend::contract::BulkKernels for bulksketch::backend::x86_pclmul::Pclmul}::insert_nonzero","{impl bulksketch::backend::contract::BulkKernels for bulksketch::backend::x86_pclmul::Pclmul}::xor_assign","{impl bulksketch::backend::contract::BulkKernels for bulksketch::backend::x86_pclmul::Pclmul}::horner_many","bulksketch::backend::portable::_::mul","bulksketch::backend::portable::_::square","bulksketch::backend::portable::_::frobenius","bulksketch::backend::portable::_::inverse","bulksketch::backend::portable::_::trace","bulksketch::backend::portable::_::solve_quadratic","bulksketch::backend::portable::_::raw_mul","bulksketch::backend::portable::_::reduce","bulksketch::backend::portable::_::scale_xor","bulksketch::backend::portable::_::square_slice","bulksketch::backend::portable::_::insert_nonzero","bulksketch::backend::portable::_::xor_assign","bulksketch::backend::portable::_::horner_many","bulksketch::backend::x86_pclmul::_::mul","bulksketch::backend::x86_pclmul::_::square","bulksketch::backend::x86_pclmul::_::frobenius","bulksketch::backend::x86_pclmul::_::inverse","bulksketch::backend::x86_pclmul::_::trace","bulksketch::backend::x86_pclmul::_::solve_quadratic","bulksketch::backend::x86_pclmul::_::raw_mul","bulksketch::backend::x86_pclmul::_::reduce","bulksketch::backend::x86_pclmul::_::scale_xor","bulksketch::backend::x86_pclmul::_::square_slice","bulksketch::backend::x86_pclmul::_::insert_nonzero","bulksketch::backend::x86_pclmul::_::xor_assign","bulksketch::backend::x86_pclmul::_::horner_many","bulksketch::backend::x86_pclmul::horner"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/workspace/bulk/bulksketch-proof-evidence-20261109-traversal-stages/default-wire-difference/dictionaries-native-clone/arithmetic.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-apple-darwin","value":{"arch":"X86_64","vendor":"apple","os":"MacOs","env":"Unspecified","cfg_abi":"Unspecified","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bulksketch","contents":"//! Native binary-syndrome reconciliation with bounded, deterministic GF64 decoding.\n#![deny(unsafe_code)]\n#![warn(missing_docs)]\n\nmod backend;\nmod decode;\nmod field;\nmod poly;\nmod sketch;\nmod types;\n\npub use {\n    field::{BinaryField, Gf64},\n    sketch::{\n        DecodeJob, DecodeLimits, DecodeOutcome, DecodePlan, DecodeReport, DecodeRequest, DecodeRow,\n        DecodeRowsRequest, DecodeScratch, Decoder, FrozenSketch, InsertScratch, MutableSketch,\n        ParseLimits, ScratchLayout, ShapeLimits, SketchShape, SketchView, decode_into,\n        decode_rows_into,\n    },\n    types::{\n        BackendError, BackendId, BackendRequest, CreateError, DecodeError, DecodeFailure,\n        EncodeError, FieldId, ParseError, ShapeError, ShapeMismatch, Stage, StageProgress,\n        UpdateError, WorkUnits,\n    },\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"src/backend/contract.rs"},"crate_name":"bulksketch","contents":"//! Each backend implements these static, monomorphized contracts for each checked capability.\n#![forbid(unsafe_code)]\n\nuse crate::{field::BinaryField, types::RawProduct};\n\n/// All operands/results are canonical F words. Slice dimensions are internal invariants.\n/// Inverse rejects zero; raw products are unreduced polynomials, never field elements.\npub(crate) trait Arithmetic<F: BinaryField>: Copy + Send + Sync + 'static {\n    fn mul(a: u64, b: u64) -> u64;\n    fn square(a: u64) -> u64;\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"arithmetic parity contract; insertion uses fixed private maps\"\n        )\n    )]\n    fn frobenius(a: u64, power: u32) -> u64;\n    fn inverse(a: u64) -> Option<u64>;\n    /// Absolute field trace, 0 or 1. Canonical scalar maps live in the field module.\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"arithmetic parity contract; scalar map owns current trace callers\"\n        )\n    )]\n    fn trace(a: u64) -> u8;\n    /// Deterministic right inverse of z^2+z on trace-zero inputs; verify each solution.\n    /// Even-degree fields use the fixed-pivot map, never the odd-degree half trace.\n    fn solve_quadratic(a: u64) -> Option<u64>;\n    fn raw_mul(a: u64, b: u64) -> RawProduct;\n    fn reduce(product: RawProduct) -> u64;\n    /// Equal lengths; XOR raw products then reduce once, including the empty dot = 0.\n    #[cfg(test)]\n    fn dot(a: &[u64], b: &[u64]) -> u64;\n    /// Equal lengths; dst[i] ^= src[i] * scale. Aliasing follows safe Rust borrows.\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64);\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"bulk parity contract; current reconstruction squares dependent positions\"\n        )\n    )]\n    fn square_slice(dst: &mut [u64], src: &[u64]);\n}\n\n/// Bulk arithmetic, without shape, wire, request, job or complete-operation types.\npub(crate) trait BulkKernels<F: BinaryField>: Arithmetic<F> {\n    /// Optional monic square-mod kernel; false leaves both mutable slices untouched.\n    /// Degree d>=3, a.len<=d, table.len=d*floor(d/2), dst.len=d, raw.len>=2*d+1.\n    fn square_mod(_a: &[u64], _table: &[u64], _dst: &mut [u64], _raw: &mut [RawProduct]) -> bool {\n        false\n    }\n\n    /// Multiply an ascending polynomial in place by (1 + root*z). Its final\n    /// coefficient must initially be zero; the slice includes that spare word.\n    fn multiply_linear(coefficients: &mut [u64], root: u64) {\n        for index in (1..coefficients.len()).rev() {\n            coefficients[index] ^= Self::mul(coefficients[index - 1], root);\n        }\n    }\n\n    /// Check all odd-sequence continuation equations, after the caller has\n    /// independently verified its first d words. squared_locator is rebuilt\n    /// from roots, has d+1 ascending words and constant coefficient one.\n    fn odd_recurrence_matches(odd: &[u64], squared_locator: &[u64]) -> bool {\n        let degree = squared_locator.len() - 1;\n        for index in degree..odd.len() {\n            let mut sum = RawProduct::default();\n            for lag in 1..=degree {\n                let product = Self::raw_mul(odd[index - lag], squared_locator[lag]);\n                sum.lo ^= product.lo;\n                sum.hi ^= product.hi;\n            }\n            if Self::reduce(sum) != odd[index] {\n                return false;\n            }\n        }\n        true\n    }\n\n    /// Toggle nonzero canonical IDs into S1,S3,... in arrival order. Parity semantics.\n    /// Caller handles routing/zero and validates every input. No post-final multiply.\n    fn insert_nonzero(odd: &mut [u64], ids: &[u64]);\n    /// Overwrite all odd syndromes with the direct encoding of these IDs.\n    fn encode_nonzero(odd: &mut [u64], ids: &[u64]) {\n        odd.fill(0);\n        if ids.len() <= 2 {\n            for id in ids {\n                Self::insert_nonzero(odd, std::slice::from_ref(id));\n            }\n        } else {\n            Self::insert_nonzero(odd, ids);\n        }\n    }\n\n    /// Equal lengths; XOR algebraic words only, never wire metadata.\n    fn xor_assign(dst: &mut [u64], src: &[u64]);\n    /// XOR canonical local words with unaligned little-endian remote words.\n    /// Equal word lengths; returns whether any output word is nonzero.\n    fn difference(dst: &mut [u64], local: &[u64], remote: &[u8]) -> bool {\n        #[cfg(test)]\n        super::test_observer::difference();\n        assert_eq!(dst.len(), local.len(), \"difference length mismatch\");\n        assert_eq!(\n            remote.len(),\n            8 * dst.len(),\n            \"difference byte length mismatch\"\n        );\n        let mut any = 0;\n        for ((out, &word), bytes) in dst.iter_mut().zip(local).zip(remote.chunks_exact(8)) {\n            *out = word ^ u64::from_le_bytes(bytes.try_into().expect(\"complete word\"));\n            any |= *out;\n        }\n        any != 0\n    }\n    /// Ascending coefficients; empty polynomial evaluates to zero. out.len=points.len.\n    fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]);\n}\n"},{"id":6,"name":{"Local":"src/backend/mod.rs"},"crate_name":"bulksketch","contents":"//! Arithmetic capabilities and canonical-word kernels only.\n#![deny(unsafe_code)]\n\npub(crate) mod contract;\npub(crate) mod detect;\npub(crate) mod portable;\n#[cfg(target_arch = \"x86_64\")]\npub(crate) mod x86_pclmul;\n\n#[cfg(target_arch = \"x86_64\")]\npub(crate) mod x86_vpclmul512;\n\n#[cfg(all(test, target_arch = \"x86_64\"))]\nmod vpclmul512_tests;\n\n#[cfg(all(test, target_arch = \"x86_64\"))]\nmod pclmul_tests;\n#[cfg(test)]\nmod portable_tests;\n\n#[cfg(test)]\nmod difference_tests;\n\n#[cfg(test)]\npub(crate) mod test_observer;\n\n#[cfg(test)]\nmod byte_map_tests;\n"},{"id":7,"name":{"Local":"src/backend/portable.rs"},"crate_name":"bulksketch","contents":"//! Safe canonical-word kernels shared by GF64 and the sealed test fields.\n#![forbid(unsafe_code)]\n\nuse crate::{\n    backend::contract::{Arithmetic, BulkKernels},\n    field::{BinaryField, gf64, maps},\n    types::RawProduct,\n};\n\n#[derive(Clone, Copy, Debug)]\npub(crate) struct Portable;\n\nimpl<F: BinaryField> Arithmetic<F> for Portable {\n    fn mul(a: u64, b: u64) -> u64 {\n        gf64::mul::<F>(a, b)\n    }\n\n    fn square(a: u64) -> u64 {\n        gf64::square::<F>(a)\n    }\n\n    fn frobenius(a: u64, power: u32) -> u64 {\n        gf64::frobenius::<F>(a, power)\n    }\n\n    fn inverse(a: u64) -> Option<u64> {\n        #[cfg(test)]\n        super::test_observer::inverse();\n        #[cfg(test)]\n        crate::types::small_degree_observer::inverse();\n        maps::inverse::<F>(a)\n    }\n\n    fn trace(a: u64) -> u8 {\n        maps::trace::<F>(a)\n    }\n\n    fn solve_quadratic(a: u64) -> Option<u64> {\n        maps::solve_quadratic::<F>(a)\n    }\n\n    fn raw_mul(a: u64, b: u64) -> RawProduct {\n        gf64::raw_mul::<F>(a, b)\n    }\n\n    fn reduce(product: RawProduct) -> u64 {\n        gf64::reduce::<F>(product)\n    }\n\n    #[cfg(test)]\n    fn dot(a: &[u64], b: &[u64]) -> u64 {\n        assert_eq!(a.len(), b.len(), \"dot length mismatch\");\n        let mut sum = RawProduct::default();\n        for (&left, &right) in a.iter().zip(b) {\n            let product = <Self as Arithmetic<F>>::raw_mul(left, right);\n            sum.lo ^= product.lo;\n            sum.hi ^= product.hi;\n        }\n        <Self as Arithmetic<F>>::reduce(sum)\n    }\n\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64) {\n        assert_eq!(dst.len(), src.len(), \"scale_xor length mismatch\");\n        if scale == 0 {\n            return;\n        }\n        if scale == 1 {\n            <Self as BulkKernels<F>>::xor_assign(dst, src);\n            return;\n        }\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target ^= <Self as Arithmetic<F>>::mul(source, scale);\n        }\n    }\n\n    fn square_slice(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"square_slice length mismatch\");\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target = <Self as Arithmetic<F>>::square(source);\n        }\n    }\n}\n\nimpl<F: BinaryField> BulkKernels<F> for Portable {\n    fn insert_nonzero(odd: &mut [u64], ids: &[u64]) {\n        let Some((first, successors)) = odd.split_first_mut() else {\n            return;\n        };\n        // Zero extraction and canonicality belong to the caller, as does routing.\n        for &id in ids {\n            *first ^= id;\n            let square = <Self as Arithmetic<F>>::square(id);\n            let mut power = id;\n            // Advancing before each successor uses exactly c-1 multiplications.\n            for syndrome in &mut *successors {\n                power = <Self as Arithmetic<F>>::mul(power, square);\n                *syndrome ^= power;\n            }\n        }\n    }\n\n    fn xor_assign(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"xor_assign length mismatch\");\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target ^= source;\n        }\n    }\n\n    fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]) {\n        assert_eq!(out.len(), points.len(), \"horner_many length mismatch\");\n        let Some((&leading, rest)) = coefficients.split_last() else {\n            out.fill(0);\n            return;\n        };\n        for (target, &point) in out.iter_mut().zip(points) {\n            *target = rest.iter().rev().fold(leading, |value, &coefficient| {\n                <Self as Arithmetic<F>>::mul(value, point) ^ coefficient\n            });\n        }\n    }\n}\n"},{"id":8,"name":{"Local":"src/backend/x86_pclmul.rs"},"crate_name":"bulksketch","contents":"//! Scalar XMM kernels; only checked dispatch and feature-checked tests reach this module.\n#![allow(unsafe_code)]\n\n#[cfg(test)]\nuse std::arch::x86_64::_mm_setzero_si128;\nuse {\n    super::contract::{Arithmetic, BulkKernels},\n    crate::{\n        field::{BinaryField, gf64, maps},\n        types::RawProduct,\n    },\n    std::arch::x86_64::{\n        __m128i, _mm_clmulepi64_si128, _mm_cvtsi64_si128, _mm_cvtsi128_si64, _mm_srli_si128,\n        _mm_xor_si128,\n    },\n};\n\n#[derive(Clone, Copy, Debug)]\npub(crate) struct Pclmul;\n\n#[cfg(test)]\npub(super) fn reduce_cl_for_test(product: RawProduct) -> u64 {\n    assert!(std::is_x86_feature_detected!(\"pclmulqdq\"));\n    // SAFETY: detection above checks PCLMUL; the other intrinsics need baseline SSE2.\n    unsafe {\n        let value = std::arch::x86_64::_mm_set_epi64x(\n            i64::from_ne_bytes(product.hi.to_ne_bytes()),\n            i64::from_ne_bytes(product.lo.to_ne_bytes()),\n        );\n        low(reduced::<crate::field::Gf64, true>(value))\n    }\n}\n\nimpl<F: BinaryField> Arithmetic<F> for Pclmul {\n    fn mul(a: u64, b: u64) -> u64 {\n        // SAFETY: Pclmul is selected only after runtime PCLMUL detection.\n        unsafe { multiply::<F, true>(a, b) }\n    }\n\n    fn square(a: u64) -> u64 {\n        // SAFETY: checked dispatch guarantees PCLMUL; SSE2 is architectural on x86-64.\n        unsafe { multiply::<F, true>(a, a) }\n    }\n\n    fn frobenius(a: u64, power: u32) -> u64 {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { frobenius::<F>(a, power) }\n    }\n\n    fn inverse(a: u64) -> Option<u64> {\n        #[cfg(test)]\n        super::test_observer::inverse();\n        #[cfg(test)]\n        crate::types::small_degree_observer::inverse();\n        // SAFETY: checked dispatch detects PCLMULQDQ before selecting this backend.\n        unsafe { inverse::<F>(a) }\n    }\n\n    fn trace(a: u64) -> u8 {\n        maps::trace::<F>(a)\n    }\n\n    fn solve_quadratic(a: u64) -> Option<u64> {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { solve_quadratic::<F>(a) }\n    }\n\n    fn raw_mul(a: u64, b: u64) -> RawProduct {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { raw_product(a, b) }\n    }\n\n    fn reduce(product: RawProduct) -> u64 {\n        gf64::reduce::<F>(product)\n    }\n\n    #[cfg(test)]\n    fn dot(a: &[u64], b: &[u64]) -> u64 {\n        assert_eq!(a.len(), b.len(), \"dot length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { dot::<F, false>(a, b) }\n    }\n\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64) {\n        assert_eq!(dst.len(), src.len(), \"scale_xor length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { scale_xor::<F, true>(dst, src, scale) }\n    }\n\n    fn square_slice(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"square_slice length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { square_slice::<F, true>(dst, src) }\n    }\n}\n\nimpl<F: BinaryField> BulkKernels<F> for Pclmul {\n    fn insert_nonzero(odd: &mut [u64], ids: &[u64]) {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { insert::<F, true>(odd, ids) }\n    }\n\n    fn xor_assign(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"xor_assign length mismatch\");\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target ^= source;\n        }\n    }\n\n    fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]) {\n        assert_eq!(out.len(), points.len(), \"horner_many length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { horner::<F, true>(coefficients, points, out) }\n    }\n}\n\n#[inline]\nfn word(a: u64) -> __m128i {\n    // SAFETY: SSE2 is part of the x86-64 baseline, with no memory operands here.\n    unsafe { _mm_cvtsi64_si128(i64::from_ne_bytes(a.to_ne_bytes())) }\n}\n\n#[inline]\nfn low(product: __m128i) -> u64 {\n    // SAFETY: SSE2 is part of the x86-64 baseline, with no memory operands here.\n    u64::from_ne_bytes(unsafe { _mm_cvtsi128_si64(product) }.to_ne_bytes())\n}\n\n#[inline]\nfn words(product: __m128i) -> RawProduct {\n    // SAFETY: SSE2 is architectural on x86-64; the shift stays within this register.\n    let high = unsafe { _mm_srli_si128::<8>(product) };\n    RawProduct {\n        lo: low(product),\n        hi: low(high),\n    }\n}\n\n#[inline]\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn raw_product(a: u64, b: u64) -> RawProduct {\n    words(_mm_clmulepi64_si128::<0x00>(word(a), word(b)))\n}\n\n#[inline]\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn reduced<F: BinaryField, const CL: bool>(product: __m128i) -> __m128i {\n    if CL && F::BITS == 64 {\n        let modulus = word(F::MODULUS_LOW);\n        let first = _mm_clmulepi64_si128::<0x01>(product, modulus);\n        let second = _mm_clmulepi64_si128::<0x01>(first, modulus);\n        _mm_xor_si128(_mm_xor_si128(product, first), second)\n    } else {\n        word(gf64::reduce::<F>(words(product)))\n    }\n}\n\n#[inline]\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn multiply<F: BinaryField, const CL: bool>(a: u64, b: u64) -> u64 {\n    let product = _mm_clmulepi64_si128::<0x00>(word(a), word(b));\n    // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n    low(unsafe { reduced::<F, CL>(product) })\n}\n\n#[cfg(test)]\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn dot<F: BinaryField, const CL: bool>(a: &[u64], b: &[u64]) -> u64 {\n    let mut sum = _mm_setzero_si128();\n    for (&left, &right) in a.iter().zip(b) {\n        sum = _mm_xor_si128(sum, _mm_clmulepi64_si128::<0x00>(word(left), word(right)));\n    }\n    // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n    low(unsafe { reduced::<F, CL>(sum) })\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn scale_xor<F: BinaryField, const CL: bool>(dst: &mut [u64], src: &[u64], scale: u64) {\n    if scale == 0 {\n        return;\n    }\n    if scale == 1 {\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target ^= source;\n        }\n        return;\n    }\n    let scale = word(scale);\n    for (target, &source) in dst.iter_mut().zip(src) {\n        let product = _mm_clmulepi64_si128::<0x00>(word(source), scale);\n        // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n        *target ^= low(unsafe { reduced::<F, CL>(product) });\n    }\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn square_slice<F: BinaryField, const CL: bool>(dst: &mut [u64], src: &[u64]) {\n    for (target, &source) in dst.iter_mut().zip(src) {\n        let source = word(source);\n        let product = _mm_clmulepi64_si128::<0x00>(source, source);\n        // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n        *target = low(unsafe { reduced::<F, CL>(product) });\n    }\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn insert<F: BinaryField, const CL: bool>(odd: &mut [u64], ids: &[u64]) {\n    let Some((first, successors)) = odd.split_first_mut() else {\n        return;\n    };\n    for &id in ids {\n        *first ^= id;\n        // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n        let square = word(unsafe { multiply::<F, false>(id, id) });\n        let mut power = word(id);\n        for syndrome in &mut *successors {\n            let product = _mm_clmulepi64_si128::<0x00>(power, square);\n            // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n            power = unsafe { reduced::<F, CL>(product) };\n            *syndrome ^= low(power);\n        }\n    }\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn horner<F: BinaryField, const CL: bool>(\n    coefficients: &[u64],\n    points: &[u64],\n    out: &mut [u64],\n) {\n    let Some((&leading, rest)) = coefficients.split_last() else {\n        out.fill(0);\n        return;\n    };\n    for (target, &point) in out.iter_mut().zip(points) {\n        let point = word(point);\n        let mut value = word(leading);\n        for &coefficient in rest.iter().rev() {\n            let product = _mm_clmulepi64_si128::<0x00>(value, point);\n            // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n            value = _mm_xor_si128(unsafe { reduced::<F, CL>(product) }, word(coefficient));\n        }\n        *target = low(value);\n    }\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn frobenius<F: BinaryField>(mut a: u64, power: u32) -> u64 {\n    if F::BITS == 64\n        && let Some(value) = crate::field::frobenius::lookup(a, power % F::BITS)\n    {\n        return value;\n    }\n    for _ in 0..power % F::BITS {\n        // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n        a = unsafe { multiply::<F, false>(a, a) };\n    }\n    a\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn inverse<F: BinaryField>(a: u64) -> Option<u64> {\n    if F::BITS != 64 {\n        return maps::inverse_with_frobenius::<F>(\n            a,\n            // SAFETY: the enclosing function requires PCLMULQDQ.\n            |left, right| unsafe { multiply::<F, true>(left, right) },\n            // SAFETY: the enclosing function requires PCLMULQDQ.\n            |value, power| unsafe { frobenius::<F>(value, power) },\n        );\n    }\n    if a == 0 {\n        return None;\n    }\n    if a == 1 {\n        return Some(1);\n    }\n    // t_k = a^(2^k - 1). The chain 1,2,3,6,7,14,21,42,63 uses\n    // eight products; fixed linear maps replace the long Frobenius runs.\n    let map7 = |value| crate::field::frobenius::lookup(value, 7).expect(\"fixed inverse map\");\n    let map21 = crate::field::frobenius::inverse21;\n    // SAFETY: every multiply below requires the enclosing PCLMULQDQ feature.\n    unsafe {\n        let t2 = multiply::<F, true>(multiply::<F, false>(a, a), a);\n        let t3 = multiply::<F, true>(multiply::<F, false>(t2, t2), a);\n        let f3 = crate::field::frobenius::lookup(t3, 3).expect(\"fixed inverse map\");\n        let t6 = multiply::<F, true>(f3, t3);\n        let t7 = multiply::<F, true>(multiply::<F, false>(t6, t6), a);\n        let t14 = multiply::<F, true>(map7(t7), t7);\n        let t21 = multiply::<F, true>(map7(t14), t7);\n        let t42 = multiply::<F, true>(map21(t21), t21);\n        let t63 = multiply::<F, true>(map21(t42), t21);\n        Some(multiply::<F, false>(t63, t63))\n    }\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn solve_quadratic<F: BinaryField>(a: u64) -> Option<u64> {\n    if maps::trace::<F>(a) != 0 {\n        return None;\n    }\n    let solution = maps::quadratic_value::<F>(a);\n    // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n    let square = unsafe { multiply::<F, false>(solution, solution) };\n    assert_eq!(square ^ solution, a, \"quadratic-map invariant\");\n    Some(solution)\n}\n"},{"id":9,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"src/field/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical field identity, arithmetic and test-only tiny fields.\n#![forbid(unsafe_code)]\n\nuse crate::types::FieldId;\n\n#[cfg(test)]\npub(crate) mod arithmetic_tests;\n#[cfg(test)]\nmod constant_tests;\n#[cfg(any(target_arch = \"x86_64\", test))]\npub(crate) mod frobenius;\npub(crate) mod gf64;\npub(crate) mod maps;\nmod quadratic_chunks;\n#[cfg(test)]\npub(crate) mod reference;\n#[cfg(test)]\npub(crate) mod tiny;\n\npub(crate) mod sealed {\n    pub trait Sealed {}\n}\n\n/// Closed field specification. Kernels consume canonical words, never masked IDs.\npub trait BinaryField: sealed::Sealed + Copy + Eq + Send + Sync + 'static {\n    /// Extension degree over GF(2).\n    const BITS: u32;\n    /// Irreducible polynomial without its leading term.\n    const MODULUS_LOW: u64;\n    /// Registered polynomial/basis identity.\n    const WIRE_ID: FieldId;\n    /// Canonical element mask.\n    const MASK: u64;\n}\n\n/// Full-width GF(2^64) identity field.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub struct Gf64;\nimpl sealed::Sealed for Gf64 {}\nimpl BinaryField for Gf64 {\n    const BITS: u32 = 64;\n    const MODULUS_LOW: u64 = 0x1b;\n    const WIRE_ID: FieldId = FieldId::Gf64;\n    const MASK: u64 = u64::MAX;\n}\n"},{"id":14,"name":{"Local":"src/types.rs"},"crate_name":"bulksketch","contents":"//! Value-only definitions; this module has no dependency on the engine layers.\n#![forbid(unsafe_code)]\n\n/// Polynomial-basis identity, including the irreducible polynomial.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[repr(u8)]\npub enum FieldId {\n    /// GF(2^64), modulus Z^64 + Z^4 + Z^3 + Z + 1, bit i is Z^i.\n    Gf64 = 1,\n}\n\n/// Shape admission failure, before any row storage is allocated.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ShapeError {\n    /// Unsupported field, zero/non-power-of-two row count, or zero capacity.\n    InvalidShape,\n    /// Configured storage/dimension cap or representable wire dimension exceeded.\n    InputLimitExceeded,\n}\n\n/// Bounded wire admission failure. No view is exposed on either error.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ParseError {\n    /// A caller-supplied byte or dimension limit was exceeded.\n    InputLimitExceeded,\n    /// Unknown metadata, malformed lengths, or noncanonical payload.\n    InvalidEncoding,\n}\n\nimpl std::fmt::Display for ShapeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InvalidShape => \"invalid sketch shape\",\n            Self::InputLimitExceeded => \"shape input limit exceeded\",\n        })\n    }\n}\nimpl std::error::Error for ShapeError {}\n\nimpl std::fmt::Display for ParseError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InputLimitExceeded => \"wire input limit exceeded\",\n            Self::InvalidEncoding => \"invalid sketch encoding\",\n        })\n    }\n}\nimpl std::error::Error for ParseError {}\n\n/// Runtime arithmetic capability. No complete-operation dispatch lives in this type.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub enum BackendId {\n    /// Always-available safe Rust arithmetic.\n    Portable,\n    /// Scalar x86 carryless multiplication.\n    Pclmul,\n    /// 256-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul256,\n    /// 512-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul512,\n}\n\n/// Backend selection requested at engine construction, before any decode.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum BackendRequest {\n    /// Select from capabilities detected at runtime.\n    Auto,\n    /// Require this capability; never bypass feature/OS-state validation.\n    Force(BackendId),\n}\n\n/// An explicitly requested backend is unavailable in this build or on this CPU/OS.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct BackendError(pub BackendId);\n\n/// Construction of mutable state failed before any state was returned.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CreateError {\n    /// The requested arithmetic implementation is unavailable.\n    Backend(BackendError),\n    /// The algebraic buffers could not be reserved.\n    AllocationFailed,\n}\n\n/// Batch insertion failed before changing the sketch.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum UpdateError {\n    /// The supplied insertion arena cannot hold this call's IDs or row offsets.\n    ScratchTooSmall,\n}\n\n/// XOR requires identical fields, row counts and capacities.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ShapeMismatch;\n\n/// Encoding failed without changing the destination or algebraic state.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum EncodeError {\n    /// The destination cannot hold the complete record.\n    BufferTooSmall,\n    /// The cached record could not be reserved.\n    AllocationFailed,\n}\n\nimpl std::fmt::Display for CreateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            Self::Backend(error) => error.fmt(f),\n            Self::AllocationFailed => f.write_str(\"sketch allocation failed\"),\n        }\n    }\n}\nimpl std::error::Error for CreateError {}\nimpl std::fmt::Display for UpdateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"insertion scratch is too small\")\n    }\n}\nimpl std::error::Error for UpdateError {}\nimpl std::fmt::Display for ShapeMismatch {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"sketch shapes differ\")\n    }\n}\nimpl std::error::Error for ShapeMismatch {}\nimpl std::fmt::Display for EncodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::BufferTooSmall => \"encoding buffer is too small\",\n            Self::AllocationFailed => \"encoding allocation failed\",\n        })\n    }\n}\nimpl std::error::Error for EncodeError {}\n\nimpl std::fmt::Display for BackendError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        write!(f, \"backend {:?} is unavailable\", self.0)\n    }\n}\nimpl std::error::Error for BackendError {}\n\n/// Backend-independent logical work, never elapsed time or instruction count.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]\npub struct WorkUnits(pub u64);\n\n/// A request-wide failure publishes no row report or provisional IDs.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeError {\n    /// Local and remote fields, row counts or capacities differ.\n    ShapeMismatch,\n    /// Unknown plan or an output budget larger than any row capacity.\n    InvalidPlan,\n    /// Raw candidate count exceeds the request cap, before normalization.\n    CandidateLimitExceeded,\n    /// Work arithmetic overflows or the next charge exceeds the request limit.\n    WorkLimitExceeded,\n    /// Layout overflows, exceeds its byte cap, or any supplied segment is short.\n    ScratchTooSmall,\n}\n\n/// An admitted row failed algebraically; independently successful rows remain usable.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeFailure {\n    /// Zero consumes an unavailable slot, or locator/final output exceeds beta.\n    DegreeExceedsBudget,\n    /// The locator fails required canonicality/algebraic validation.\n    InvalidLocator,\n    /// The locator does not split into distinct permitted field roots.\n    NotSplit,\n    /// Re-encoding fails any stored odd syndrome or the zero channel.\n    VerificationFailed,\n}\n\nimpl std::fmt::Display for DecodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::ShapeMismatch => \"sketch shapes differ\",\n            Self::InvalidPlan => \"invalid decode plan or output budget\",\n            Self::CandidateLimitExceeded => \"candidate input limit exceeded\",\n            Self::WorkLimitExceeded => \"decode work limit exceeded\",\n            Self::ScratchTooSmall => \"decode scratch is too small\",\n        })\n    }\n}\nimpl std::error::Error for DecodeError {}\n\n/// Deterministic stage order. Repeated trace/GCD/division/leaf stages follow factor traversal.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Stage {\n    /// Propose the nonzero root S1 before general decoding.\n    DirectOne,\n    /// Derive a distinct nonzero pair from S1 and S3 before general decoding.\n    DirectTwo,\n    /// Reject inconsistent cubic prefixes before inversion (V3).\n    GuardThree,\n    /// Normalize a passed cubic Newton guard (V3).\n    NewtonThree,\n    /// Reject inconsistent quartic prefixes before inversion (V3).\n    GuardFour,\n    /// Normalize a passed quartic Newton guard (V3).\n    NewtonFour,\n    /// Propose the roots of a cubic factor (V3).\n    LeafThree,\n    /// Propose the roots of a quartic factor (V3).\n    LeafFour,\n    /// Certify a complete distinct nonzero factor root set (V3).\n    FactorVerification,\n    /// Expand odd syndromes and reconstruct even powers.\n    Reconstruction,\n    /// Binary Berlekamp-Massey iterations.\n    BerlekampMassey,\n    /// Evaluate the original locator at normalized hints.\n    CandidateEvaluation,\n    /// Divide out confirmed candidate roots.\n    Deflation,\n    /// Build a factor's modular-square table.\n    ReducerPreparation,\n    /// Find the least affine multiple and solve its binary map (V3).\n    AffinePreparation,\n    /// Enumerate and evaluate the recovered affine solution coset (V3).\n    AffineEnumeration,\n    /// Form an annihilator splitter for the current affine coset (V3).\n    AffineSplit,\n    /// Try the next canonical trace direction and the internal split check.\n    Trace,\n    /// Compute a monic polynomial GCD.\n    Gcd,\n    /// Divide a factor exactly after a proper split.\n    FactorDivision,\n    /// Solve degree-one or degree-two leaves.\n    Leaf,\n    /// Verify every stored odd syndrome by re-encoding or rebuilt recurrence.\n    Verification,\n    /// Sort and validate the final original IDs.\n    Canonicalization,\n}\n\n/// Public stage progress contains no row outcome or provisional ID.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum StageProgress {\n    /// A deterministic stage completed; counters are cumulative for the request.\n    Completed {\n        /// Bucket whose stage completed, in deterministic request traversal order.\n        bucket: usize,\n        /// Stage just executed.\n        stage: Stage,\n        /// Logical work consumed so far.\n        work: WorkUnits,\n        /// Peak required workspace bytes, excluding unused arena capacity.\n        peak_scratch_bytes: usize,\n        /// Original BM locator degree for this row; zero until BM completes.\n        locator_degree: usize,\n        /// Confirmed candidate roots so far in this row.\n        candidate_hits: usize,\n        /// Trace directions attempted so far in this row.\n        trace_attempts: usize,\n        /// Degree returned by this row's most recent GCD; zero before the first GCD.\n        gcd_degree: usize,\n    },\n    /// Terminal request failure; finishing the job must return this error.\n    Failed(DecodeError),\n}\n\n/// Internal arithmetic product, distinct from a canonical field element.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub(crate) struct RawProduct {\n    pub(crate) lo: u64,\n    pub(crate) hi: u64,\n}\n\n/// One request meter, shared by preprocessing and all rows. A failed charge is terminal.\n#[derive(Debug)]\npub(crate) struct WorkMeter {\n    limit: WorkUnits,\n    used: WorkUnits,\n    exhausted: bool,\n}\n\nimpl WorkMeter {\n    pub(crate) fn new(limit: WorkUnits) -> Self {\n        Self {\n            limit,\n            used: WorkUnits(0),\n            exhausted: false,\n        }\n    }\n\n    pub(crate) fn charge(&mut self, charge: WorkUnits) -> Result<(), DecodeError> {\n        let next = self.used.0.checked_add(charge.0);\n        if self.exhausted || next.is_none_or(|n| n > self.limit.0) {\n            self.exhausted = true;\n            return Err(DecodeError::WorkLimitExceeded);\n        }\n        self.used = WorkUnits(next.expect(\"checked work charge\"));\n        Ok(())\n    }\n\n    pub(crate) fn used(&self) -> WorkUnits {\n        self.used\n    }\n}\n\n#[cfg(test)]\npub(crate) mod small_degree_observer;\n"},{"id":15,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/iter/adapters/rev.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/iter/adapters/mod.rs"},"crate_name":"core","contents":null},{"id":21,"name":{