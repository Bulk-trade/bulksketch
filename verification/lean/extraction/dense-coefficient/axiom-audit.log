fun {F K} =>
  BulksketchBridge.DenseCoefficient.xor_coefficient_refines : ∀ {F K : Type} (field : bulksketch.field.BinaryField F)
  (backend : bulksketch.backend.contract.BulkKernels K F) (original : Aeneas.Std.Slice Aeneas.Std.U64)
  (length index : Aeneas.Std.Usize) (value : Aeneas.Std.U64),
  have source :=
    bulksketch.poly.Dense.Insts.BulksketchPolyPolynomial.xor_coefficient field backend original length index value;
  if ↑length ≤ original.length ∧ ↑index < original.length then
    ∃ normalized result,
      source = Aeneas.Std.Result.ok (normalized, result) ∧
        result.length = original.length ∧
          (∀ slot < original.length,
              result[slot]! =
                BulksketchBridge.DenseCoefficient.expectedCoefficient original (↑length) (↑index) value slot) ∧
            ↑normalized =
              BulksketchBridge.DenseNormalization.normalizedLength
                (List.take (BulksketchBridge.DenseCoefficient.activeSize ↑length ↑index) ↑result)
  else source = Aeneas.Std.Result.fail Aeneas.Std.Error.assertionFailure
BulksketchBridge.DenseCoefficient.xor_coefficient_polynomial_refines : BulksketchBridge.DenseCoefficient.XorCoefficientPolynomialRefines
'BulksketchBridge.DenseCoefficient.xor_coefficient_refines' depends on axioms: [propext, Classical.choice, Quot.sound]
'BulksketchBridge.DenseCoefficient.xor_coefficient_polynomial_refines' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'BulksketchBridge.DenseCoefficient.normalized_prefix_polynomial' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'BulksketchBridge.DenseCoefficient.coefficient_frame' depends on axioms: [propext, Classical.choice, Quot.sound]
