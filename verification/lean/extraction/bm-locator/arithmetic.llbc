},"source_text":"pub(crate) fn cost(charge: Charge) -> Result<WorkUnits, DecodeError> {\n        let cost = match charge {\n            Charge::Admission { rows } => add(1, number(rows)?)?,\n            Charge::Normalize { inputs } => mul(number(inputs)?, add(log2_ceil(inputs), 3)?)?,\n            Charge::Compare { capacity } => add(number(capacity)?, 1)?,\n            Charge::DirectOne => 1,\n            Charge::DirectTwo => 168,\n            Charge::GuardThree => 48,\n            Charge::NewtonThree => 144,\n            Charge::GuardFour => 80,\n            Charge::NewtonFour => 160,\n            Charge::LeafThree => 640,\n            Charge::LeafFour => 2048,\n            Charge::FactorVerification { degree } => {\n                add(add(mul(2, square(degree)?)?, mul(4, number(degree)?)?)?, 1)?\n            }\n            Charge::Reconstruct { capacity } => mul(3, number(capacity)?)?,\n            Charge::BmStep { budget } => add(mul(6, add(number(budget)?, 1)?)?, 128)?,\n            Charge::Candidates { degree, inputs } => {\n                mul(mul(2, number(inputs)?)?, add(number(degree)?, 1)?)?\n            }\n            Charge::Deflate { degree } => mul(mul(2, number(degree)?)?, add(number(degree)?, 1)?)?,\n            Charge::AffinePreparation { degree } => {\n                let d = number(degree)?;\n                let d2 = mul(d, d)?;\n                add(\n                    add(mul(5, mul(d2, d)?)?, mul(16, d2)?)?,\n                    add(mul(327, d)?, 16900)?,\n                )?\n            }\n            Charge::AffineEnumeration { degree, rank } => {\n                let points = 1_u64\n                    .checked_shl(u32::try_from(rank).map_err(|_| DecodeError::WorkLimitExceeded)?)\n                    .ok_or(DecodeError::WorkLimitExceeded)?;\n                add(\n                    mul(mul(2, points)?, add(number(degree)?, 2)?)?,\n                    add(number(degree)?, 1)?,\n                )?\n            }\n            Charge::AffineSplit { degree, rank } => {\n                let d = number(degree)?;\n                add(\n                    mul(\n                        number(rank)?,\n                        add(square_mod(degree)?, add(mul(3, d)?, 3)?)?,\n                    )?,\n                    add(mul(3, d)?, 1)?,\n                )?\n            }\n\n            Charge::VerifyLfsr {\n                capacity,\n                output_budget,\n                degree,\n            } => add(\n                mul(add(mul(3, number(degree)?)?, 4)?, number(capacity)?)?,\n                add(number(degree)?, add(number(output_budget)?, 3)?)?,\n            )?,\n            Charge::Table { degree } => add(mul(8, square(degree)?)?, mul(2, number(degree)?)?)?,\n            Charge::Trace { degree } => mul(63, add(square_mod(degree)?, 2)?)?,\n            Charge::SplitCheck { degree } => add(square_mod(degree)?, add(number(degree)?, 1)?)?,\n            Charge::Gcd { degree } => {\n                let n = add(number(degree)?, 1)?;\n                add(mul(8, mul(n, n)?)?, mul(128, n)?)?\n            }\n            Charge::Divide { degree } => {\n                let n = add(number(degree)?, 1)?;\n                add(mul(4, mul(n, n)?)?, 128)?\n            }\n            Charge::SplitAssembly { degree } => mul(4, add(number(degree)?, 1)?)?,\n            Charge::Leaf { degree } => match degree {\n                0 => 0,\n                1 => 1,\n                2 => 160,\n                _ => panic!(\"leaf degree must be at most two\"),\n            },\n            Charge::Verify {\n                capacity,\n                output_budget,\n            } => {\n                let beta = number(output_budget)?;\n                add(\n                    mul(add(mul(2, beta)?, 3)?, number(capacity)?)?,\n                    add(beta, 1)?,\n                )?\n            }\n            Charge::Canonicalize { ids } => mul(number(ids)?, add(log2_ceil(ids), 1)?)?,\n        };\n        Ok(WorkUnits(cost))\n    }","attr_info":{"attributes":[{"DocComment":" The constants reserve a fixed inversion envelope of 128 field operations."},{"DocComment":" Degree-dependent polynomial charges include normalization/copies. A driver"},{"DocComment":" charges each macro once; kernels underneath do not recursively charge it again."},{"Builtin":{"Inline":["Always",{"Untagged":{"data":{"file_id":17,"beg":{"line":107,"col":4},"end":{"line":107,"col":21}},"generated_from_span":null}}]}}],"inline":"Always","rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":48}],"output":{"Deduplicated":47}},"src":"Normal","body":{"Structured":{"span":{"Value":[374,{"data":{"file_id":17,"beg":{"line":108,"col":4},"end":{"line":197,"col":5}},"generated_from_span":null}]},"bound_body_regions":7,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"Value":[375,{"data":{"file_id":17,"beg":{"line":108,"col":42},"end":{"line":108,"col":72}},"generated_from_span":null}]},"ty":{"Deduplicated":47},"drop_flag_for":null},{"index":1,"name":"charge","span":{"Value":[376,{"data":{"file_id":17,"beg":{"line":108,"col":23},"end":{"line":108,"col":29}},"generated_from_span":null}]},"ty":{"Deduplicated":48},"drop_flag_for":null},{"index":2,"name":"cost","span":{"Value":[377,{"data":{"file_id":17,"beg":{"line":109,"col":12},"end":{"line":109,"col":16}},"generated_from_span":null}]},"ty":{"Deduplicated":11},"drop_flag_for":null},{"index":3,"name":"rows","span":{"Value":[378,{"data":{"file_id":17,"beg":{"line":110,"col":32},"end":{"line":110,"col":36}},"generated_from_span":null}]},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":4,"name":null,"span":{"Value":[379,{"data":{"file_id":17,"beg":