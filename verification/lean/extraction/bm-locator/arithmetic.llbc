n be safely performed."},{"DocComment":""},{"DocComment":" You can use the `Arguments<'a>` that [`format_args!`] returns in `Debug`"},{"DocComment":" and `Display` contexts as seen below. The example also shows that `Debug`"},{"DocComment":" and `Display` format to the same thing: the interpolated format string"},{"DocComment":" in `format_args!`."},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" let debug = format!(\"{:?}\", format_args!(\"{} foo {:?}\", 1, 2));"},{"DocComment":" let display = format!(\"{}\", format_args!(\"{} foo {:?}\", 1, 2));"},{"DocComment":" assert_eq!(\"1 foo 2\", display);"},{"DocComment":" assert_eq!(display, debug);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`format()`]: ../../std/fmt/fn.format.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"FormatArguments","diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":"'a","variance":"Covariant","mutability":"Shared","late_bound":false}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"aarch64-apple-darwin","value":{"size":{"chosen":{"Deduplicated":130},"guarantee":null},"align":{"chosen":{"Deduplicated":28},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0},{"guarantee":null,"chosen":8}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":null},{"def_id":27,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["types",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4},"kind":"InherentImplBlock"}}},{"Ident":["charge",0]},