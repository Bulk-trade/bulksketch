an":{"Untagged":{"data":{"file_id":13,"beg":{"line":68,"col":4},"end":{"line":82,"col":5}},"generated_from_span":null}},"source_text":"fn odd_recurrence_matches(odd: &[u64], squared_locator: &[u64]) -> bool {\n        let degree = squared_locator.len() - 1;\n        for index in degree..odd.len() {\n            let mut sum = RawProduct::default();\n            for lag in 1..=degree {\n                let product = Self::raw_mul(odd[index - lag], squared_locator[lag]);\n                sum.lo ^= product.lo;\n                sum.hi ^= product.hi;\n            }\n            if Self::reduce(sum) != odd[index] {\n                return false;\n            }\n        }\n        true\n    }","attr_info":{"attributes":[{"DocComment":" Check all odd-sequence continuation equations, after the caller has"},{"DocComment":" independently verified its first d words. squared_locator is rebuilt"},{"DocComment":" from roots, has d+1 ascending words and constant coefficient one."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":279},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":12},{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":34},{"Deduplicated":315}],"output":{"Deduplicated":14}},"src":{"TraitDefault":{"trait_ref":{"id":5,"generics":{"regions":[],"ty