+(* Selector for the preceding read-only discrepancy chain. *)
+let bm_shared_component span (ctx : eval_ctx) =
+  let ( let* ) = Option.bind in
+  let unique f xs = match List.filter_map f xs with [x] -> Some x | _ -> None in
+  let active (abs : abs) =
+    abs.can_end && AbsId.Set.is_empty abs.parents && not (abs_has_markers abs)
