+  (* Expose a shared terminal return to tail-position loops before lowering
+     their local exits. A final switch may have hoisted the common return and
+     storage-dead statements outside its arms. Appending this exact epilogue
+     to each fallthrough arm preserves its execution and local lifetimes.
+     Do not descend into a loop or move a nontrivial continuation. *)
+  let rec split_dead suffix = function
+    | ({ kind = StorageDead _; _ } as st) :: rest -> split_dead (st :: suffix) rest
+    | rest -> (rest, suffix)
+  in
+  let has_return block =
+    let visitor = object
+      inherit [_] iter_statement
+      method! visit_Return _ = raise Found
+    end in
+    try visitor#visit_block () block; false with Found -> true
+  in
+  let rec needs_local_return block =
+    match fst (split_dead [] (List.rev block.statements)) with
+    | { kind = Loop body; _ } :: _ -> has_return body
+    | { kind = Switch (_, arms); _ } :: _ -> List.exists needs_local_return arms
+    | _ -> false
+  in
+  let rec expose_return block =
+    match List.rev block.statements with
+    | ({ kind = Return; _ } as ret) :: rev -> (
+        match split_dead [ret] rev with
+        | ({ kind = Switch (data, arms); _ } as switch) :: prefix, suffix
+          when List.exists needs_local_return arms ->
+            let add_epilogue arm =
+              match List.rev arm.statements with
+              | { kind = (Return | Panic _ | UnwindTerminate | UndefinedBehavior | UnwindResume); _ } :: _ -> arm
+              | _ -> expose_return { arm with statements = arm.statements @ suffix }
+            in
+            { block with statements =
+                List.rev ({ switch with kind = Switch (data, List.map add_epilogue arms) } :: prefix) }
+        | _ -> block)
+    | _ -> block
+  in
   (* Map  *)
   let body =
     match f.body with
     | StructuredBody body ->
-        StructuredBody { body with body = visitor#visit_block 0 body.body }
+        let block =
+          if Config.bm_locator_enabled () &&
+             Errors.raw_span_to_string span = "'src/decode/bm.rs', lines 14:0-98:1"
+          then expose_return body.body else body.body
+        in
+        StructuredBody { body with body = visitor#visit_block 0 block }
     | other -> other
   in
 
