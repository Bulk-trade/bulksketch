+           && proj.sv_id <> leaf.sv_id && proj.proj_ty = leaf.proj_ty
+           && shared_view abs proj -> Some (proj, label, leaf)
+    | _ -> None) in
+  let* zip, () = find (fun abs ->
+    if not (fun_call abs) then None
+    else field abs (function
+      | ASymbolic (PNone, AProjLoans { proj; consumed = []; borrows = [
+          (tag, AProjBorrows { proj = back; loans = [] }) ] })
+        when tag = label && same_slot loop owner abs proj
+             && same_slot loop leaf abs back && shared_view abs proj -> Some ()
+      | _ -> None)) in
+  let predecessor (abs : abs) =
+    let* borrowed = field abs (function
+      | ASymbolic (PNone, AProjBorrows { proj; loans = [] })
+        when shared_view abs proj -> Some proj
+      | _ -> None) in
+    find (fun upstream ->
+      if not (fun_call upstream) then None
+      else field upstream (function
+        | ASymbolic (PNone, AProjLoans { proj; consumed = []; borrows = [] })
+          when same_slot abs borrowed upstream proj && shared_view upstream proj -> Some ()
+        | _ -> None))
+  in
+  let* reverse, () = predecessor zip in
+  let* iterator, () = predecessor reverse in
+  let* slice_borrow = field iterator (function
+    | ABorrow (ASharedBorrow (PNone, bid, _)) -> Some bid
+    | _ -> None) in
+  let* slice, () = find (fun abs ->
+    if not (fun_call abs) then None
+    else field abs (function
+      | ALoan (ASharedLoan (PNone, bid,
+          { value = VSymbolic { sv_ty = TSlice (TScalar _, _); _ }; _ }, _))
+        when bid = slice_borrow -> Some ()
+      | _ -> None)) in
+  let ids = AbsId.Set.of_list [loop.abs_id; zip.abs_id; reverse.abs_id; iterator.abs_id; slice.abs_id] in
+  if AbsId.Set.cardinal ids = 5 then Some (ids, slice_borrow) else None
+
+let diagnose_bm_shared_ending (config : config) (span : Meta.span) : cm_fun =
+ fun ctx ->
+  if Config.bm_locator_enabled () &&
+     Errors.raw_span_to_string span = "'src/decode/bm.rs', lines 69:48-69:49"
+  then (
+    match bm_shared_component span ctx with
+    | None -> (ctx, fun expr -> expr)
+    | Some (ids, loan) ->
+        let scope, env = List.partition (function
+          | EAbs abs -> AbsId.Set.mem abs.abs_id ids
+          | _ -> false) ctx.env in
+        let component, _ = compute_env_ids scope in
+        let outside = { ctx with env } in
+        let outside_ids, _ = compute_ctx_ids outside in
+        let isolated = SymbolicValueId.Set.disjoint component.sids outside_ids.sids
+          && not (BorrowId.Set.mem loan outside_ids.blids)
+          && AbsId.Map.for_all (fun _ (abs : abs) ->
+            AbsId.Set.disjoint abs.parents ids) (ctx_get_abs outside) in
+        Format.eprintf "BM-DYNAMIC-SHARED-PRE ids=%s isolated=%b
+%!"
+          (String.concat "," (List.map AbsId.to_string (AbsId.Set.elements ids))) isolated;
+        [%cassert] span (isolated && List.length scope = 5)
+          "BM shared diagnostic found a live external use";
+        let targets = AbsIdWithLevelSet.of_list
+          (List.map (fun abs_id -> { abs_id; level = 0 }) (AbsId.Set.elements ids)) in
+        let ended, backward = InterpBorrows.end_abs_set config span targets ctx in
+        let real_bindings (ctx : eval_ctx) = List.filter (function
+          | EBinding (BVar _, _) -> true | _ -> false) ctx.env in
+        [%cassert] span (List.equal equal_env_elem (real_bindings ctx) (real_bindings ended)
+            && AbsId.Set.for_all (fun aid -> Option.is_none (ctx_lookup_abs_opt ended aid)) ids)
+          "BM shared stock ending changed real bindings or retained selected abstractions";
+        Invariants.check_invariants span ended;
+        let rec inspect = function
+          | SA.EndAbs (_, abs, level, rest) ->
+              Format.eprintf "BM-DYNAMIC-SHARED-AST abs=%s level=%d
+%!"
+                (AbsId.to_string abs.abs_id) level;
