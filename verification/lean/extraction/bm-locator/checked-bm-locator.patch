+(* Structural selector for the line-80 indexed connection
+   writeback. The source place is pinned, but symbolic IDs may be refreshed. *)
+let bm_mutable_component span (ctx : eval_ctx) =
+  let ( let* ) = Option.bind in
+  let unique f xs = match List.filter_map f xs with [x] -> Some x | _ -> None in
+  let active (abs : abs) =
+    abs.can_end && AbsId.Set.is_empty abs.parents && not (abs_has_markers abs)
+    && (match RegionSet.elements abs.regions.owned with
+        | [RVar (Free id)] -> not (RegionId.Set.mem id ctx.ended_regions)
+        | _ -> false)
+  in
+  let abses = List.filter active (AbsId.Map.values (ctx_get_abs ctx)) in
+  let same_slot (a : abs) (p : symbolic_proj) (b : abs) (q : symbolic_proj) =
+    p.sv_id = q.sv_id
+    && Subst.erase_regions p.proj_ty = Subst.erase_regions q.proj_ty
+    && InterpBorrowsCore.projection_contains span ctx a.regions.owned p.proj_ty
+         b.regions.owned q.proj_ty
+    && InterpBorrowsCore.projection_contains span ctx b.regions.owned q.proj_ty
+         a.regions.owned p.proj_ty
+  in
+  let mut_view (abs : abs) (proj : symbolic_proj) =
+    ty_has_mut_borrow_for_region_in_set ctx.type_ctx.type_infos
+      abs.regions.owned proj.proj_ty
+  in
+  let exact_child (label : mconsumed_symb) (child : symbolic_proj) =
+    label.sv_id = child.sv_id && label.proj_ty = child.proj_ty
+  in
+  let find f = unique (fun (abs : abs) -> Option.map (fun v -> (abs, v)) (f abs)) abses in
+  let field (abs : abs) f = unique (fun (av : tavalue) -> f av.value) abs.avalues in
+  let fun_call (abs : abs) = match abs.kind with FunCall _ -> true | _ -> false in
+  let* loop, (owner, label, leaf) = find (fun abs ->
+    match abs.kind with
+    | Loop _ -> field abs (function
+        | ASymbolic (PNone, AProjBorrows { proj; loans = [
+            (label, AProjLoans { proj = leaf; consumed = []; borrows = [] }) ] })
+          when exact_child label leaf && proj.sv_id <> leaf.sv_id
+               && proj.proj_ty = leaf.proj_ty && mut_view abs proj ->
+            Some (proj, label, leaf)
+        | _ -> None)
+    | _ -> None) in
+  let* zip, () = find (fun abs ->
+    if not (fun_call abs) then None
+    else field abs (function
+      | ASymbolic (PNone, AProjLoans { proj; consumed = []; borrows = [
+          (tag, AProjBorrows { proj = back; loans = [] }) ] })
+        when tag = label && same_slot loop owner abs proj
+             && same_slot loop leaf abs back && mut_view abs proj -> Some ()
+      | _ -> None)) in
+  let* iterator_borrow = field zip (function
+    | ASymbolic (PNone, AProjBorrows { proj; loans = [] })
+      when mut_view zip proj && proj.sv_id <> owner.sv_id && proj.sv_id <> leaf.sv_id -> Some proj
+    | _ -> None) in
+  let* iterator, () = find (fun abs ->
+    if not (fun_call abs) then None
+    else field abs (function
+      | ASymbolic (PNone, AProjLoans { proj; consumed = []; borrows = [] })
+        when same_slot zip iterator_borrow abs proj && mut_view abs proj -> Some ()
+      | _ -> None)) in
+  let* inner = field iterator (function
