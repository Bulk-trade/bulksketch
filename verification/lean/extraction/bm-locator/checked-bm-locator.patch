+  let field (abs : abs) f = unique (fun (av : tavalue) -> f av.value) abs.avalues in
+  let fun_call (abs : abs) = match abs.kind with FunCall _ -> true | _ -> false in
+  let* loop, (owner, label, leaf) = find (fun abs ->
+    match abs.kind, abs.avalues with
+    | Loop _, [{ value = ASymbolic (PNone, AProjBorrows { proj; loans = [
+          ((label : mconsumed_symb), AProjLoans { proj = leaf; consumed = []; borrows = [] }) ] }); _ }]
