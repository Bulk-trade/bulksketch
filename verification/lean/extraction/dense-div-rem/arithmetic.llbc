  let (mut left_len, mut right_len) = (a.len(), b.len());\n        while right_len != 0 {\n            let (_, len) = <Self as Polynomial<F, K>>::div_rem_into(\n                &left[..left_len],\n                &right[..right_len],\n                quotient,\n                remainder,\n                raw,\n            );\n            std::mem::swap(&mut left, &mut right);\n            std::mem::swap(&mut right, &mut remainder);\n            left_len = right_len;\n            right_len = len;\n        }\n        dst[..max_len].fill(0);\n        if left_len != 0 {\n            if left[left_len - 1] == 1 {\n                dst[..left_len].copy_from_slice(&left[..left_len]);\n            } else {\n                let inverse =\n                    K::inverse(left[left_len - 1]).expect(\"nonzero gcd leading coefficient\");\n                K::scale_xor(&mut dst[..left_len], &left[..left_len], inverse);\n            }\n        }\n        left_len\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":4,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Unknown"},{"index":1,"name":"K","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":6,"col":8},"end":{"line":6,"col":19}},"generated_from_span":null}},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"ge