 rows add two.\n        if !degree.is_multiple_of(2) {\n            times_x_mod::<F, K>(current, modulus);\n        }\n        for row in 0..rows {\n            table[row * degree..(row + 1) * degree].copy_from_slice(current);\n            if row + 1 != rows {\n                times_x_mod::<F, K>(current, modulus);\n                times_x_mod::<F, K>(current, modulus);\n            }\n        }\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Unknown"},{"index":1,"name":"K","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":6,"col":8},"end":{"line":6,"col":19}},"generated_from_span":null}},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":6,"col":24},"end":{"line":6,"col":38}},"generated_from_span":null}},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}},{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Slice":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U64"}}}},null]}},"Shared"]}},{