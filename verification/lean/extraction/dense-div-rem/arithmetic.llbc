(odd: &[u64], squared_locator: &[u64]) -> bool {\n        let degree = squared_locator.len() - 1;\n        for index in degree..odd.len() {\n            let mut sum = RawProduct::default();\n            for lag in 1..=degree {\n                let product = Self::raw_mul(odd[index - lag], squared_locator[lag]);\n                sum.lo ^= product.lo;\n                sum.hi ^= product.hi;\n            }\n            if Self::reduce(sum) != odd[index] {\n                return false;\n            }\n        }\n        true\n    }","attr_info":{"attributes":[{"DocComment":" Check all odd-sequence continuation equations, after the caller has"},{"DocComment":" independently verified its first d words. squared_locator is rebuilt"},{"DocComment":" from roots, has d+1 ascending words and constant coefficient one."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null}},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Slice":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U64"}}}},null]}},"Shared"]}},{"Untagged":{"Ref":[{"Var":{"Free":1}},{"Un