""},{"DocComment":" ```"},{"DocComment":" let x: Option<u32> = Some(2);"},{"DocComment":" assert_eq!(x.is_none_or(|x| x > 1), true);"},{"DocComment":""},{"DocComment":" let x: Option<u32> = Some(0);"},{"DocComment":" assert_eq!(x.is_none_or(|x| x > 1), false);"},{"DocComment":""},{"DocComment":" let x: Option<u32> = None;"},{"DocComment":" assert_eq!(x.is_none_or(|x| x > 1), true);"},{"DocComment":""},{"DocComment":" let x: Option<String> = Some(\"ownership\".to_string());"},{"DocComment":" assert_eq!(x.as_ref().is_none_or(|x| x.len() > 1), true);"},{"DocComment":" println!(\"still alive {:?}\", x);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"T1","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[57,{"data":{"file_id":11,"beg":{"line":708,"col":42},"end":{"line":708,"col":67}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":9},{"Value":[48,{"Adt":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":8}],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}]},{"Deduplicated":7}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[58,{"data":{"file_id":11,"beg":{"line":708,"col":70},"end":{"line":708,"col":86}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":9}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[49,{"Adt":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":8}],"const_gener