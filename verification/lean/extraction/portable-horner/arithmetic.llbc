ocal words with unaligned little-endian remote words."},{"DocComment":" Equal word lengths; returns whether any output word is nonzero."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":733},{"Deduplicated":730},{"Value":[734,{"Ref":[{"Var":{"Bound":[0,2]}},{"Deduplicated":13},"Shared"]}]}],"output":{"Deduplicated":49}},"default":{"id":24,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}},{"Var":{"Bound":[0,2]}}],"types":[{"Deduplicated":10},{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}},"kind":{"TraitMethod":[5,6]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"horner_many","item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["BulkKernels",0]},{"Ident":["horner_many",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":120,"col":4},"end":{"line":120,"col":74}},"generated_from_span":null}},"source_text":"fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]);","attr_info":{"attributes":[{"DocComment":" Ascending coefficients; empty polynomial evaluates to zero. out.len=points.len."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":729},{"Deduplicated":730},{"Deduplic