        let product = <Self as Arithmetic<F>>::raw_mul(left, right);\n            sum.lo ^= product.lo;\n            sum.hi ^= product.hi;\n        }\n        <Self as Arithmetic<F>>::reduce(sum)\n    }\n\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64) {\n        assert_eq!(dst.len(), src.len(), \"scale_xor length mismatch\");\n        if scale == 0 {\n            return;\n        }\n        if scale == 1 {\n            <Self as BulkKernels<F>>::xor_assign(dst, src);\n            return;\n        }\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target ^= <Self as Arithmetic<F>>::mul(source, scale);\n        }\n    }\n\n    fn square_slice(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"square_slice length mismatch\");\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target = <Self as Arithmetic<F>>::square(source);\n        }\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":36},{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":410},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"implied_trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Value":[127,{"kind":{"TraitImpl":{"id":18,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},"trait_decl_ref":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":36}],"const_gen