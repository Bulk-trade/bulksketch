eates an iterator starting at the same point, but stepping by"},{"DocComment":" the given amount at each iteration."},{"DocComment":""},{"DocComment":" Note 1: The first element of the iterator will always be returned,"},{"DocComment":" regardless of the step given."},{"DocComment":""},{"DocComment":" Note 2: The time at which ignored elements are pulled is not fixed."},{"DocComment":" `StepBy` behaves like the sequence `self.next()`, `self.nth(step-1)`,"},{"DocComment":" `self.nth(step-1)`, …, but is also free to behave like the sequence"},{"DocComment":" `advance_n_and_return_first(&mut self, step)`,"},{"DocComment":" `advance_n_and_return_first(&mut self, step)`, …"},{"DocComment":" Which way is used may change for some iterators for performance reasons."},{"DocComment":" The second way will advance the iterator earlier and may consume more items."},{"DocComment":""},{"DocComment":" `advance_n_and_return_first` is the equivalent of:"},{"DocComment":" ```"},{"DocComment":" fn advance_n_and_return_first<I>(iter: &mut I, n: usize) -> Option<I::Item>"},{"DocComment":" where"},{"DocComment":"     I: Iterator,"},{"DocComment":" {"},{"DocComment":"     let next = iter.next();"},{"DocComment":"     if n > 1 {"},{"DocComment":"         iter.nth(n - 2);"},{"DocComment":"     }"},{"DocComment":"     next"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" The method will panic if the given step is `0`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [0, 1, 2, 3, 4, 5];"},{"DocComment":" let mut iter = a.into_iter().step_by(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":87},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10},{"Deduplicated":0}],"output":{"Value":[519,{"Adt":{"id":27,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":{"TraitDefault":{"trait_ref":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}},"item_id":7}},"body":"Opaque"},null,null,null,null,null,null,null,{"def_id":84,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["enumerate",0]}],"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":1058,"col":4},"end":{"line":1060,"col":20}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator which gives the current iteration count as well as"},{"DocComment":" the next value."},{"DocComment":""},{"DocComment":" The iterator returned yields pairs `(i, val)`, where `i` is the"},{"DocComment":" current index of iteration and `val` is the value returned by the"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" `enumerate()` keeps its count as a [`usize`]. If you want to count by a"},{"DocComment":" different sized integer, the [`zip`] function provides similar"},{"DocComment":" functionality."},{"DocComment":""},{"DocComment":" # Overflow Behavior"},{"DocComment":""},{"DocComment":" The method does no guarding against overflows, so enumerating more than"},{"DocComment":" [`usize::MAX`] elements either produces the wrong result or panics. If"},{"DocComment":" overflow checks are enabled, a panic is guaranteed."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" The returned iterator might panic if the to-be-returned index would"},{"DocComment":" overflow a [`usize`]."},{"DocComment":""},{"DocComment":" [`zip`]: Iterator::zip"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = ['a', 'b', 'c'];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().enumerate();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some((0, 'a')));"},{"DocComment":" assert_eq!(iter.next(), Some((1, 'b')));"},{"DocComment":" assert_eq!(iter.next(), Some((2, 'c')));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"enumerate_method","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":87},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10}],"output":{"Value":[520,{"Adt":{"id":34,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":{"TraitDefault":{"trait_ref":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}},"item_id":16}},"body":"Opaque"},null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,{"def_id":106,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["fold",0]}],"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":2674,"col":4},"end":{"line":2677,"col":64}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Folds every element into an accumulator by applying an operation,"},{"DocComment":" returning the final result."},{"DocComment":""},{"DocComment":" `fold()` takes two arguments: an initial value, and a closure with two"},{"DocComment":" arguments: an 'accumulator', and an element. The closure returns the value that"},{"DocComment":" the accumulator should have for the next iteration."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call."},{"DocComment":""},{"DocComment":" After applying this closure to every element of the iterator, `fold()`"},{"DocComment":" returns the accumulator."},{"DocComment":""},{"DocComment":" This operation is sometimes called 'reduce' or 'inject'."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" Note: `fold()`, and similar methods that traverse the entire iterator,"},{"DocComment":" might not terminate for infinite iterators, even on traits for which a"},{"DocComment":" result is determinable in finite time."},{"DocComment":""},{"DocComment":" Note: [`reduce()`] can be used to use the first element as the initial"},{"DocComment":" value, if the accumulator type and item type is the same."},{"DocComment":""},{"DocComment":" Note: `fold()` combines elements in a *left-associative* fashion. For associative"},{"DocComment":" operators like `+`, the order the elements are combined in is not important, but for non-associative"},{"DocComment":" operators like `-` the order will affect the final result."},{"DocComment":" For a *right-associative* version of `fold()`, see [`DoubleEndedIterator::rfold()`]."},{"DocComment":""},{"DocComment":" # Note to Implementors"},{"DocComment":""},{"DocComment":" Several of the other (forward) methods have default implementations in"},{"DocComment":" terms of this one, so try to implement this explicitly if it can"},{"DocComment":" do something better than the default `for` loop implementation."},{"DocComment":""},{"DocComment":" In particular, try to have this call `fold()` on the internal parts"},{"DocComment":" from which this iterator is composed."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the sum of all of the elements of the array"},{"DocComment":" let sum = a.iter().fold(0, |acc, x| acc + x);"},{"DocComment":""},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Let's walk through each step of the iteration here:"},{"DocComment":""},{"DocComment":" | element | acc | x | result |"},{"DocComment":" |---------|-----|---|--------|"},{"DocComment":" |         | 0   |   |        |"},{"DocComment":" | 1       | 0   | 1 | 1      |"},{"DocComment":" | 2       | 1   | 2 | 3      |"},{"DocComment":" | 3       | 3   | 3 | 6      |"},{"DocComment":""},{"DocComment":" And so, our final result, `6`."},{"DocComment":""},{"DocComment":" This example demonstrates the left-associative nature of `fold()`:"},{"DocComment":" it builds a string, starting with an initial value"},{"DocComment":" and continuing with each element from the front until the back:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" let zero = \"0\".to_string();"},{"DocComment":""},{"DocComment":" let result = numbers.iter().fold(zero, |acc, &x| {"},{"DocComment":"     format!(\"({acc} + {x})\")"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(result, \"(((((0 + 1) + 2) + 3) + 4) + 5)\");"},{"DocComment":" ```"},{"DocComment":" It's common for people who haven't used iterators a lot to"},{"DocComment":" use a `for` loop with a list of things to build up a result. Those"},{"DocComment":" can be turned into `fold()`s:"},{"DocComment":""},{"DocComment":" [`for`]: ../../book/ch03-05-control-flow.html#looping-through-a-collection-with-for"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" let mut result = 0;"},{"DocComment":""},{"DocComment":" // for loop:"},{"DocComment":" for i in &numbers {"},{"DocComment":"     result = result + i;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // fold:"},{"DocComment":" let result2 = numbers.iter().fold(0, |acc, &x| acc + x);"},{"DocComment":""},{"DocComment":" // they're the same"},{"DocComment":" assert_eq!(result, result2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`reduce()`]: Iterator::reduce"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"B","variance":"Invariant"},{"index":2,"name":"F","variance":"Contravariant"},{"index":3,"name":"Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":87},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":440}],"const_generics":[],"trait_refs":[]}}