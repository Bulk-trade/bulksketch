ip_binder":{"id":9,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[2,4]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"id":10,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[2,5]}}],"vtable":"Lazy"},{"def_id":6,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["portable",0]},{"Impl":{"Trait":6}}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":84,"col":0},"end":{"line":121,"col":1}},"generated_from_span":null}},"source_text":"impl<F: BinaryField> BulkKernels<F> for Portable {\n    fn insert_nonzero(odd: &mut [u64], ids: &[u64]) {\n        let Some((first, successors)) = odd.split_first_mut() else {\n            return;\n        };\n        // Zero extraction and canonicality belong to the caller, as does routing.\n        for &id in ids {\n            *first ^= id;\n            let square = <Self as Arithmetic<F>>::square(id);\n            let mut power = id;\n            // Advancing before each successor uses exactly c-1 multiplications.\n            for syndrome in &mut *successors {\n                power = <Self as Arithmetic<F>>::mul(power, square);\n                *syndrome ^= power;\n            }\n        }\n    }\n\n    fn xor_assign(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"xor_assign length mismatch\");\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target ^= source;\n        }\n    }\n\n    fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]) {\n        assert_eq!(out.len(), points.len(), \"horner_many length mismatch\");\n        let Some((&leading, rest)) = coefficients.split_last() else {\n            out.fill(0);\n            return;\n        };\n        for (target, &point) in out.iter_mut().zip(points) {\n            *target = rest.iter().rev().fold(leading, |value, &coefficient| {\n                <Self as Arithmetic<F>>::mul(value, point) ^ coefficient\n            });\n        }\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":36},{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":5},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"implied_trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Value":[125,{"kind":{"TraitImpl":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":17}}]}}},"trait_decl_ref":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":36},{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}]}},{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":17}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_gene