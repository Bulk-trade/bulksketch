&mut [RawProduct],\n    ) -> usize;\n    fn eval_many_into(coefficients: &[u64], points: &[u64], out: &mut [u64]);\n    /// Extend with zeros through index, XOR value, normalize. dst has index+1 capacity.\n    fn xor_coefficient(dst: &mut [u64], len: usize, index: usize, value: u64) -> usize;\n    /// Monic degree d>=3; table needs d*floor(d/2), work needs 4*(d+1) words.\n    fn prepare_square_table(modulus: &[u64], table: &mut [u64], work: &mut [u64]);\n    /// dst has d words; raw has 2*d+1; table is the exact table for this modulus.\n    fn square_mod_into(\n        a: &[u64],\n        modulus: &[u64],\n        table: &[u64],\n        dst: &mut [u64],\n        raw: &mut [RawProduct],\n    ) -> usize;\n}","attr_info":{"attributes":[{"DocComment":" Canonical ascending slices: empty is zero; nonempty has no trailing zero."},{"DocComment":" Output slices are caller-owned, sufficiently sized, and return their normalized length."},{"DocComment":" Input/output aliasing follows Rust borrows. Zero divisors violate internal invariants."},{"DocComment":" The row driver charges `WorkScheduleV1` *before* invoking these unmetered kernels."},{"Unknown":{"path":"expect","args":"dead_code, reason =\n\"test polynomial oracles consume the remaining private primitives\""}}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"F","variance":"Unknown"},{"index":2,"name":"K","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[1684,{"data":{"file_id":26,"beg":{"line":32,"col":31},"end":{"line":32,"col":42}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"g