(|x| x == 5), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1, 2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.rposition(|x| x >= 2), Some(3));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":" assert_eq!(iter.next_back(), Some(3));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1174},{"Deduplicated":2}],"output":{"Deduplicated":74}},"default":{"id":144,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":13},{"Deduplicated":2},{"Deduplicated":22},{"Deduplicated":7},{"Deduplicated":1198}],"const_generics":[],"trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":145}},{"regions":[],"outlives":[],"skip_binder":{"Value":[147,{"kind":{"Clause":[{"Bound":[1,0]},{"regions":[]}]},"trait_decl_ref":{"id":26,"generics":{"regions":[],"types":[{"Deduplicated":1194},{"Deduplicated":1199},{"Deduplicated":12}],"const_generics":[],"trait_refs":[]}}}]}},{"regions":[],"outlives":[],"skip_binder":{"Value":[148,{"kind":{"Clause":[{"Bound":[1,1]},{"regions":[]}]},"trait_decl_ref":{"id":31,"generics":{"regions":[],"types":[{"Deduplicated":13},{"Deduplicated":1195}],"const_generics":[],"trait_refs":[]}}}]}},{"regions":[],"outlives":[],"skip_binder":{"Value":[149,{"kind":{"Clause":[{"Bound":[1,2]},{"regions":[]}]},"trait_decl_ref":{"id":23,"generics":{"regions":[],"types":[{"Deduplicated":13},{"Deduplicated":1196}],"const_generics":[],"trait_refs":[]}}}]}}]}}},"kind":{"TraitMethod":[21,47]}},null,null,nu