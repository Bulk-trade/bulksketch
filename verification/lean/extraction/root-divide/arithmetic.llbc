al","diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":22}],"output":{"Deduplicated":13}},"default":null},"kind":{"TraitMethod":[16,0]}}],"vtable":null},{"def_id":17,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["try_trait",0]},{"Ident":["Residual",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":364,"col":0},"end":{"line":364,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Allows retrieving the canonical type implementing [`Try`] that has this type"},{"DocComment":" as its residual and allows it to hold an `O` as its output."},{"DocComment":""},{"DocComment":" If you think of the `Try` trait as splitting a type into its [`Try::Output`]"},{"DocComment":" and [`Try::Residual`] components, this allows putting them back together."},{"DocComment":""},{"DocComment":" For example,"},{"DocComment":" `Result<T, E>: Try<Output = T, Residual = Result<!, E>>`,"},{"DocComment":" and in the other direction,"},{"DocComment":" `<Result<!, E> as Residual<T>>::TryType = Result<T, E>`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"O","variance":"Unknown"},{"index":2,"name":"Self_TryType","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[{"regions":[],"outlives":[],"skip_binder":{"trait_ref":{"Value":[143,{"kind":{"ParentClause":[{"Value":[144,{"kind":"SelfId","trait_decl_ref":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":13},{"Deduplicated":22},{"Deduplicated":35}],"const_generics":[],"trait_refs":[]}}}]},0,{"regions":[]}]},"trait_decl_ref":{"id":15,"generics":{"regions":[],"types":[{