enerics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[2,1]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"id":46,"generics":{"regions":[],"types":[{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[2,2]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"id":47,"generics":{"regions":[],"types":[{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[2,3]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"id":48,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[2,4]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"id":49,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[2,5]}}],"vtable":"Lazy"},{"def_id":11,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["poly",0]},{"Ident":["dense",0]},{"Impl":{"Trait":11}}],"span":{"Untagged":{"data":{"file_id":25,"beg":{"line":6,"col":0},"end":{"line":225,"col":1}},"generated_from_span":null}},"source_text":"impl<F: BinaryField, K: BulkKernels<F>> Polynomial<F, K> for Dense {\n    fn mul_into(a: &[u64], b: &[u64], dst: &mut [u64], raw: &mut [RawProduct]) -> usize {\n        if a.is_empty() || b.is_empty() {\n            return 0;\n        }\n        let size = a.len() + b.len();\n        assert!(dst.len() >= size && raw.len() >= size);\n        let len = size - 1;\n        raw[..len].fill(RawProduct::default());\n        // Reduction is XOR-linear; each coefficient needs only one reduction,\n        // regardless of how many raw products contribute to it.\n        for (i, &left) in a.iter().enumerate() {\n            for (slot, &right) in raw[i..i + b.len()].iter_mut().zip(b) {\n                let product = K::raw_mul(left, right);\n                slot.lo ^= product.lo;\n                slot.hi ^= product.hi;\n            }\n        }\n        for (target, &product) in dst[..len].iter_mut().zip(&raw[..len]) {\n            *target = K::reduce(product);\n        }\n        normalized_len(&dst[..len])\n    }\n\n    fn square_into(a: &[u64], dst: &mut [u64], raw: &mut [RawProduct]) -> usize {\n        let size = 2 * a.len();\n        assert!(dst.len() >= size && raw.len() >= size);\n        dst[..size].fill(0);\n        for (target, &coefficient) in dst[..size].iter_mut().step_by(2).zip(a) {\n            *target = K::square(coefficient);\n        }\n        normalized_len(&dst[..size])\n    }\n\n    fn div_rem_into(\n        a: &[u64],\n        b: &[u64],\n        q: &mut [u64],\n        rem: &mut [u64],\n        raw: &mut [RawProduct],\n    ) -> (usize, usize) {\n        let &leading = b.last().expect(\"zero polynomial divisor\");\n        let inverse = if leading == 1 {\n            1\n        } else {\n            K::inverse(leading).expect(\"noncanonical polynomial divisor\")\n        };\n        let size = a.len() + 1;\n        assert!(q.len() >= size && rem.len() >= size && raw.len() >= size);\n        q[..size].fill(0);\n        rem[..size].fill(0);\n        for (target, &coefficient) in raw[..a.len()].iter_mut().zip(a) {\n            *target = RawProduct {\n                lo: coefficient,\n                hi: 0,\n            };\n        }\n        let degree = b.len() - 1;\n        // Lower slots retain raw XOR sums. Only a reduced leading slot may\n        // enter field multiplication; eliminated slots are never read again.\n        for top in (degree..a.len()).rev() {\n            let mut factor = K::reduce(raw[top]);\n            if inverse != 1 {\n                factor = K::mul(factor, inverse);\n            }\n            let offset = top - degree;\n            q[offset] = factor;\n            if factor == 0 {\n                continue;\n            }\n            if factor == 1 {\n                for (slot, &coefficient) in raw[offset..top].iter_mut().zip(&b[..degree]) {\n                    slot.lo ^= coefficient;\n                }\n                continue;\n            }\n            for (slot, &coefficient) in raw[offset..top].iter_mut().zip(&b[..degree]) {\n                let product = K::raw_mul(factor, coefficient);\n                slot.lo ^= product.lo;\n                slot.hi ^= product.hi;\n            }\n        }\n        let remainder_size = degree.min(a.len());\n        for (target, &product) in rem[..remainder_size].iter_mut().zip(raw.iter()) {\n            *target = K::reduce(product);\n        }\n        (\n            normalized_len(&q[..size]),\n            normalized_len(&rem[..remainder_size]),\n        )\n    }\n\n    fn exact_divide_into(\n        a: &[u64],\n        b: &[u64],\n        q: &mut [u64],\n        rem: &mut [u64],\n        raw: &mut [RawProduct],\n    ) -> Option<usize> {\n        let (q_len, rem_len) = <Self as Polynomial<F, K>>::div_rem_into(a, b, q, rem, raw);\n        if rem_len != 0 {\n            q[..=a.len()].fill(0);\n            return None;\n        }\n        Some(q_len)\n    }\n\n    fn monic_gcd_into(\n        a: &[u64],\n        b: &[u64],\n        dst: &mut [u64],\n        work: &mut [u64],\n        raw: &mut [RawProduct],\n    ) -> usize {\n        let max_len = a.len().max(b.len());\n        let width = max_len + 1;\n        assert!(dst.len() >= max_len && work.len() >= 4 * width && raw.len() >= 2 * width);\n        let (mut left, rest) = work[..4 * width].split_at_mut(width);\n        let (mut right, rest) = rest.split_at_mut(width);\n        let (quotient, mut remainder) = rest.split_at_mut(width);\n        left[..a.len()].copy_from_slice(a);\n        right[..b.len()].copy_from_slice(b);\n        let (mut left_len, mut right_len) = (a.len(), b.len());\n        while right_len != 0 {\n            let (_, len) = <Self as Polynomial<F, K>>::div_rem_into(\n                &left[..left_len],\n                &right[..right_len],\n                quotient,\n                remainder,\n                raw,\n            );\n            std::mem::swap(&mut left, &mut right);\n            std::mem::swap(&mut right, &mut remainder);\n            left_len = right_len;\n            right_len = len;\n        }\n        dst[..max_len].fill(0);\n        if left_len != 0 {\n            if left[left_len - 1] == 1 {\n                dst[..left_len].copy_from_slice(&left[..left_len]);\n            } else {\n                let inverse =\n                    K::inverse(left[left_len - 1]).expect(\"nonzero gcd leading coefficient\");\n                K::scale_xor(&mut dst[..left_len], &left[..left_len], inverse);\n            }\n        }\n        left_len\n    }\n\n    fn eval_many_into(coefficients: &[u64], points: &[u64], out: &mut [u64]) {\n        K::horner_many(coefficients, points, out);\n    }\n\n    fn xor_coefficient(dst: &mut [u64], len: usize, index: usize, value: u64) -> usize {\n        assert!(len <= dst.len() && index < dst.len());\n        let size = len.max(index + 1);\n        dst[len..size].fill(0);\n        dst[index] ^= value;\n        normalized_len(&dst[..size])\n    }\n\n    fn prepare_square_table(modulus: &[u64], table: &mut [u64], work: &mut [u64]) {\n        assert!(modulus.len() >= 4 && modulus.last() == Some(&1));\n        let degree = modulus.len() - 1;\n        let rows = degree / 2;\n        assert!(table.len() >= degree * rows && work.len() >= 4 * (degree + 1));\n        let current = &mut work[..degree];\n        current.copy_from_slice(&modulus[..degree]);\n        // X^d = f's low coefficients modulo monic f. The first stored\n        // exponent is d for even d, d+1 for odd d; successive rows add two.\n        if !degree.is_multiple_of(2) {\n            times_x_mod::<F, K>(current, modulus);\n        }\n        for row in 0..rows {\n            table[row * degree..(row + 1) * degree].copy_from_slice(current);\n            if row + 1 != rows {\n                times_x_mod::<F, K>(current, modulus);\n                times_x_mod::<F, K>(current, modulus);\n            }\n        }\n    }\n\n    fn square_mod_into(\n        a: &[u64],\n        modulus: &[u64],\n        table: &[u64],\n        dst: &mut [u64],\n        raw: &mut [RawProduct],\n    ) -> usize {\n        assert!(modulus.len() >= 4 && modulus.last() == Some(&1));\n        let degree = modulus.len() - 1;\n        assert!(a.len() <= degree && dst.len() >= degree && raw.len() > 2 * degree);\n        assert_eq!(table.len(), degree * (degree / 2));\n        if K::square_mod(a, table, &mut dst[..degree], raw) {\n            return normalized_len(&dst[..degree]);\n        }\n        let accumulators = &mut raw[..degree];\n        accumulators.fill(RawProduct::default());\n        let first_high = degree.div_ceil(2);\n        // The table is linear only after squaring each coefficient: Frobenius\n        // acts on coefficients as well as exponents in the extension field.\n        for (i, &coefficient) in a.iter().enumerate() {\n            let square = K::square(coefficient);\n            if i < first_high {\n                accumulators[2 * i].lo ^= square;\n            } else {\n                let start = (i - first_high) * degree;\n                for (slot, &entry) in accumulators.iter_mut().zip(&table[start..start + degree]) {\n                    let product = K::raw_mul(square, entry);\n                    slot.lo ^= product.lo;\n                    slot.hi ^= product.hi;\n                }\n            }\n        }\n        for (target, &product) in dst[..degree].iter_mut().zip(accumulators.iter()) {\n            *target = K::reduce(product);\n        }\n        normalized_len(&dst[..degree])\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":158},{"Deduplicated":13},{"Deduplicated":22}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Unknown"},{"index":1,"name":"K","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":197},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Deduplicated":198},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":22},{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"implied_trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":4}},{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":5}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"id":50,"generics":{"regions