{"charon_version":"0.1.304","translated":{"crate_name":"bulksketch","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["bulksketch::sketch::shape::record_bytes"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/Users/junbug/bulk/bulksketch-proof-tools/shape-admission/wire-size/arithmetic.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"aarch64-apple-darwin","value":{"arch":"AArch64","vendor":"apple","os":"MacOs","env":"Unspecified","cfg_abi":"Unspecified","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bulksketch","contents":"//! Native binary-syndrome reconciliation with bounded, deterministic GF64 decoding.\n#![deny(unsafe_code)]\n#![warn(missing_docs)]\n\nmod backend;\nmod decode;\nmod field;\nmod poly;\nmod sketch;\nmod types;\n\npub use {\n    field::{BinaryField, Gf64},\n    sketch::{\n        DecodeJob, DecodeLimits, DecodeOutcome, DecodePlan, DecodeReport, DecodeRequest, DecodeRow,\n        DecodeRowsRequest, DecodeScratch, Decoder, FrozenSketch, InsertScratch, MutableSketch,\n        ParseLimits, ScratchLayout, ShapeLimits, SketchShape, SketchView, decode_into,\n        decode_rows_into,\n    },\n    types::{\n        BackendError, BackendId, BackendRequest, CreateError, DecodeError, DecodeFailure,\n        EncodeError, FieldId, ParseError, ShapeError, ShapeMismatch, Stage, StageProgress,\n        UpdateError, WorkUnits,\n    },\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"src/sketch/mod.rs"},"crate_name":"bulksketch","contents":"//! Request-level shape, wire, admission and ownership.\n#![forbid(unsafe_code)]\n\npub(crate) mod api;\nmod candidates;\npub(crate) mod contract;\nmod dispatch;\nmod input;\nmod job;\nmod plan;\npub(crate) mod scratch;\nmod shape;\nmod state;\nmod wire;\n\npub use {\n    api::{DecodeLimits, DecodeOutcome, DecodeReport, DecodeRequest},\n    dispatch::Decoder,\n    input::{DecodeRow, DecodeRowsRequest},\n    job::{DecodeJob, decode_into, decode_rows_into},\n    plan::DecodePlan,\n    scratch::{DecodeScratch, InsertScratch, ScratchLayout},\n    shape::{ShapeLimits, SketchShape},\n    state::{FrozenSketch, MutableSketch},\n    wire::{ParseLimits, SketchView},\n};\n\n#[cfg(test)]\nmod tests;\n\n#[cfg(test)]\nmod state_tests;\n\n#[cfg(test)]\nmod wire_tests;\n\n#[cfg(test)]\nmod decode_tests;\n\n#[cfg(test)]\nmod v1_plan_tests;\n\n#[cfg(test)]\nmod forced_dispatch_tests;\n\n#[cfg(test)]\nmod backend_work_tests;\n#[cfg(test)]\nmod forced_backend_tests;\n"},{"id":6,"name":{"Local":"src/sketch/shape.rs"},"crate_name":"bulksketch","contents":"//! Fixed identity/modulo mapping with checked storage admission.\n#![forbid(unsafe_code)]\n\nuse {\n    crate::{\n        field::BinaryField,\n        types::{FieldId, ShapeError},\n    },\n    std::marker::PhantomData,\n};\n\n/// Explicit allocation caps. There is deliberately no unbounded default.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ShapeLimits {\n    /// Maximum complete `CoreWireV1` record size, including framing.\n    pub max_wire_bytes: usize,\n    /// Maximum number of rows.\n    pub max_buckets: usize,\n    /// Maximum odd-syndrome words per row.\n    pub max_capacity_per_bucket: usize,\n    /// Maximum aggregate odd-syndrome words.\n    pub max_total_syndrome_words: usize,\n}\n\n/// Validated power-of-two GF64 row layout. All original u64 IDs are permitted.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct SketchShape<F: BinaryField> {\n    capacities: Box<[u16]>,\n    total_words: usize,\n    wire_bytes: usize,\n    field: PhantomData<F>,\n}\n\nimpl<F: BinaryField> SketchShape<F> {\n    /// Admit dimensions and storage before allocating the capacity descriptors.\n    ///\n    /// # Errors\n    /// Rejects invalid mapping dimensions or exceeded caller/wire limits.\n    ///\n    /// # Panics\n    /// Only if an internal capacity-admission invariant is broken.\n    pub fn new(capacities: &[usize], limits: &ShapeLimits) -> Result<Self, ShapeError> {\n        if F::BITS != 64 || F::WIRE_ID != FieldId::Gf64 || !capacities.len().is_power_of_two() {\n            return Err(ShapeError::InvalidShape);\n        }\n        if capacities.len() > limits.max_buckets || capacities.len() > usize::from(u16::MAX) {\n            return Err(ShapeError::InputLimitExceeded);\n        }\n        let mut total_words = 0usize;\n        for &capacity in capacities {\n            if capacity > limits.max_capacity_per_bucket || capacity > usize::from(u16::MAX) {\n                return Err(ShapeError::InputLimitExceeded);\n            }\n            total_words = total_words\n                .checked_add(capacity)\n                .ok_or(ShapeError::InputLimitExceeded)?;\n            if total_words > limits.max_total_syndrome_words {\n                return Err(ShapeError::InputLimitExceeded);\n            }\n        }\n        if capacities.contains(&0) {\n            return Err(ShapeError::InvalidShape);\n        }\n        let wire_bytes =\n            record_bytes(capacities.len(), total_words).ok_or(ShapeError::InputLimitExceeded)?;\n        if wire_bytes > limits.max_wire_bytes {\n            return Err(ShapeError::InputLimitExceeded);\n        }\n        Ok(Self {\n            capacities: capacities\n                .iter()\n                .map(|&c| u16::try_from(c).expect(\"admitted capacity\"))\n                .collect(),\n            total_words,\n            wire_bytes,\n            field: PhantomData,\n        })\n    }\n\n    /// Row capacities in bucket order.\n    #[must_use]\n    pub fn capacities(&self) -> &[u16] {\n        &self.capacities\n    }\n\n    /// Row count, including empty-membership rows.\n    #[must_use]\n    pub fn bucket_count(&self) -> usize {\n        self.capacities.len()\n    }\n\n    /// Aggregate number of stored odd syndromes.\n    #[must_use]\n    pub fn total_syndrome_words(&self) -> usize {\n        self.total_words\n    }\n\n    /// Exact complete `CoreWireV1` record length.\n    #[must_use]\n    pub fn wire_bytes(&self) -> usize {\n        self.wire_bytes\n    }\n\n    /// Total modulo routing; the field value is exactly `id`.\n    ///\n    /// # Panics\n    /// Only if the previously validated shape is internally inconsistent.\n    #[must_use]\n    pub fn bucket_for(&self, id: u64) -> usize {\n        usize::try_from(id % self.bucket_count() as u64).expect(\"remainder fits row count\")\n    }\n\n    /// Validate an original ID recovered from the given row. Zero belongs only to row 0.\n    #[must_use]\n    pub fn permits_id(&self, bucket: usize, id: u64) -> bool {\n        bucket < self.bucket_count() && self.bucket_for(id) == bucket\n    }\n}\n\npub(super) fn record_bytes(buckets: usize, words: usize) -> Option<usize> {\n    let descriptors = buckets.checked_mul(2)?;\n    let zero_bytes = buckets.checked_add(7)?.checked_div(8)?;\n    let payload = words.checked_mul(8)?.checked_add(zero_bytes)?;\n    u32::try_from(descriptors).ok()?;\n    u32::try_from(payload).ok()?;\n    24usize.checked_add(descriptors)?.checked_add(payload)\n}\n"},{"id":7,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/num/error.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/convert/num.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/ops/try_trait.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Value":[1,{"Array":[{"Value":[2,{"TypeVar":{"Bound":[0,0]}}]},{"Value":[0,[{"Var":{"Bound":[0,0]}},{"Deduplicated":0}]]},null]}]},"kind":"InherentImplBlock"}}},{"Ident":["as_slice",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Dedupli