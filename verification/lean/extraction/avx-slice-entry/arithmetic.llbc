et features.\n        unsafe { scale_xor(dst, src, scale) }\n    }\n\n    fn square_slice(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"square_slice length mismatch\");\n        if F::BITS != 64 {\n            return <Portable as Arithmetic<F>>::square_slice(dst, src);\n        }\n        // SAFETY: checked backend selection guarantees both target features.\n        unsafe { square_slice(dst, src) }\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":31},{"Deduplicated":5}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":30},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":5}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"implied_trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Value":[7,{"kind":{"TraitImpl":{"id":7,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},"trait_decl_ref":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":31}],"const_generics":[],"trait_refs":[]}}}]}},{"regions":[],"outlives":[],"skip_binder":{"Value":[8,{"kind":{"BuiltinOrAuto":{"builtin_data":"Auto","parent_trait_refs":[],"types":[],"vtable":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":31}],"const_generics":[],"trait_refs":[]}}}},"trait_decl_ref":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":31}],"const_generics":[],"trait_refs":[]}}}]}},{"regions":[],"outlives":[],"skip_binder":{"Value":[9,{"kind":{"BuiltinOrAuto":{"builtin_data":"Auto",