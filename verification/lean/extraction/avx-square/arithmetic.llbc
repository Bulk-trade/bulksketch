["iterator",0]},{"Ident":["Iterator",0]}],"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":42,"col":0},"end":{"line":42,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for dealing with iterators."},{"DocComment":""},{"DocComment":" This is the main iterator trait. For more about the concept of iterators"},{"DocComment":" generally, please see the [module-level documentation]. In particular, you"},{"DocComment":" may want to know how to [implement `Iterator`][impl]."},{"DocComment":""},{"DocComment":" [module-level documentation]: crate::iter"},{"DocComment":" [impl]: crate::iter#implementing-iterator"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Iterator","diagnostic_item":"Iterator","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"next","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["next",0]}],"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":78,"col":4},"end":{"line":78,"col":45}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Advances the iterator and returns the next value."},{"DocComment":""},{"DocComment":" Returns [`None`] when iteration is finished. Individual iterator"},{"DocComment":" implementations may choose to resume iteration, and so calling `next()`"},{"DocComment":" again may or may not eventually start returning [`Some(Item)`] again at some"},{"DocComment":" point."},{"DocComment":""},{"DocComment":" [`Some(Item)`]: Some"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" // A call to next() returns the next value..."},{"DocComment":" assert_eq!(Some(1), iter.next());"},{"DocComment":" assert_eq!(Some(2), iter.next());"},{"DocComment":" assert_eq!(Some(3), iter.next());"},{"DocComment":""},{"DocComment":" // ... and then None once it's over."},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":""},{"DocComment":" // More calls may or may not return `None`. Here, they always will."},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"IteratorNext","diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":635}],"output":{"Deduplicated":167}},"default":null},"kind":{"TraitMethod":[4,0]}},null,null,null,null,null,null,{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"step_by","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["step_by",0]}],"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":453,"col":4},"end":{"line":455,"col":20}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator starting at the same point, but stepping by"},{"DocComment":" the given amount at each iteration."},{"DocComment":""},{"DocComment":" Note 1: The first element of the iterator will always be returned,"},{"DocComment":" regardless of the step given."},{"DocComment":""},{"DocComment":" Note 2: The time at which ignored elements are pulled is not fixed."},{"DocComment":" `StepBy` behaves like the sequence `self.next()`, `self.nth(step-1)`,"},{"DocComment":" `self.nth(step-1)`, …, but is also free to behave like the sequence"},{"DocComment":" `advance_n_and_return_first(&mut self, step)`,"},{"DocComment":" `advance_n_and_return_first(&mut self, step)`, …"},{"DocComment":" Which way is used may change for some iterators for performance reasons."},{"DocComment":" The second way will advance the iterator earlier and may consume more items."},{"DocComment":""},{"DocComment":" `advance_n_and_return_first` is the equivalent of:"},{"DocComment":" ```"},{"DocComment":" fn advance_n_and_return_first<I>(iter: &mut I, n: usize) -> Option<I::Item>"},{"DocComment":" where"},{"DocComment":"     I: Iterator,"},{"DocComment":" {"},{"DocComment":"     let next = iter.next();"},{"DocComment":"     if n > 1 {"},{"DocComment":"         iter.nth(n - 2);"},{"DocComment":"     }"},{"DocComment":"     next"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" The method will panic if the given step is `0`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [0, 1, 2, 3, 4, 5];"},{"DocComment":" let mut iter = a.into_iter().step_by(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":12},{"Deduplicated":0}],"output":{"Deduplicated":164}},"default":{"id":28,"generics":{"regions":[],"types":[{"Deduplicated":12},{"Deduplicated":13}],"const_generics":[],"trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Value":[102,{"kind":"SelfId","trait_decl_ref":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":12},{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}]}}]}}},"kind":{"TraitMethod":[4,7]}},null,{"params":{"regions":[],"types":[{"index":0,"name":"U","variance":"Invariant"},{"index":1,"name":"Clause0_Item","variance":"Invariant"},{"index":2,"name":"Clause0_IntoIter","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":242},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Value":[636,{"TypeVar":{"Bound":[1,0]}}]},{"Value":[637,{"TypeVar":{"Bound":[1,1]}}]},{"Value":[638,{"TypeVar":{"Bound":[1,2]}}]}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"zip","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["zip",0]}],"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":643,"col":4},"end":{"line":646,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" 'Zips up' two iterators into a single iterator of pairs."},{"DocComment":""},{"DocComment":" `zip()` returns a new iterator that will iterate over two other"},{"DocComment":" iterators, returning a tuple where the first element comes from the"},{"DocComment":" first iterator, and the second element comes from the second iterator."},{"DocComment":""},{"DocComment":" In other words, it zips two iterators together, into a single one."},{"DocComment":""},{"DocComment":" If either iterator returns [`None`], [`next`] from the zipped iterator"},{"DocComment":" will return [`None`]."},{"DocComment":" If the zipped iterator has no more elements to return then each further attempt to advance"},{"DocComment":" it will first try to advance the first iterator at most one time and if it still yielded an item"},{"DocComment":" try to advance the second iterator at most one time."},{"DocComment":""},{"DocComment":" To 'undo' the result of zipping up two iterators, see [`unzip`]."},{"DocComment":""},{"DocComment":" [`unzip`]: Iterator::unzip"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s1 = \"abc\".chars();"},{"DocComment":" let s2 = \"def\".chars();"},{"DocComment":""},{"DocComment":" let mut iter = s1.zip(s2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(('a', 'd')));"},{"DocComment":" assert_eq!(iter.next(), Some(('b', 'e')));"},{"DocComment":" assert_eq!(iter.next(), Some(('c', 'f')));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the argument to `zip()` uses [`IntoIterator`], we can pass"},{"DocComment":" anything that can be converted into an [`Iterator`], not just an"},{"DocComment":" [`Iterator`] itself. For example, arrays (`[T]`) implement"},{"DocComment":" [`IntoIterator`], and so can be passed to `zip()` directly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a1 = [1, 2, 3];"},{"DocComment":" let a2 = [4, 5, 6];"},{"DocComment":""},{"DocComment":" let mut iter = a1.into_iter().zip(a2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some((1, 4)));"},{"DocComment":" assert_eq!(iter.next(), Some((2, 5)));"},{"DocComment":" assert_eq!(iter.next(), Some((3, 6)));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `zip()` is often used to zip an infinite iterator to a finite one."},{"DocComment":" This works because the finite iterator will eventually return [`None`],"},{"DocComment":" ending the zipper. Zipping with `(0..)` can look a lot like [`enumerate`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let enumerate: Vec<_> = \"foo\".chars().enumerate().collect();"},{"DocComment":""},{"DocComment":" let zipper: Vec<_> = (0..).zip(\"foo\".chars()).collect();"},{"DocComment":""},{"DocComment":" assert_eq!((0, 'f'), enumerate[0]);"},{"DocComment":" assert_eq!((0, 'f'), zipper[0]);"},{"DocComment":""},{"DocComment":" assert_eq!((1, 'o'), enumerate[1]);"},{"DocComment":" assert_eq!((1, 'o'), zipper[1]);"},{"DocComment":""},{"DocComment":" assert_eq!((2, 'o'), enumerate[2]);"},{"DocComment":" assert_eq!((2, 'o'), zipper[2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If both iterators have roughly equivalent syntax, it may be more readable to use [`zip`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::iter::zip;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let b = [2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut zipped = zip("},{"DocComment":"     a.into_iter().map(|x| x * 2).skip(1),"},{"DocComment":"     b.into_iter().map(|x| x * 2).skip(1),"},{"DocComment":" );"},{"DocComment":""},{"DocComment":" assert_eq!(zipped.next(), Some((4, 6)));"},{"DocComment":" assert_eq!(zipped.next(), Some((6, 8)));"},{"DocComment":" assert_eq!(zipped.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" compared to:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # let a = [1, 2, 3];"},{"DocComment":" # let b = [2, 3, 4];"},{"DocComment":" #"},{"DocComment":" let mut zipped = a"},{"DocComment":"     .into_iter()"},{"DocComment":"     .map(|x| x * 2)"},{"DocComment":"     .skip(1)"},{"DocComment":"     .zip(b.into_iter().map(|x| x * 2).skip(1));"},{"DocComment":" #"},{"DocComment":" # assert_eq!(zipped.next(), Some((4, 6)));"},{"DocComment":" # assert_eq!(zipped.next(), Some((6, 8)));"},{"DocComment":" # assert_eq!(zipped.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`enumerate`]: Iterator::enumerate"},{"DocComment":" [`next`]: Iterator::next"},{"DocComment":" [`zip`]: crate::iter::zip"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":12},{"Deduplicated":2}],"output":{"Value":[639,{"Adt":{"id":19,"generics":{"regions":[],"types":[{"Deduplicated":12},{"Value":[640,{"TypeVar":{"Bound":[0,2]}}]}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"default":{"id":56,"generics":{"regions":[],"types":[{"Deduplicated":12},{"Deduplicated":2},{"Deduplicated":13},{"Deduplicated":9},{"Deduplicated":640}],"const_generics":[],"trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":102}},{"regions":[],"outlives":[],"skip_binder":{"Value":[103,{"kind":{"Clause":[{"Bound":[1,0]},{"regions":[]}]},"trait_decl_ref":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":636},{"Deduplicated":637},{"Deduplicated":638}],"const_generics":[],"trait_refs":[]}}}]}}]}}},"kind":{"TraitMethod":[4,9]}},null,null,null,null,null,null,{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"enumerate","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["enumerate",0]}],"span":{"Untagged":{"data":{"file_id":24,"beg":{"line":1058,"col":4},"end":{"line":1060,"col":20}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator which gives the current iteration count as well as"},{"DocComment":" the next value."},{"DocComment":""},{"DocComment":" The iterator returned yields pairs `(i, val)`, where `i` is the"},{"DocComment":" current index of iteration and `val` is the value returned by the"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" `enumerate()` keeps its count as a [`usize`]. If you want to count by a"},{"DocComment":" different sized integer, the [`zip`] function provides similar"},{"DocComment":" functionality."},{"DocComment":""},{"DocComment":" # Overflow Behavior"},{"DocComment":""},{"DocComment":" The method does no guarding against overflows, so enumerating more than"},{"DocComment":" [`usize::MAX`] elements either produces the wrong result or panics. If"},{"DocComment":" overflow checks are enabled, a panic is guaranteed."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" The returned iterator might panic if the to-be-returned index would"},{"DocComment":" overflow a [`usize`]."},{"DocComment":""},{"DocComment":" [`zip`]: Iterator::zip"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = ['a', 'b', 'c'];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().enumerate();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some((0, 'a')));"},{"DocComment":" assert_eq!(iter.next(), Some((1, 'b')));"},{"DocComment":" assert_eq!(iter.next(), Some((2, 'c')));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"enumerate_method","has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":12}],"output":{"Deduplicated":159}},"default":{"id":24,"generics":{"regions":[],"types":[{"Deduplicated":12},{"Deduplicated":13}],"const_generics":[],"trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Deduplicated":102}}]}}},"kind":{"TraitMethod":[4,16]}},null,null,null,null,{"params":{"regions":[],"types":[