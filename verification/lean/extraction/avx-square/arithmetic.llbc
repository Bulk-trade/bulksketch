{"charon_version":"0.1.304","translated":{"crate_name":"bulksketch","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["bulksketch::backend::x86_vpclmul512::square_mod"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":["bulksketch::backend::x86_vpclmul512::load","bulksketch::backend::x86_vpclmul512::store"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/workspace/bulk/bulksketch-proof-evidence-20261109-avx-square/free-only/arithmetic.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-apple-darwin","value":{"arch":"X86_64","vendor":"apple","os":"MacOs","env":"Unspecified","cfg_abi":"Unspecified","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bulksketch","contents":"//! Native binary-syndrome reconciliation with bounded, deterministic GF64 decoding.\n#![deny(unsafe_code)]\n#![warn(missing_docs)]\n\nmod backend;\nmod decode;\nmod field;\nmod poly;\nmod sketch;\nmod types;\n\npub use {\n    field::{BinaryField, Gf64},\n    sketch::{\n        DecodeJob, DecodeLimits, DecodeOutcome, DecodePlan, DecodeReport, DecodeRequest, DecodeRow,\n        DecodeRowsRequest, DecodeScratch, Decoder, FrozenSketch, InsertScratch, MutableSketch,\n        ParseLimits, ScratchLayout, ShapeLimits, SketchShape, SketchView, decode_into,\n        decode_rows_into,\n    },\n    types::{\n        BackendError, BackendId, BackendRequest, CreateError, DecodeError, DecodeFailure,\n        EncodeError, FieldId, ParseError, ShapeError, ShapeMismatch, Stage, StageProgress,\n        UpdateError, WorkUnits,\n    },\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"src/backend/mod.rs"},"crate_name":"bulksketch","contents":"//! Arithmetic capabilities and canonical-word kernels only.\n#![deny(unsafe_code)]\n\npub(crate) mod contract;\npub(crate) mod detect;\npub(crate) mod portable;\n#[cfg(target_arch = \"x86_64\")]\npub(crate) mod x86_pclmul;\n\n#[cfg(target_arch = \"x86_64\")]\npub(crate) mod x86_vpclmul512;\n\n#[cfg(all(test, target_arch = \"x86_64\"))]\nmod vpclmul512_tests;\n\n#[cfg(all(test, target_arch = \"x86_64\"))]\nmod pclmul_tests;\n#[cfg(test)]\nmod portable_tests;\n\n#[cfg(test)]\nmod difference_tests;\n\n#[cfg(test)]\npub(crate) mod test_observer;\n\n#[cfg(test)]\nmod byte_map_tests;\n"},{"id":6,"name":{"Local":"src/backend/x86_vpclmul512.rs"},"crate_name":"bulksketch","contents":"//! Eight compact GF64 lanes, with four products per VPCLMUL instruction.\n#![allow(unsafe_code)]\n\nuse {\n    super::{\n        contract::{Arithmetic, BulkKernels},\n        portable::Portable,\n        x86_pclmul::Pclmul,\n    },\n    crate::{\n        field::{BinaryField, frobenius::square as map_square},\n        types::RawProduct,\n    },\n    core::arch::x86_64::{\n        __cpuid, __cpuid_count, __m512i, _mm_cvtsi128_si64, _mm512_castsi512_si128,\n        _mm512_clmulepi64_epi128, _mm512_mask_mov_epi64, _mm512_mask_storeu_epi64,\n        _mm512_maskz_loadu_epi64, _mm512_or_si512, _mm512_permutex2var_epi64,\n        _mm512_permutexvar_epi64, _mm512_set_epi64, _mm512_set1_epi64, _mm512_setzero_si512,\n        _mm512_shuffle_epi32, _mm512_shuffle_i64x2, _mm512_slli_epi64, _mm512_srli_epi64,\n        _mm512_test_epi64_mask, _mm512_unpackhi_epi64, _mm512_unpacklo_epi64, _mm512_xor_si512,\n        _xgetbv,\n    },\n};\n\ntype ScalarArithmetic = Pclmul;\n\n#[derive(Clone, Copy, Debug)]\npub(crate) struct Vpclmul512;\n\n#[inline]\npub(super) fn available() -> bool {\n    static AVAILABLE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();\n    *AVAILABLE.get_or_init(detect)\n}\n\nfn detect() -> bool {\n    // SAFETY: CPUID is architectural on x86-64. XGETBV is reached only when\n    // CPUID reports both XSAVE and OSXSAVE; no vector instruction executes here.\n    unsafe {\n        let leaf1 = __cpuid(1);\n        let leaf7 = __cpuid_count(7, 0);\n        let cpu = leaf7.ebx & (1 << 16) != 0 && leaf7.ecx & (1 << 10) != 0;\n        let xsave = leaf1.ecx & (3 << 26) == 3 << 26;\n        let os = xsave && _xgetbv(0) & 0xe6 == 0xe6;\n        super::detect::vpclmul512_supported(cpu, os)\n    }\n}\n\nimpl<F: BinaryField> Arithmetic<F> for Vpclmul512 {\n    fn mul(a: u64, b: u64) -> u64 {\n        <ScalarArithmetic as Arithmetic<F>>::mul(a, b)\n    }\n    fn square(a: u64) -> u64 {\n        <ScalarArithmetic as Arithmetic<F>>::square(a)\n    }\n    fn frobenius(a: u64, power: u32) -> u64 {\n        <ScalarArithmetic as Arithmetic<F>>::frobenius(a, power)\n    }\n    fn inverse(a: u64) -> Option<u64> {\n        <ScalarArithmetic as Arithmetic<F>>::inverse(a)\n    }\n    fn trace(a: u64) -> u8 {\n        <ScalarArithmetic as Arithmetic<F>>::trace(a)\n    }\n    fn solve_quadratic(a: u64) -> Option<u64> {\n        <ScalarArithmetic as Arithmetic<F>>::solve_quadratic(a)\n    }\n    fn raw_mul(a: u64, b: u64) -> RawProduct {\n        <ScalarArithmetic as Arithmetic<F>>::raw_mul(a, b)\n    }\n    fn reduce(p: RawProduct) -> u64 {\n        <ScalarArithmetic as Arithmetic<F>>::reduce(p)\n    }\n\n    #[cfg(test)]\n    fn dot(a: &[u64], b: &[u64]) -> u64 {\n        assert_eq!(a.len(), b.len(), \"dot length mismatch\");\n        if F::BITS != 64 {\n            return <Portable as Arithmetic<F>>::dot(a, b);\n        }\n        // SAFETY: dispatch selects this backend only after available(); all loads\n        // are masked to the admitted slices. Test callers use the same gate.\n        unsafe { dot(a, b) }\n    }\n\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64) {\n        assert_eq!(dst.len(), src.len(), \"scale_xor length mismatch\");\n        if F::BITS != 64 {\n            return <Portable as Arithmetic<F>>::scale_xor(dst, src, scale);\n        }\n        // SAFETY: checked backend selection guarantees both target features.\n        unsafe { scale_xor(dst, src, scale) }\n    }\n\n    fn square_slice(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"square_slice length mismatch\");\n        if F::BITS != 64 {\n            return <Portable as Arithmetic<F>>::square_slice(dst, src);\n        }\n        // SAFETY: checked backend selection guarantees both target features.\n        unsafe { square_slice(dst, src) }\n    }\n}\n\nimpl<F: BinaryField> BulkKernels<F> for Vpclmul512 {\n    fn square_mod(a: &[u64], table: &[u64], dst: &mut [u64], raw: &mut [RawProduct]) -> bool {\n        if F::BITS != 64 {\n            return false;\n        }\n        // SAFETY: backend selection checked AVX-512F, VPCLMULQDQ and OS ZMM state.\n        // Dense::square_mod_into checks the slice dimensions before this call.\n        unsafe { square_mod(a, table, dst, raw) }\n        true\n    }\n\n    fn multiply_linear(coefficients: &mut [u64], root: u64) {\n        if F::BITS != 64 {\n            return <Portable as BulkKernels<F>>::multiply_linear(coefficients, root);\n        }\n        // SAFETY: checked backend selection guarantees both target features.\n        unsafe { multiply_linear(coefficients, root) }\n    }\n\n    fn odd_recurrence_matches(odd: &[u64], squared_locator: &[u64]) -> bool {\n        if F::BITS != 64 {\n            return <Portable as BulkKernels<F>>::odd_recurrence_matches(odd, squared_locator);\n        }\n        // SAFETY: checked backend selection guarantees both target features;\n        // every masked load is bounded by the admitted input slices.\n        unsafe { odd_recurrence_matches(odd, squared_locator) }\n    }\n\n    fn insert_nonzero(odd: &mut [u64], ids: &[u64]) {\n        if odd.is_empty() || ids.is_empty() {\n            return;\n        }\n        if F::BITS != 64 {\n            return <Portable as BulkKernels<F>>::insert_nonzero(odd, ids);\n        }\n        // SAFETY: checked backend selection guarantees both target features.\n        unsafe { insert(odd, ids) }\n    }\n\n    fn encode_nonzero(odd: &mut [u64], ids: &[u64]) {\n        if F::BITS == 64 && odd.len() == 18 && matches!(ids.len(), 1 | 2) {\n            // SAFETY: checked backend selection guarantees AVX-512F and VPCLMULQDQ.\n            unsafe { encode_18(odd, ids) }\n            return;\n        }\n        odd.fill(0);\n        if ids.len() <= 2 {\n            for id in ids {\n                <Self as BulkKernels<F>>::insert_nonzero(odd, std::slice::from_ref(id));\n            }\n        } else {\n            <Self as BulkKernels<F>>::insert_nonzero(odd, ids);\n        }\n    }\n\n    fn xor_assign(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"xor_assign length mismatch\");\n        // SAFETY: checked backend selection guarantees AVX-512 state.\n        unsafe { xor_assign(dst, src) }\n    }\n\n    fn difference(dst: &mut [u64], local: &[u64], remote: &[u8]) -> bool {\n        #[cfg(test)]\n        super::test_observer::difference();\n        assert_eq!(dst.len(), local.len(), \"difference length mismatch\");\n        assert_eq!(\n            remote.len(),\n            8 * dst.len(),\n            \"difference byte length mismatch\"\n        );\n        // SAFETY: this backend is constructed only after CPU/OS-state checks.\n        // The kernel masks every load/store to the equal admitted slice lengths.\n        unsafe { difference(dst, local, remote) }\n    }\n\n    fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]) {\n        assert_eq!(out.len(), points.len(), \"horner_many length mismatch\");\n        if F::BITS != 64 {\n            return <Portable as BulkKernels<F>>::horner_many(coefficients, points, out);\n        }\n        // SAFETY: checked backend selection guarantees both target features.\n        unsafe { horner_many(coefficients, points, out) }\n    }\n}\n\nfn mask(len: usize) -> u8 {\n    debug_assert!(len <= 8);\n    if len == 0 { 0 } else { u8::MAX >> (8 - len) }\n}\n\n#[target_feature(enable = \"avx512f\")]\nfn load(words: &[u64]) -> __m512i {\n    // SAFETY: only the low words.len() lanes are accessed, and unaligned\n    // addresses are permitted. Every caller supplies at most eight words.\n    unsafe { _mm512_maskz_loadu_epi64(mask(words.len()), words.as_ptr().cast()) }\n}\n\n#[target_feature(enable = \"avx512f\")]\nfn store(words: &mut [u64], value: __m512i) {\n    // SAFETY: the mask limits writes to this exclusively borrowed slice.\n    unsafe { _mm512_mask_storeu_epi64(words.as_mut_ptr().cast(), mask(words.len()), value) }\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn raw(a: __m512i, b: __m512i) -> (__m512i, __m512i) {\n    (\n        _mm512_clmulepi64_epi128::<0x00>(a, b),\n        _mm512_clmulepi64_epi128::<0x11>(a, b),\n    )\n}\n\n// Eight output coefficients of the current, already charged row per vector.\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn square_mod(a: &[u64], table: &[u64], dst: &mut [u64], scratch: &mut [RawProduct]) {\n    let degree = dst.len();\n    let first_high = degree.div_ceil(2);\n    dst.fill(0);\n    for (i, &coefficient) in a.iter().enumerate() {\n        let square = <ScalarArithmetic as Arithmetic<crate::field::Gf64>>::square(coefficient);\n        scratch[i].lo = square;\n        if i < first_high {\n            dst[2 * i] = square;\n        }\n    }\n    // Reuse the raw scratch for coefficient squares. Each table row scales a\n    // contiguous output block; XOR unreduced products across all high inputs\n    // and reduce just once per block. Masked loads/stores handle the last block.\n    for offset in (0..degree).step_by(8) {\n        let end = (offset + 8).min(degree);\n        let mut even = _mm512_setzero_si512();\n        let mut odd = even;\n        for (i, square) in scratch[..a.len()].iter().enumerate().skip(first_high) {\n            let start = (i - first_high) * degree;\n            let scale = _mm512_set1_epi64(i64::from_ne_bytes(square.lo.to_ne_bytes()));\n            let (lo, hi) = raw(scale, load(&table[start + offset..start + end]));\n            even = _mm512_xor_si512(even, lo);\n            odd = _mm512_xor_si512(odd, hi);\n        }\n        let result = reduce_shift(\n            _mm512_unpacklo_epi64(even, odd),\n            _mm512_unpackhi_epi64(even, odd),\n        );\n        let out = &mut dst[offset..end];\n        store(out, _mm512_xor_si512(load(out), result));\n    }\n}\n\n#[target_feature(enable = \"avx512f\")]\nfn horizontal_xor(mut value: __m512i) -> u64 {\n    value = _mm512_xor_si512(value, _mm512_shuffle_i64x2::<0x4e>(value, value));\n    value = _mm512_xor_si512(value, _mm512_shuffle_i64x2::<0xb1>(value, value));\n    value = _mm512_xor_si512(value, _mm512_shuffle_epi32::<0x4e>(value));\n    u64::from_ne_bytes(_mm_cvtsi128_si64(_mm512_castsi512_si128(value)).to_ne_bytes())\n}\n\n#[target_feature(enable = \"avx512f\")]\nfn reduce_shift(lo: __m512i, hi: __m512i) -> __m512i {\n    let overflow = _mm512_xor_si512(\n        _mm512_srli_epi64::<63>(hi),\n        _mm512_xor_si512(_mm512_srli_epi64::<61>(hi), _mm512_srli_epi64::<60>(hi)),\n    );\n    let fold = |v| {\n        _mm512_xor_si512(\n            v,\n            _mm512_xor_si512(\n                _mm512_slli_epi64::<1>(v),\n                _mm512_xor_si512(_mm512_slli_epi64::<3>(v), _mm512_slli_epi64::<4>(v)),\n            ),\n        )\n    };\n    _mm512_xor_si512(lo, _mm512_xor_si512(fold(hi), fold(overflow)))\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn reduce_cl(product: __m512i) -> __m512i {\n    let polynomial = _mm512_set1_epi64(0x1b);\n    let fold = _mm512_clmulepi64_epi128::<0x01>(product, polynomial);\n    let overflow = _mm512_clmulepi64_epi128::<0x01>(fold, polynomial);\n    _mm512_xor_si512(product, _mm512_xor_si512(fold, overflow))\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn multiply<const CL: bool>(a: __m512i, b: __m512i) -> __m512i {\n    let (even, odd) = raw(a, b);\n    if CL {\n        _mm512_unpacklo_epi64(reduce_cl(even), reduce_cl(odd))\n    } else {\n        reduce_shift(\n            _mm512_unpacklo_epi64(even, odd),\n            _mm512_unpackhi_epi64(even, odd),\n        )\n    }\n}\n\n#[cfg(test)]\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn dot(a: &[u64], b: &[u64]) -> u64 {\n    let mut even = _mm512_setzero_si512();\n    let mut odd = even;\n    for (a, b) in a.chunks(8).zip(b.chunks(8)) {\n        let (low, high) = raw(load(a), load(b));\n        even = _mm512_xor_si512(even, low);\n        odd = _mm512_xor_si512(odd, high);\n    }\n    // XOR is carryless: one final scalar reduction suffices for every lane.\n    let lo = horizontal_xor(_mm512_unpacklo_epi64(even, odd));\n    let hi = horizontal_xor(_mm512_unpackhi_epi64(even, odd));\n    <ScalarArithmetic as Arithmetic<crate::field::Gf64>>::reduce(RawProduct { lo, hi })\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn scale_xor(dst: &mut [u64], src: &[u64], scale: u64) {\n    scale_kernel::<false>(dst, src, scale);\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn scale_kernel<const CL: bool>(dst: &mut [u64], src: &[u64], scale: u64) {\n    if scale == 0 {\n        return;\n    }\n    if scale == 1 {\n        return xor_assign(dst, src);\n    }\n    let scale = _mm512_set1_epi64(i64::from_ne_bytes(scale.to_ne_bytes()));\n    for (dst, src) in dst.chunks_mut(8).zip(src.chunks(8)) {\n        store(\n            dst,\n            _mm512_xor_si512(load(dst), multiply::<CL>(load(src), scale)),\n        );\n    }\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\n#[cfg_attr(\n    not(test),\n    allow(\n        dead_code,\n        reason = \"square_slice contract is exercised by the forced kernel corpus\"\n    )\n)]\nfn square_slice(dst: &mut [u64], src: &[u64]) {\n    square_kernel::<false>(dst, src);\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\n#[cfg_attr(\n    not(test),\n    allow(\n        dead_code,\n        reason = \"square_slice contract is exercised by the forced kernel corpus\"\n    )\n)]\nfn square_kernel<const CL: bool>(dst: &mut [u64], src: &[u64]) {\n    for (dst, src) in dst.chunks_mut(8).zip(src.chunks(8)) {\n        let value = load(src);\n        store(dst, multiply::<CL>(value, value));\n    }\n}\n\n#[target_feature(enable = \"avx512f\")]\nfn xor_assign(dst: &mut [u64], src: &[u64]) {\n    for (dst, src) in dst.chunks_mut(8).zip(src.chunks(8)) {\n        store(dst, _mm512_xor_si512(load(dst), load(src)));\n    }\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]) {\n    horner_kernel::<true>(coefficients, points, out);\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn horner_kernel<const CL: bool>(coefficients: &[u64], points: &[u64], out: &mut [u64]) {\n    let Some((&leading, rest)) = coefficients.split_last() else {\n        out.fill(0);\n        return;\n    };\n    for (points, out) in points.chunks(8).zip(out.chunks_mut(8)) {\n        let points = load(points);\n        let mut value = _mm512_set1_epi64(i64::from_ne_bytes(leading.to_ne_bytes()));\n        for &coefficient in rest.iter().rev() {\n            value = _mm512_xor_si512(\n                multiply::<CL>(value, points),\n                _mm512_set1_epi64(i64::from_ne_bytes(coefficient.to_ne_bytes())),\n            );\n        }\n        store(out, value);\n    }\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn insert(odd: &mut [u64], ids: &[u64]) {\n    if odd.is_empty() || ids.is_empty() {\n        return;\n    }\n    if ids.len() == 1 {\n        match odd.len() {\n            18 => return insert_18(odd, ids[0]),\n            32 => return insert_32(odd, ids[0]),\n            72 => return insert_single::<72>(odd, ids[0]),\n            89 => return insert_single::<89>(odd, ids[0]),\n            _ => {}\n        }\n    }\n    // Sparse rows leave most lanes of the dependent tile unused. Reuse the\n    // short single-ID power schedules before switching to parallel ID lanes.\n    if ids.len() <= 4 {\n        match odd.len() {\n            18 | 72 | 89 => return insert_sparse(odd, ids),\n            _ => {}\n        }\n    }\n    for ids in ids.chunks(32) {\n        match ids.len() {\n            0 => {}\n            1..=8 => insert_tile::<1, true>(odd, ids),\n            9..=16 => insert_tile::<2, true>(odd, ids),\n            _ => insert_tile::<4, false>(odd, ids),\n        }\n    }\n}\n\n// Re-enter single dispatch so the kernels keep one call site and their original\n// inlining. Keep the sparse loop's register saves off the single-ID entry path.\n#[inline(never)]\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn insert_sparse(odd: &mut [u64], ids: &[u64]) {\n    for &id in ids {\n        insert(odd, &[id]);\n    }\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn insert_tile<const W: usize, const CL: bool>(odd: &mut [u64], ids: &[u64]) {\n    let mut powers = [_mm512_setzero_si512(); W];\n    let mut steps = powers;\n    for ((power, step), ids) in powers.iter_mut().zip(&mut steps).zip(ids.chunks(8)) {\n        *power = load(ids);\n        *step = multiply::<CL>(*power, *power);\n    }\n    odd[0] ^= horizontal_xor(\n        powers\n            .iter()\n            .copied()\n            .fold(_mm512_setzero_si512(), |sum, p| _mm512_xor_si512(sum, p)),\n    );\n    for syndrome in &mut odd[1..] {\n        let mut sum = _mm512_setzero_si512();\n        for (power, &step) in powers.iter_mut().zip(&steps) {\n            *power = multiply::<CL>(*power, step);\n            sum = _mm512_xor_si512(sum, *power);\n        }\n        *syndrome ^= horizontal_xor(sum);\n    }\n}\n\n#[cfg(test)]\npub(super) fn test_frobenius(word: u64, power: usize) -> u64 {\n    let lane = power - 1;\n    let mut result = 0;\n    for (chunk, entries) in INSERT_BASES.six.iter().enumerate() {\n        result ^= entries[((word >> (6 * chunk)) & 63) as usize][lane];\n    }\n    result\n        ^ INSERT_BASES.five[0][((word >> 54) & 31) as usize][lane]\n        ^ INSERT_BASES.five[1][(word >> 59) as usize][lane]\n}\n\n// Each lookup supplies all seven Frobenius powers of x. Nine six-bit chunks\n// and two five-bit chunks cover the full ID with 640 cache-line entries (40 KiB).\n// Alignment keeps an entry in one cache line; it imposes no alignment on sketches.\n#[repr(C, align(64))]\nstruct InsertionBases {\n    six: [[[u64; 8]; 64]; 9],\n    five: [[[u64; 8]; 32]; 2],\n}\n\n#[expect(\n    clippy::large_stack_arrays,\n    reason = \"evaluated only by the static initializer\"\n)]\nconst fn insertion_bases() -> InsertionBases {\n    let mut maps = InsertionBases {\n        six: [[[0; 8]; 64]; 9],\n        five: [[[0; 8]; 32]; 2],\n    };\n    let mut bit = 0;\n    while bit < 64 {\n        let mut column = 1_u64 << bit;\n        let mut power = 0;\n        while power < 7 {\n            column = map_square(column);\n            let (chunk, shift, count) = if bit < 54 {\n                (bit / 6, bit % 6, 64)\n            } else {\n                ((bit - 54) / 5, (bit - 54) % 5, 32)\n            };\n            let mut value = 1;\n            while value < count {\n                if value & (1 << shift) != 0 {\n                    if bit < 54 {\n                        maps.six[chunk][value][power] ^= column;\n                    } else {\n                        maps.five[chunk][value][power] ^= column;\n                    }\n                }\n                value += 1;\n            }\n            power += 1;\n        }\n        bit += 1;\n    }\n    maps\n}\nstatic INSERT_BASES: InsertionBases = insertion_bases();\n\n#[target_feature(enable = \"avx512f\")]\nfn single_bases(id: u64) -> __m512i {\n    let v0 = load(&INSERT_BASES.six[0][(id & 63) as usize]);\n    let v1 = load(&INSERT_BASES.six[1][((id >> 6) & 63) as usize]);\n    let v2 = load(&INSERT_BASES.six[2][((id >> 12) & 63) as usize]);\n    let v3 = load(&INSERT_BASES.six[3][((id >> 18) & 63) as usize]);\n    let v4 = load(&INSERT_BASES.six[4][((id >> 24) & 63) as usize]);\n    let v5 = load(&INSERT_BASES.six[5][((id >> 30) & 63) as usize]);\n    let v6 = load(&INSERT_BASES.six[6][((id >> 36) & 63) as usize]);\n    let v7 = load(&INSERT_BASES.six[7][((id >> 42) & 63) as usize]);\n    let v8 = load(&INSERT_BASES.six[8][((id >> 48) & 63) as usize]);\n    let v9 = load(&INSERT_BASES.five[0][((id >> 54) & 31) as usize]);\n    let v10 = load(&INSERT_BASES.five[1][(id >> 59) as usize]);\n    let a = _mm512_xor_si512(v0, _mm512_xor_si512(v1, v2));\n    let b = _mm512_xor_si512(v3, _mm512_xor_si512(v4, v5));\n    let c = _mm512_xor_si512(v6, _mm512_xor_si512(v7, v8));\n    let d = _mm512_xor_si512(v9, v10);\n    _mm512_xor_si512(_mm512_xor_si512(a, b), _mm512_xor_si512(c, d))\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn insert_18(odd: &mut [u64], id: u64) {\n    let (low, high, tail) = powers_18(id);\n    let (low_words, rest) = odd[..18].split_at_mut(8);\n    let (high_words, tail_words) = rest.split_at_mut(8);\n    store(low_words, _mm512_xor_si512(load(low_words), low));\n    store(high_words, _mm512_xor_si512(load(high_words), high));\n    store(tail_words, _mm512_xor_si512(load(tail_words), tail));\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn encode_18(odd: &mut [u64], ids: &[u64]) {\n    let (mut low, mut high, mut tail) = powers_18(ids[0]);\n    if ids.len() == 2 {\n        let (other_low, other_high, other_tail) = powers_18(ids[1]);\n        low = _mm512_xor_si512(low, other_low);\n        high = _mm512_xor_si512(high, other_high);\n        tail = _mm512_xor_si512(tail, other_tail);\n    }\n    let (low_words, rest) = odd[..18].split_at_mut(8);\n    let (high_words, tail_words) = rest.split_at_mut(8);\n    store(low_words, low);\n    store(high_words, high);\n    store(tail_words, tail);\n}\n\n#[inline]\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn powers_18(id: u64) -> (__m512i, __m512i, __m512i) {\n    let x = _mm512_set1_epi64(i64::from_ne_bytes(id.to_ne_bytes()));\n    let base = single_bases(id);\n    // The spare first-level lane computes x^24 = x^8 * x^16,\n    // avoiding a separate Frobenius lookup on the cube.\n    // First: x^3,x^5,x^9,x^17,x^33. Second: x^7,x^11,x^13,x^19,x^21,x^25,x^35.\n    let first = multiply::<true>(\n        _mm512_mask_mov_epi64(\n            x,\n            0x20,\n            _mm512_permutexvar_epi64(_mm512_set_epi64(2, 2, 2, 2, 2, 2, 2, 2), base),\n        ),\n        _mm512_mask_mov_epi64(\n            base,\n            0x20,\n            _mm512_permutexvar_epi64(_mm512_set_epi64(3, 3, 3, 3, 3, 3, 3, 3), base),\n        ),\n    );\n    let second = multiply::<true>(\n        _mm512_permutexvar_epi64(_mm512_set_epi64(5, 0, 2, 1, 0, 1, 0, 0), first),\n        _mm512_permutexvar_epi64(_mm512_set_epi64(5, 4, 3, 3, 3, 2, 2, 1), base),\n    );\n    let right = _mm512_permutexvar_epi64(_mm512_set_epi64(5, 5, 5, 0, 3, 3, 3, 2), base);\n    let right = _mm512_mask_mov_epi64(\n        right,\n        0x10,\n        _mm512_permutexvar_epi64(_mm512_set_epi64(5, 5, 5, 5, 5, 5, 5, 5), first),\n    );\n    // Third: x^15,x^23,x^27,x^29,x^31. Keep products in registers until the row update.\n    let third = multiply::<true>(\n        _mm512_permutexvar_epi64(_mm512_set_epi64(7, 7, 7, 0, 2, 1, 0, 0), second),\n        right,\n    );\n    let low = _mm512_permutex2var_epi64(first, _mm512_set_epi64(0, 10, 9, 2, 8, 1, 0, 0), second);\n    let low = _mm512_permutex2var_epi64(low, _mm512_set_epi64(8, 6, 5, 4, 3, 2, 1, 0), third);\n    let low = _mm512_mask_mov_epi64(low, 1, x);\n    let high =\n        _mm512_permutex2var_epi64(first, _mm512_set_epi64(0, 0, 0, 13, 0, 12, 11, 3), second);\n    let high = _mm512_permutex2var_epi64(high, _mm512_set_epi64(12, 11, 10, 4, 9, 2, 1, 0), third);\n    let tail = _mm512_permutex2var_epi64(first, _mm512_set_epi64(0, 0, 0, 0, 0, 0, 14, 4), second);\n    (low, high, tail)\n}\n\n// Three multiplication levels, with spare lanes carrying even powers needed\n// by later levels. Five vector multiplies replace the six of block doubling;\n// the exponent layouts below make each literal permutation auditable.\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn insert_32(odd: &mut [u64], id: u64) {\n    let odd = &mut odd[..32];\n    let base = single_bases(id);\n    let x = _mm512_set1_epi64(i64::from_ne_bytes(id.to_ne_bytes()));\n    // first: x^3,x^5,x^9,x^17,x^33,x^12,x^24,x^48.\n    let first = multiply::<true>(\n        _mm512_permutex2var_epi64(x, _mm512_set_epi64(11, 10, 9, 0, 0, 0, 0, 0), base),\n        _mm512_permutexvar_epi64(_mm512_set_epi64(4, 3, 2, 4, 3, 2, 1, 0), base),\n    );\n    // second_low: x^7,x^11,x^13,x^19,x^21,x^25,x^35,x^37.\n    let second_low = multiply::<true>(\n        _mm512_permutexvar_epi64(_mm512_set_epi64(1, 0, 2, 1, 0, 1, 0, 0), first),\n        _mm512_permutexvar_epi64(_mm512_set_epi64(4, 4, 3, 3, 3, 2, 2, 1), base),\n    );\n    // second_high: x^41,x^49,x^15,x^27,x^29,x^51,x^40,x^56.\n    let second_high = multiply::<true>(\n        _mm512_permutex2var_epi64(first, _mm512_set_epi64(6, 10, 0, 1, 0, 0, 3, 2), base),\n        _mm512_permutex2var_epi64(base, _mm512_set_epi64(4, 4, 15, 14, 14, 13, 4, 4), first),\n    );\n    // third_low: x^23,x^31,x^39,x^43,x^45,x^47,x^53,x^55.\n    let third_low = multiply::<true>(\n        _mm512_permutex2var_epi64(second_low, _mm512_set_epi64(0, 9, 0, 9, 8, 0, 0, 0), first),\n        _mm512_mask_mov_epi64(\n            _mm512_permutex2var_epi64(base, _mm512_set_epi64(15, 15, 0, 0, 0, 4, 14, 3), first),\n            56,\n            _mm512_permutexvar_epi64(_mm512_set_epi64(0, 0, 6, 6, 6, 0, 0, 0), second_high),\n        ),\n    );\n    // third_high: x^57,x^59,x^61,x^63 (remaining lanes unused).\n    let third_high = multiply::<true>(\n        _mm512_permutex2var_epi64(first, _mm512_set_epi64(0, 0, 0, 0, 8, 1, 0, 2), second_low),\n        _mm512_permutex2var_epi64(\n            first,\n            _mm512_set_epi64(0, 0, 0, 0, 15, 15, 15, 7),\n            second_high,\n        ),\n    );\n    let value = _mm512_mask_mov_epi64(\n        _mm512_mask_mov_epi64(\n            _mm512_permutex2var_epi64(x, _mm512_set_epi64(0, 0, 0, 10, 0, 9, 8, 0), first),\n            104,\n            _mm512_permutexvar_epi64(_mm512_set_epi64(0, 2, 1, 0, 0, 0, 0, 0), second_low),\n        ),\n        128,\n        _mm512_permutexvar_epi64(_mm512_set_epi64(2, 0, 0, 0, 0, 0, 0, 0), second_high),\n    );\n    let dst = &mut odd[0..8];\n    store(dst, _mm512_xor_si512(load(dst), value));\n    let value = _mm512_mask_mov_epi64(\n        _mm512_mask_mov_epi64(\n            _mm512_permutex2var_epi64(\n                first,\n                _mm512_set_epi64(0, 0, 0, 13, 0, 12, 11, 3),\n                second_low,\n            ),\n            136,\n            _mm512_permutexvar_epi64(_mm512_set_epi64(1, 0, 0, 0, 0, 0, 0, 0), third_low),\n        ),\n        96,\n        _mm512_permutexvar_epi64(_mm512_set_epi64(0, 4, 3, 0, 0, 0, 0, 0), second_high),\n    );\n    let dst = &mut odd[8..16];\n    store(dst, _mm512_xor_si512(load(dst), value));\n    let value = _mm512_mask_mov_epi64(\n        _mm512_mask_mov_epi64(\n            _mm512_permutex2var_epi64(\n                first,\n                _mm512_set_epi64(0, 0, 0, 0, 0, 15, 14, 4),\n                second_low,\n            ),\n            232,\n            _mm512_permutexvar_epi64(_mm512_set_epi64(5, 4, 3, 0, 2, 0, 0, 0), third_low),\n        ),\n        16,\n        _mm512_permutexvar_epi64(_mm512_set_epi64(0, 0, 0, 0, 0, 0, 0, 0), second_high),\n    );\n    let dst = &mut odd[16..24];\n    store(dst, _mm512_xor_si512(load(dst), value));\n    let value = _mm512_mask_mov_epi64(\n        _mm512_permutex2var_epi64(\n            second_high,\n            _mm512_set_epi64(0, 0, 0, 0, 15, 14, 5, 1),\n            third_low,\n        ),\n        240,\n        _mm512_permutexvar_epi64(_mm512_set_epi64(3, 2, 1, 0, 0, 0, 0, 0), third_high),\n    );\n    let dst = &mut odd[24..32];\n    store(dst, _mm512_xor_si512(load(dst), value));\n}\n\n// Start with x,x^3,...,x^15. Multiplication by x^16 doubles this to\n// sixteen odd powers; x^32, x^64 and x^128 repeat the same operation on\n// independent register blocks. Unlike a runtime schedule, every bound and\n// broadcast below is constant for both supported capacities.\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn insert_single<const C: usize>(odd: &mut [u64], id: u64) {\n    let odd = &mut odd[..C];\n    let base = single_bases(id);\n    let x = _mm512_set1_epi64(i64::from_ne_bytes(id.to_ne_bytes()));\n    let b = multiply::<true>(x, broadcast::<0>(base));\n    let a = _mm512_unpacklo_epi64(x, b);\n    let b = multiply::<true>(a, broadcast::<1>(base));\n    let a = _mm512_permutex2var_epi64(a, _mm512_set_epi64(9, 8, 1, 0, 9, 8, 1, 0), b);\n    let b = multiply::<true>(a, broadcast::<2>(base));\n    let v0 = _mm512_permutex2var_epi64(a, _mm512_set_epi64(11, 10, 9, 8, 3, 2, 1, 0), b);\n    update_single_block(odd, 0, v0);\n    let v1 = multiply::<true>(v0, broadcast::<3>(base));\n    update_single_block(odd, 8, v1);\n    let v2 = multiply::<true>(v0, broadcast::<4>(base));\n    update_single_block(odd, 16, v2);\n    let v3 = multiply::<true>(v1, broadcast::<4>(base));\n    update_single_block(odd, 24, v3);\n    if C > 32 {\n        let step = broadcast::<5>(base);\n        let v4 = multiply::<true>(v0, step);\n        let v5 = multiply::<true>(v1, step);\n        let v6 = multiply::<true>(v2, step);\n        let v7 = multiply::<true>(v3, step);\n        update_single_block(odd, 32, v4);\n        update_single_block(odd, 40, v5);\n        update_single_block(odd, 48, v6);\n        update_single_block(odd, 56, v7);\n        let step = broadcast::<6>(base);\n        update_single_block(odd, 64, multiply::<true>(v0, step));\n        if C > 72 {\n            update_single_block(odd, 72, multiply::<true>(v1, step));\n            update_single_block(odd, 80, multiply::<true>(v2, step));\n            update_single_block(odd, 88, multiply::<true>(v3, step));\n        }\n    }\n}\n\n#[target_feature(enable = \"avx512f\")]\nfn broadcast<const LANE: i64>(value: __m512i) -> __m512i {\n    _mm512_permutexvar_epi64(_mm512_set1_epi64(LANE), value)\n}\n\n#[target_feature(enable = \"avx512f\")]\nfn update_single_block(odd: &mut [u64], offset: usize, value: __m512i) {\n    let end = (offset + 8).min(odd.len());\n    let dst = &mut odd[offset..end];\n    store(dst, _mm512_xor_si512(load(dst), value));\n}\n\n#[cfg(test)]\npub(super) fn test_products(a: &[u64; 8], b: &[u64; 8]) -> ([u64; 8], [u64; 8]) {\n    assert!(available());\n    // SAFETY: this test interface enforces the hardware/OS gate itself.\n    unsafe { product_words(a, b) }\n}\n\n#[cfg(test)]\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn product_words(a: &[u64; 8], b: &[u64; 8]) -> ([u64; 8], [u64; 8]) {\n    let (even, odd) = raw(load(a), load(b));\n    let (mut lo, mut hi) = ([0; 8], [0; 8]);\n    store(&mut lo, _mm512_unpacklo_epi64(even, odd));\n    store(&mut hi, _mm512_unpackhi_epi64(even, odd));\n    (lo, hi)\n}\n\n#[cfg(test)]\npub(super) fn test_reductions(lo: &[u64; 8], hi: &[u64; 8]) -> ([u64; 8], [u64; 8]) {\n    assert!(available());\n    // SAFETY: this test interface enforces the hardware/OS gate itself.\n    unsafe { reduction_words(lo, hi) }\n}\n\n#[cfg(test)]\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn reduction_words(lo: &[u64; 8], hi: &[u64; 8]) -> ([u64; 8], [u64; 8]) {\n    let (lo, hi) = (load(lo), load(hi));\n    let even = _mm512_unpacklo_epi64(lo, hi);\n    let odd = _mm512_unpackhi_epi64(lo, hi);\n    let (mut shift, mut cl) = ([0; 8], [0; 8]);\n    store(&mut shift, reduce_shift(lo, hi));\n    store(\n        &mut cl,\n        _mm512_unpacklo_epi64(reduce_cl(even), reduce_cl(odd)),\n    );\n    (shift, cl)\n}\n\n#[target_feature(enable = \"avx512f\")]\nfn difference(dst: &mut [u64], local: &[u64], remote: &[u8]) -> bool {\n    let mut any = _mm512_setzero_si512();\n    for offset in (0..dst.len()).step_by(8) {\n        let n = (dst.len() - offset).min(8);\n        // SAFETY: offset..offset+n is in each slice; remote has eight bytes per\n        // word. Masked unaligned loads admit every byte alignment and short tail.\n        let delta = unsafe {\n            _mm512_xor_si512(\n                load(&local[offset..offset + n]),\n                _mm512_maskz_loadu_epi64(mask(n), remote.as_ptr().add(8 * offset).cast()),\n            )\n        };\n        store(&mut dst[offset..offset + n], delta);\n        any = _mm512_or_si512(any, delta);\n    }\n    _mm512_test_epi64_mask(any, any) != 0\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn multiply_linear(coefficients: &mut [u64], root: u64) {\n    let root = _mm512_set1_epi64(i64::from_ne_bytes(root.to_ne_bytes()));\n    let mut end = coefficients.len();\n    while end > 1 {\n        let start = end.saturating_sub(8).max(1);\n        // Descending blocks preserve every source coefficient until it is read.\n        let value = _mm512_xor_si512(\n            load(&coefficients[start..end]),\n            multiply::<true>(load(&coefficients[start - 1..end - 1]), root),\n        );\n        store(&mut coefficients[start..end], value);\n        end = start;\n    }\n}\n\n#[target_feature(enable = \"avx512f,vpclmulqdq\")]\nfn odd_recurrence_matches(odd: &[u64], squared_locator: &[u64]) -> bool {\n    let degree = squared_locator.len() - 1;\n    for index in (degree..odd.len()).step_by(8) {\n        let len = (odd.len() - index).min(8);\n        let mut even = _mm512_setzero_si512();\n        let mut high = even;\n        for lag in 1..=degree {\n            let (low, upper) = raw(\n                load(&odd[index - lag..index - lag + len]),\n                _mm512_set1_epi64(i64::from_ne_bytes(squared_locator[lag].to_ne_bytes())),\n            );\n            even = _mm512_xor_si512(even, low);\n            high = _mm512_xor_si512(high, upper);\n        }\n        let expected = _mm512_unpacklo_epi64(reduce_cl(even), reduce_cl(high));\n        let mismatch = _mm512_xor_si512(expected, load(&odd[index..index + len]));\n        if _mm512_test_epi64_mask(mismatch, _mm512_set1_epi64(-1)) & mask(len) != 0 {\n            return false;\n        }\n    }\n    true\n}\n"},{"id":7,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"src/types.rs"},"crate_name":"bulksketch","contents":"//! Value-only definitions; this module has no dependency on the engine layers.\n#![forbid(unsafe_code)]\n\n/// Polynomial-basis identity, including the irreducible polynomial.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[repr(u8)]\npub enum FieldId {\n    /// GF(2^64), modulus Z^64 + Z^4 + Z^3 + Z + 1, bit i is Z^i.\n    Gf64 = 1,\n}\n\n/// Shape admission failure, before any row storage is allocated.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ShapeError {\n    /// Unsupported field, zero/non-power-of-two row count, or zero capacity.\n    InvalidShape,\n    /// Configured storage/dimension cap or representable wire dimension exceeded.\n    InputLimitExceeded,\n}\n\n/// Bounded wire admission failure. No view is exposed on either error.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ParseError {\n    /// A caller-supplied byte or dimension limit was exceeded.\n    InputLimitExceeded,\n    /// Unknown metadata, malformed lengths, or noncanonical payload.\n    InvalidEncoding,\n}\n\nimpl std::fmt::Display for ShapeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InvalidShape => \"invalid sketch shape\",\n            Self::InputLimitExceeded => \"shape input limit exceeded\",\n        })\n    }\n}\nimpl std::error::Error for ShapeError {}\n\nimpl std::fmt::Display for ParseError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InputLimitExceeded => \"wire input limit exceeded\",\n            Self::InvalidEncoding => \"invalid sketch encoding\",\n        })\n    }\n}\nimpl std::error::Error for ParseError {}\n\n/// Runtime arithmetic capability. No complete-operation dispatch lives in this type.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub enum BackendId {\n    /// Always-available safe Rust arithmetic.\n    Portable,\n    /// Scalar x86 carryless multiplication.\n    Pclmul,\n    /// 256-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul256,\n    /// 512-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul512,\n}\n\n/// Backend selection requested at engine construction, before any decode.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum BackendRequest {\n    /// Select from capabilities detected at runtime.\n    Auto,\n    /// Require this capability; never bypass feature/OS-state validation.\n    Force(BackendId),\n}\n\n/// An explicitly requested backend is unavailable in this build or on this CPU/OS.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct BackendError(pub BackendId);\n\n/// Construction of mutable state failed before any state was returned.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CreateError {\n    /// The requested arithmetic implementation is unavailable.\n    Backend(BackendError),\n    /// The algebraic buffers could not be reserved.\n    AllocationFailed,\n}\n\n/// Batch insertion failed before changing the sketch.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum UpdateError {\n    /// The supplied insertion arena cannot hold this call's IDs or row offsets.\n    ScratchTooSmall,\n}\n\n/// XOR requires identical fields, row counts and capacities.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ShapeMismatch;\n\n/// Encoding failed without changing the destination or algebraic state.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum EncodeError {\n    /// The destination cannot hold the complete record.\n    BufferTooSmall,\n    /// The cached record could not be reserved.\n    AllocationFailed,\n}\n\nimpl std::fmt::Display for CreateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            Self::Backend(error) => error.fmt(f),\n            Self::AllocationFailed => f.write_str(\"sketch allocation failed\"),\n        }\n    }\n}\nimpl std::error::Error for CreateError {}\nimpl std::fmt::Display for UpdateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"insertion scratch is too small\")\n    }\n}\nimpl std::error::Error for UpdateError {}\nimpl std::fmt::Display for ShapeMismatch {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"sketch shapes differ\")\n    }\n}\nimpl std::error::Error for ShapeMismatch {}\nimpl std::fmt::Display for EncodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::BufferTooSmall => \"encoding buffer is too small\",\n            Self::AllocationFailed => \"encoding allocation failed\",\n        })\n    }\n}\nimpl std::error::Error for EncodeError {}\n\nimpl std::fmt::Display for BackendError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        write!(f, \"backend {:?} is unavailable\", self.0)\n    }\n}\nimpl std::error::Error for BackendError {}\n\n/// Backend-independent logical work, never elapsed time or instruction count.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]\npub struct WorkUnits(pub u64);\n\n/// A request-wide failure publishes no row report or provisional IDs.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeError {\n    /// Local and remote fields, row counts or capacities differ.\n    ShapeMismatch,\n    /// Unknown plan or an output budget larger than any row capacity.\n    InvalidPlan,\n    /// Raw candidate count exceeds the request cap, before normalization.\n    CandidateLimitExceeded,\n    /// Work arithmetic overflows or the next charge exceeds the request limit.\n    WorkLimitExceeded,\n    /// Layout overflows, exceeds its byte cap, or any supplied segment is short.\n    ScratchTooSmall,\n}\n\n/// An admitted row failed algebraically; independently successful rows remain usable.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeFailure {\n    /// Zero consumes an unavailable slot, or locator/final output exceeds beta.\n    DegreeExceedsBudget,\n    /// The locator fails required canonicality/algebraic validation.\n    InvalidLocator,\n    /// The locator does not split into distinct permitted field roots.\n    NotSplit,\n    /// Re-encoding fails any stored odd syndrome or the zero channel.\n    VerificationFailed,\n}\n\nimpl std::fmt::Display for DecodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::ShapeMismatch => \"sketch shapes differ\",\n            Self::InvalidPlan => \"invalid decode plan or output budget\",\n            Self::CandidateLimitExceeded => \"candidate input limit exceeded\",\n            Self::WorkLimitExceeded => \"decode work limit exceeded\",\n            Self::ScratchTooSmall => \"decode scratch is too small\",\n        })\n    }\n}\nimpl std::error::Error for DecodeError {}\n\n/// Deterministic stage order. Repeated trace/GCD/division/leaf stages follow factor traversal.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Stage {\n    /// Propose the nonzero root S1 before general decoding.\n    DirectOne,\n    /// Derive a distinct nonzero pair from S1 and S3 before general decoding.\n    DirectTwo,\n    /// Reject inconsistent cubic prefixes before inversion (V3).\n    GuardThree,\n    /// Normalize a passed cubic Newton guard (V3).\n    NewtonThree,\n    /// Reject inconsistent quartic prefixes before inversion (V3).\n    GuardFour,\n    /// Normalize a passed quartic Newton guard (V3).\n    NewtonFour,\n    /// Propose the roots of a cubic factor (V3).\n    LeafThree,\n    /// Propose the roots of a quartic factor (V3).\n    LeafFour,\n    /// Certify a complete distinct nonzero factor root set (V3).\n    FactorVerification,\n    /// Expand odd syndromes and reconstruct even powers.\n    Reconstruction,\n    /// Binary Berlekamp-Massey iterations.\n    BerlekampMassey,\n    /// Evaluate the original locator at normalized hints.\n    CandidateEvaluation,\n    /// Divide out confirmed candidate roots.\n    Deflation,\n    /// Build a factor's modular-square table.\n    ReducerPreparation,\n    /// Find the least affine multiple and solve its binary map (V3).\n    AffinePreparation,\n    /// Enumerate and evaluate the recovered affine solution coset (V3).\n    AffineEnumeration,\n    /// Form an annihilator splitter for the current affine coset (V3).\n    AffineSplit,\n    /// Try the next canonical trace direction and the internal split check.\n    Trace,\n    /// Compute a monic polynomial GCD.\n    Gcd,\n    /// Divide a factor exactly after a proper split.\n    FactorDivision,\n    /// Solve degree-one or degree-two leaves.\n    Leaf,\n    /// Verify every stored odd syndrome by re-encoding or rebuilt recurrence.\n    Verification,\n    /// Sort and validate the final original IDs.\n    Canonicalization,\n}\n\n/// Public stage progress contains no row outcome or provisional ID.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum StageProgress {\n    /// A deterministic stage completed; counters are cumulative for the request.\n    Completed {\n        /// Bucket whose stage completed, in deterministic request traversal order.\n        bucket: usize,\n        /// Stage just executed.\n        stage: Stage,\n        /// Logical work consumed so far.\n        work: WorkUnits,\n        /// Peak required workspace bytes, excluding unused arena capacity.\n        peak_scratch_bytes: usize,\n        /// Original BM locator degree for this row; zero until BM completes.\n        locator_degree: usize,\n        /// Confirmed candidate roots so far in this row.\n        candidate_hits: usize,\n        /// Trace directions attempted so far in this row.\n        trace_attempts: usize,\n        /// Degree returned by this row's most recent GCD; zero before the first GCD.\n        gcd_degree: usize,\n    },\n    /// Terminal request failure; finishing the job must return this error.\n    Failed(DecodeError),\n}\n\n/// Internal arithmetic product, distinct from a canonical field element.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub(crate) struct RawProduct {\n    pub(crate) lo: u64,\n    pub(crate) hi: u64,\n}\n\n/// One request meter, shared by preprocessing and all rows. A failed charge is terminal.\n#[derive(Debug)]\npub(crate) struct WorkMeter {\n    limit: WorkUnits,\n    used: WorkUnits,\n    exhausted: bool,\n}\n\nimpl WorkMeter {\n    pub(crate) fn new(limit: WorkUnits) -> Self {\n        Self {\n            limit,\n            used: WorkUnits(0),\n            exhausted: false,\n        }\n    }\n\n    pub(crate) fn charge(&mut self, charge: WorkUnits) -> Result<(), DecodeError> {\n        let next = self.used.0.checked_add(charge.0);\n        if self.exhausted || next.is_none_or(|n| n > self.limit.0) {\n            self.exhausted = true;\n            return Err(DecodeError::WorkLimitExceeded);\n        }\n        self.used = WorkUnits(next.expect(\"checked work charge\"));\n        Ok(())\n    }\n\n    pub(crate) fn used(&self) -> WorkUnits {\n        self.used\n    }\n}\n\n#[cfg(test)]\npub(crate) mod small_degree_observer;\n"},{"id":12,"name":{"Local":"/rustc/library/core/src/iter/adapters/enumerate.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/iter/adapters/mod.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/slice/iter.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/iter/adapters/step_by.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/../../stdarch/crates/core_arch/src/macros.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/../../stdarch/crates/core_arch/src/x86/mod.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/../../stdarch/crates/core_arch/src/mod.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"/rustc/library/core/src/iter/adapters/skip.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":24,"name":{"Local":"/rustc/library/core/src/iter/traits/iterator.rs"},"crate_name":"core","contents":null},{"id":25,"name":{"Local":"/rustc/library/core/src/iter/traits/mod.rs"},"crate_name":"core","contents":null},{"id":26,"name":{"Local":"/rustc/library/core/src/slice/iter/macros.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"/rustc/library/core/src/iter/traits/collect.rs"},"crate_name":"core","contents":null},{"id":28,"name":{"Local":"src/backend/x86_pclmul.rs"},"crate_name":"bulksketch","contents":"//! Scalar XMM kernels; only checked dispatch and feature-checked tests reach this module.\n#![allow(unsafe_code)]\n\n#[cfg(test)]\nuse std::arch::x86_64::_mm_setzero_si128;\nuse {\n    super::contract::{Arithmetic, BulkKernels},\n    crate::{\n        field::{BinaryField, gf64, maps},\n        types::RawProduct,\n    },\n    std::arch::x86_64::{\n        __m128i, _mm_clmulepi64_si128, _mm_cvtsi64_si128, _mm_cvtsi128_si64, _mm_srli_si128,\n        _mm_xor_si128,\n    },\n};\n\n#[derive(Clone, Copy, Debug)]\npub(crate) struct Pclmul;\n\n#[cfg(test)]\npub(super) fn reduce_cl_for_test(product: RawProduct) -> u64 {\n    assert!(std::is_x86_feature_detected!(\"pclmulqdq\"));\n    // SAFETY: detection above checks PCLMUL; the other intrinsics need baseline SSE2.\n    unsafe {\n        let value = std::arch::x86_64::_mm_set_epi64x(\n            i64::from_ne_bytes(product.hi.to_ne_bytes()),\n            i64::from_ne_bytes(product.lo.to_ne_bytes()),\n        );\n        low(reduced::<crate::field::Gf64, true>(value))\n    }\n}\n\nimpl<F: BinaryField> Arithmetic<F> for Pclmul {\n    fn mul(a: u64, b: u64) -> u64 {\n        // SAFETY: Pclmul is selected only after runtime PCLMUL detection.\n        unsafe { multiply::<F, true>(a, b) }\n    }\n\n    fn square(a: u64) -> u64 {\n        // SAFETY: checked dispatch guarantees PCLMUL; SSE2 is architectural on x86-64.\n        unsafe { multiply::<F, true>(a, a) }\n    }\n\n    fn frobenius(a: u64, power: u32) -> u64 {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { frobenius::<F>(a, power) }\n    }\n\n    fn inverse(a: u64) -> Option<u64> {\n        #[cfg(test)]\n        super::test_observer::inverse();\n        #[cfg(test)]\n        crate::types::small_degree_observer::inverse();\n        // SAFETY: checked dispatch detects PCLMULQDQ before selecting this backend.\n        unsafe { inverse::<F>(a) }\n    }\n\n    fn trace(a: u64) -> u8 {\n        maps::trace::<F>(a)\n    }\n\n    fn solve_quadratic(a: u64) -> Option<u64> {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { solve_quadratic::<F>(a) }\n    }\n\n    fn raw_mul(a: u64, b: u64) -> RawProduct {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { raw_product(a, b) }\n    }\n\n    fn reduce(product: RawProduct) -> u64 {\n        gf64::reduce::<F>(product)\n    }\n\n    #[cfg(test)]\n    fn dot(a: &[u64], b: &[u64]) -> u64 {\n        assert_eq!(a.len(), b.len(), \"dot length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { dot::<F, false>(a, b) }\n    }\n\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64) {\n        assert_eq!(dst.len(), src.len(), \"scale_xor length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { scale_xor::<F, true>(dst, src, scale) }\n    }\n\n    fn square_slice(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"square_slice length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { square_slice::<F, true>(dst, src) }\n    }\n}\n\nimpl<F: BinaryField> BulkKernels<F> for Pclmul {\n    fn insert_nonzero(odd: &mut [u64], ids: &[u64]) {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { insert::<F, true>(odd, ids) }\n    }\n\n    fn xor_assign(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"xor_assign length mismatch\");\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target ^= source;\n        }\n    }\n\n    fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]) {\n        assert_eq!(out.len(), points.len(), \"horner_many length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { horner::<F, true>(coefficients, points, out) }\n    }\n}\n\n#[inline]\nfn word(a: u64) -> __m128i {\n    // SAFETY: SSE2 is part of the x86-64 baseline, with no memory operands here.\n    unsafe { _mm_cvtsi64_si128(i64::from_ne_bytes(a.to_ne_bytes())) }\n}\n\n#[inline]\nfn low(product: __m128i) -> u64 {\n    // SAFETY: SSE2 is part of the x86-64 baseline, with no memory operands here.\n    u64::from_ne_bytes(unsafe { _mm_cvtsi128_si64(product) }.to_ne_bytes())\n}\n\n#[inline]\nfn words(product: __m128i) -> RawProduct {\n    // SAFETY: SSE2 is architectural on x86-64; the shift stays within this register.\n    let high = unsafe { _mm_srli_si128::<8>(product) };\n    RawProduct {\n        lo: low(product),\n        hi: low(high),\n    }\n}\n\n#[inline]\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn raw_product(a: u64, b: u64) -> RawProduct {\n    words(_mm_clmulepi64_si128::<0x00>(word(a), word(b)))\n}\n\n#[inline]\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn reduced<F: BinaryField, const CL: bool>(product: __m128i) -> __m128i {\n    if CL && F::BITS == 64 {\n        let modulus = word(F::MODULUS_LOW);\n        let first = _mm_clmulepi64_si128::<0x01>(product, modulus);\n        let second = _mm_clmulepi64_si128::<0x01>(first, modulus);\n        _mm_xor_si128(_mm_xor_si128(product, first), second)\n    } else {\n        word(gf64::reduce::<F>(words(product)))\n    }\n}\n\n#[inline]\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn multiply<F: BinaryField, const CL: bool>(a: u64, b: u64) -> u64 {\n    let product = _mm_clmulepi64_si128::<0x00>(word(a), word(b));\n    // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n    low(unsafe { reduced::<F, CL>(product) })\n}\n\n#[cfg(test)]\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn dot<F: BinaryField, const CL: bool>(a: &[u64], b: &[u64]) -> u64 {\n    let mut sum = _mm_setzero_si128();\n    for (&left, &right) in a.iter().zip(b) {\n        sum = _mm_xor_si128(sum, _mm_clmulepi64_si128::<0x00>(word(left), word(right)));\n    }\n    // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n    low(unsafe { reduced::<F, CL>(sum) })\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn scale_xor<F: BinaryField, const CL: bool>(dst: &mut [u64], src: &[u64], scale: u64) {\n    if scale == 0 {\n        return;\n    }\n    if scale == 1 {\n        for (target, &source) in dst.iter_mut().zip(src) {\n            *target ^= source;\n        }\n        return;\n    }\n    let scale = word(scale);\n    for (target, &source) in dst.iter_mut().zip(src) {\n        let product = _mm_clmulepi64_si128::<0x00>(word(source), scale);\n        // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n        *target ^= low(unsafe { reduced::<F, CL>(product) });\n    }\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn square_slice<F: BinaryField, const CL: bool>(dst: &mut [u64], src: &[u64]) {\n    for (target, &source) in dst.iter_mut().zip(src) {\n        let source = word(source);\n        let product = _mm_clmulepi64_si128::<0x00>(source, source);\n        // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n        *target = low(unsafe { reduced::<F, CL>(product) });\n    }\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn insert<F: BinaryField, const CL: bool>(odd: &mut [u64], ids: &[u64]) {\n    let Some((first, successors)) = odd.split_first_mut() else {\n        return;\n    };\n    for &id in ids {\n        *first ^= id;\n        // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n        let square = word(unsafe { multiply::<F, false>(id, id) });\n        let mut power = word(id);\n        for syndrome in &mut *successors {\n            let product = _mm_clmulepi64_si128::<0x00>(power, square);\n            // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n            power = unsafe { reduced::<F, CL>(product) };\n            *syndrome ^= low(power);\n        }\n    }\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn horner<F: BinaryField, const CL: bool>(\n    coefficients: &[u64],\n    points: &[u64],\n    out: &mut [u64],\n) {\n    let Some((&leading, rest)) = coefficients.split_last() else {\n        out.fill(0);\n        return;\n    };\n    for (target, &point) in out.iter_mut().zip(points) {\n        let point = word(point);\n        let mut value = word(leading);\n        for &coefficient in rest.iter().rev() {\n            let product = _mm_clmulepi64_si128::<0x00>(value, point);\n            // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n            value = _mm_xor_si128(unsafe { reduced::<F, CL>(product) }, word(coefficient));\n        }\n        *target = low(value);\n    }\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn frobenius<F: BinaryField>(mut a: u64, power: u32) -> u64 {\n    if F::BITS == 64\n        && let Some(value) = crate::field::frobenius::lookup(a, power % F::BITS)\n    {\n        return value;\n    }\n    for _ in 0..power % F::BITS {\n        // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n        a = unsafe { multiply::<F, false>(a, a) };\n    }\n    a\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn inverse<F: BinaryField>(a: u64) -> Option<u64> {\n    if F::BITS != 64 {\n        return maps::inverse_with_frobenius::<F>(\n            a,\n            // SAFETY: the enclosing function requires PCLMULQDQ.\n            |left, right| unsafe { multiply::<F, true>(left, right) },\n            // SAFETY: the enclosing function requires PCLMULQDQ.\n            |value, power| unsafe { frobenius::<F>(value, power) },\n        );\n    }\n    if a == 0 {\n        return None;\n    }\n    if a == 1 {\n        return Some(1);\n    }\n    // t_k = a^(2^k - 1). The chain 1,2,3,6,7,14,21,42,63 uses\n    // eight products; fixed linear maps replace the long Frobenius runs.\n    let map7 = |value| crate::field::frobenius::lookup(value, 7).expect(\"fixed inverse map\");\n    let map21 = crate::field::frobenius::inverse21;\n    // SAFETY: every multiply below requires the enclosing PCLMULQDQ feature.\n    unsafe {\n        let t2 = multiply::<F, true>(multiply::<F, false>(a, a), a);\n        let t3 = multiply::<F, true>(multiply::<F, false>(t2, t2), a);\n        let f3 = crate::field::frobenius::lookup(t3, 3).expect(\"fixed inverse map\");\n        let t6 = multiply::<F, true>(f3, t3);\n        let t7 = multiply::<F, true>(multiply::<F, false>(t6, t6), a);\n        let t14 = multiply::<F, true>(map7(t7), t7);\n        let t21 = multiply::<F, true>(map7(t14), t7);\n        let t42 = multiply::<F, true>(map21(t21), t21);\n        let t63 = multiply::<F, true>(map21(t42), t21);\n        Some(multiply::<F, false>(t63, t63))\n    }\n}\n\n#[target_feature(enable = \"pclmulqdq\")]\nunsafe fn solve_quadratic<F: BinaryField>(a: u64) -> Option<u64> {\n    if maps::trace::<F>(a) != 0 {\n        return None;\n    }\n    let solution = maps::quadratic_value::<F>(a);\n    // SAFETY: the enclosing function has the same PCLMUL feature requirement.\n    let square = unsafe { multiply::<F, false>(solution, solution) };\n    assert_eq!(square ^ solution, a, \"quadratic-map invariant\");\n    Some(solution)\n}\n"},{"id":29,"name":{"Local":"src/field/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical field identity, arithmetic and test-only tiny fields.\n#![forbid(unsafe_code)]\n\nuse crate::types::FieldId;\n\n#[cfg(test)]\npub(crate) mod arithmetic_tests;\n#[cfg(test)]\nmod constant_tests;\n#[cfg(any(target_arch = \"x86_64\", test))]\npub(crate) mod frobenius;\npub(crate) mod gf64;\npub(crate) mod maps;\nmod quadratic_chunks;\n#[cfg(test)]\npub(crate) mod reference;\n#[cfg(test)]\npub(crate) mod tiny;\n\npub(crate) mod sealed {\n    pub trait Sealed {}\n}\n\n/// Closed field specification. Kernels consume canonical words, never masked IDs.\npub trait BinaryField: sealed::Sealed + Copy + Eq + Send + Sync + 'static {\n    /// Extension degree over GF(2).\n    const BITS: u32;\n    /// Irreducible polynomial without its leading term.\n    const MODULUS_LOW: u64;\n    /// Registered polynomial/basis identity.\n    const WIRE_ID: FieldId;\n    /// Canonical element mask.\n    const MASK: u64;\n}\n\n/// Full-width GF(2^64) identity field.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub struct Gf64;\nimpl sealed::Sealed for Gf64 {}\nimpl BinaryField for Gf64 {\n    const BITS: u32 = 64;\n    const MODULUS_LOW: u64 = 0x1b;\n    const WIRE_ID: FieldId = FieldId::Gf64;\n    const MASK: u64 = u64::MAX;\n}\n"},{"id":30,"name":{"Local":"/rustc/library/core/src/iter/range.rs"},"crate_name":"core","contents":null},{"id":31,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":32,"name":{"Local":"/rustc/library/core/src/intrinsics/mod.rs"},"crate_name":"core","contents":null},{"id":33,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":34,"name":{"Local":"/rustc/library/core/src/../../stdarch/crates/core_arch/src/x86/avx512f.rs"},"crate_name":"core","contents":null},{"id":35,"name":{"Local":"/rustc/library/core/src/num/int_macros.rs"},"crate_name":"core","contents":null},{"id":36,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":37,"name":{"Local":"/rustc/library/core/src/array/iter.rs"},"crate_name":"core","contents":null},{"id":38,"name":{"Local":"/rustc/library/core/src/num/nonzero.rs"},"crate_name":"core","contents":null},{"id":39,"name":{"Local":"/rustc/library/core/src/iter/adapters/chain.rs"},"crate_name":"core","contents":null},{"id":40,"name":{"Local":"/rustc/library/core/src/iter/adapters/zip.rs"},"crate_name":"core","contents":null},{"id":41,"name":{"Local":"/rustc/library/core/src/iter/adapters/intersperse.rs"},"crate_name":"core","contents":null},{"id":42,"name":{"Local":"/rustc/library/core/src/ops/function.rs"},"crate_name":"core","contents":null},{"id":43,"name":{"Local":"/rustc/library/core/src/iter/adapters/map.rs"},"crate_name":"core","contents":null},{"id":44,"name":{"Local":"/rustc/library/core/src/iter/adapters/filter.rs"},"crate_name":"core","contents":null},{"id":45,"name":{"Local":"/rustc/library/core/src/iter/adapters/filter_map.rs"},"crate_name":"core","contents":null},{"id":46,"name":{"Local":"/rustc/library/core/src/iter/adapters/peekable.rs"},"crate_name":"core","contents":null},{"id":47,"name":{"Local":"/rustc/library/core/src/iter/adapters/skip_while.rs"},"crate_name":"core","contents":null},{"id":48,"name":{"Local":"/rustc/library/core/src/iter/adapters/take_while.rs"},"crate_name":"core","contents":null},{"id":49,"name":{"Local":"/rustc/library/core/src/iter/adapters/map_while.rs"},"crate_name":"core","contents":null},{"id":50,"name":{"Local":"/rustc/library/core/src/iter/adapters/take.rs"},"crate_name":"core","contents":null},{"id":51,"name":{"Local":"/rustc/library/core/src/iter/adapters/scan.rs"},"crate_name":"core","contents":null},{"id":52,"name":{"Local":"/rustc/library/core/src/iter/adapters/flatten.rs"},"crate_name":"core","contents":null},{"id":53,"name":{"Local":"/rustc/library/core/src/iter/adapters/map_windows.rs"},"crate_name":"core","contents":null},{"id":54,"name":{"Local":"/rustc/library/core/src/iter/adapters/fuse.rs"},"crate_name":"core","contents":null},{"id":55,"name":{"Local":"/rustc/library/core/src/iter/adapters/inspect.rs"},"crate_name":"core","contents":null},{"id":56,"name":{"Local":"/rustc/library/core/src/ops/try_trait.rs"},"crate_name":"core","contents":null},{"id":57,"name":{"Local":"/rustc/library/core/src/default.rs"},"crate_name":"core","contents":null},{"id":58,"name":{"Local":"/rustc/library/core/src/iter/traits/double_ended.rs"},"crate_name":"core","contents":null},{"id":59,"name":{"Local":"/rustc/library/core/src/iter/traits/exact_size.rs"},"crate_name":"core","contents":null},{"id":60,"name":{"Local":"/rustc/library/core/src/iter/adapters/rev.rs"},"crate_name":"core","contents":null},{"id":61,"name":{"Local":"/rustc/library/core/src/iter/adapters/copied.rs"},"crate_name":"core","contents":null},{"id":62,"name":{"Local":"/rustc/library/core/src/iter/adapters/cloned.rs"},"crate_name":"core","contents":null},{"id":63,"name":{"Local":"/rustc/library/core/src/iter/adapters/cycle.rs"},"crate_name":"core","contents":null},{"id":64,"name":{"Local":"/rustc/library/core/src/iter/adapters/array_chunks.rs"},"crate_name":"core","contents":null},{"id":65,"name":{"Local":"/rustc/library/core/src/iter/traits/accum.rs"},"crate_name":"core","contents":null},{"id":66,"name":{"Local":"src/backend/contract.rs"},"crate_name":"bulksketch","contents":"//! Each backend implements these static, monomorphized contracts for each checked capability.\n#![forbid(unsafe_code)]\n\nuse crate::{field::BinaryField, types::RawProduct};\n\n/// All operands/results are canonical F words. Slice dimensions are internal invariants.\n/// Inverse rejects zero; raw products are unreduced polynomials, never field elements.\npub(crate) trait Arithmetic<F: BinaryField>: Copy + Send + Sync + 'static {\n    fn mul(a: u64, b: u64) -> u64;\n    fn square(a: u64) -> u64;\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"arithmetic parity contract; insertion uses fixed private maps\"\n        )\n    )]\n    fn frobenius(a: u64, power: u32) -> u64;\n    fn inverse(a: u64) -> Option<u64>;\n    /// Absolute field trace, 0 or 1. Canonical scalar maps live in the field module.\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"arithmetic parity contract; scalar map owns current trace callers\"\n        )\n    )]\n    fn trace(a: u64) -> u8;\n    /// Deterministic right inverse of z^2+z on trace-zero inputs; verify each solution.\n    /// Even-degree fields use the fixed-pivot map, never the odd-degree half trace.\n    fn solve_quadratic(a: u64) -> Option<u64>;\n    fn raw_mul(a: u64, b: u64) -> RawProduct;\n    fn reduce(product: RawProduct) -> u64;\n    /// Equal lengths; XOR raw products then reduce once, including the empty dot = 0.\n    #[cfg(test)]\n    fn dot(a: &[u64], b: &[u64]) -> u64;\n    /// Equal lengths; dst[i] ^= src[i] * scale. Aliasing follows safe Rust borrows.\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64);\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"bulk parity contract; current reconstruction squares dependent positions\"\n        )\n    )]\n    fn square_slice(dst: &mut [u64], src: &[u64]);\n}\n\n/// Bulk arithmetic, without shape, wire, request, job or complete-operation types.\npub(crate) trait BulkKernels<F: BinaryField>: Arithmetic<F> {\n    /// Optional monic square-mod kernel; false leaves both mutable slices untouched.\n    /// Degree d>=3, a.len<=d, table.len=d*floor(d/2), dst.len=d, raw.len>=2*d+1.\n    fn square_mod(_a: &[u64], _table: &[u64], _dst: &mut [u64], _raw: &mut [RawProduct]) -> bool {\n        false\n    }\n\n    /// Multiply an ascending polynomial in place by (1 + root*z). Its final\n    /// coefficient must initially be zero; the slice includes that spare word.\n    fn multiply_linear(coefficients: &mut [u64], root: u64) {\n        for index in (1..coefficients.len()).rev() {\n            coefficients[index] ^= Self::mul(coefficients[index - 1], root);\n        }\n    }\n\n    /// Check all odd-sequence continuation equations, after the caller has\n    /// independently verified its first d words. squared_locator is rebuilt\n    /// from roots, has d+1 ascending words and constant coefficient one.\n    fn odd_recurrence_matches(odd: &[u64], squared_locator: &[u64]) -> bool {\n        let degree = squared_locator.len() - 1;\n        for index in degree..odd.len() {\n            let mut sum = RawProduct::default();\n            for lag in 1..=degree {\n                let product = Self::raw_mul(odd[index - lag], squared_locator[lag]);\n                sum.lo ^= product.lo;\n                sum.hi ^= product.hi;\n            }\n            if Self::reduce(sum) != odd[index] {\n                return false;\n            }\n        }\n        true\n    }\n\n    /// Toggle nonzero canonical IDs into S1,S3,... in arrival order. Parity semantics.\n    /// Caller handles routing/zero and validates every input. No post-final multiply.\n    fn insert_nonzero(odd: &mut [u64], ids: &[u64]);\n    /// Overwrite all odd syndromes with the direct encoding of these IDs.\n    fn encode_nonzero(odd: &mut [u64], ids: &[u64]) {\n        odd.fill(0);\n        if ids.len() <= 2 {\n            for id in ids {\n                Self::insert_nonzero(odd, std::slice::from_ref(id));\n            }\n        } else {\n            Self::insert_nonzero(odd, ids);\n        }\n    }\n\n    /// Equal lengths; XOR algebraic words only, never wire metadata.\n    fn xor_assign(dst: &mut [u64], src: &[u64]);\n    /// XOR canonical local words with unaligned little-endian remote words.\n    /// Equal word lengths; returns whether any output word is nonzero.\n    fn difference(dst: &mut [u64], local: &[u64], remote: &[u8]) -> bool {\n        #[cfg(test)]\n        super::test_observer::difference();\n        assert_eq!(dst.len(), local.len(), \"difference length mismatch\");\n        assert_eq!(\n            remote.len(),\n            8 * dst.len(),\n            \"difference byte length mismatch\"\n        );\n        let mut any = 0;\n        for ((out, &word), bytes) in dst.iter_mut().zip(local).zip(remote.chunks_exact(8)) {\n            *out = word ^ u64::from_le_bytes(bytes.try_into().expect(\"complete word\"));\n            any |= *out;\n        }\n        any != 0\n    }\n    /// Ascending coefficients; empty polynomial evaluates to zero. out.len=points.len.\n    fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]);\n}\n"},{"id":67,"name":{"Local":"/rustc/library/core/src/cmp/clamp.rs"},"crate_name":"core","contents":null},{"id":68,"name":{"Local":"/rustc/library/core/src/../../stdarch/crates/core_arch/src/x86/vpclmulqdq.rs"},"crate_name":"core","contents":null},{"id":69,"name":{"Local":"/rustc/library/core/src/num/niche_types.rs"},"crate_name":"core","contents":null},{"id":70,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":71,"name":{"Local":"src/field/maps.rs"},"crate_name":"bulksketch","contents":"//! Canonical scalar maps, including even-degree quadratic solving.\n#![forbid(unsafe_code)]\n\nuse crate::field::{BinaryField, gf64};\n\n#[must_use]\npub(crate) fn trace<F: BinaryField>(a: u64) -> u8 {\n    debug_assert_eq!(a & !F::MASK, 0, \"noncanonical field operand\");\n    if F::BITS == 64 {\n        // Only Z^61 and Z^63 have trace one in this polynomial basis.\n        return u8::try_from(((a >> 61) ^ (a >> 63)) & 1).expect(\"trace is a bit\");\n    }\n    canonical_trace::<F>(a)\n}\n\nfn canonical_trace<F: BinaryField>(a: u64) -> u8 {\n    let mut sum = a;\n    let mut conjugate = a;\n    for _ in 1..F::BITS {\n        conjugate = gf64::square::<F>(conjugate);\n        sum ^= conjugate;\n    }\n    assert!(sum <= 1, \"absolute trace must lie in GF(2)\");\n    u8::try_from(sum).expect(\"trace is a bit\")\n}\n\n/// Binary Itoh-Tsujii chain for `t_k=a^(2^k-1)`, targeting `k=BITS-1`.\n/// Doubling: `t_(2k)=t_k^(2^k)*t_k`; append one: `t_(k+1)=t_k^2*a`.\n/// GF64 k: 1,2,3,6,7,14,15,30,31,62,63; final square gives `a^(2^64-2)`.\n/// Exactly 63 squarings and 10 multiplications for nonzero, nonunit GF64 inputs.\n#[must_use]\npub(crate) fn inverse<F: BinaryField>(a: u64) -> Option<u64> {\n    inverse_using::<F>(a, gf64::mul::<F>, gf64::square::<F>)\n}\n\n#[inline]\npub(crate) fn inverse_using<F: BinaryField>(\n    a: u64,\n    mul: impl Fn(u64, u64) -> u64,\n    square: impl Fn(u64) -> u64,\n) -> Option<u64> {\n    inverse_with_frobenius::<F>(a, mul, |mut value, power| {\n        for _ in 0..power {\n            value = square(value);\n        }\n        value\n    })\n}\n\n#[inline]\npub(crate) fn inverse_with_frobenius<F: BinaryField>(\n    a: u64,\n    mul: impl Fn(u64, u64) -> u64,\n    frobenius: impl Fn(u64, u32) -> u64,\n) -> Option<u64> {\n    debug_assert_eq!(a & !F::MASK, 0, \"noncanonical field operand\");\n    if a == 0 {\n        return None;\n    }\n    if a == 1 {\n        return Some(1);\n    }\n    let target = F::BITS - 1;\n    let mut k = 1;\n    let mut t = a;\n    for bit in (0..(u32::BITS - target.leading_zeros() - 1)).rev() {\n        t = mul(frobenius(t, k), t);\n        k *= 2;\n        if target & (1 << bit) != 0 {\n            t = mul(frobenius(t, 1), a);\n            k += 1;\n        }\n    }\n    Some(frobenius(t, 1))\n}\n\n/// Right inverse of Q(z)=z^2+z on trace-zero inputs, with bit zero of z fixed to zero.\n/// Constants use columns 1..BITS (ascending), lowest available row first, and\n/// Gauss-Jordan elimination over GF(2). Kernel(Q)={0,1}, so this fixes the only free coordinate.\n#[must_use]\npub(crate) fn solve_quadratic<F: BinaryField>(a: u64) -> Option<u64> {\n    if trace::<F>(a) != 0 {\n        return None;\n    }\n    let z = quadratic_value::<F>(a);\n    assert_eq!(gf64::square::<F>(z) ^ z, a, \"quadratic-map invariant\");\n    Some(z)\n}\n\n#[inline]\npub(crate) fn quadratic_value<F: BinaryField>(a: u64) -> u64 {\n    if F::BITS == 64 {\n        let mut remaining = a;\n        let mut value = 0;\n        for table in &super::quadratic_chunks::GF64_QUADRATIC_CHUNKS {\n            let index = usize::try_from(remaining & 15).expect(\"nibble index\");\n            value ^= table[index];\n            remaining >>= 4;\n        }\n        return value;\n    }\n    let mut z = 0;\n    for (bit, &row) in quadratic_rows::<F>().iter().enumerate() {\n        z |= u64::from((row & a).count_ones() & 1) << bit;\n    }\n    z\n}\n\npub(super) fn quadratic_rows<F: BinaryField>() -> &'static [u64] {\n    match F::BITS {\n        64 => &GF64_QUADRATIC,\n        #[cfg(test)]\n        2 => &GF4_QUADRATIC,\n        #[cfg(test)]\n        4 => &GF16_QUADRATIC,\n        #[cfg(test)]\n        8 => &GF256_QUADRATIC,\n        #[cfg(test)]\n        16 => &GF65536_QUADRATIC,\n        _ => unreachable!(\"sealed field has no quadratic map\"),\n    }\n}\n\n// Regenerated from Q on the polynomial basis by the quadratic_constants test.\nconst GF64_QUADRATIC: [u64; 64] = [\n    0x0000_0000_0000_0000,\n    0x748d_c4cb_e3a9_915d,\n    0x67eb_d2de_b9ce_5ace,\n    0x67eb_d2de_b9ce_5ac0,\n    0x135d_a537_5f37_f7e8,\n    0x135d_a537_5f37_f7de,\n    0x235e_1ebf_1e67_6bde,\n    0x2365_ad9d_1b37_577e,\n    0x2353_9353_1d5d_7ee8,\n    0x136b_9bf9_595d_ddfe,\n    0x2e52_b4ad_2c63_2d37,\n    0x2e64_8a63_2a09_0917,\n    0x2385_11e1_1359_4db7,\n    0x2ebf_853d_2737_177e,\n    0x3dd9_93fe_7d5e_be69,\n    0x3003_bb5e_415e_1e69,\n    0x2353_938b_1d50_7ce8,\n    0x3003_bb86_4150_9c69,\n    0x0d3a_94e4_346e_6a80,\n    0x2e52_b49b_2c6d_2b17,\n    0x2ebf_865d_273f_377e,\n    0x2ebf_866b_2709_315e,\n    0x30d8_ba38_4c04_a200,\n    0x3003_b630_41e4_9a49,\n    0x0368_f644_19ea_58c9,\n    0x10ee_5195_48d7_8f37,\n    0x0e89_5890_25c4_3a49,\n    0x30d8_8c38_4424_a200,\n    0x1d37_2105_6713_b57e,\n    0x1036_3ec3_6669_a917,\n    0x3000_0000_0000_0000,\n    0x1035_859d_c737_b77e,\n    0x2000_0000_0000_0001,\n    0x1366_1615_5a67_cb97,\n    0x003b_b322_0550_3c69,\n    0x235e_1ebf_1e67_6b97,\n    0x3035_8546_473a_b469,\n    0x1e51_0f25_6d33_b57e,\n    0x30ee_8a18_4a04_8200,\n    0x00ed_3146_0b5a_1c69,\n    0x30ee_8ac0_4a08_8000,\n    0x1ebc_3e5b_666d_ab17,\n    0x3003_b830_4144_9a49,\n    0x0000_0e00_0020_0000,\n    0x10ee_5f95_4af7_8f37,\n    0x2036_d3ad_06d3_2d37,\n    0x3000_ed6e_40ba_8420,\n    0x2035_68f3_078d_335e,\n    0x3353_7ee4_5dea_f8c9,\n    0x100d_6053_438d_935e,\n    0x0e5c_6f56_2ebe_2620,\n    0x0eb1_5e90_25e4_3a49,\n    0x100d_62cb_4389_915e,\n    0x100d_64cb_43a9_915e,\n    0x303b_9766_457a_bc69,\n    0x100e_7f95_42f7_8f37,\n    0x0001_1fc6_017a_1c69,\n    0x0eb8_4156_249e_2620,\n    0x1e95_259d_6737_b77e,\n    0x0e1b_5a08_25c0_3849,\n    0x02a3_1b5e_015e_1e69,\n    0x04b8_4156_249e_2620,\n    0x2000_0000_0000_0000,\n    0x748d_c4cb_e3a9_915e,\n];\n#[cfg(test)]\nconst GF4_QUADRATIC: [u64; 2] = [0x0000_0000_0000_0000, 0x0000_0000_0000_0001];\n#[cfg(test)]\nconst GF16_QUADRATIC: [u64; 4] = [\n    0x0000_0000_0000_0000,\n    0x0000_0000_0000_0003,\n    0x0000_0000_0000_0001,\n    0x0000_0000_0000_0006,\n];\n#[cfg(test)]\nconst GF256_QUADRATIC: [u64; 8] = [\n    0x0000_0000_0000_0000,\n    0x0000_0000_0000_006a,\n    0x0000_0000_0000_0079,\n    0x0000_0000_0000_0077,\n    0x0000_0000_0000_0021,\n    0x0000_0000_0000_0017,\n    0x0000_0000_0000_0020,\n    0x0000_0000_0000_0069,\n];\n#[cfg(test)]\nconst GF65536_QUADRATIC: [u64; 16] = [\n    0x0000_0000_0000_0000,\n    0x0000_0000_0000_0315,\n    0x0000_0000_0000_184f,\n    0x0000_0000_0000_1841,\n    0x0000_0000_0000_72df,\n    0x0000_0000_0000_71fe,\n    0x0000_0000_0000_0a49,\n    0x0000_0000_0000_7b5e,\n    0x0000_0000_0000_6997,\n    0x0000_0000_0000_0a00,\n    0x0000_0000_0000_73de,\n    0x0000_0000_0000_1468,\n    0x0000_0000_0000_3a48,\n    0x0000_0000_0000_0536,\n    0x0000_0000_0000_2000,\n    0x0000_0000_0000_0316,\n];\n"},{"id":72,"name":{"Local":"src/field/gf64.rs"},"crate_name":"bulksketch","contents":"//! Safe portable arithmetic on canonical polynomial-basis words.\n#![forbid(unsafe_code)]\n\nuse crate::{field::BinaryField, types::RawProduct};\n\n#[must_use]\n#[expect(\n    clippy::cast_possible_truncation,\n    reason = \"split a polynomial into its low and high words\"\n)]\n#[inline]\npub(crate) fn raw_mul<F: BinaryField>(a: u64, b: u64) -> RawProduct {\n    debug_assert_eq!((a | b) & !F::MASK, 0, \"noncanonical field operand\");\n    let mut multiples = [0_u128; 16];\n    for i in 1_usize..16 {\n        multiples[i] = multiples[i & (i - 1)] ^ (u128::from(a) << i.trailing_zeros());\n    }\n    let mut product = 0_u128;\n    for shift in (0..F::BITS).step_by(4) {\n        product ^= multiples[((b >> shift) & 15) as usize] << shift;\n    }\n    RawProduct {\n        lo: product as u64,\n        hi: (product >> 64) as u64,\n    }\n}\n\n/// Accepts every 128-bit polynomial, including XOR accumulators of raw products.\n#[must_use]\npub(crate) fn reduce<F: BinaryField>(product: RawProduct) -> u64 {\n    if F::BITS == 64 {\n        // Z^64 = Z^4+Z^3+Z+1. The first fold overflows by at most four bits;\n        // folding those again has degree at most seven, so it cannot overflow.\n        let high = product.hi;\n        let overflow = (high >> 63) ^ (high >> 61) ^ (high >> 60);\n        product.lo\n            ^ high\n            ^ (high << 1)\n            ^ (high << 3)\n            ^ (high << 4)\n            ^ overflow\n            ^ (overflow << 1)\n            ^ (overflow << 3)\n            ^ (overflow << 4)\n    } else {\n        let mut remainder = 0;\n        for word in [product.hi, product.lo] {\n            for bit in (0..64).rev() {\n                let carry = remainder >> (F::BITS - 1);\n                remainder = ((remainder << 1) & F::MASK) | ((word >> bit) & 1);\n                remainder ^= F::MODULUS_LOW & 0_u64.wrapping_sub(carry);\n            }\n        }\n        remainder\n    }\n}\n\n#[must_use]\npub(crate) fn mul<F: BinaryField>(a: u64, b: u64) -> u64 {\n    reduce::<F>(raw_mul::<F>(a, b))\n}\n\nfn spread(mut word: u64) -> u64 {\n    word &= 0xffff_ffff;\n    word = (word | (word << 16)) & 0x0000_ffff_0000_ffff;\n    word = (word | (word << 8)) & 0x00ff_00ff_00ff_00ff;\n    word = (word | (word << 4)) & 0x0f0f_0f0f_0f0f_0f0f;\n    word = (word | (word << 2)) & 0x3333_3333_3333_3333;\n    (word | (word << 1)) & 0x5555_5555_5555_5555\n}\n\n#[must_use]\npub(crate) fn square<F: BinaryField>(a: u64) -> u64 {\n    debug_assert_eq!(a & !F::MASK, 0, \"noncanonical field operand\");\n    reduce::<F>(RawProduct {\n        lo: spread(a),\n        hi: spread(a >> 32),\n    })\n}\n\n#[must_use]\npub(crate) fn frobenius<F: BinaryField>(mut a: u64, power: u32) -> u64 {\n    debug_assert_eq!(a & !F::MASK, 0, \"noncanonical field operand\");\n    for _ in 0..power % F::BITS {\n        a = square::<F>(a);\n    }\n    a\n}\n"},{"id":73,"name":{"Local":"/rustc/library/core/src/macros/mod.rs"},"crate_name":"core","contents":null},{"id":74,"name":{"Local":"/rustc/library/core/src/panicking.rs"},"crate_name":"core","contents":null},{"id":75,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":76,"name":{"Local":"/rustc/library/core/src/fmt/num.rs"},"crate_name":"core","contents":null},{"id":77,"name":{"Local":"/rustc/library/core/src/../../stdarch/crates/core_arch/src/x86/pclmulqdq.rs"},"crate_name":"core","contents":null},{"id":78,"name":{"Local":"src/field/frobenius.rs"},"crate_name":"bulksketch","contents":"//! Fixed GF64 linear maps shared by insertion and the Itoh–Tsujii chain.\n#![forbid(unsafe_code)]\n\nconst POWERS: [u32; 9] = [1, 2, 3, 4, 5, 6, 7, 15, 31];\npub(crate) static TABLES: [[[u64; 16]; 16]; 9] = tables();\n\n#[inline]\npub(crate) fn lookup(word: u64, power: u32) -> Option<u64> {\n    let index = match power {\n        1..=7 => usize::try_from(power - 1).expect(\"small map index\"),\n        15 => 7,\n        31 => 8,\n        _ => return None,\n    };\n    let mut result = 0;\n    for (nibble, entries) in TABLES[index].iter().enumerate() {\n        result ^= entries[usize::try_from((word >> (4 * nibble)) & 15).expect(\"nibble index\")];\n    }\n    Some(result)\n}\n\n/// The eight-multiply inverse chain also needs the 21st Frobenius power.\n#[inline]\npub(crate) fn inverse21(word: u64) -> u64 {\n    static TABLE: [[u64; 16]; 16] = inverse21_table();\n    let mut result = 0;\n    for (nibble, entries) in TABLE.iter().enumerate() {\n        result ^= entries[usize::try_from((word >> (4 * nibble)) & 15).expect(\"nibble index\")];\n    }\n    result\n}\n\nconst fn inverse21_table() -> [[u64; 16]; 16] {\n    let mut table = [[0; 16]; 16];\n    let mut bit = 0;\n    while bit < 64 {\n        let mut column = 1_u64 << bit;\n        let mut power = 0;\n        while power < 21 {\n            column = square(column);\n            power += 1;\n        }\n        let mut value = 0;\n        while value < 16 {\n            if value & (1 << (bit % 4)) != 0 {\n                table[bit / 4][value] ^= column;\n            }\n            value += 1;\n        }\n        bit += 1;\n    }\n    table\n}\n\npub(crate) const fn square(word: u64) -> u64 {\n    let mut square = 0_u128;\n    let mut bit = 0;\n    while bit < 64 {\n        if word & (1_u64 << bit) != 0 {\n            square ^= 1_u128 << (2 * bit);\n        }\n        bit += 1;\n    }\n    let polynomial = (1_u128 << 64) | 0x1b;\n    bit = 128;\n    while bit > 64 {\n        bit -= 1;\n        if square & (1_u128 << bit) != 0 {\n            square ^= polynomial << (bit - 64);\n        }\n    }\n    // The long division above leaves exactly one canonical field word.\n    let bytes = square.to_le_bytes();\n    u64::from_le_bytes([\n        bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7],\n    ])\n}\n\n#[expect(\n    clippy::large_stack_arrays,\n    reason = \"only evaluated at compile time to initialize immutable static maps\"\n)]\nconst fn tables() -> [[[u64; 16]; 16]; 9] {\n    let mut tables = [[[0; 16]; 16]; 9];\n    let mut columns = [0_u64; 64];\n    let mut bit = 0;\n    while bit < 64 {\n        columns[bit] = 1 << bit;\n        bit += 1;\n    }\n    let mut index = 0;\n    let mut power = 0;\n    while index < POWERS.len() {\n        while power < POWERS[index] {\n            bit = 0;\n            while bit < 64 {\n                columns[bit] = square(columns[bit]);\n                bit += 1;\n            }\n            power += 1;\n        }\n        let mut nibble = 0;\n        while nibble < 16 {\n            let mut value: usize = 1;\n            while value < 16 {\n                tables[index][nibble][value] = tables[index][nibble][value & (value - 1)]\n                    ^ columns[4 * nibble + value.trailing_zeros() as usize];\n                value += 1;\n            }\n            nibble += 1;\n        }\n        index += 1;\n    }\n    tables\n}\n\n#[cfg(test)]\nmod tests {\n    use {\n        super::{POWERS, TABLES, lookup},\n        crate::field::{Gf64, gf64},\n    };\n\n    #[test]\n    fn fixed_frobenius_maps_match_scalar_regeneration() {\n        for power in POWERS {\n            for word in (0..64)\n                .map(|bit| 1_u64 << bit)\n                .chain((0_u64..4096).map(|mut word| {\n                    word = word.wrapping_add(0x9e37_79b9_7f4a_7c15);\n                    word = (word ^ (word >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);\n                    word = (word ^ (word >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);\n                    word ^ (word >> 31)\n                }))\n            {\n                let mut expected = word;\n                for _ in 0..power {\n                    expected = gf64::square::<Gf64>(expected);\n                }\n                assert_eq!(\n                    lookup(word, power),\n                    Some(expected),\n                    \"power={power} word={word:#x}\"\n                );\n            }\n            for (nibble, entries) in TABLES[match power {\n                15 => 7,\n                31 => 8,\n                _ => usize::try_from(power - 1).unwrap(),\n            }]\n            .iter()\n            .enumerate()\n            {\n                for (value, &actual) in entries.iter().enumerate() {\n                    let mut expected = u64::try_from(value).unwrap() << (4 * nibble);\n                    for _ in 0..power {\n                        expected = gf64::square::<Gf64>(expected);\n                    }\n                    assert_eq!(\n                        actual, expected,\n                        \"table power={power} nibble={nibble} value={value}\"\n                    );\n                }\n            }\n        }\n        for power in [0, 8, 14, 16, 30, 32, 63, 64] {\n            assert_eq!(lookup(u64::MAX, power), None);\n        }\n        println!(\n            \"SHARED FROBENIUS TABLE BYTES {}\",\n            std::mem::size_of_val(&TABLES)\n        );\n    }\n}\n"},{"id":79,"name":{"Local":"/rustc/library/core/src/num/error.rs"},"crate_name":"core","contents":null},{"id":80,"name":{"Local":"/rustc/library/core/src/convert/num.rs"},"crate_name":"core","contents":null},{"id":81,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":82,"name":{"Local":"/rustc/library/core/src/../../stdarch/crates/core_arch/src/x86_64/sse2.rs"},"crate_name":"core","contents":null},{"id":83,"name":{"Local":"/rustc/library/core/src/../../stdarch/crates/core_arch/src/x86_64/mod.rs"},"crate_name":"core","contents":null},{"id":84,"name":{"Local":"/rustc/library/core/src/../../stdarch/crates/core_arch/src/x86/sse2.rs"},"crate_name":"core","contents":null},{"id":85,"name":{"Local":"/rustc/library/core/src/panic.rs"},"crate_name":"core","contents":null},{"id":86,"name":{"Local":"src/field/quadratic_chunks.rs"},"crate_name":"bulksketch","contents":"//! Nibble contributions to the fixed-free-coordinate GF64 quadratic map.\n#![forbid(unsafe_code)]\n\npub(super) const GF64_QUADRATIC_CHUNKS: [[u64; 16]; 16] = [\n    [\n        0x0000_0000_0000_0000,\n        0x19c9_369f_278a_dc02,\n        0x84b2_b22a_b238_3ee4,\n        0x9d7b_84b5_95b2_e2e6,\n        0x84b2