i32\"."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))] {"},{"DocComment":" #[cfg(target_arch = \"x86\")]"},{"DocComment":" use std::arch::x86::*;"},{"DocComment":" #[cfg(target_arch = \"x86_64\")]"},{"DocComment":" use std::arch::x86_64::*;"},{"DocComment":""},{"DocComment":" # #[target_feature(enable = \"sse2\")]"},{"DocComment":" # #[allow(unused_unsafe)] // temporary, to unstick CI"},{"DocComment":" # unsafe fn foo() { unsafe {"},{"DocComment":" let all_bytes_zero = _mm_setzero_si128();"},{"DocComment":" let all_bytes_one = _mm_set1_epi8(1);"},{"DocComment":" let four_i32 = _mm_set_epi32(1, 2, 3, 4);"},{"DocComment":" # }}"},{"DocComment":" # if is_x86_feature_detected!(\"sse2\") { unsafe { foo() } }"},{"DocComment":" # }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-apple-darwin","value":{"size":{"chosen":{"Deduplicated":13},"guarantee":null},"align":{"chosen":{"Deduplicated":13},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Simd","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},null,null,{"def_id":62,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["x86_pclmul",0]},{"Ident":["inverse",0]},{"Builtin":["Closure",0]}],"span":{"Untagged":{"data":{"file_id":28,"beg":{"line":267,"col":12},"e