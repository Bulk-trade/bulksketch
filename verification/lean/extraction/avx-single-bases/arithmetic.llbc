6,"beg":{"line":196,"col":0},"end":{"line":200,"col":1}},"generated_from_span":null}},"source_text":"fn load(words: &[u64]) -> __m512i {\n    // SAFETY: only the low words.len() lanes are accessed, and unaligned\n    // addresses are permitted. Every caller supplies at most eight words.\n    unsafe { _mm512_maskz_loadu_epi64(mask(words.len()), words.as_ptr().cast()) }\n}","attr_info":{"attributes":[{"Builtin":{"TargetFeature":{"features":[["avx512f",{"Untagged":{"data":{"file_id":6,"beg":{"line":195,"col":17},"end":{"line":195,"col":35}},"generated_from_span":null}}]],"attr_span":{"Untagged":{"data":{"file_id":6,"beg":{"line":195,"col":0},"end":{"line":195,"col":37}},"generated_from_span":null}},"was_forced":false}}}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[77,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":25},"Shared"]}]}],"output":{"Deduplicated":23}},"src":"Normal","body":"Opaque"},{"def_id":21,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["core_arch",0]},{"Ident":["x86",0]},{"Ident":["avx512f",0]},{"Ident":["_mm512_xor_si512",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":30079,"col":0},"end":{"line":30079,"col":64}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Compute the bitwise XOR of 512 bits (representing integer data) in a and b, and store the result in dst."},{"DocComment":""},{"DocComment":" [Intel's documentation](https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm512_xor_si512&expand=6172)"}],"inline":"Hint","rename":null,"public":true},"is_loca