g":{"line":162,"col":0},"end":{"line":195,"col":1}},"generated_from_span":null}},"source_text":"fn quartic<F: BinaryField, K: BulkKernels<F>>(factor: &[u64]) -> Option<[u64; 4]> {\n    let (a, b, c, d) = (factor[3], factor[2], factor[1], factor[0]);\n    if a == 0 {\n        return affine_quartic::<F, K>(b, c, d);\n    }\n    let ratio = K::mul(c, K::inverse(a)?);\n    // F63 = square(F31(F31(x))); reuse the existing fixed maps.\n    let shift = K::square(K::frobenius(K::frobenius(ratio, 31), 31));\n    let e2 = K::square(shift);\n    let denominator = K::square(e2) ^ K::mul(b, e2) ^ d;\n    if denominator == 0 {\n        return None;\n    }\n    let inverse = K::inverse(denominator)?;\n    let mut roots = affine_quartic::<F, K>(\n        K::mul(b ^ K::mul(a, shift), inverse),\n        K::mul(a, inverse),\n        inverse,\n    )?;\n    if roots.contains(&0) {\n        return None;\n    }\n    let mut prefixes = [1; 4];\n    for i in 1..4 {\n        prefixes[i] = K::mul(prefixes[i - 1], roots[i - 1]);\n    }\n    let mut inverse = K::inverse(K::mul(prefixes[3], roots[3]))?;\n    for i in (0..4).rev() {\n        let original = roots[i];\n        roots[i] = K::mul(prefixes[i], inverse) ^ shift;\n        inverse = K::mul(inverse, original);\n    }\n    Some(roots)\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Invariant"},{"index":1,"name":"K","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[1948,{"data":{"file_id":31,"beg":{"line":162,"col":14},"end":{"line":162,"col":25}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":6,"generics":{"region