lthy\"); // panics with `fruits are healthy`"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Recommended Message Style"},{"DocComment":""},{"DocComment":" We recommend that `expect` messages are used to describe the reason you"},{"DocComment":" _expect_ the `Option` should be `Some`."},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" # let slice: &[u8] = &[];"},{"DocComment":" let item = slice.get(0)"},{"DocComment":"     .expect(\"slice should not be empty\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" **Hint**: If you're having trouble remembering how to phrase expect"},{"DocComment":" error messages remember to focus on the word \"should\" as in \"env"},{"DocComment":" variable should be set by blah\" or \"the given binary should be available"},{"DocComment":" and executable by the current user\"."},{"DocComment":""},{"DocComment":" For more detail on expect message styles and the reasoning behind our"},{"DocComment":" recommendation please refer to the section on [\"Common Message"},{"DocComment":" Styles\"](../../std/error/index.html#common-message-styles) in the [`std::error`](../../std/error/index.html) module docs."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":12,"beg":{"line":963,"col":4},"end":{"line":963,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"option_expect","has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":249},{"Value":[250,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":74},"Shared"]}]}],"output":{"Deduplicated":15}},"src":"Normal","body":"