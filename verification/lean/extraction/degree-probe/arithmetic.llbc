{"charon_version":"0.1.304","translated":{"crate_name":"bulksketch","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["bulksketch::decode::degree_probe"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/workspace/bulk/bulksketch-proof-evidence-20261109-closed-leaf/degree-probe-run/arithmetic.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-apple-darwin","value":{"arch":"X86_64","vendor":"apple","os":"MacOs","env":"Unspecified","cfg_abi":"Unspecified","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bulksketch","contents":"//! Native binary-syndrome reconciliation with bounded, deterministic GF64 decoding.\n#![deny(unsafe_code)]\n#![warn(missing_docs)]\n\nmod backend;\nmod decode;\nmod field;\nmod poly;\nmod sketch;\nmod types;\n\npub use {\n    field::{BinaryField, Gf64},\n    sketch::{\n        DecodeJob, DecodeLimits, DecodeOutcome, DecodePlan, DecodeReport, DecodeRequest, DecodeRow,\n        DecodeRowsRequest, DecodeScratch, Decoder, FrozenSketch, InsertScratch, MutableSketch,\n        ParseLimits, ScratchLayout, ShapeLimits, SketchShape, SketchView, decode_into,\n        decode_rows_into,\n    },\n    types::{\n        BackendError, BackendId, BackendRequest, CreateError, DecodeError, DecodeFailure,\n        EncodeError, FieldId, ParseError, ShapeError, ShapeMismatch, Stage, StageProgress,\n        UpdateError, WorkUnits,\n    },\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"src/decode/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical-row decoding; no sketch/shape/wire or public arena dependencies.\n#![forbid(unsafe_code)]\n\npub(crate) mod row;\npub(crate) mod scratch;\npub(crate) mod work;\n\nmod bm;\n#[cfg(test)]\nmod bm_tests;\npub(crate) mod direct;\n\nmod affine;\nmod deg34;\nmod degree_probe;\npub(crate) mod probe;\nmod roots;\npub(crate) mod stages;\nmod verify;\n\n#[cfg(test)]\nmod row_tests;\n"},{"id":10,"name":{"Local":"src/decode/degree_probe.rs"},"crate_name":"bulksketch","contents":"//! Transactional whole-row degree-three/four probes. No candidate or splitter state.\n#![forbid(unsafe_code)]\nuse {\n    super::{\n        deg34,\n        probe::verified,\n        row::RowBudget,\n        scratch::RowWorkspace,\n        work::{Charge, WorkScheduleV1},\n    },\n    crate::{\n        backend::contract::BulkKernels,\n        field::BinaryField,\n        types::{DecodeError, Stage, WorkMeter},\n    },\n};\n\n#[derive(Debug)]\npub(super) struct DegreeProbe {\n    degree: u8,\n    count: u8,\n    next: Option<Stage>,\n}\nimpl DegreeProbe {\n    // Use every available check at c=3..6. Roots still need the product certificate\n    // and complete row verification; no extra stored words are required.\n    pub(super) fn new(budget: RowBudget, capacity: usize) -> Option<Self> {\n        (budget.nonzero >= 3 && capacity >= 3).then_some(Self {\n            degree: 3,\n            count: 0,\n            next: Some(Stage::GuardThree),\n        })\n    }\n    pub(super) fn next_stage(&self) -> Option<Stage> {\n        self.next\n    }\n    pub(super) fn count(&self) -> usize {\n        usize::from(self.count)\n    }\n    pub(super) fn reject(&mut self, capacity: usize, budget: RowBudget) {\n        self.count = 0;\n        self.next = Some(\n            if self.degree == 3 && capacity >= 4 && budget.nonzero >= 4 {\n                self.degree = 4;\n                Stage::GuardFour\n            } else {\n                Stage::Reconstruction\n            },\n        );\n    }\n    pub(super) fn run<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        odd: &[u64],\n        budget: RowBudget,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Option<Stage>, DecodeError> {\n        let stage = self.next.expect(\"active degree probe\");\n        let degree = usize::from(self.degree);\n        let count = self.count();\n        let operation = match stage {\n            Stage::GuardThree => Charge::GuardThree,\n            Stage::GuardFour => Charge::GuardFour,\n            Stage::NewtonThree => Charge::NewtonThree,\n            Stage::NewtonFour => Charge::NewtonFour,\n            Stage::LeafThree => Charge::LeafThree,\n            Stage::LeafFour => Charge::LeafFour,\n            Stage::FactorVerification => Charge::FactorVerification { degree },\n            Stage::Verification => Charge::Verify {\n                capacity: odd.len(),\n                output_budget: budget.total,\n            },\n            Stage::Canonicalization => Charge::Canonicalize { ids: budget.total },\n            _ => unreachable!(\"whole-row degree probe stage\"),\n        };\n        meter.charge(WorkScheduleV1::cost(operation)?)?;\n        #[cfg(test)]\n        crate::types::small_degree_observer::stage(stage, false);\n        match stage {\n            Stage::GuardThree | Stage::GuardFour => {\n                if deg34::guard::<F, K>(odd, degree, &mut workspace.polynomials[5..11]) {\n                    self.next = Some(if degree == 3 {\n                        Stage::NewtonThree\n                    } else {\n                        Stage::NewtonFour\n                    });\n                } else {\n                    self.reject(odd.len(), budget);\n                }\n            }\n            Stage::NewtonThree | Stage::NewtonFour => {\n                let (factor, rest) = workspace.polynomials.split_at_mut(5);\n                deg34::normalize::<F, K>(&rest[..6], odd[0], degree, factor);\n                self.next = Some(if degree == 3 {\n                    Stage::LeafThree\n                } else {\n                    Stage::LeafFour\n                });\n            }\n            Stage::LeafThree | Stage::LeafFour => {\n                let (factor, rest) = workspace.polynomials.split_at_mut(11);\n                if let Some(count) = deg34::solve::<F, K>(&factor[..=degree], &mut rest[..4]) {\n                    self.count = u8::try_from(count).expect(\"degree-three/four root count\");\n                    self.next = Some(Stage::FactorVerification);\n                } else {\n                    self.reject(odd.len(), budget);\n                }\n            }\n            Stage::FactorVerification => {\n                let (values, product) = workspace.polynomials.split_at_mut(15);\n                let valid = deg34::certificate::<F, K>(\n                    &values[..=degree],\n                    &values[11..11 + count],\n                    &mut product[..5],\n                );\n                #[cfg(test)]\n                crate::types::small_degree_observer::certificate(valid);\n                if valid {\n                    workspace.roots[..count].copy_from_slice(&values[11..11 + count]);\n                    self.next = Some(Stage::Verification);\n                } else {\n                    self.reject(odd.len(), budget);\n                }\n            }\n            Stage::Verification => {\n                if verified::<F, K>(odd, &workspace.roots[..count], workspace.verification) {\n                    self.next = Some(Stage::Canonicalization);\n                } else {\n                    self.reject(odd.len(), budget);\n                }\n            }\n            Stage::Canonicalization => {\n                workspace.roots[..count].sort_unstable();\n                self.next = None;\n            }\n            _ => unreachable!(\"charged degree probe\"),\n        }\n        Ok(self.next)\n    }\n}\n"},{"id":11,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"src/types.rs"},"crate_name":"bulksketch","contents":"//! Value-only definitions; this module has no dependency on the engine layers.\n#![forbid(unsafe_code)]\n\n/// Polynomial-basis identity, including the irreducible polynomial.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[repr(u8)]\npub enum FieldId {\n    /// GF(2^64), modulus Z^64 + Z^4 + Z^3 + Z + 1, bit i is Z^i.\n    Gf64 = 1,\n}\n\n/// Shape admission failure, before any row storage is allocated.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ShapeError {\n    /// Unsupported field, zero/non-power-of-two row count, or zero capacity.\n    InvalidShape,\n    /// Configured storage/dimension cap or representable wire dimension exceeded.\n    InputLimitExceeded,\n}\n\n/// Bounded wire admission failure. No view is exposed on either error.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ParseError {\n    /// A caller-supplied byte or dimension limit was exceeded.\n    InputLimitExceeded,\n    /// Unknown metadata, malformed lengths, or noncanonical payload.\n    InvalidEncoding,\n}\n\nimpl std::fmt::Display for ShapeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InvalidShape => \"invalid sketch shape\",\n            Self::InputLimitExceeded => \"shape input limit exceeded\",\n        })\n    }\n}\nimpl std::error::Error for ShapeError {}\n\nimpl std::fmt::Display for ParseError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InputLimitExceeded => \"wire input limit exceeded\",\n            Self::InvalidEncoding => \"invalid sketch encoding\",\n        })\n    }\n}\nimpl std::error::Error for ParseError {}\n\n/// Runtime arithmetic capability. No complete-operation dispatch lives in this type.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub enum BackendId {\n    /// Always-available safe Rust arithmetic.\n    Portable,\n    /// Scalar x86 carryless multiplication.\n    Pclmul,\n    /// 256-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul256,\n    /// 512-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul512,\n}\n\n/// Backend selection requested at engine construction, before any decode.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum BackendRequest {\n    /// Select from capabilities detected at runtime.\n    Auto,\n    /// Require this capability; never bypass feature/OS-state validation.\n    Force(BackendId),\n}\n\n/// An explicitly requested backend is unavailable in this build or on this CPU/OS.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct BackendError(pub BackendId);\n\n/// Construction of mutable state failed before any state was returned.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CreateError {\n    /// The requested arithmetic implementation is unavailable.\n    Backend(BackendError),\n    /// The algebraic buffers could not be reserved.\n    AllocationFailed,\n}\n\n/// Batch insertion failed before changing the sketch.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum UpdateError {\n    /// The supplied insertion arena cannot hold this call's IDs or row offsets.\n    ScratchTooSmall,\n}\n\n/// XOR requires identical fields, row counts and capacities.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ShapeMismatch;\n\n/// Encoding failed without changing the destination or algebraic state.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum EncodeError {\n    /// The destination cannot hold the complete record.\n    BufferTooSmall,\n    /// The cached record could not be reserved.\n    AllocationFailed,\n}\n\nimpl std::fmt::Display for CreateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            Self::Backend(error) => error.fmt(f),\n            Self::AllocationFailed => f.write_str(\"sketch allocation failed\"),\n        }\n    }\n}\nimpl std::error::Error for CreateError {}\nimpl std::fmt::Display for UpdateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"insertion scratch is too small\")\n    }\n}\nimpl std::error::Error for UpdateError {}\nimpl std::fmt::Display for ShapeMismatch {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"sketch shapes differ\")\n    }\n}\nimpl std::error::Error for ShapeMismatch {}\nimpl std::fmt::Display for EncodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::BufferTooSmall => \"encoding buffer is too small\",\n            Self::AllocationFailed => \"encoding allocation failed\",\n        })\n    }\n}\nimpl std::error::Error for EncodeError {}\n\nimpl std::fmt::Display for BackendError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        write!(f, \"backend {:?} is unavailable\", self.0)\n    }\n}\nimpl std::error::Error for BackendError {}\n\n/// Backend-independent logical work, never elapsed time or instruction count.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]\npub struct WorkUnits(pub u64);\n\n/// A request-wide failure publishes no row report or provisional IDs.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeError {\n    /// Local and remote fields, row counts or capacities differ.\n    ShapeMismatch,\n    /// Unknown plan or an output budget larger than any row capacity.\n    InvalidPlan,\n    /// Raw candidate count exceeds the request cap, before normalization.\n    CandidateLimitExceeded,\n    /// Work arithmetic overflows or the next charge exceeds the request limit.\n    WorkLimitExceeded,\n    /// Layout overflows, exceeds its byte cap, or any supplied segment is short.\n    ScratchTooSmall,\n}\n\n/// An admitted row failed algebraically; independently successful rows remain usable.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeFailure {\n    /// Zero consumes an unavailable slot, or locator/final output exceeds beta.\n    DegreeExceedsBudget,\n    /// The locator fails required canonicality/algebraic validation.\n    InvalidLocator,\n    /// The locator does not split into distinct permitted field roots.\n    NotSplit,\n    /// Re-encoding fails any stored odd syndrome or the zero channel.\n    VerificationFailed,\n}\n\nimpl std::fmt::Display for DecodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::ShapeMismatch => \"sketch shapes differ\",\n            Self::InvalidPlan => \"invalid decode plan or output budget\",\n            Self::CandidateLimitExceeded => \"candidate input limit exceeded\",\n            Self::WorkLimitExceeded => \"decode work limit exceeded\",\n            Self::ScratchTooSmall => \"decode scratch is too small\",\n        })\n    }\n}\nimpl std::error::Error for DecodeError {}\n\n/// Deterministic stage order. Repeated trace/GCD/division/leaf stages follow factor traversal.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Stage {\n    /// Propose the nonzero root S1 before general decoding.\n    DirectOne,\n    /// Derive a distinct nonzero pair from S1 and S3 before general decoding.\n    DirectTwo,\n    /// Reject inconsistent cubic prefixes before inversion (V3).\n    GuardThree,\n    /// Normalize a passed cubic Newton guard (V3).\n    NewtonThree,\n    /// Reject inconsistent quartic prefixes before inversion (V3).\n    GuardFour,\n    /// Normalize a passed quartic Newton guard (V3).\n    NewtonFour,\n    /// Propose the roots of a cubic factor (V3).\n    LeafThree,\n    /// Propose the roots of a quartic factor (V3).\n    LeafFour,\n    /// Certify a complete distinct nonzero factor root set (V3).\n    FactorVerification,\n    /// Expand odd syndromes and reconstruct even powers.\n    Reconstruction,\n    /// Binary Berlekamp-Massey iterations.\n    BerlekampMassey,\n    /// Evaluate the original locator at normalized hints.\n    CandidateEvaluation,\n    /// Divide out confirmed candidate roots.\n    Deflation,\n    /// Build a factor's modular-square table.\n    ReducerPreparation,\n    /// Find the least affine multiple and solve its binary map (V3).\n    AffinePreparation,\n    /// Enumerate and evaluate the recovered affine solution coset (V3).\n    AffineEnumeration,\n    /// Form an annihilator splitter for the current affine coset (V3).\n    AffineSplit,\n    /// Try the next canonical trace direction and the internal split check.\n    Trace,\n    /// Compute a monic polynomial GCD.\n    Gcd,\n    /// Divide a factor exactly after a proper split.\n    FactorDivision,\n    /// Solve degree-one or degree-two leaves.\n    Leaf,\n    /// Verify every stored odd syndrome by re-encoding or rebuilt recurrence.\n    Verification,\n    /// Sort and validate the final original IDs.\n    Canonicalization,\n}\n\n/// Public stage progress contains no row outcome or provisional ID.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum StageProgress {\n    /// A deterministic stage completed; counters are cumulative for the request.\n    Completed {\n        /// Bucket whose stage completed, in deterministic request traversal order.\n        bucket: usize,\n        /// Stage just executed.\n        stage: Stage,\n        /// Logical work consumed so far.\n        work: WorkUnits,\n        /// Peak required workspace bytes, excluding unused arena capacity.\n        peak_scratch_bytes: usize,\n        /// Original BM locator degree for this row; zero until BM completes.\n        locator_degree: usize,\n        /// Confirmed candidate roots so far in this row.\n        candidate_hits: usize,\n        /// Trace directions attempted so far in this row.\n        trace_attempts: usize,\n        /// Degree returned by this row's most recent GCD; zero before the first GCD.\n        gcd_degree: usize,\n    },\n    /// Terminal request failure; finishing the job must return this error.\n    Failed(DecodeError),\n}\n\n/// Internal arithmetic product, distinct from a canonical field element.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub(crate) struct RawProduct {\n    pub(crate) lo: u64,\n    pub(crate) hi: u64,\n}\n\n/// One request meter, shared by preprocessing and all rows. A failed charge is terminal.\n#[derive(Debug)]\npub(crate) struct WorkMeter {\n    limit: WorkUnits,\n    used: WorkUnits,\n    exhausted: bool,\n}\n\nimpl WorkMeter {\n    pub(crate) fn new(limit: WorkUnits) -> Self {\n        Self {\n            limit,\n            used: WorkUnits(0),\n            exhausted: false,\n        }\n    }\n\n    pub(crate) fn charge(&mut self, charge: WorkUnits) -> Result<(), DecodeError> {\n        let next = self.used.0.checked_add(charge.0);\n        if self.exhausted || next.is_none_or(|n| n > self.limit.0) {\n            self.exhausted = true;\n            return Err(DecodeError::WorkLimitExceeded);\n        }\n        self.used = WorkUnits(next.expect(\"checked work charge\"));\n        Ok(())\n    }\n\n    pub(crate) fn used(&self) -> WorkUnits {\n        self.used\n    }\n}\n\n#[cfg(test)]\npub(crate) mod small_degree_observer;\n"},{"id":14,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/fmt/num.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"src/decode/row.rs"},"crate_name":"bulksketch","contents":"//! Staged ordinary binary rows. Mapping and zero stay upstairs.\n#![forbid(unsafe_code)]\n\nuse {\n    super::scratch::RowWorkspace,\n    crate::{\n        backend::contract::BulkKernels,\n        field::BinaryField,\n        types::{DecodeError, DecodeFailure, Stage, WorkMeter},\n    },\n};\n\n/// Field roots only: distinct, nonzero, ascending, count <= the checked nonzero budget.\n/// Decoded borrows exactly the verified roots from any workspace segment; no prefix\n/// location is promised. The upper job copies this slice and prepends original zero.\npub(crate) enum RowResult<'w> {\n    Equal,\n    Decoded(&'w [u64]),\n    Failed(DecodeFailure),\n}\n\n/// Checked upstairs: nonzero <= total <= capacity, with at most one zero slot.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub(crate) struct RowBudget {\n    pub(crate) nonzero: usize,\n    pub(crate) total: usize,\n}\n\n/// Canonical odd difference and normalized nonzero hints, unchanged across stages.\n#[derive(Clone, Copy, Debug)]\npub(crate) struct RowInput<'a> {\n    pub(crate) difference: &'a [u64],\n    pub(crate) candidates: &'a [u64],\n}\n\n/// Row-local progress. The request job adds bucket, request work and complete arena size;\n/// lower code never constructs the public job's request-level progress record.\npub(crate) struct RowProgress {\n    pub(crate) stage: Stage,\n    pub(crate) locator_degree: usize,\n    pub(crate) candidate_hits: usize,\n    pub(crate) trace_attempts: usize,\n    pub(crate) gcd_degree: usize,\n}\n\n/// Execution owns only small row state, never borrowed inputs or workspace handles.\n/// Progress exposes no provisional roots. V2's private upper-job handoff validates\n/// proposed roots before canonicalization; rejection resumes the row without publication.\n/// Finish drains and borrows only completed roots.\npub(crate) trait RowExecution {\n    fn next_stage(&self) -> Option<Stage>;\n    fn run_next(\n        &mut self,\n        input: RowInput<'_>,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<RowProgress, DecodeError>;\n    /// Drain and consume execution; only a completed, verified slice may escape.\n    /// Its borrow ends before workspace reuse; callers must use the returned slice,\n    /// not infer a storage location. Drop and errors publish no roots.\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"The consuming row contract is tested directly; request jobs borrow \\\n                      completed rows\"\n        )\n    )]\n    fn finish<'w>(\n        self,\n        input: RowInput<'_>,\n        workspace: &'w mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<RowResult<'w>, DecodeError>;\n}\n\n/// One monomorphized row driver per arithmetic capability; no runtime per-multiply dispatch.\npub(crate) trait RowDecoder<F: BinaryField, K: BulkKernels<F>> {\n    type Execution: RowExecution;\n    /// difference.len=c>0; budgets checked; hints normalized/nonzero/canonical.\n    /// Each stage is lent the same row segments; no stage may grow them.\n    /// Reject BM degree beyond budget.nonzero before out-of-budget writes.\n    /// Verification and canonicalization charge budget.total, including the zero slot.\n    /// General stages retain V1 charges. V2 probes pay before materialization/algebra\n    /// and each verification; misses preserve these inputs and fresh general state.\n    /// V3 may replace roots/verification with charged affine and rebuilt-LFSR stages.\n    fn begin(budget: RowBudget) -> Self::Execution;\n}\n"},{"id":18,"name":{"Local":"/rustc/library/core/src/bool.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/convert/num.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"src/field/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical field identity, arithmetic and test-only tiny fields.\n#![forbid(unsafe_code)]\n\nuse crate::types::FieldId;\n\n#[cfg(test)]\npub(crate) mod arithmetic_tests;\n#[cfg(test)]\nmod constant_tests;\n#[cfg(any(target_arch = \"x86_64\", test))]\npub(crate) mod frobenius;\npub(crate) mod gf64;\npub(crate) mod maps;\nmod quadratic_chunks;\n#[cfg(test)]\npub(crate) mod reference;\n#[cfg(test)]\npub(crate) mod tiny;\n\npub(crate) mod sealed {\n    pub trait Sealed {}\n}\n\n/// Closed field specification. Kernels consume canonical words, never masked IDs.\npub trait BinaryField: sealed::Sealed + Copy + Eq + Send + Sync + 'static {\n    /// Extension degree over GF(2).\n    const BITS: u32;\n    /// Irreducible polynomial without its leading term.\n    const MODULUS_LOW: u64;\n    /// Registered polynomial/basis identity.\n    const WIRE_ID: FieldId;\n    /// Canonical element mask.\n    const MASK: u64;\n}\n\n/// Full-width GF(2^64) identity field.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub struct Gf64;\nimpl sealed::Sealed for Gf64 {}\nimpl BinaryField for Gf64 {\n    const BITS: u32 = 64;\n    const MODULUS_LOW: u64 = 0x1b;\n    const WIRE_ID: FieldId = FieldId::Gf64;\n    const MASK: u64 = u64::MAX;\n}\n"},{"id":22,"name":{"Local":"src/backend/mod.rs"},"crate_name":"bulksketch","contents":"//! Arithmetic capabilities and canonical-word kernels only.\n#![deny(unsafe_code)]\n\npub(crate) mod contract;\npub(crate) mod detect;\npub(crate) mod portable;\n#[cfg(target_arch = \"x86_64\")]\npub(crate) mod x86_pclmul;\n\n#[cfg(target_arch = \"x86_64\")]\npub(crate) mod x86_vpclmul512;\n\n#[cfg(all(test, target_arch = \"x86_64\"))]\nmod vpclmul512_tests;\n\n#[cfg(all(test, target_arch = \"x86_64\"))]\nmod pclmul_tests;\n#[cfg(test)]\nmod portable_tests;\n\n#[cfg(test)]\nmod difference_tests;\n\n#[cfg(test)]\npub(crate) mod test_observer;\n\n#[cfg(test)]\nmod byte_map_tests;\n"},{"id":23,"name":{"Local":"src/backend/contract.rs"},"crate_name":"bulksketch","contents":"//! Each backend implements these static, monomorphized contracts for each checked capability.\n#![forbid(unsafe_code)]\n\nuse crate::{field::BinaryField, types::RawProduct};\n\n/// All operands/results are canonical F words. Slice dimensions are internal invariants.\n/// Inverse rejects zero; raw products are unreduced polynomials, never field elements.\npub(crate) trait Arithmetic<F: BinaryField>: Copy + Send + Sync + 'static {\n    fn mul(a: u64, b: u64) -> u64;\n    fn square(a: u64) -> u64;\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"arithmetic parity contract; insertion uses fixed private maps\"\n        )\n    )]\n    fn frobenius(a: u64, power: u32) -> u64;\n    fn inverse(a: u64) -> Option<u64>;\n    /// Absolute field trace, 0 or 1. Canonical scalar maps live in the field module.\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"arithmetic parity contract; scalar map owns current trace callers\"\n        )\n    )]\n    fn trace(a: u64) -> u8;\n    /// Deterministic right inverse of z^2+z on trace-zero inputs; verify each solution.\n    /// Even-degree fields use the fixed-pivot map, never the odd-degree half trace.\n    fn solve_quadratic(a: u64) -> Option<u64>;\n    fn raw_mul(a: u64, b: u64) -> RawProduct;\n    fn reduce(product: RawProduct) -> u64;\n    /// Equal lengths; XOR raw products then reduce once, including the empty dot = 0.\n    #[cfg(test)]\n    fn dot(a: &[u64], b: &[u64]) -> u64;\n    /// Equal lengths; dst[i] ^= src[i] * scale. Aliasing follows safe Rust borrows.\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64);\n    #[cfg_attr(\n        not(test),\n        allow(\n            dead_code,\n            reason = \"bulk parity contract; current reconstruction squares dependent positions\"\n        )\n    )]\n    fn square_slice(dst: &mut [u64], src: &[u64]);\n}\n\n/// Bulk arithmetic, without shape, wire, request, job or complete-operation types.\npub(crate) trait BulkKernels<F: BinaryField>: Arithmetic<F> {\n    /// Optional monic square-mod kernel; false leaves both mutable slices untouched.\n    /// Degree d>=3, a.len<=d, table.len=d*floor(d/2), dst.len=d, raw.len>=2*d+1.\n    fn square_mod(_a: &[u64], _table: &[u64], _dst: &mut [u64], _raw: &mut [RawProduct]) -> bool {\n        false\n    }\n\n    /// Multiply an ascending polynomial in place by (1 + root*z). Its final\n    /// coefficient must initially be zero; the slice includes that spare word.\n    fn multiply_linear(coefficients: &mut [u64], root: u64) {\n        for index in (1..coefficients.len()).rev() {\n            coefficients[index] ^= Self::mul(coefficients[index - 1], root);\n        }\n    }\n\n    /// Check all odd-sequence continuation equations, after the caller has\n    /// independently verified its first d words. squared_locator is rebuilt\n    /// from roots, has d+1 ascending words and constant coefficient one.\n    fn odd_recurrence_matches(odd: &[u64], squared_locator: &[u64]) -> bool {\n        let degree = squared_locator.len() - 1;\n        for index in degree..odd.len() {\n            let mut sum = RawProduct::default();\n            for lag in 1..=degree {\n                let product = Self::raw_mul(odd[index - lag], squared_locator[lag]);\n                sum.lo ^= product.lo;\n                sum.hi ^= product.hi;\n            }\n            if Self::reduce(sum) != odd[index] {\n                return false;\n            }\n        }\n        true\n    }\n\n    /// Toggle nonzero canonical IDs into S1,S3,... in arrival order. Parity semantics.\n    /// Caller handles routing/zero and validates every input. No post-final multiply.\n    fn insert_nonzero(odd: &mut [u64], ids: &[u64]);\n    /// Overwrite all odd syndromes with the direct encoding of these IDs.\n    fn encode_nonzero(odd: &mut [u64], ids: &[u64]) {\n        odd.fill(0);\n        if ids.len() <= 2 {\n            for id in ids {\n                Self::insert_nonzero(odd, std::slice::from_ref(id));\n            }\n        } else {\n            Self::insert_nonzero(odd, ids);\n        }\n    }\n\n    /// Equal lengths; XOR algebraic words only, never wire metadata.\n    fn xor_assign(dst: &mut [u64], src: &[u64]);\n    /// XOR canonical local words with unaligned little-endian remote words.\n    /// Equal word lengths; returns whether any output word is nonzero.\n    fn difference(dst: &mut [u64], local: &[u64], remote: &[u8]) -> bool {\n        #[cfg(test)]\n        super::test_observer::difference();\n        assert_eq!(dst.len(), local.len(), \"difference length mismatch\");\n        assert_eq!(\n            remote.len(),\n            8 * dst.len(),\n            \"difference byte length mismatch\"\n        );\n        let mut any = 0;\n        for ((out, &word), bytes) in dst.iter_mut().zip(local).zip(remote.chunks_exact(8)) {\n            *out = word ^ u64::from_le_bytes(bytes.try_into().expect(\"complete word\"));\n            any |= *out;\n        }\n        any != 0\n    }\n    /// Ascending coefficients; empty polynomial evaluates to zero. out.len=points.len.\n    fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]);\n}\n"},{"id":24,"name":{"Local":"src/decode/scratch.rs"},"crate_name":"bulksketch","contents":"//! Lower workspace borrows, owned by the upper request arena. The row decoder consumes these.\n#![forbid(unsafe_code)]\n\nuse crate::types::RawProduct;\n\n#[derive(Default)]\npub(crate) struct SplitterBasis {\n    pub(crate) directions: Option<[u64; 64]>,\n    pub(crate) len: u32,\n}\n\nimpl std::fmt::Debug for SplitterBasis {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.debug_struct(\"SplitterBasis\").finish_non_exhaustive()\n    }\n}\n\n/// An explicit factor-stack entry. The parent table is released before children start.\n#[derive(Clone, Debug, Default)]\n#[repr(C)]\npub(crate) struct FactorFrame {\n    pub(crate) coefficient_start: u64,\n    pub(crate) coefficient_len: u64,\n    pub(crate) next_direction: u32,\n    pub(crate) split_checked: u32,\n}\n\n/// Consecutive words, never a public arena or a replaceable scratch handle.\npub(crate) struct RowWorkspace<'w> {\n    pub(crate) syndromes: &'w mut [u64],\n    pub(crate) bm: &'w mut [u64],\n    pub(crate) polynomials: &'w mut [u64],\n    pub(crate) factors: &'w mut [u64],\n    pub(crate) square_table: &'w mut [u64],\n    pub(crate) verification: &'w mut [u64],\n    pub(crate) roots: &'w mut [u64],\n    pub(crate) raw: &'w mut [RawProduct],\n    pub(crate) stack: &'w mut [FactorFrame],\n    pub(crate) basis: &'w mut SplitterBasis,\n}\n"},{"id":25,"name":{"Local":"src/decode/work.rs"},"crate_name":"bulksketch","contents":"//! Versioned logical charges: V2 adds tiny probes; proposed V3 adds affine roots\n//! and independently rebuilt odd-LFSR verification. V1/V2 charges stay frozen.\n//! These are dimension charges, not CPU estimates.\n//!\n//! Charge before the named operation, even if a scalar/vector shortcut would avoid work.\n//! Preflight shape/plan/zero-budget scanning costs zero. A row preclassified by zero\n//! underflow has no row charges. An equal row pays Compare only. Every admitted request\n//! pays Admission and Normalize once, including requests whose rows all fail or are equal.\n//! Compare also writes the complete odd difference into its separate immutable row\n//! input segment. Reconstruction/BM/verification never overwrite that input.\n//! No cross-request algebra cache may change a charge. All row stages use the original\n//! nonzero budget for BM, original locator degree for candidate evaluation/deflation,\n//! current factor degree for root operations, and beta for verification/canonicalization.\n#![forbid(unsafe_code)]\n\nuse crate::types::{DecodeError, WorkUnits};\n\n/// Logical field-word envelopes, including V2 probes and proposed V3 kernels.\n/// Padding is never a dimension.\n#[derive(Clone, Copy, Debug)]\npub(crate) enum Charge {\n    Admission {\n        rows: usize,\n    },\n    Normalize {\n        inputs: usize,\n    },\n    Compare {\n        capacity: usize,\n    },\n    DirectOne,\n    DirectTwo,\n    GuardThree,\n    NewtonThree,\n    GuardFour,\n    NewtonFour,\n    LeafThree,\n    LeafFour,\n    FactorVerification {\n        degree: usize,\n    },\n    Reconstruct {\n        capacity: usize,\n    },\n    BmStep {\n        budget: usize,\n    },\n    Candidates {\n        degree: usize,\n        inputs: usize,\n    },\n    Deflate {\n        degree: usize,\n    },\n    AffinePreparation {\n        degree: usize,\n    },\n    AffineEnumeration {\n        degree: usize,\n        rank: usize,\n    },\n    AffineSplit {\n        degree: usize,\n        rank: usize,\n    },\n    VerifyLfsr {\n        capacity: usize,\n        output_budget: usize,\n        degree: usize,\n    },\n    Table {\n        degree: usize,\n    },\n    Trace {\n        degree: usize,\n    },\n    SplitCheck {\n        degree: usize,\n    },\n    Gcd {\n        degree: usize,\n    },\n    Divide {\n        degree: usize,\n    },\n    SplitAssembly {\n        degree: usize,\n    },\n    Leaf {\n        degree: usize,\n    },\n    Verify {\n        capacity: usize,\n        output_budget: usize,\n    },\n    Canonicalize {\n        ids: usize,\n    },\n}\n\npub(crate) struct WorkScheduleV1;\n\nimpl WorkScheduleV1 {\n    /// The constants reserve a fixed inversion envelope of 128 field operations.\n    /// Degree-dependent polynomial charges include normalization/copies. A driver\n    /// charges each macro once; kernels underneath do not recursively charge it again.\n    #[inline(always)]\n    pub(crate) fn cost(charge: Charge) -> Result<WorkUnits, DecodeError> {\n        let cost = match charge {\n            Charge::Admission { rows } => add(1, number(rows)?)?,\n            Charge::Normalize { inputs } => mul(number(inputs)?, add(log2_ceil(inputs), 3)?)?,\n            Charge::Compare { capacity } => add(number(capacity)?, 1)?,\n            Charge::DirectOne => 1,\n            Charge::DirectTwo => 168,\n            Charge::GuardThree => 48,\n            Charge::NewtonThree => 144,\n            Charge::GuardFour => 80,\n            Charge::NewtonFour => 160,\n            Charge::LeafThree => 640,\n            Charge::LeafFour => 2048,\n            Charge::FactorVerification { degree } => {\n                add(add(mul(2, square(degree)?)?, mul(4, number(degree)?)?)?, 1)?\n            }\n            Charge::Reconstruct { capacity } => mul(3, number(capacity)?)?,\n            Charge::BmStep { budget } => add(mul(6, add(number(budget)?, 1)?)?, 128)?,\n            Charge::Candidates { degree, inputs } => {\n                mul(mul(2, number(inputs)?)?, add(number(degree)?, 1)?)?\n            }\n            Charge::Deflate { degree } => mul(mul(2, number(degree)?)?, add(number(degree)?, 1)?)?,\n            Charge::AffinePreparation { degree } => {\n                let d = number(degree)?;\n                let d2 = mul(d, d)?;\n                add(\n                    add(mul(5, mul(d2, d)?)?, mul(16, d2)?)?,\n                    add(mul(327, d)?, 16900)?,\n                )?\n            }\n            Charge::AffineEnumeration { degree, rank } => {\n                let points = 1_u64\n                    .checked_shl(u32::try_from(rank).map_err(|_| DecodeError::WorkLimitExceeded)?)\n                    .ok_or(DecodeError::WorkLimitExceeded)?;\n                add(\n                    mul(mul(2, points)?, add(number(degree)?, 2)?)?,\n                    add(number(degree)?, 1)?,\n                )?\n            }\n            Charge::AffineSplit { degree, rank } => {\n                let d = number(degree)?;\n                add(\n                    mul(\n                        number(rank)?,\n                        add(square_mod(degree)?, add(mul(3, d)?, 3)?)?,\n                    )?,\n                    add(mul(3, d)?, 1)?,\n                )?\n            }\n\n            Charge::VerifyLfsr {\n                capacity,\n                output_budget,\n                degree,\n            } => add(\n                mul(add(mul(3, number(degree)?)?, 4)?, number(capacity)?)?,\n                add(number(degree)?, add(number(output_budget)?, 3)?)?,\n            )?,\n            Charge::Table { degree } => add(mul(8, square(degree)?)?, mul(2, number(degree)?)?)?,\n            Charge::Trace { degree } => mul(63, add(square_mod(degree)?, 2)?)?,\n            Charge::SplitCheck { degree } => add(square_mod(degree)?, add(number(degree)?, 1)?)?,\n            Charge::Gcd { degree } => {\n                let n = add(number(degree)?, 1)?;\n                add(mul(8, mul(n, n)?)?, mul(128, n)?)?\n            }\n            Charge::Divide { degree } => {\n                let n = add(number(degree)?, 1)?;\n                add(mul(4, mul(n, n)?)?, 128)?\n            }\n            Charge::SplitAssembly { degree } => mul(4, add(number(degree)?, 1)?)?,\n            Charge::Leaf { degree } => match degree {\n                0 => 0,\n                1 => 1,\n                2 => 160,\n                _ => panic!(\"leaf degree must be at most two\"),\n            },\n            Charge::Verify {\n                capacity,\n                output_budget,\n            } => {\n                let beta = number(output_budget)?;\n                add(\n                    mul(add(mul(2, beta)?, 3)?, number(capacity)?)?,\n                    add(beta, 1)?,\n                )?\n            }\n            Charge::Canonicalize { ids } => mul(number(ids)?, add(log2_ceil(ids), 1)?)?,\n        };\n        Ok(WorkUnits(cost))\n    }\n\n    /// Worst proper split tree. For increasing convex node costs, an unbalanced\n    /// chain maximizes their sum: at most one node of each size 3..=r is sufficient\n    /// as a bound. At each node all 64 trace directions and split checks are charged.\n    /// 160*r additionally bounds every possible degree-one/two leaf partition.\n    #[inline(always)]\n    pub(crate) fn roots_bound(budget: usize) -> Result<WorkUnits, DecodeError> {\n        let r = number(budget)?;\n        let leaves = mul(160, r)?;\n        if budget < 3 {\n            return Ok(WorkUnits(leaves));\n        }\n        // Expanding one node's exact table gives 12812*d^2 + 17486*d + 16968.\n        // Closed sums keep request admission O(B), independent of algebraic degree.\n        let next = add(r, 1)?;\n        let squares = mul(mul(r, next)?, add(mul(2, r)?, 1)?)? / 6;\n        let linear = mul(r, next)? / 2;\n        let squares = squares\n            .checked_sub(5)\n            .ok_or(DecodeError::WorkLimitExceeded)?;\n        let linear = linear\n            .checked_sub(3)\n            .ok_or(DecodeError::WorkLimitExceeded)?;\n        let nodes = r.checked_sub(2).ok_or(DecodeError::WorkLimitExceeded)?;\n        let total = add(\n            add(mul(12812, squares)?, mul(17486, linear)?)?,\n            mul(16968, nodes)?,\n        )?;\n        Ok(WorkUnits(add(leaves, total)?))\n    }\n\n    #[inline(always)]\n    pub(crate) fn row_bound(\n        capacity: usize,\n        budget: usize,\n        beta: usize,\n        candidates: usize,\n    ) -> Result<WorkUnits, DecodeError> {\n        let fixed = sum_costs(&[\n            Charge::Compare { capacity },\n            Charge::Reconstruct { capacity },\n            Charge::Candidates {\n                degree: budget,\n                inputs: candidates,\n            },\n            Charge::Deflate { degree: budget },\n            Charge::Verify {\n                capacity,\n                output_budget: beta,\n            },\n            Charge::Canonicalize { ids: beta },\n        ])?;\n        let bm = mul(\n            mul(2, number(capacity)?)?,\n            Self::cost(Charge::BmStep { budget })?.0,\n        )?;\n        Ok(WorkUnits(add(\n            add(fixed, bm)?,\n            Self::roots_bound(budget)?.0,\n        )?))\n    }\n}\n\npub(crate) struct WorkScheduleV2;\n\nimpl WorkScheduleV2 {\n    #[inline(always)]\n    pub(crate) fn row_bound(\n        capacity: usize,\n        budget: usize,\n        beta: usize,\n        candidates: usize,\n    ) -> Result<WorkUnits, DecodeError> {\n        let mut bound = WorkScheduleV1::row_bound(capacity, budget, beta, candidates)?.0;\n        let verify = WorkScheduleV1::cost(Charge::Verify {\n            capacity,\n            output_budget: beta,\n        })?\n        .0;\n        if budget >= 1 {\n            bound = add(\n                bound,\n                add(WorkScheduleV1::cost(Charge::DirectOne)?.0, verify)?,\n            )?;\n        }\n        if capacity >= 2 && budget >= 2 {\n            bound = add(\n                bound,\n                add(WorkScheduleV1::cost(Charge::DirectTwo)?.0, verify)?,\n            )?;\n        }\n        Ok(WorkUnits(bound))\n    }\n}\n\n#[inline(always)]\nfn square_mod(degree: usize) -> Result<u64, DecodeError> {\n    add(mul(3, square(degree)?)?, mul(2, number(degree)?)?)\n}\n#[inline(always)]\nfn square(n: usize) -> Result<u64, DecodeError> {\n    mul(number(n)?, number(n)?)\n}\n#[inline(always)]\npub(crate) fn number(n: usize) -> Result<u64, DecodeError> {\n    u64::try_from(n).map_err(|_| DecodeError::WorkLimitExceeded)\n}\n#[inline(always)]\npub(crate) fn add(a: u64, b: u64) -> Result<u64, DecodeError> {\n    a.checked_add(b).ok_or(DecodeError::WorkLimitExceeded)\n}\n#[inline(always)]\nfn mul(a: u64, b: u64) -> Result<u64, DecodeError> {\n    a.checked_mul(b).ok_or(DecodeError::WorkLimitExceeded)\n}\n#[inline(always)]\nfn sum_costs(charges: &[Charge]) -> Result<u64, DecodeError> {\n    charges\n        .iter()\n        .try_fold(0, |n, &c| add(n, WorkScheduleV1::cost(c)?.0))\n}\n#[inline(always)]\nfn log2_ceil(n: usize) -> u64 {\n    if n <= 1 {\n        0\n    } else {\n        u64::from(usize::BITS - (n - 1).leading_zeros())\n    }\n}\n\n/// Proposed V3 reserves extra affine stages and the larger general verifier.\npub(crate) struct WorkScheduleV3;\nimpl WorkScheduleV3 {\n    #[inline(always)]\n    pub(crate) fn row_bound(\n        capacity: usize,\n        budget: usize,\n        beta: usize,\n        candidates: usize,\n    ) -> Result<WorkUnits, DecodeError> {\n        let mut bound = WorkScheduleV2::row_bound(capacity, budget, beta, candidates)?.0;\n        let original = WorkScheduleV1::cost(Charge::Verify {\n            capacity,\n            output_budget: beta,\n        })?\n        .0;\n        let rebuilt = WorkScheduleV1::cost(Charge::VerifyLfsr {\n            capacity,\n            output_budget: beta,\n            degree: budget,\n        })?\n        .0;\n        bound = add(bound, rebuilt.max(original) - original)?;\n        // The maximum is const-derived from the operation predictor, never a\n        // tuned admission parameter. Each new charge is monotone in d/rank.\n        let d = budget.min(super::affine::MAX_PREFERRED_DEGREE);\n        if d >= 3 {\n            let setup = WorkScheduleV1::cost(Charge::AffinePreparation { degree: d })?.0;\n            let enumeration = WorkScheduleV1::cost(Charge::AffineEnumeration {\n                degree: d,\n                rank: d - 1,\n            })?\n            .0;\n            let split = WorkScheduleV1::cost(Charge::AffineSplit {\n                degree: d,\n                rank: d - 1,\n            })?\n            .0;\n            let attempts = mul(number(d)?, number(d - 2)?)?;\n            bound = add(bound, add(setup, enumeration.max(mul(attempts, split)?))?)?;\n        }\n        // Retain all integrated affine/LFSR fallback work, then add the degree-3/4 guards and leaves.\n        if capacity >= 3 && budget >= 3 {\n            bound = add(bound, add(863, original)?)?;\n        }\n        if capacity >= 4 && budget >= 4 {\n            bound = add(bound, add(2337, original)?)?;\n        }\n        bound = add(\n            bound,\n            add(\n                mul(671, number(budget / 3)?)?,\n                mul(2097, number(budget / 4)?)?,\n            )?,\n        )?;\n        Ok(WorkUnits(bound))\n    }\n}\n"},{"id":26,"name":{"Local":"/rustc/library/core/src/panic.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":28,"name":{"Local":"/rustc/library/core/src/num/error.rs"},"crate_name":"core","contents":null},{"id":29,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":30,"name":{"Local":"/rustc/library/core/src/panicking.rs"},"crate_name":"core","contents":null},{"id":31,"name":{"Local":"src/decode/deg34.rs"},"crate_name":"bulksketch","contents":"//! Cleared Newton guards and closed-form GF64 factor solvers for degree 3 and 4.\n//! Callers charge before entry and certify returned roots before using them.\n#![forbid(unsafe_code)]\n\nuse crate::{backend::contract::BulkKernels, field::BinaryField};\n\nconst OMEGA: u64 = 0x19c9_369f_278a_dc02;\n\n/// Six words: five ascending cleared coefficients, then the denominator.\npub(super) fn guard<F: BinaryField, K: BulkKernels<F>>(\n    odd: &[u64],\n    degree: usize,\n    out: &mut [u64],\n) -> bool {\n    let s = odd[0];\n    let s2 = K::square(s);\n    let s4 = K::square(s2);\n    let a = odd[1] ^ K::mul(s, s2);\n    let b = odd[2] ^ K::mul(odd[1], s2);\n    let denominator;\n    if degree == 3 {\n        denominator = a;\n        if denominator == 0 {\n            return false;\n        }\n        out[..5].copy_from_slice(&[K::square(a) ^ K::mul(s, b), b, K::mul(s, a), a, 0]);\n    } else {\n        let d = odd[2] ^ K::mul(s, s4);\n        let c = odd[3] ^ K::mul(s, K::square(odd[1])) ^ K::mul(a, s4);\n        denominator = K::mul(a, odd[1]) ^ K::mul(s, d);\n        if denominator == 0 {\n            return false;\n        }\n        let u2 = K::mul(b, odd[1]) ^ K::mul(s, c);\n        out[..5].copy_from_slice(&[\n            K::mul(a, c) ^ K::mul(b, d),\n            K::mul(a, denominator) ^ K::mul(s, u2),\n            u2,\n            K::mul(s, denominator),\n            denominator,\n        ]);\n    }\n    out[5] = denominator;\n    for index in degree..odd.len().min(degree + 2) {\n        let exponent = 2 * index + 1;\n        #[cfg(test)]\n        crate::types::small_degree_observer::residual(exponent);\n        let mut residual = K::mul(denominator, odd[index]);\n        for lag in 1..=degree {\n            let power = exponent - lag;\n            let squares = power.trailing_zeros();\n            let mut observed = odd[(power >> squares) / 2];\n            for _ in 0..squares {\n                observed = K::square(observed);\n            }\n            residual ^= K::mul(out[degree - lag], observed);\n        }\n        if residual != 0 {\n            return false;\n        }\n    }\n    true\n}\n\npub(super) fn normalize<F: BinaryField, K: BulkKernels<F>>(\n    cleared: &[u64],\n    s: u64,\n    degree: usize,\n    factor: &mut [u64],\n) {\n    let inverse = K::inverse(cleared[5]).expect(\"passed nonsingular Newton guard\");\n    for index in 0..degree - 1 {\n        factor[index] = K::mul(cleared[index], inverse);\n    }\n    factor[degree - 1] = s;\n    factor[degree] = 1;\n}\n\nfn quadratic<F: BinaryField, K: BulkKernels<F>>(target: u64) -> Option<u64> {\n    let root = K::solve_quadratic(target)?;\n    (K::square(root) ^ root == target).then_some(root)\n}\n\nfn cube_root<F: BinaryField, K: BulkKernels<F>>(t: u64) -> Option<u64> {\n    let t16 = K::frobenius(t, 4);\n    let t49 = K::mul(K::mul(K::square(t16), t16), t);\n    let mut u = t;\n    for _ in 0..10 {\n        u = K::mul(K::frobenius(u, 6), t49);\n    }\n    u = K::mul(u, t);\n    (u != 0 && K::mul(K::square(u), u) == t).then_some(u)\n}\n\nfn cubic<F: BinaryField, K: BulkKernels<F>>(a: u64, b: u64, c: u64) -> Option<[u64; 3]> {\n    let p = K::square(a) ^ b;\n    let q = K::mul(a, b) ^ c;\n    if q == 0 {\n        return None;\n    }\n    let inverse = K::inverse(q)?;\n    let z = quadratic::<F, K>(K::mul(K::mul(K::square(p), p), K::square(inverse)))?;\n    let t = K::mul(q, z);\n    let u = cube_root::<F, K>(if t == 0 { q } else { t })?;\n    let v = if p == 0 { 0 } else { K::mul(p, K::inverse(u)?) };\n    let ou = K::mul(OMEGA, u);\n    let ov = K::mul(OMEGA, v);\n    Some([a ^ u ^ v, a ^ ou ^ ov ^ v, a ^ ou ^ u ^ ov])\n}\n\n/// The single complete product certificate, also used privately for a quartic's kernel.\npub(super) fn certificate<F: BinaryField, K: BulkKernels<F>>(\n    factor: &[u64],\n    roots: &[u64],\n    product: &mut [u64],\n) -> bool {\n    if roots.len() + 1 != factor.len()\n        || roots\n            .iter()\n            .enumerate()\n            .any(|(i, &x)| x == 0 || x & !F::MASK != 0 || roots[..i].contains(&x))\n    {\n        return false;\n    }\n    let product = &mut product[..factor.len()];\n    product.fill(0);\n    product[0] = 1;\n    for (degree, &root) in roots.iter().enumerate() {\n        product[degree + 1] = product[degree];\n        for j in (1..=degree).rev() {\n            product[j] = product[j - 1] ^ K::mul(root, product[j]);\n        }\n        product[0] = K::mul(root, product[0]);\n    }\n    product == factor\n}\n\nfn affine_quartic<F: BinaryField, K: BulkKernels<F>>(b: u64, c: u64, d: u64) -> Option<[u64; 4]> {\n    if c == 0 {\n        return None;\n    }\n    let kernel = cubic::<F, K>(0, b, c)?;\n    if !certificate::<F, K>(&[c, b, 0, 1], &kernel, &mut [0; 4]) {\n        return None;\n    }\n    let u = *kernel.iter().min().expect(\"three kernel roots\");\n    #[cfg(test)]\n    crate::types::small_degree_observer::selected(u);\n    let v = b ^ K::square(u);\n    if u == 0 || v == 0 || K::mul(u, v) != c {\n        return None;\n    }\n    let inverse = K::inverse(c)?;\n    let iu2 = K::square(K::mul(v, inverse));\n    let iv2 = K::square(K::mul(u, inverse));\n    let w = K::mul(v, quadratic::<F, K>(K::mul(d, iv2))?);\n    let x = K::mul(u, quadratic::<F, K>(K::mul(w, iu2))?);\n    let y = K::mul(u, quadratic::<F, K>(K::mul(w ^ v, iu2))?);\n    Some([x, x ^ u, y, y ^ u])\n}\n\nfn quartic<F: BinaryField, K: BulkKernels<F>>(factor: &[u64]) -> Option<[u64; 4]> {\n    let (a, b, c, d) = (factor[3], factor[2], factor[1], factor[0]);\n    if a == 0 {\n        return affine_quartic::<F, K>(b, c, d);\n    }\n    let ratio = K::mul(c, K::inverse(a)?);\n    // F63 = square(F31(F31(x))); reuse the existing fixed maps.\n    let shift = K::square(K::frobenius(K::frobenius(ratio, 31), 31));\n    let e2 = K::square(shift);\n    let denominator = K::square(e2) ^ K::mul(b, e2) ^ d;\n    if denominator == 0 {\n        return None;\n    }\n    let inverse = K::inverse(denominator)?;\n    let mut roots = affine_quartic::<F, K>(\n        K::mul(b ^ K::mul(a, shift), inverse),\n        K::mul(a, inverse),\n        inverse,\n    )?;\n    if roots.contains(&0) {\n        return None;\n    }\n    let mut prefixes = [1; 4];\n    for i in 1..4 {\n        prefixes[i] = K::mul(prefixes[i - 1], roots[i - 1]);\n    }\n    let mut inverse = K::inverse(K::mul(prefixes[3], roots[3]))?;\n    for i in (0..4).rev() {\n        let original = roots[i];\n        roots[i] = K::mul(prefixes[i], inverse) ^ shift;\n        inverse = K::mul(inverse, original);\n    }\n    Some(roots)\n}\n\n/// Returned candidates are deliberately uncertified. A miss writes no output.\npub(super) fn solve<F: BinaryField, K: BulkKernels<F>>(\n    factor: &[u64],\n    output: &mut [u64],\n) -> Option<usize> {\n    debug_assert_eq!(F::BITS, 64);\n    let degree = factor.len() - 1;\n    let roots = if degree == 3 {\n        let roots = cubic::<F, K>(factor[2], factor[1], factor[0])?;\n        [roots[0], roots[1], roots[2], 0]\n    } else {\n        quartic::<F, K>(factor)?\n    };\n    output[..degree].copy_from_slice(&roots[..degree]);\n    #[cfg(test)]\n    return crate::types::small_degree_observer::returned(output, degree);\n    #[cfg(not(test))]\n    Some(degree)\n}\n\n#[cfg(test)]\nmod tests;\n"},{"id":32,"name":{"Local":"src/decode/probe.rs"},"crate_name":"bulksketch","contents":"//! Small V2 stage state. A miss resumes the general decoder at Reconstruction.\n#![forbid(unsafe_code)]\n\nuse {\n    super::{\n        direct,\n        row::{RowBudget, RowProgress},\n        work::{Charge, WorkScheduleV1},\n    },\n    crate::{\n        backend::contract::BulkKernels,\n        field::BinaryField,\n        types::{DecodeError, Stage, WorkMeter},\n    },\n};\n\n#[derive(Debug)]\npub(crate) struct Probe {\n    budget: RowBudget,\n    next: Option<Stage>,\n    count: usize,\n    pair: bool,\n    #[cfg(test)]\n    pub(crate) probe_fault: direct::Fault,\n    #[cfg(test)]\n    pub(crate) probe_algebra: Option<(u64, u64, u64)>,\n    #[cfg(test)]\n    pub(crate) operation_observer: Option<std::sync::Arc<std::sync::atomic::AtomicUsize>>,\n}\n\nimpl Probe {\n    pub(crate) fn new(budget: RowBudget, difference: &[u64]) -> Option<Self> {\n        (budget.nonzero != 0 && difference[0] != 0).then_some(Self {\n            budget,\n            next: Some(Stage::DirectOne),\n            count: 0,\n            pair: false,\n            #[cfg(test)]\n            probe_fault: direct::Fault::None,\n            #[cfg(test)]\n            probe_algebra: None,\n            #[cfg(test)]\n            operation_observer: None,\n        })\n    }\n\n    pub(crate) fn next_stage(&self) -> Option<Stage> {\n        self.next\n    }\n    pub(crate) fn count(&self) -> usize {\n        self.count\n    }\n    #[cfg(test)]\n    pub(crate) fn provisional_count(&self) -> usize {\n        self.count\n    }\n\n    pub(crate) fn reject(&mut self, capacity: usize) {\n        self.next = Some(if !self.pair && capacity >= 2 && self.budget.nonzero >= 2 {\n            self.pair = true;\n            Stage::DirectTwo\n        } else {\n            Stage::Reconstruction\n        });\n        self.count = 0;\n    }\n\n    #[inline(always)]\n    pub(crate) fn run_next<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        difference: &[u64],\n        verification: &mut [u64],\n        roots: &mut [u64],\n        meter: &mut WorkMeter,\n    ) -> Result<RowProgress, DecodeError> {\n        self.charge(difference.len(), meter)?;\n        Ok(self.run_charged::<F, K>(difference, verification, roots))\n    }\n\n    // Standalone lower-layer executions validate their workspace between this\n    // successful charge and run_charged. Public jobs already admitted the arena.\n    #[inline(always)]\n    pub(crate) fn charge(&self, capacity: usize, meter: &mut WorkMeter) -> Result<(), DecodeError> {\n        let stage = self.next.expect(\"active probe\");\n        let charge = match stage {\n            Stage::DirectOne => Charge::DirectOne,\n            Stage::DirectTwo => Charge::DirectTwo,\n            Stage::Verification => Charge::Verify {\n                capacity,\n                output_budget: self.budget.total,\n            },\n            Stage::Canonicalization => Charge::Canonicalize {\n                ids: self.budget.total,\n            },\n            _ => unreachable!(\"probe has handed off to general execution\"),\n        };\n        meter.charge(WorkScheduleV1::cost(charge)?)?;\n        #[cfg(test)]\n        if let Some(observer) = &self.operation_observer {\n            observer.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n        }\n        Ok(())\n    }\n\n    #[inline(always)]\n    pub(crate) fn run_charged<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        difference: &[u64],\n        verification: &mut [u64],\n        roots: &mut [u64],\n    ) -> RowProgress {\n        let stage = self.next.expect(\"charged probe\");\n        match stage {\n            Stage::DirectOne => {\n                roots[0] = difference[0];\n                self.count = 1;\n                self.next = Some(Stage::Verification);\n            }\n            Stage::DirectTwo => {\n                if let Some(pair) = direct::two::<F, K>(\n                    difference[0],\n                    difference[1],\n                    #[cfg(test)]\n                    self.probe_fault,\n                ) {\n                    roots[..2].copy_from_slice(&pair.roots);\n                    self.count = 2;\n                    #[cfg(test)]\n                    {\n                        self.probe_algebra = Some(pair.algebra);\n                    }\n                    self.next = Some(Stage::Verification);\n                } else {\n                    self.reject(difference.len());\n                }\n            }\n            Stage::Verification => {\n                let roots = &roots[..self.count];\n                if roots.len() <= self.budget.nonzero\n                    && roots.iter().all(|&id| id != 0 && id & !F::MASK == 0)\n                    && !roots.windows(2).any(|p| p[0] == p[1])\n                    && verified::<F, K>(difference, roots, verification)\n                {\n                    self.next = Some(Stage::Canonicalization);\n                } else {\n                    self.reject(difference.len());\n                }\n            }\n            Stage::Canonicalization => {\n                if self.count == 2 && roots[0] > roots[1] {\n                    roots.swap(0, 1);\n                }\n                self.next = None;\n            }\n            _ => unreachable!(\"charged probe stage\"),\n        }\n        RowProgress {\n            stage,\n            locator_degree: 0,\n            candidate_hits: 0,\n            trace_attempts: 0,\n            gcd_degree: 0,\n        }\n    }\n}\n\n/// Called only after Verify is charged. Prefix rejection never replaces full re-encoding.\npub(super) fn verified<F: BinaryField, K: BulkKernels<F>>(\n    difference: &[u64],\n    roots: &[u64],\n    verification: &mut [u64],\n) -> bool {\n    if roots.len() <= 2\n        && (roots.iter().fold(0, |s, &x| s ^ x) != difference[0]\n            || (difference.len() >= 2\n                && roots.iter().fold(0, |s, &x| s ^ K::mul(x, K::square(x))) != difference[1]))\n    {\n        return false;\n    }\n    let verification = &mut verification[..difference.len()];\n    K::encode_nonzero(verification, roots);\n    verification == difference\n}\n"},{"id":33,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":34,"name":{"Local":"/rustc/library/core/src/intrinsics/mod.rs"},"crate_name":"core","contents":null},{"id":35,"name":{"Local":"/rustc/library/core/src/ops/function.rs"},"crate_name":"core","contents":null},{"id":36,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":37,"name":{"Local":"/rustc/library/core/src/ops/try_trait.rs"},"crate_name":"core","contents":null},{"id":38,"name":{"Local":"/rustc/library/core/src/iter/traits/collect.rs"},"crate_name":"core","contents":null},{"id":39,"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"core","contents":null},{"id":40,"name":{"Local":"/rustc/library/core/src/iter/traits/mod.rs"},"crate_name":"core","contents":null},{"id":41,"name":{"Local":"/rustc/library/core/src/iter/traits/iterator.rs"},"crate_name":"core","contents":null},{"id":42,"name":{"Local":"/rustc/library/core/src/iter/range.rs"},"crate_name":"core","contents":null},{"id":43,"name":{"Local":"/rustc/library/core/src/slice/iter.rs"},"crate_name":"core","contents":null},{"id":44,"name":{"Local":"/rustc/library/core