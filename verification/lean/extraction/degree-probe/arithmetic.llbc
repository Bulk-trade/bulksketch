e first will contain all indices from `[0, mid)` (excluding"},{"DocComment":" the index `mid` itself) and the second will contain all"},{"DocComment":" indices from `[mid, len)` (excluding the index `len` itself)."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `mid > len`.  For a non-panicking alternative see"},{"DocComment":" [`split_at_mut_checked`](slice::split_at_mut_checked)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut v = [1, 0, 3, 0, 5, 6];"},{"DocComment":" let (left, right) = v.split_at_mut(2);"},{"DocComment":" assert_eq!(left, [1, 0]);"},{"DocComment":" assert_eq!(right, [3, 0, 5, 6]);"},{"DocComment":" left[1] = 2;"},{"DocComment":" right[1] = 4;"},{"DocComment":" assert_eq!(v, [1, 2, 3, 4, 5, 6]);"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":3,"beg":{"line":1994,"col":4},"end":{"line":1994,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":15}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":47},{"Deduplicated":0}],"output":{"Value":[274,{"Adt":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":47},{"Deduplicated":47}],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}]}},"src":"Normal","body":"Opaque"},{"def_id":38,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["decode",0]},{"Ident":["deg34",0]},{"Ident":["guard",0]}],"span":{"Untagged":{"data"