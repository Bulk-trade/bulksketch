nknown","late_bound":false}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"drop_glue","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]},{"Ident":["drop_glue",0]}],"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":1063,"col":0},"end":{"line":1063,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":756}],"output":{"Deduplicated":66}},"default":null},"kind":{"TraitMethod":[4,0]}}],"vtable":null},{"def_id":5,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":1053,"col":0},"end":{"line":1053,"col":29}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `?` formatting."},{"DocComment":""},{"DocComment":" `Debug` should format the output in a programmer-facing, debugging context."},{"DocComment":""},{"DocComment":" Generally speaking, you should just `derive` a `Debug` implementation."},{"DocComment":""},{"DocComment":" When used with the alternate format specifier `#?`, the output is pretty-printed."},{"DocComment":""},{"DocComment":" For more information on formatters, see [the module-level documentation][module]."},{"DocComment":""},{"DocComment":" [module]: ../../std/fmt/index.html"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]` if all fields implement `Debug`. When"},{"DocComment":" `derive`d for structs, it will use the name of the `struct`, then `{`, then a"},{"DocComment":" comma-separated list of each field's name and `Debug` value, then `}`. For"},{"DocComment":" `enum`s, it will use the name of the variant and, if applicable, `(`, then the"},{"DocComment":" `Debug` values of the fields, then `)`."},{"DocComment":""},{"DocComment":" # Stability"},{"DocComment":""},{"DocComment":" Derived `Debug` formats are not stable, and so may change with future Rust"},{"DocComment":" versions. Additionally, `Debug` implementations of types provided by the"},{"DocComment":" standard library (`std`, `core`, `alloc`, etc.) are not stable, and"},{"DocComment":" may also change with future Rust versions."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Deriving an implementation:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Manually implementing:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_struct(\"Point\")"},{"DocComment":"          .field(\"x\", &self.x)"},{"DocComment":"          .field(\"y\", &self.y)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are a number of helper methods on the [`Formatter`] struct to help you with manual"},{"DocComment":" implementations, such as [`debug_struct`]."},{"DocComment":""},{"DocComment":" [`debug_struct`]: Formatter::debug_struct"},{"DocComment":""},{"DocComment":" Types that do not wish to use the standard suite of debug representations"},{"DocComment":" provided by the `Formatter` trait (`debug_struct`, `debug_tuple`,"},{"DocComment":" `debug_list`, `debug_set`, `debug_map`) can do something totally custom by"},{"DocComment":" manually writing an arbitrary representation to the `Formatter`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use std::fmt;"},{"DocComment":" # struct Point {"},{"DocComment":" #     x: i32,"},{"DocComment":" #     y: i32,"},{"DocComment":" # }"},{"DocComment":" #"},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"Point [{} {}]\", self.x, self.y)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Debug` implementations using either `derive` or the debug builder API"},{"DocComment":" on [`Formatter`] support pretty-printing using the alternate flag: `{:#?}`."},{"DocComment":""},{"DocComment":" Pretty-printing with `#?`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" let expected = \"The origin is: Point {"},{"DocComment":"     x: 0,"},{"DocComment":"     y: 0,"},{"DocComment":" }\";"},{"DocComment":" assert_eq!(format!(\"The origin is: {origin:#?}\"), expected);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Debug","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]},{"Ident":["fmt",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":1084,"col":4},"end":{"line":1084,"col":51}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Formats the value using the given formatter.\n\n# Errors\n\nThis function should return [`Err`] if, and only if, the provided [`Formatter`] returns [`Err`].\nString formatting is considered an infallible operation; this function only\nreturns a [`Result`] because writing to the underlying stream might fail and it must\nprovide a way to propagate the fact that an error has occurred back up the stack.\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Position {"},{"DocComment":"     longitude: f32,"},{"DocComment":"     latitude: f32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Position {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_tuple(\"\")"},{"DocComment":"          .field(&self.longitude)"},{"DocComment":"          .field(&self.latitude)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let position = Position { longitude: 1.987, latitude: 2.983 };"},{"DocComment":" assert_eq!(format!(\"{position:?}\"), \"(1.987, 2.983)\");"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"{position:#?}\"), \"("},{"DocComment":"     1.987,"},{"DocComment":"     2.983,"},{"DocComment":" )\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":745},{"Value":[757,{"Ref":[{"Var":{"Bound":[0,1]}},{"Value":[758,{"Adt":{"id":9,"generics":{"regions":[{"Var":{"Bound":[0,2]}}],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]},"Mut"]}]}],"output":{"Deduplicated":65}},"default":null},"kind":{"TraitMethod":[5,0]}}],"vtable":{"id":8,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":6,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["field",0]},{"Ident":["BinaryField",0]}],"span":{"Untagged":{"data":{"file_id":21,"beg":{"line":25,"col":0},"end":{"line":34,"col":1}},"generated_from_span":null}},"source_text":"pub trait BinaryField: sealed::Sealed + Copy + Eq + Send + Sync + 'static {\n    /// Extension degree over GF(2).\n    const BITS: u32;\n    /// Irreducible polynomial without its leading term.\n    const MODULUS_LOW: u64;\n    /// Registered polynomial/basis identity.\n    const WIRE_ID: FieldId;\n    /// Canonical element mask.\n    const MASK: u64;\n}","attr_info":{"attributes":[{"DocComment":" Closed field specification. Kernels consume canonical words, never masked IDs."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":15}},"Static"]}],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[2622,{"data":{"file_id":21,"beg":{"line":25,"col":23},"end":{"line":25,"col":37}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[2623,{"data":{"file_id":21,"beg":{"line":25,"col":40},"end":{"line":25,"col":44}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Value":[2624,{"data":{"file_id":21,"beg":{"line":25,"col":47},"end":{"line":25,"col":49}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Value":[2625,{"data":{"file_id":21,"beg":{"line":25,"col":52},"end":{"line":25,"col":56}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":4,"span":{"Value":[2626,{"data":{"file_id":21,"beg":{"line":25,"col":59},"end":{"line":25,"col":63}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}}],"consts":[{"name":"BITS","attr_info":{"attributes":[{"DocComment":" Extension degree over GF(2)."}],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":33},"default":null},{"name":"MODULUS_LOW","attr_info":{"attributes":[{"DocComment":" Irreducible polynomial without its leading term."}],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":13},"default":null},{"name":"WIRE_ID","attr_info":{"attributes":[{"DocComment":" Registered polynomial/basis identity."}],"inline":null,"rename":null,"public":true},"ty":{"Value":[759,{"Adt":{"id":25,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]},"default":null},{"name":"MASK","attr_info":{"attributes":[{"DocComment":" Canonical element mask."}],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":13},"default":null}],"types":[],"methods":[],"vtable":null},{"def_id":7,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["BulkKernels",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":50,"col":0},"end":{"line":121,"col":1}},"generated_from_span":null}},"source_text":"pub(crate) trait BulkKernels<F: BinaryField>: Arithmetic<F> {\n    /// Optional monic square-mod kernel; false leaves both mutable slices untouched.\n    /// Degree d>=3, a.len<=d, table.len=d*floor(d/2), dst.len=d, raw.len>=2*d+1.\n    fn square_mod(_a: &[u64], _table: &[u64], _dst: &mut [u64], _raw: &mut [RawProduct]) -> bool {\n        false\n    }\n\n    /// Multiply an ascending polynomial in place by (1 + root*z). Its final\n    /// coefficient must initially be zero; the slice includes that spare word.\n    fn multiply_linear(coefficients: &mut [u64], root: u64) {\n        for index in (1..coefficients.len()).rev() {\n            coefficients[index] ^= Self::mul(coefficients[index - 1], root);\n        }\n    }\n\n    /// Check all odd-sequence continuation equations, after the caller has\n    /// independently verified its first d words. squared_locator is rebuilt\n    /// from roots, has d+1 ascending words and constant coefficient one.\n    fn odd_recurrence_matches(odd: &[u64], squared_locator: &[u64]) -> bool {\n        let degree = squared_locator.len() - 1;\n        for index in degree..odd.len() {\n            let mut sum = RawProduct::default();\n            for lag in 1..=degree {\n                let product = Self::raw_mul(odd[index - lag], squared_locator[lag]);\n                sum.lo ^= product.lo;\n                sum.hi ^= product.hi;\n            }\n            if Self::reduce(sum) != odd[index] {\n                return false;\n            }\n        }\n        true\n    }\n\n    /// Toggle nonzero canonical IDs into S1,S3,... in arrival order. Parity semantics.\n    /// Caller handles routing/zero and validates every input. No post-final multiply.\n    fn insert_nonzero(odd: &mut [u64], ids: &[u64]);\n    /// Overwrite all odd syndromes with the direct encoding of these IDs.\n    fn encode_nonzero(odd: &mut [u64], ids: &[u64]) {\n        odd.fill(0);\n        if ids.len() <= 2 {\n            for id in ids {\n                Self::insert_nonzero(odd, std::slice::from_ref(id));\n            }\n        } else {\n            Self::insert_nonzero(odd, ids);\n        }\n    }\n\n    /// Equal lengths; XOR algebraic words only, never wire metadata.\n    fn xor_assign(dst: &mut [u64], src: &[u64]);\n    /// XOR canonical local words with unaligned little-endian remote words.\n    /// Equal word lengths; returns whether any output word is nonzero.\n    fn difference(dst: &mut [u64], local: &[u64], remote: &[u8]) -> bool {\n        #[cfg(test)]\n        super::test_observer::difference();\n        assert_eq!(dst.len(), local.len(), \"difference length mismatch\");\n        assert_eq!(\n            remote.len(),\n            8 * dst.len(),\n            \"difference byte length mismatch\"\n        );\n        let mut any = 0;\n        for ((out, &word), bytes) in dst.iter_mut().zip(local).zip(remote.chunks_exact(8)) {\n            *out = word ^ u64::from_le_bytes(bytes.try_into().expect(\"complete word\"));\n            any |= *out;\n        }\n        any != 0\n    }\n    /// Ascending coefficients; empty polynomial evaluates to zero. out.len=points.len.\n    fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]);\n}","attr_info":{"attributes":[{"DocComment":" Bulk arithmetic, without shape, wire, request, job or complete-operation types."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[2627,{"data":{"file_id":23,"beg":{"line":50,"col":46},"end":{"line":50,"col":59}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":15},{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[2628,{"data":{"file_id":23,"beg":{"line":50,"col":32},"end":{"line":50,"col":43}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"square_mod","item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["BulkKernels",0]},{"Ident":["square_mod",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":53,"col":4},"end":{"line":55,"col":5}},"generated_from_span":null}},"source_text":"fn square_mod(_a: &[u64], _table: &[u64], _dst: &mut [u64], _raw: &mut [RawProduct]) -> bool {\n        false\n    }","attr_info":{"attributes":[{"DocComment":" Optional monic square-mod kernel; false leaves both mutable slices untouched."},{"DocComment":" Degree d>=3, a.len<=d, table.len=d*floor(d/2), dst.len=d, raw.len>=2*d+1."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[760,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":23},"Shared"]}]},{"Value":[761,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":23},"Shared"]}]},{"Value":[762,{"Ref":[{"Var":{"Bound":[0,2]}},{"Deduplicated":23},"Mut"]}]},{"Value":[763,{"Ref":[{"Var":{"Bound":[0,3]}},{"Deduplicated":25},"Mut"]}]}],"output":{"Deduplicated":5}},"default":{"id":52,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}},{"Var":{"Bound":[0,2]}},{"Var":{"Bound":[0,3]}}],"types":[{"Deduplicated":15},{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}},"kind":{"TraitMethod":[7,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"multiply_linear","item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["BulkKernels",0]},{"Ident":["multiply_linear",0