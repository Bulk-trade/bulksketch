Deduplicated":13}},"default":null},"kind":{"TraitMethod":[15,1]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"frobenius","item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["Arithmetic",0]},{"Ident":["frobenius",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":18,"col":4},"end":{"line":18,"col":44}},"generated_from_span":null}},"source_text":"fn frobenius(a: u64, power: u32) -> u64;","attr_info":{"attributes":[{"Unknown":{"path":"allow","args":"dead_code, reason =\n\"arithmetic parity contract; insertion uses fixed private maps\""}}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":13},{"Deduplicated":33}],"output":{"Deduplicated":13}},"default":null},"kind":{"TraitMethod":[15,2]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"inverse","item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["Arithmetic",0]},{"Ident":["inverse",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":19,"col":4},"end":{"line":19,"col":38}},"generated_from_span":null}},"source_text":"fn inverse(a: u64) -> Option<u64>;","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":13}],"output":{"Deduplicated":255}},"default":null},"kind":{"TraitMethod":[15,3]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_cla