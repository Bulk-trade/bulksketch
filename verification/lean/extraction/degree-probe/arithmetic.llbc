utput":{"Deduplicated":255}},"default":null},"kind":{"TraitMethod":[15,5]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"raw_mul","item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["Arithmetic",0]},{"Ident":["raw_mul",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":32,"col":4},"end":{"line":32,"col":45}},"generated_from_span":null}},"source_text":"fn raw_mul(a: u64, b: u64) -> RawProduct;","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":13},{"Deduplicated":13}],"output":{"Deduplicated":26}},"default":null},"kind":{"TraitMethod":[15,6]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"reduce","item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["Arithmetic",0]},{"Ident":["reduce",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":33,"col":4},"end":{"line":33,"col":42}},"generated_from_span":null}},"source_text":"fn reduce(product: RawProduct) -> u64;","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":26}],"output":{"Deduplicated":13}},"default":null},"kind":{"TraitMethod":[15,7]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","l