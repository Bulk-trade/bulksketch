{"charon_version":"0.1.304","translated":{"crate_name":"bulksketch","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["bulksketch::decode::work::_::roots_bound"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/Users/junbug/bulk/bulksketch-proof-evidence-20261109-root-work-budget/roots-only/arithmetic.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-apple-darwin","value":{"arch":"X86_64","vendor":"apple","os":"MacOs","env":"Unspecified","cfg_abi":"Unspecified","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bulksketch","contents":"//! Native binary-syndrome reconciliation with bounded, deterministic GF64 decoding.\n#![deny(unsafe_code)]\n#![warn(missing_docs)]\n\nmod backend;\nmod decode;\nmod field;\nmod poly;\nmod sketch;\nmod types;\n\npub use {\n    field::{BinaryField, Gf64},\n    sketch::{\n        DecodeJob, DecodeLimits, DecodeOutcome, DecodePlan, DecodeReport, DecodeRequest, DecodeRow,\n        DecodeRowsRequest, DecodeScratch, Decoder, FrozenSketch, InsertScratch, MutableSketch,\n        ParseLimits, ScratchLayout, ShapeLimits, SketchShape, SketchView, decode_into,\n        decode_rows_into,\n    },\n    types::{\n        BackendError, BackendId, BackendRequest, CreateError, DecodeError, DecodeFailure,\n        EncodeError, FieldId, ParseError, ShapeError, ShapeMismatch, Stage, StageProgress,\n        UpdateError, WorkUnits,\n    },\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"src/decode/work.rs"},"crate_name":"bulksketch","contents":"//! Versioned logical charges: V2 adds tiny probes; proposed V3 adds affine roots\n//! and independently rebuilt odd-LFSR verification. V1/V2 charges stay frozen.\n//! These are dimension charges, not CPU estimates.\n//!\n//! Charge before the named operation, even if a scalar/vector shortcut would avoid work.\n//! Preflight shape/plan/zero-budget scanning costs zero. A row preclassified by zero\n//! underflow has no row charges. An equal row pays Compare only. Every admitted request\n//! pays Admission and Normalize once, including requests whose rows all fail or are equal.\n//! Compare also writes the complete odd difference into its separate immutable row\n//! input segment. Reconstruction/BM/verification never overwrite that input.\n//! No cross-request algebra cache may change a charge. All row stages use the original\n//! nonzero budget for BM, original locator degree for candidate evaluation/deflation,\n//! current factor degree for root operations, and beta for verification/canonicalization.\n#![forbid(unsafe_code)]\n\nuse crate::types::{DecodeError, WorkUnits};\n\n/// Logical field-word envelopes, including V2 probes and proposed V3 kernels.\n/// Padding is never a dimension.\n#[derive(Clone, Copy, Debug)]\npub(crate) enum Charge {\n    Admission {\n        rows: usize,\n    },\n    Normalize {\n        inputs: usize,\n    },\n    Compare {\n        capacity: usize,\n    },\n    DirectOne,\n    DirectTwo,\n    GuardThree,\n    NewtonThree,\n    GuardFour,\n    NewtonFour,\n    LeafThree,\n    LeafFour,\n    FactorVerification {\n        degree: usize,\n    },\n    Reconstruct {\n        capacity: usize,\n    },\n    BmStep {\n        budget: usize,\n    },\n    Candidates {\n        degree: usize,\n        inputs: usize,\n    },\n    Deflate {\n        degree: usize,\n    },\n    AffinePreparation {\n        degree: usize,\n    },\n    AffineEnumeration {\n        degree: usize,\n        rank: usize,\n    },\n    AffineSplit {\n        degree: usize,\n        rank: usize,\n    },\n    VerifyLfsr {\n        capacity: usize,\n        output_budget: usize,\n        degree: usize,\n    },\n    Table {\n        degree: usize,\n    },\n    Trace {\n        degree: usize,\n    },\n    SplitCheck {\n        degree: usize,\n    },\n    Gcd {\n        degree: usize,\n    },\n    Divide {\n        degree: usize,\n    },\n    SplitAssembly {\n        degree: usize,\n    },\n    Leaf {\n        degree: usize,\n    },\n    Verify {\n        capacity: usize,\n        output_budget: usize,\n    },\n    Canonicalize {\n        ids: usize,\n    },\n}\n\npub(crate) struct WorkScheduleV1;\n\nimpl WorkScheduleV1 {\n    /// The constants reserve a fixed inversion envelope of 128 field operations.\n    /// Degree-dependent polynomial charges include normalization/copies. A driver\n    /// charges each macro once; kernels underneath do not recursively charge it again.\n    #[inline(always)]\n    pub(crate) fn cost(charge: Charge) -> Result<WorkUnits, DecodeError> {\n        let cost = match charge {\n            Charge::Admission { rows } => add(1, number(rows)?)?,\n            Charge::Normalize { inputs } => mul(number(inputs)?, add(log2_ceil(inputs), 3)?)?,\n            Charge::Compare { capacity } => add(number(capacity)?, 1)?,\n            Charge::DirectOne => 1,\n            Charge::DirectTwo => 168,\n            Charge::GuardThree => 48,\n            Charge::NewtonThree => 144,\n            Charge::GuardFour => 80,\n            Charge::NewtonFour => 160,\n            Charge::LeafThree => 640,\n            Charge::LeafFour => 2048,\n            Charge::FactorVerification { degree } => {\n                add(add(mul(2, square(degree)?)?, mul(4, number(degree)?)?)?, 1)?\n            }\n            Charge::Reconstruct { capacity } => mul(3, number(capacity)?)?,\n            Charge::BmStep { budget } => add(mul(6, add(number(budget)?, 1)?)?, 128)?,\n            Charge::Candidates { degree, inputs } => {\n                mul(mul(2, number(inputs)?)?, add(number(degree)?, 1)?)?\n            }\n            Charge::Deflate { degree } => mul(mul(2, number(degree)?)?, add(number(degree)?, 1)?)?,\n            Charge::AffinePreparation { degree } => {\n                let d = number(degree)?;\n                let d2 = mul(d, d)?;\n                add(\n                    add(mul(5, mul(d2, d)?)?, mul(16, d2)?)?,\n                    add(mul(327, d)?, 16900)?,\n                )?\n            }\n            Charge::AffineEnumeration { degree, rank } => {\n                let points = 1_u64\n                    .checked_shl(u32::try_from(rank).map_err(|_| DecodeError::WorkLimitExceeded)?)\n                    .ok_or(DecodeError::WorkLimitExceeded)?;\n                add(\n                    mul(mul(2, points)?, add(number(degree)?, 2)?)?,\n                    add(number(degree)?, 1)?,\n                )?\n            }\n            Charge::AffineSplit { degree, rank } => {\n                let d = number(degree)?;\n                add(\n                    mul(\n                        number(rank)?,\n                        add(square_mod(degree)?, add(mul(3, d)?, 3)?)?,\n                    )?,\n                    add(mul(3, d)?, 1)?,\n                )?\n            }\n\n            Charge::VerifyLfsr {\n                capacity,\n                output_budget,\n                degree,\n            } => add(\n                mul(add(mul(3, number(degree)?)?, 4)?, number(capacity)?)?,\n                add(number(degree)?, add(number(output_budget)?, 3)?)?,\n            )?,\n            Charge::Table { degree } => add(mul(8, square(degree)?)?, mul(2, number(degree)?)?)?,\n            Charge::Trace { degree } => mul(63, add(square_mod(degree)?, 2)?)?,\n            Charge::SplitCheck { degree } => add(square_mod(degree)?, add(number(degree)?, 1)?)?,\n            Charge::Gcd { degree } => {\n                let n = add(number(degree)?, 1)?;\n                add(mul(8, mul(n, n)?)?, mul(128, n)?)?\n            }\n            Charge::Divide { degree } => {\n                let n = add(number(degree)?, 1)?;\n                add(mul(4, mul(n, n)?)?, 128)?\n            }\n            Charge::SplitAssembly { degree } => mul(4, add(number(degree)?, 1)?)?,\n            Charge::Leaf { degree } => match degree {\n                0 => 0,\n                1 => 1,\n                2 => 160,\n                _ => panic!(\"leaf degree must be at most two\"),\n            },\n            Charge::Verify {\n                capacity,\n                output_budget,\n            } => {\n                let beta = number(output_budget)?;\n                add(\n                    mul(add(mul(2, beta)?, 3)?, number(capacity)?)?,\n                    add(beta, 1)?,\n                )?\n            }\n            Charge::Canonicalize { ids } => mul(number(ids)?, add(log2_ceil(ids), 1)?)?,\n        };\n        Ok(WorkUnits(cost))\n    }\n\n    /// Worst proper split tree. For increasing convex node costs, an unbalanced\n    /// chain maximizes their sum: at most one node of each size 3..=r is sufficient\n    /// as a bound. At each node all 64 trace directions and split checks are charged.\n    /// 160*r additionally bounds every possible degree-one/two leaf partition.\n    #[inline(always)]\n    pub(crate) fn roots_bound(budget: usize) -> Result<WorkUnits, DecodeError> {\n        let r = number(budget)?;\n        let leaves = mul(160, r)?;\n        if budget < 3 {\n            return Ok(WorkUnits(leaves));\n        }\n        // Expanding one node's exact table gives 12812*d^2 + 17486*d + 16968.\n        // Closed sums keep request admission O(B), independent of algebraic degree.\n        let next = add(r, 1)?;\n        let squares = mul(mul(r, next)?, add(mul(2, r)?, 1)?)? / 6;\n        let linear = mul(r, next)? / 2;\n        let squares = squares\n            .checked_sub(5)\n            .ok_or(DecodeError::WorkLimitExceeded)?;\n        let linear = linear\n            .checked_sub(3)\n            .ok_or(DecodeError::WorkLimitExceeded)?;\n        let nodes = r.checked_sub(2).ok_or(DecodeError::WorkLimitExceeded)?;\n        let total = add(\n            add(mul(12812, squares)?, mul(17486, linear)?)?,\n            mul(16968, nodes)?,\n        )?;\n        Ok(WorkUnits(add(leaves, total)?))\n    }\n\n    #[inline(always)]\n    pub(crate) fn row_bound(\n        capacity: usize,\n        budget: usize,\n        beta: usize,\n        candidates: usize,\n    ) -> Result<WorkUnits, DecodeError> {\n        let fixed = sum_costs(&[\n            Charge::Compare { capacity },\n            Charge::Reconstruct { capacity },\n            Charge::Candidates {\n                degree: budget,\n                inputs: candidates,\n            },\n            Charge::Deflate { degree: budget },\n            Charge::Verify {\n                capacity,\n                output_budget: beta,\n            },\n            Charge::Canonicalize { ids: beta },\n        ])?;\n        let bm = mul(\n            mul(2, number(capacity)?)?,\n            Self::cost(Charge::BmStep { budget })?.0,\n        )?;\n        Ok(WorkUnits(add(\n            add(fixed, bm)?,\n            Self::roots_bound(budget)?.0,\n        )?))\n    }\n}\n\npub(crate) struct WorkScheduleV2;\n\nimpl WorkScheduleV2 {\n    #[inline(always)]\n    pub(crate) fn row_bound(\n        capacity: usize,\n        budget: usize,\n        beta: usize,\n        candidates: usize,\n    ) -> Result<WorkUnits, DecodeError> {\n        let mut bound = WorkScheduleV1::row_bound(capacity, budget, beta, candidates)?.0;\n        let verify = WorkScheduleV1::cost(Charge::Verify {\n            capacity,\n            output_budget: beta,\n        })?\n        .0;\n        if budget >= 1 {\n            bound = add(\n                bound,\n                add(WorkScheduleV1::cost(Charge::DirectOne)?.0, verify)?,\n            )?;\n        }\n        if capacity >= 2 && budget >= 2 {\n            bound = add(\n                bound,\n                add(WorkScheduleV1::cost(Charge::DirectTwo)?.0, verify)?,\n            )?;\n        }\n        Ok(WorkUnits(bound))\n    }\n}\n\n#[inline(always)]\nfn square_mod(degree: usize) -> Result<u64, DecodeError> {\n    add(mul(3, square(degree)?)?, mul(2, number(degree)?)?)\n}\n#[inline(always)]\nfn square(n: usize) -> Result<u64, DecodeError> {\n    mul(number(n)?, number(n)?)\n}\n#[inline(always)]\npub(crate) fn number(n: usize) -> Result<u64, DecodeError> {\n    u64::try_from(n).map_err(|_| DecodeError::WorkLimitExceeded)\n}\n#[inline(always)]\npub(crate) fn add(a: u64, b: u64) -> Result<u64, DecodeError> {\n    a.checked_add(b).ok_or(DecodeError::WorkLimitExceeded)\n}\n#[inline(always)]\nfn mul(a: u64, b: u64) -> Result<u64, DecodeError> {\n    a.checked_mul(b).ok_or(DecodeError::WorkLimitExceeded)\n}\n#[inline(always)]\nfn sum_costs(charges: &[Charge]) -> Result<u64, DecodeError> {\n    charges\n        .iter()\n        .try_fold(0, |n, &c| add(n, WorkScheduleV1::cost(c)?.0))\n}\n#[inline(always)]\nfn log2_ceil(n: usize) -> u64 {\n    if n <= 1 {\n        0\n    } else {\n        u64::from(usize::BITS - (n - 1).leading_zeros())\n    }\n}\n\n/// Proposed V3 reserves extra affine stages and the larger general verifier.\npub(crate) struct WorkScheduleV3;\nimpl WorkScheduleV3 {\n    #[inline(always)]\n    pub(crate) fn row_bound(\n        capacity: usize,\n        budget: usize,\n        beta: usize,\n        candidates: usize,\n    ) -> Result<WorkUnits, DecodeError> {\n        let mut bound = WorkScheduleV2::row_bound(capacity, budget, beta, candidates)?.0;\n        let original = WorkScheduleV1::cost(Charge::Verify {\n            capacity,\n            output_budget: beta,\n        })?\n        .0;\n        let rebuilt = WorkScheduleV1::cost(Charge::VerifyLfsr {\n            capacity,\n            output_budget: beta,\n            degree: budget,\n        })?\n        .0;\n        bound = add(bound, rebuilt.max(original) - original)?;\n        // The maximum is const-derived from the operation predictor, never a\n        // tuned admission parameter. Each new charge is monotone in d/rank.\n        let d = budget.min(super::affine::MAX_PREFERRED_DEGREE);\n        if d >= 3 {\n            let setup = WorkScheduleV1::cost(Charge::AffinePreparation { degree: d })?.0;\n            let enumeration = WorkScheduleV1::cost(Charge::AffineEnumeration {\n                degree: d,\n                rank: d - 1,\n            })?\n            .0;\n            let split = WorkScheduleV1::cost(Charge::AffineSplit {\n                degree: d,\n                rank: d - 1,\n            })?\n            .0;\n            let attempts = mul(number(d)?, number(d - 2)?)?;\n            bound = add(bound, add(setup, enumeration.max(mul(attempts, split)?))?)?;\n        }\n        // Retain all integrated affine/LFSR fallback work, then add the degree-3/4 guards and leaves.\n        if capacity >= 3 && budget >= 3 {\n            bound = add(bound, add(863, original)?)?;\n        }\n        if capacity >= 4 && budget >= 4 {\n            bound = add(bound, add(2337, original)?)?;\n        }\n        bound = add(\n            bound,\n            add(\n                mul(671, number(budget / 3)?)?,\n                mul(2097, number(budget / 4)?)?,\n            )?,\n        )?;\n        Ok(WorkUnits(bound))\n    }\n}\n"},{"id":6,"name":{"Local":"src/decode/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical-row decoding; no sketch/shape/wire or public arena dependencies.\n#![forbid(unsafe_code)]\n\npub(crate) mod row;\npub(crate) mod scratch;\npub(crate) mod work;\n\nmod bm;\n#[cfg(test)]\nmod bm_tests;\npub(crate) mod direct;\n\nmod affine;\nmod deg34;\nmod degree_probe;\npub(crate) mod probe;\nmod roots;\npub(crate) mod stages;\nmod verify;\n\n#[cfg(test)]\nmod row_tests;\n"},{"id":7,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"src/types.rs"},"crate_name":"bulksketch","contents":"//! Value-only definitions; this module has no dependency on the engine layers.\n#![forbid(unsafe_code)]\n\n/// Polynomial-basis identity, including the irreducible polynomial.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[repr(u8)]\npub enum FieldId {\n    /// GF(2^64), modulus Z^64 + Z^4 + Z^3 + Z + 1, bit i is Z^i.\n    Gf64 = 1,\n}\n\n/// Shape admission failure, before any row storage is allocated.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ShapeError {\n    /// Unsupported field, zero/non-power-of-two row count, or zero capacity.\n    InvalidShape,\n    /// Configured storage/dimension cap or representable wire dimension exceeded.\n    InputLimitExceeded,\n}\n\n/// Bounded wire admission failure. No view is exposed on either error.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ParseError {\n    /// A caller-supplied byte or dimension limit was exceeded.\n    InputLimitExceeded,\n    /// Unknown metadata, malformed lengths, or noncanonical payload.\n    InvalidEncoding,\n}\n\nimpl std::fmt::Display for ShapeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InvalidShape => \"invalid sketch shape\",\n            Self::InputLimitExceeded => \"shape input limit exceeded\",\n        })\n    }\n}\nimpl std::error::Error for ShapeError {}\n\nimpl std::fmt::Display for ParseError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InputLimitExceeded => \"wire input limit exceeded\",\n            Self::InvalidEncoding => \"invalid sketch encoding\",\n        })\n    }\n}\nimpl std::error::Error for ParseError {}\n\n/// Runtime arithmetic capability. No complete-operation dispatch lives in this type.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub enum BackendId {\n    /// Always-available safe Rust arithmetic.\n    Portable,\n    /// Scalar x86 carryless multiplication.\n    Pclmul,\n    /// 256-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul256,\n    /// 512-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul512,\n}\n\n/// Backend selection requested at engine construction, before any decode.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum BackendRequest {\n    /// Select from capabilities detected at runtime.\n    Auto,\n    /// Require this capability; never bypass feature/OS-state validation.\n    Force(BackendId),\n}\n\n/// An explicitly requested backend is unavailable in this build or on this CPU/OS.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct BackendError(pub BackendId);\n\n/// Construction of mutable state failed before any state was returned.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CreateError {\n    /// The requested arithmetic implementation is unavailable.\n    Backend(BackendError),\n    /// The algebraic buffers could not be reserved.\n    AllocationFailed,\n}\n\n/// Batch insertion failed before changing the sketch.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum UpdateError {\n    /// The supplied insertion arena cannot hold this call's IDs or row offsets.\n    ScratchTooSmall,\n}\n\n/// XOR requires identical fields, row counts and capacities.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ShapeMismatch;\n\n/// Encoding failed without changing the destination or algebraic state.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum EncodeError {\n    /// The destination cannot hold the complete record.\n    BufferTooSmall,\n    /// The cached record could not be reserved.\n    AllocationFailed,\n}\n\nimpl std::fmt::Display for CreateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            Self::Backend(error) => error.fmt(f),\n            Self::AllocationFailed => f.write_str(\"sketch allocation failed\"),\n        }\n    }\n}\nimpl std::error::Error for CreateError {}\nimpl std::fmt::Display for UpdateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"insertion scratch is too small\")\n    }\n}\nimpl std::error::Error for UpdateError {}\nimpl std::fmt::Display for ShapeMismatch {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"sketch shapes differ\")\n    }\n}\nimpl std::error::Error for ShapeMismatch {}\nimpl std::fmt::Display for EncodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::BufferTooSmall => \"encoding buffer is too small\",\n            Self::AllocationFailed => \"encoding allocation failed\",\n        })\n    }\n}\nimpl std::error::Error for EncodeError {}\n\nimpl std::fmt::Display for BackendError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        write!(f, \"backend {:?} is unavailable\", self.0)\n    }\n}\nimpl std::error::Error for BackendError {}\n\n/// Backend-independent logical work, never elapsed time or instruction count.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]\npub struct WorkUnits(pub u64);\n\n/// A request-wide failure publishes no row report or provisional IDs.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeError {\n    /// Local and remote fields, row counts or capacities differ.\n    ShapeMismatch,\n    /// Unknown plan or an output budget larger than any row capacity.\n    InvalidPlan,\n    /// Raw candidate count exceeds the request cap, before normalization.\n    CandidateLimitExceeded,\n    /// Work arithmetic overflows or the next charge exceeds the request limit.\n    WorkLimitExceeded,\n    /// Layout overflows, exceeds its byte cap, or any supplied segment is short.\n    ScratchTooSmall,\n}\n\n/// An admitted row failed algebraically; independently successful rows remain usable.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeFailure {\n    /// Zero consumes an unavailable slot, or locator/final output exceeds beta.\n    DegreeExceedsBudget,\n    /// The locator fails required canonicality/algebraic validation.\n    InvalidLocator,\n    /// The locator does not split into distinct permitted field roots.\n    NotSplit,\n    /// Re-encoding fails any stored odd syndrome or the zero channel.\n    VerificationFailed,\n}\n\nimpl std::fmt::Display for DecodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::ShapeMismatch => \"sketch shapes differ\",\n            Self::InvalidPlan => \"invalid decode plan or output budget\",\n            Self::CandidateLimitExceeded => \"candidate input limit exceeded\",\n            Self::WorkLimitExceeded => \"decode work limit exceeded\",\n            Self::ScratchTooSmall => \"decode scratch is too small\",\n        })\n    }\n}\nimpl std::error::Error for DecodeError {}\n\n/// Deterministic stage order. Repeated trace/GCD/division/leaf stages follow factor traversal.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Stage {\n    /// Propose the nonzero root S1 before general decoding.\n    DirectOne,\n    /// Derive a distinct nonzero pair from S1 and S3 before general decoding.\n    DirectTwo,\n    /// Reject inconsistent cubic prefixes before inversion (V3).\n    GuardThree,\n    /// Normalize a passed cubic Newton guard (V3).\n    NewtonThree,\n    /// Reject inconsistent quartic prefixes before inversion (V3).\n    GuardFour,\n    /// Normalize a passed quartic Newton guard (V3).\n    NewtonFour,\n    /// Propose the roots of a cubic factor (V3).\n    LeafThree,\n    /// Propose the roots of a quartic factor (V3).\n    LeafFour,\n    /// Certify a complete distinct nonzero factor root set (V3).\n    FactorVerification,\n    /// Expand odd syndromes and reconstruct even powers.\n    Reconstruction,\n    /// Binary Berlekamp-Massey iterations.\n    BerlekampMassey,\n    /// Evaluate the original locator at normalized hints.\n    CandidateEvaluation,\n    /// Divide out confirmed candidate roots.\n    Deflation,\n    /// Build a factor's modular-square table.\n    ReducerPreparation,\n    /// Find the least affine multiple and solve its binary map (V3).\n    AffinePreparation,\n    /// Enumerate and evaluate the recovered affine solution coset (V3).\n    AffineEnumeration,\n    /// Form an annihilator splitter for the current affine coset (V3).\n    AffineSplit,\n    /// Try the next canonical trace direction and the internal split check.\n    Trace,\n    /// Compute a monic polynomial GCD.\n    Gcd,\n    /// Divide a factor exactly after a proper split.\n    FactorDivision,\n    /// Solve degree-one or degree-two leaves.\n    Leaf,\n    /// Verify every stored odd syndrome by re-encoding or rebuilt recurrence.\n    Verification,\n    /// Sort and validate the final original IDs.\n    Canonicalization,\n}\n\n/// Public stage progress contains no row outcome or provisional ID.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum StageProgress {\n    /// A deterministic stage completed; counters are cumulative for the request.\n    Completed {\n        /// Bucket whose stage completed, in deterministic request traversal order.\n        bucket: usize,\n        /// Stage just executed.\n        stage: Stage,\n        /// Logical work consumed so far.\n        work: WorkUnits,\n        /// Peak required workspace bytes, excluding unused arena capacity.\n        peak_scratch_bytes: usize,\n        /// Original BM locator degree for this row; zero until BM completes.\n        locator_degree: usize,\n        /// Confirmed candidate roots so far in this row.\n        candidate_hits: usize,\n        /// Trace directions attempted so far in this row.\n        trace_attempts: usize,\n        /// Degree returned by this row's most recent GCD; zero before the first GCD.\n        gcd_degree: usize,\n    },\n    /// Terminal request failure; finishing the job must return this error.\n    Failed(DecodeError),\n}\n\n/// Internal arithmetic product, distinct from a canonical field element.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub(crate) struct RawProduct {\n    pub(crate) lo: u64,\n    pub(crate) hi: u64,\n}\n\n/// One request meter, shared by preprocessing and all rows. A failed charge is terminal.\n#[derive(Debug)]\npub(crate) struct WorkMeter {\n    limit: WorkUnits,\n    used: WorkUnits,\n    exhausted: bool,\n}\n\nimpl WorkMeter {\n    pub(crate) fn new(limit: WorkUnits) -> Self {\n        Self {\n            limit,\n            used: WorkUnits(0),\n            exhausted: false,\n        }\n    }\n\n    pub(crate) fn charge(&mut self, charge: WorkUnits) -> Result<(), DecodeError> {\n        let next = self.used.0.checked_add(charge.0);\n        if self.exhausted || next.is_none_or(|n| n > self.limit.0) {\n            self.exhausted = true;\n            return Err(DecodeError::WorkLimitExceeded);\n        }\n        self.used = WorkUnits(next.expect(\"checked work charge\"));\n        Ok(())\n    }\n\n    pub(crate) fn used(&self) -> WorkUnits {\n        self.used\n    }\n}\n\n#[cfg(test)]\npub(crate) mod small_degree_observer;\n"},{"id":13,"name":{"Local":"/rustc/library/core/src/ops/c