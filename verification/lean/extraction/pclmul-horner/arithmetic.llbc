      maps::trace::<F>(a)\n    }\n\n    fn solve_quadratic(a: u64) -> Option<u64> {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { solve_quadratic::<F>(a) }\n    }\n\n    fn raw_mul(a: u64, b: u64) -> RawProduct {\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { raw_product(a, b) }\n    }\n\n    fn reduce(product: RawProduct) -> u64 {\n        gf64::reduce::<F>(product)\n    }\n\n    #[cfg(test)]\n    fn dot(a: &[u64], b: &[u64]) -> u64 {\n        assert_eq!(a.len(), b.len(), \"dot length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { dot::<F, false>(a, b) }\n    }\n\n    fn scale_xor(dst: &mut [u64], src: &[u64], scale: u64) {\n        assert_eq!(dst.len(), src.len(), \"scale_xor length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { scale_xor::<F, true>(dst, src, scale) }\n    }\n\n    fn square_slice(dst: &mut [u64], src: &[u64]) {\n        assert_eq!(dst.len(), src.len(), \"square_slice length mismatch\");\n        // SAFETY: this backend is reachable only through checked dispatch.\n        unsafe { square_slice::<F, true>(dst, src) }\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":35},{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":404},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":13}],"const_generics":[