ent":""},{"DocComment":" **Hint**: If you're having trouble remembering how to phrase expect"},{"DocComment":" error messages remember to focus on the word \"should\" as in \"env"},{"DocComment":" variable should be set by blah\" or \"the given binary should be available"},{"DocComment":" and executable by the current user\"."},{"DocComment":""},{"DocComment":" For more detail on expect message styles and the reasoning behind our recommendation please"},{"DocComment":" refer to the section on [\"Common Message"},{"DocComment":" Styles\"](../../std/error/index.html#common-message-styles) in the"},{"DocComment":" [`std::error`](../../std/error/index.html) module docs."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":34,"beg":{"line":1176,"col":4},"end":{"line":1176,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"E","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[572,{"data":{"file_id":34,"beg":{"line":1180,"col":11},"end":{"line":1180,"col":21}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":16}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[435,{"Adt":{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":13},{"Deduplicated":16}],"const_generics":[],"trait_refs":[]},"builtin":null}}]},{"Value":[436,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":61},"Shared"]}]}],"output":{"Deduplicated":13}},"src":"Normal","body":"Opaque"},{