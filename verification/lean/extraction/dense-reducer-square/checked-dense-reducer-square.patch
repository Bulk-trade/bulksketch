diff --git a/src/symbolic/SymbolicToPureExpressions.ml b/src/symbolic/SymbolicToPureExpressions.ml
index e9c181a..0fe1a9d 100644
--- a/src/symbolic/SymbolicToPureExpressions.ml
+++ b/src/symbolic/SymbolicToPureExpressions.ml
@@ -9,6 +9,43 @@ open SymbolicToPureAbs
 (** The local logger *)
 let log = Logging.symbolic_to_pure_expressions_log
 
+(** Checked erasure of a level-one loop ending with no pure continuation.
+    Inspect child payload types directly because the ordinary projection-kind
+    classifier only classifies their enclosing symbolic value. *)
+let can_erase_shared_loop_end type_infos ~ignored ~has_continuation
+    (abs : V.abs) (level : V.abs_level) : bool =
+  !Config.sanity_checks && level = 1 && ignored && not has_continuation
+  && V.AbsLevelSet.mem level abs.ended_subabs
+  && (match (abs.kind, abs.cont) with
+      | ( V.Loop loop_id,
+          Some { output = Some output;
+                 input = Some { value = V.EApp (V.ELoop (aid, lid), [[]]); ty } } ) ->
+          aid = abs.abs_id && lid = loop_id && ty = TypesUtils.mk_unit_ty
+          && V.equal_tevalue output (ValuesUtils.mk_etuple ~borrow_proj:true [])
+      | _ -> false)
+  &&
+  let shared ty =
+    TypesUtils.ty_is_rty ty
+    && not (TypesUtils.ty_has_mut_borrow_for_region_in_set type_infos abs.regions.owned ty)
+  in
+  let rec projection ~top = function
+    | V.AEmpty -> true
+    | V.AProjLoans { proj; consumed; borrows } when top ->
+        shared proj.proj_ty && payloads consumed && payloads borrows
+    | V.AProjBorrows { proj; loans } when top -> shared proj.proj_ty && payloads loans
+    | V.AProjLoans _ | V.AProjBorrows _ -> false
+    | V.AEndedProjLoans { consumed; borrows; _ } -> payloads consumed && payloads borrows
+    | V.AEndedProjBorrows { mvalues; loans } ->
+        shared mvalues.given_back.sv_ty && payloads loans
+  and payloads children =
+    List.for_all (fun ((meta : V.mconsumed_symb), child) ->
+        shared meta.proj_ty && projection ~top:false child) children
+  in
+  List.for_all (fun (av : V.tavalue) ->
+      shared av.ty &&
+      match av.value with V.ASymbolic (V.PNone, proj) -> projection ~top:true proj | _ -> false)
+    abs.avalues
+
 let translate_fn_ptr_kind (ctx : bs_ctx) (id : A.fn_ptr_kind) : fn_ptr_kind =
   match id with
   | T.Fun fun_id -> FunId fun_id
@@ -1284,7 +1321,12 @@ and translate_end_abstraction_synth_ret (ectx : C.eval_ctx) (abs : V.abs)
 
