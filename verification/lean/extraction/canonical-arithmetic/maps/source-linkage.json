      "source_fragment": "pub(crate) fn trace<F: BinaryField>(a: u64) -> u8 {\n    debug_assert_eq!(a & !F::MASK, 0, \"noncanonical field operand\");\n    if F::BITS == 64 {\n        // Only Z^61 and Z^63 have trace one in this polynomial basis.\n        return u8::try_from(((a >> 61) ^ (a >> 63)) & 1).expect(\"trace is a bit\");\n    }\n    canonical_trace::<F>(a)\n}",
      "source_fragment_sha256": "e5285815c43abf50be14960809165e3b1020154efc61bd166fdc2caa94a84b2c",
      "snapshot": "extraction/canonical-arithmetic/maps/trace-source.rs.txt",
