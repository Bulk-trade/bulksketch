      "source_fragment": "pub(super) fn quadratic_rows<F: BinaryField>() -> &'static [u64] {\n    match F::BITS {\n        64 => &GF64_QUADRATIC,\n        #[cfg(test)]\n        2 => &GF4_QUADRATIC,\n        #[cfg(test)]\n        4 => &GF16_QUADRATIC,\n        #[cfg(test)]\n        8 => &GF256_QUADRATIC,\n        #[cfg(test)]\n        16 => &GF65536_QUADRATIC,\n        _ => unreachable!(\"sealed field has no quadratic map\"),\n    }\n}",
