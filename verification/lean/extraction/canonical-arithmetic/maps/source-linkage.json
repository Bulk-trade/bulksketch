      "source_fragment": "pub(crate) fn quadratic_value<F: BinaryField>(a: u64) -> u64 {\n    if F::BITS == 64 {\n        let mut remaining = a;\n        let mut value = 0;\n        for table in &super::quadratic_chunks::GF64_QUADRATIC_CHUNKS {\n            let index = usize::try_from(remaining & 15).expect(\"nibble index\");\n            value ^= table[index];\n            remaining >>= 4;\n        }\n        return value;\n    }\n    let mut z = 0;\n    for (bit, &row) in quadratic_rows::<F>().iter().enumerate() {\n        z |= u64::from((row & a).count_ones() & 1) << bit;\n    }\n    z\n}",
      "source_fragment_sha256": "4beb0c71dbd67a8357a19931958a5d63575af2f89a6455c7c5a6b5516760323d",
      "snapshot": "extraction/canonical-arithmetic/maps/quadratic_value-source.rs.txt",
