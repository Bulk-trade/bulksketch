      "source_fragment": "pub(crate) fn solve_quadratic<F: BinaryField>(a: u64) -> Option<u64> {\n    if trace::<F>(a) != 0 {\n        return None;\n    }\n    let z = quadratic_value::<F>(a);\n    assert_eq!(gf64::square::<F>(z) ^ z, a, \"quadratic-map invariant\");\n    Some(z)\n}",
