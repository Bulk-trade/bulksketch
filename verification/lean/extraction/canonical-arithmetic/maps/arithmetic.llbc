""},{"DocComment":" ```rust"},{"DocComment":" use std::fmt::{self, write};"},{"DocComment":""},{"DocComment":" let mut output = String::new();"},{"DocComment":" if let Err(fmt::Error) = write(&mut output, format_args!(\"Hello {}!\", \"world\")) {"},{"DocComment":"     panic!(\"An error occurred\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[]},"layout":[{"key":"aarch64-apple-darwin","value":{"size":{"chosen":{"Deduplicated":0},"guarantee":{"Deduplicated":13}},"align":{"chosen":{"Deduplicated":1},"guarantee":{"Deduplicated":14}},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":20,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["iter",0]},{"Ident":["IntoIter",0]}],"span":{"Untagged":{"data":{"file_id":37,"beg":{"line":20,"col":0},"end":{"line":20,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A by-value [array] iterator."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"ArrayIntoIter","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","l