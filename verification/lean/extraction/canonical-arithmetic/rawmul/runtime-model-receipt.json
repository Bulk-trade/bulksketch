      "source_fragment": "pub(crate) fn raw_mul<F: BinaryField>(a: u64, b: u64) -> RawProduct {\n    debug_assert_eq!((a | b) & !F::MASK, 0, \"noncanonical field operand\");\n    let mut multiples = [0_u128; 16];\n    for i in 1_usize..16 {\n        multiples[i] = multiples[i & (i - 1)] ^ (u128::from(a) << i.trailing_zeros());\n    }\n    let mut product = 0_u128;\n    for shift in (0..F::BITS).step_by(4) {\n        product ^= multiples[((b >> shift) & 15) as usize] << shift;\n    }\n    RawProduct {\n        lo: product as u64,\n        hi: (product >> 64) as u64,\n    }\n}",
      "source_fragment_sha256": "8df36602b0541c1322385a1e83b61394bfaaf4eebe27aea9289a0d5f036e841b",
      "snapshot": "extraction/canonical-arithmetic/rawmul/raw_mul-source.rs.txt",
