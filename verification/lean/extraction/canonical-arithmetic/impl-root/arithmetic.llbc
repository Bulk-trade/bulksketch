{"charon_version":"0.1.304","translated":{"crate_name":"bulksketch","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["bulksketch::field::gf64::square","{impl bulksketch::field::BinaryField for bulksketch::field::Gf64}"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/workspace/bulk/bulksketch/verification/lean/extraction/canonical-arithmetic/impl-root/arithmetic.llbc","no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"aarch64-apple-darwin","value":{"arch":"AArch64","vendor":"apple","os":"MacOs","env":"Unspecified","cfg_abi":"Unspecified","target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bulksketch","contents":"//! Native binary-syndrome reconciliation with bounded, deterministic GF64 decoding.\n#![deny(unsafe_code)]\n#![warn(missing_docs)]\n\nmod backend;\nmod decode;\nmod field;\nmod poly;\nmod sketch;\nmod types;\n\npub use {\n    field::{BinaryField, Gf64},\n    sketch::{\n        DecodeJob, DecodeLimits, DecodeOutcome, DecodePlan, DecodeReport, DecodeRequest, DecodeRow,\n        DecodeRowsRequest, DecodeScratch, Decoder, FrozenSketch, InsertScratch, MutableSketch,\n        ParseLimits, ScratchLayout, ShapeLimits, SketchShape, SketchView, decode_into,\n        decode_rows_into,\n    },\n    types::{\n        BackendError, BackendId, BackendRequest, CreateError, DecodeError, DecodeFailure,\n        EncodeError, FieldId, ParseError, ShapeError, ShapeMismatch, Stage, StageProgress,\n        UpdateError, WorkUnits,\n    },\n};\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"src/field/mod.rs"},"crate_name":"bulksketch","contents":"//! Canonical field identity, arithmetic and test-only tiny fields.\n#![forbid(unsafe_code)]\n\nuse crate::types::FieldId;\n\n#[cfg(test)]\npub(crate) mod arithmetic_tests;\n#[cfg(test)]\nmod constant_tests;\n#[cfg(any(target_arch = \"x86_64\", test))]\npub(crate) mod frobenius;\npub(crate) mod gf64;\npub(crate) mod maps;\nmod quadratic_chunks;\n#[cfg(test)]\npub(crate) mod reference;\n#[cfg(test)]\npub(crate) mod tiny;\n\npub(crate) mod sealed {\n    pub trait Sealed {}\n}\n\n/// Closed field specification. Kernels consume canonical words, never masked IDs.\npub trait BinaryField: sealed::Sealed + Copy + Eq + Send + Sync + 'static {\n    /// Extension degree over GF(2).\n    const BITS: u32;\n    /// Irreducible polynomial without its leading term.\n    const MODULUS_LOW: u64;\n    /// Registered polynomial/basis identity.\n    const WIRE_ID: FieldId;\n    /// Canonical element mask.\n    const MASK: u64;\n}\n\n/// Full-width GF(2^64) identity field.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub struct Gf64;\nimpl sealed::Sealed for Gf64 {}\nimpl BinaryField for Gf64 {\n    const BITS: u32 = 64;\n    const MODULUS_LOW: u64 = 0x1b;\n    const WIRE_ID: FieldId = FieldId::Gf64;\n    const MASK: u64 = u64::MAX;\n}\n"},{"id":6,"name":{"Local":"src/field/gf64.rs"},"crate_name":"bulksketch","contents":"//! Safe portable arithmetic on canonical polynomial-basis words.\n#![forbid(unsafe_code)]\n\nuse crate::{field::BinaryField, types::RawProduct};\n\n#[must_use]\n#[expect(\n    clippy::cast_possible_truncation,\n    reason = \"split a polynomial into its low and high words\"\n)]\n#[inline]\npub(crate) fn raw_mul<F: BinaryField>(a: u64, b: u64) -> RawProduct {\n    debug_assert_eq!((a | b) & !F::MASK, 0, \"noncanonical field operand\");\n    let mut multiples = [0_u128; 16];\n    for i in 1_usize..16 {\n        multiples[i] = multiples[i & (i - 1)] ^ (u128::from(a) << i.trailing_zeros());\n    }\n    let mut product = 0_u128;\n    for shift in (0..F::BITS).step_by(4) {\n        product ^= multiples[((b >> shift) & 15) as usize] << shift;\n    }\n    RawProduct {\n        lo: product as u64,\n        hi: (product >> 64) as u64,\n    }\n}\n\n/// Accepts every 128-bit polynomial, including XOR accumulators of raw products.\n#[must_use]\npub(crate) fn reduce<F: BinaryField>(product: RawProduct) -> u64 {\n    if F::BITS == 64 {\n        // Z^64 = Z^4+Z^3+Z+1. The first fold overflows by at most four bits;\n        // folding those again has degree at most seven, so it cannot overflow.\n        let high = product.hi;\n        let overflow = (high >> 63) ^ (high >> 61) ^ (high >> 60);\n        product.lo\n            ^ high\n            ^ (high << 1)\n            ^ (high << 3)\n            ^ (high << 4)\n            ^ overflow\n            ^ (overflow << 1)\n            ^ (overflow << 3)\n            ^ (overflow << 4)\n    } else {\n        let mut remainder = 0;\n        for word in [product.hi, product.lo] {\n            for bit in (0..64).rev() {\n                let carry = remainder >> (F::BITS - 1);\n                remainder = ((remainder << 1) & F::MASK) | ((word >> bit) & 1);\n                remainder ^= F::MODULUS_LOW & 0_u64.wrapping_sub(carry);\n            }\n        }\n        remainder\n    }\n}\n\n#[must_use]\npub(crate) fn mul<F: BinaryField>(a: u64, b: u64) -> u64 {\n    reduce::<F>(raw_mul::<F>(a, b))\n}\n\nfn spread(mut word: u64) -> u64 {\n    word &= 0xffff_ffff;\n    word = (word | (word << 16)) & 0x0000_ffff_0000_ffff;\n    word = (word | (word << 8)) & 0x00ff_00ff_00ff_00ff;\n    word = (word | (word << 4)) & 0x0f0f_0f0f_0f0f_0f0f;\n    word = (word | (word << 2)) & 0x3333_3333_3333_3333;\n    (word | (word << 1)) & 0x5555_5555_5555_5555\n}\n\n#[must_use]\npub(crate) fn square<F: BinaryField>(a: u64) -> u64 {\n    debug_assert_eq!(a & !F::MASK, 0, \"noncanonical field operand\");\n    reduce::<F>(RawProduct {\n        lo: spread(a),\n        hi: spread(a >> 32),\n    })\n}\n\n#[must_use]\npub(crate) fn frobenius<F: BinaryField>(mut a: u64, power: u32) -> u64 {\n    debug_assert_eq!(a & !F::MASK, 0, \"noncanonical field operand\");\n    for _ in 0..power % F::BITS {\n        a = square::<F>(a);\n    }\n    a\n}\n"},{"id":7,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/macros/mod.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/panicking.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"src/types.rs"},"crate_name":"bulksketch","contents":"//! Value-only definitions; this module has no dependency on the engine layers.\n#![forbid(unsafe_code)]\n\n/// Polynomial-basis identity, including the irreducible polynomial.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[repr(u8)]\npub enum FieldId {\n    /// GF(2^64), modulus Z^64 + Z^4 + Z^3 + Z + 1, bit i is Z^i.\n    Gf64 = 1,\n}\n\n/// Shape admission failure, before any row storage is allocated.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ShapeError {\n    /// Unsupported field, zero/non-power-of-two row count, or zero capacity.\n    InvalidShape,\n    /// Configured storage/dimension cap or representable wire dimension exceeded.\n    InputLimitExceeded,\n}\n\n/// Bounded wire admission failure. No view is exposed on either error.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum ParseError {\n    /// A caller-supplied byte or dimension limit was exceeded.\n    InputLimitExceeded,\n    /// Unknown metadata, malformed lengths, or noncanonical payload.\n    InvalidEncoding,\n}\n\nimpl std::fmt::Display for ShapeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InvalidShape => \"invalid sketch shape\",\n            Self::InputLimitExceeded => \"shape input limit exceeded\",\n        })\n    }\n}\nimpl std::error::Error for ShapeError {}\n\nimpl std::fmt::Display for ParseError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::InputLimitExceeded => \"wire input limit exceeded\",\n            Self::InvalidEncoding => \"invalid sketch encoding\",\n        })\n    }\n}\nimpl std::error::Error for ParseError {}\n\n/// Runtime arithmetic capability. No complete-operation dispatch lives in this type.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\npub enum BackendId {\n    /// Always-available safe Rust arithmetic.\n    Portable,\n    /// Scalar x86 carryless multiplication.\n    Pclmul,\n    /// 256-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul256,\n    /// 512-bit vector carryless multiplication, with CPU and OS state checked.\n    Vpclmul512,\n}\n\n/// Backend selection requested at engine construction, before any decode.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum BackendRequest {\n    /// Select from capabilities detected at runtime.\n    Auto,\n    /// Require this capability; never bypass feature/OS-state validation.\n    Force(BackendId),\n}\n\n/// An explicitly requested backend is unavailable in this build or on this CPU/OS.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct BackendError(pub BackendId);\n\n/// Construction of mutable state failed before any state was returned.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CreateError {\n    /// The requested arithmetic implementation is unavailable.\n    Backend(BackendError),\n    /// The algebraic buffers could not be reserved.\n    AllocationFailed,\n}\n\n/// Batch insertion failed before changing the sketch.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum UpdateError {\n    /// The supplied insertion arena cannot hold this call's IDs or row offsets.\n    ScratchTooSmall,\n}\n\n/// XOR requires identical fields, row counts and capacities.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ShapeMismatch;\n\n/// Encoding failed without changing the destination or algebraic state.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum EncodeError {\n    /// The destination cannot hold the complete record.\n    BufferTooSmall,\n    /// The cached record could not be reserved.\n    AllocationFailed,\n}\n\nimpl std::fmt::Display for CreateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            Self::Backend(error) => error.fmt(f),\n            Self::AllocationFailed => f.write_str(\"sketch allocation failed\"),\n        }\n    }\n}\nimpl std::error::Error for CreateError {}\nimpl std::fmt::Display for UpdateError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"insertion scratch is too small\")\n    }\n}\nimpl std::error::Error for UpdateError {}\nimpl std::fmt::Display for ShapeMismatch {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(\"sketch shapes differ\")\n    }\n}\nimpl std::error::Error for ShapeMismatch {}\nimpl std::fmt::Display for EncodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::BufferTooSmall => \"encoding buffer is too small\",\n            Self::AllocationFailed => \"encoding allocation failed\",\n        })\n    }\n}\nimpl std::error::Error for EncodeError {}\n\nimpl std::fmt::Display for BackendError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        write!(f, \"backend {:?} is unavailable\", self.0)\n    }\n}\nimpl std::error::Error for BackendError {}\n\n/// Backend-independent logical work, never elapsed time or instruction count.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]\npub struct WorkUnits(pub u64);\n\n/// A request-wide failure publishes no row report or provisional IDs.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeError {\n    /// Local and remote fields, row counts or capacities differ.\n    ShapeMismatch,\n    /// Unknown plan or an output budget larger than any row capacity.\n    InvalidPlan,\n    /// Raw candidate count exceeds the request cap, before normalization.\n    CandidateLimitExceeded,\n    /// Work arithmetic overflows or the next charge exceeds the request limit.\n    WorkLimitExceeded,\n    /// Layout overflows, exceeds its byte cap, or any supplied segment is short.\n    ScratchTooSmall,\n}\n\n/// An admitted row failed algebraically; independently successful rows remain usable.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum DecodeFailure {\n    /// Zero consumes an unavailable slot, or locator/final output exceeds beta.\n    DegreeExceedsBudget,\n    /// The locator fails required canonicality/algebraic validation.\n    InvalidLocator,\n    /// The locator does not split into distinct permitted field roots.\n    NotSplit,\n    /// Re-encoding fails any stored odd syndrome or the zero channel.\n    VerificationFailed,\n}\n\nimpl std::fmt::Display for DecodeError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(match self {\n            Self::ShapeMismatch => \"sketch shapes differ\",\n            Self::InvalidPlan => \"invalid decode plan or output budget\",\n            Self::CandidateLimitExceeded => \"candidate input limit exceeded\",\n            Self::WorkLimitExceeded => \"decode work limit exceeded\",\n            Self::ScratchTooSmall => \"decode scratch is too small\",\n        })\n    }\n}\nimpl std::error::Error for DecodeError {}\n\n/// Deterministic stage order. Repeated trace/GCD/division/leaf stages follow factor traversal.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Stage {\n    /// Propose the nonzero root S1 before general decoding.\n    DirectOne,\n    /// Derive a distinct nonzero pair from S1 and S3 before general decoding.\n    DirectTwo,\n    /// Reject inconsistent cubic prefixes before inversion (V3).\n    GuardThree,\n    /// Normalize a passed cubic Newton guard (V3).\n    NewtonThree,\n    /// Reject inconsistent quartic prefixes before inversion (V3).\n    GuardFour,\n    /// Normalize a passed quartic Newton guard (V3).\n    NewtonFour,\n    /// Propose the roots of a cubic factor (V3).\n    LeafThree,\n    /// Propose the roots of a quartic factor (V3).\n    LeafFour,\n    /// Certify a complete distinct nonzero factor root set (V3).\n    FactorVerification,\n    /// Expand odd syndromes and reconstruct even powers.\n    Reconstruction,\n    /// Binary Berlekamp-Massey iterations.\n    BerlekampMassey,\n    /// Evaluate the original locator at normalized hints.\n    CandidateEvaluation,\n    /// Divide out confirmed candidate roots.\n    Deflation,\n    /// Build a factor's modular-square table.\n    ReducerPreparation,\n    /// Find the least affine multiple and solve its binary map (V3).\n    AffinePreparation,\n    /// Enumerate and evaluate the recovered affine solution coset (V3).\n    AffineEnumeration,\n    /// Form an annihilator splitter for the current affine coset (V3).\n    AffineSplit,\n    /// Try the next canonical trace direction and the internal split check.\n    Trace,\n    /// Compute a monic polynomial GCD.\n    Gcd,\n    /// Divide a factor exactly after a proper split.\n    FactorDivision,\n    /// Solve degree-one or degree-two leaves.\n    Leaf,\n    /// Verify every stored odd syndrome by re-encoding or rebuilt recurrence.\n    Verification,\n    /// Sort and validate the final original IDs.\n    Canonicalization,\n}\n\n/// Public stage progress contains no row outcome or provisional ID.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum StageProgress {\n    /// A deterministic stage completed; counters are cumulative for the request.\n    Completed {\n        /// Bucket whose stage completed, in deterministic request traversal order.\n        bucket: usize,\n        /// Stage just executed.\n        stage: Stage,\n        /// Logical work consumed so far.\n        work: WorkUnits,\n        /// Peak required workspace bytes, excluding unused arena capacity.\n        peak_scratch_bytes: usize,\n        /// Original BM locator degree for this row; zero until BM completes.\n        locator_degree: usize,\n        /// Confirmed candidate roots so far in this row.\n        candidate_hits: usize,\n        /// Trace directions attempted so far in this row.\n        trace_attempts: usize,\n        /// Degree returned by this row's most recent GCD; zero before the first GCD.\n        gcd_degree: usize,\n    },\n    /// Terminal request failure; finishing the job must return this error.\n    Failed(DecodeError),\n}\n\n/// Internal arithmetic product, distinct from a canonical field element.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub(crate) struct RawProduct {\n    pub(crate) lo: u64,\n    pub(crate) hi: u64,\n}\n\n/// One request meter, shared by preprocessing and all rows. A failed charge is terminal.\n#[derive(Debug)]\npub(crate) struct WorkMeter {\n    limit: WorkUnits,\n    used: WorkUnits,\n    exhausted: bool,\n}\n\nimpl WorkMeter {\n    pub(crate) fn new(limit: WorkUnits) -> Self {\n        Self {\n            limit,\n            used: WorkUnits(0),\n            exhausted: false,\n        }\n    }\n\n    pub(crate) fn charge(&mut self, charge: WorkUnits) -> Result<(), DecodeError> {\n        let next = self.used.0.checked_add(charge.0);\n        if self.exhausted || next.is_none_or(|n| n > self.limit.0) {\n            self.exhausted = true;\n            return Err(DecodeError::WorkLimitExceeded);\n        }\n        self.used = WorkUnits(next.expect(\"checked work charge\"));\n        Ok(())\n    }\n\n    pub(crate) fn used(&self) -> WorkUnits {\n        self.used\n    }\n}\n\n#[cfg(test)]\npub(crate) mod small_degree_observer;\n"},{"id":16,"name":{"Local":"/rustc/library/core/src/fmt/num.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/array/iter.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"/rustc/library/core/src/iter/adapters/rev.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/core/src/iter/adapters/mod.rs"},"crate_name":"core","contents":null},{"id":24,"name":{"Local":"/rustc/library/core/src/iter/traits/iterator.rs"},"crate_name":"core","contents":null},{"id":25,"name":{"Local":"/rustc/library/core/src/iter/traits/mod.rs"},"crate_name":"core","contents":null},{"id":26,"name":{"Local":"/rustc/library/core/src/iter/range.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"/rustc/library/core/src/iter/traits/double_ended.rs"},"crate_name":"core","contents":null},{"id":28,"name":{"Local":"/rustc/library/core/src/i