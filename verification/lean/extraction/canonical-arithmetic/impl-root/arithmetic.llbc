 cannot overflow.\n        let high = product.hi;\n        let overflow = (high >> 63) ^ (high >> 61) ^ (high >> 60);\n        product.lo\n            ^ high\n            ^ (high << 1)\n            ^ (high << 3)\n            ^ (high << 4)\n            ^ overflow\n            ^ (overflow << 1)\n            ^ (overflow << 3)\n            ^ (overflow << 4)\n    } else {\n        let mut remainder = 0;\n        for word in [product.hi, product.lo] {\n            for bit in (0..64).rev() {\n                let carry = remainder >> (F::BITS - 1);\n                remainder = ((remainder << 1) & F::MASK) | ((word >> bit) & 1);\n                remainder ^= F::MODULUS_LOW & 0_u64.wrapping_sub(carry);\n            }\n        }\n        remainder\n    }\n}","attr_info":{"attributes":[{"DocComment":" Accepts every 128-bit polynomial, including XOR accumulators of raw products."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[102,{"data":{"file_id":6,"beg":{"line":30,"col":24},"end":{"line":30,"col":35}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":5}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":38}],"output":{"Deduplicated":4}},"src":"Normal","body":{"Structured":{"span":{"Value":[103,{"data":{"file_id":6,"beg":{"line":30,"col":0},"end":{"line":56,"col":1}},"generated_from_span":null}]},"bound_body_regions":14,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"Value":[104,{"data":{"file_id":6,"beg":{"line":30,"col":61},"end":{"line":3