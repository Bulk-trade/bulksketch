      "source_fragment": "pub(crate) fn frobenius<F: BinaryField>(mut a: u64, power: u32) -> u64 {\n    debug_assert_eq!(a & !F::MASK, 0, \"noncanonical field operand\");\n    for _ in 0..power % F::BITS {\n        a = square::<F>(a);\n    }\n    a\n}",
