nt` times along with a boolean tracking whether overflow"},{"DocComment":" occurred."},{"DocComment":""},{"DocComment":" If this would overflow the range of values supported by `Self`, the"},{"DocComment":" value returned is unspecified and should not be relied on, though"},{"DocComment":" typically wrapping (modular arithmetic) is the most effective"},{"DocComment":" implementation to enable optimizations."},{"DocComment":""},{"DocComment":" # Invariants"},{"DocComment":""},{"DocComment":" For any `a`, `n`, and `m`, where no overflow occurs:"},{"DocComment":""},{"DocComment":" * `Step::forward_overflowing(Step::forward_overflowing(a, n).0, m) == Step::forward_overflowing(a, n + m)`"},{"DocComment":""},{"DocComment":" For any `a` and `n`, where no overflow occurs:"},{"DocComment":""},{"DocComment":" * `Step::forward_overflowing(a, n) == (Step::forward_checked(a, n).unwrap(), false)`"},{"DocComment":""},{"DocComment":" For any `a` and `n`:"},{"DocComment":""},{"DocComment":" * `Step::forward_overflowing(a, n) == (0..n).fold((a, false), |(x, y), _| { let (s, o) = Step::forward_overflowing(x, 1); (s, y || o) })`"},{"DocComment":"   * Corollary: `Step::forward_overflowing(a, 0) == (a, false)`"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":15},{"Deduplicated":0}],"output":{"Deduplicated":148}},"default":null},"kind":{"TraitMethod":[20,2]}},null,null,{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"backward_checked","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["range",0]},{"Ident":["Step",0]},{"Ident":["backward_checked",0]}],"span":{"Untagged":{"data":{"file_id":34,"beg":{"line":163,"col":4},"end":{"line":163,"col":67}},"generated_fr