    } else {\n                K::scale_xor(&mut columns, row, coefficient);\n            }\n        } else {\n            for (bit, dst) in columns[..bits].iter_mut().enumerate() {\n                *dst ^= K::mul(coefficient, K::frobenius(1_u64 << bit, power as u32));\n            }\n        }\n    }\n    let mut images = [0; 64];\n    let mut preimages = [0; 64];\n    let mut rank = 0;\n    for (bit, &column) in columns[..bits].iter().enumerate() {\n        let mut original = 1_u64 << bit;\n        let mut image = column;\n        while image != 0 {\n            let pivot = image.trailing_zeros() as usize;\n            if images[pivot] == 0 {\n                images[pivot] = image;\n                preimages[pivot] = original;\n                break;\n            }\n            image ^= images[pivot];\n            original ^= preimages[pivot];\n        }\n        if image == 0 {\n            kernel[rank] = original;\n            rank += 1;\n        }\n    }\n    let mut target = affine[0];\n    let mut solution = 0;\n    while target != 0 {\n        let pivot = target.trailing_zeros() as usize;\n        if images[pivot] == 0 {\n            return None;\n        }\n        target ^= images[pivot];\n        solution ^= preimages[pivot];\n    }\n    Some((solution, rank))\n}","attr_info":{"attributes":[{"DocComment":" Column elimination preserves a preimage witness for every image pivot."},{"DocComment":" Every dependent column gives one independent kernel direction. The returned"},{"DocComment":" base plus that kernel is exactly the complete solution set of L(X)=c."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"