, 'o', 'r', 'e', 'm'];"},{"DocComment":" let mut iter = slice.chunks_exact(2);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['l', 'o']);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['r', 'e']);"},{"DocComment":" assert!(iter.next().is_none());"},{"DocComment":" assert_eq!(iter.remainder(), &['m']);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`chunks`]: slice::chunks"},{"DocComment":" [`rchunks_exact`]: slice::rchunks_exact"},{"DocComment":" [`as_chunks`]: slice::as_chunks"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":3,"beg":{"line":1242,"col":4},"end":{"line":1242,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":15}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":39},{"Deduplicated":0}],"output":{"Value":[389,{"Adt":{"id":36,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":"Normal","body":"Opaque"},{"def_id":82,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["zip",0]},{"Impl":{"Trait":29}},{"Ident":["next",0]}],"span":{"Untagged":{"data":{"file_id":43,"beg":{"line":82,"col":4},"end":{"line":82,"col":44}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_erro