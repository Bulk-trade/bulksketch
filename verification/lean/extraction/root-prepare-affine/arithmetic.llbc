 &mut [u64],\n    affine: &mut [u64],\n    work: &mut [u64],\n    raw: &mut [RawProduct],\n) -> usize {\n    let d = polynomial.len() - 1;\n    let width = d + 1;\n    let (rows, rest) = factors.split_at_mut(d * d);\n    let witnesses = &mut rest[..d * width];\n    rows.fill(0);\n    witnesses.fill(0);\n    let (residue, rest) = work.split_at_mut(d);\n    let (vector, rest) = rest.split_at_mut(d);\n    let witness = &mut rest[..width];\n    residue.fill(0);\n    residue[0] = 1;\n    for column in 0..=d {\n        vector.copy_from_slice(residue);\n        witness.fill(0);\n        witness[column] = 1;\n        let mut pivot = None;\n        for i in 0..d {\n            let scale = vector[i];\n            if scale == 0 {\n                continue;\n            }\n            if rows[i * d + i] == 0 {\n                pivot = Some(i);\n                break;\n            }\n            K::scale_xor(&mut vector[i..], &rows[i * d + i..(i + 1) * d], scale);\n            K::scale_xor(\n                &mut witness[..=column],\n                &witnesses[i * width..i * width + column + 1],\n                scale,\n            );\n        }\n        let Some(pivot) = pivot else {\n            affine[..=column].copy_from_slice(&witness[..=column]);\n            return column + 1;\n        };\n        let inverse = if vector[pivot] == 1 {\n            1\n        } else {\n            K::inverse(vector[pivot]).expect(\"nonzero affine pivot\")\n        };\n        for (dst, &value) in rows[pivot * d + pivot..(pivot + 1) * d]\n            .iter_mut()\n            .zip(&vector[pivot..])\n        {\n            *dst = K::mul(value, inverse);\n        }\n        for (dst, &value) in witnesses[pivot * width..pivot * width + column + 1]\n            .iter_mut()\n            .zip(&witness[..=column])\n        {\n            *dst = K::mul(value, inverse);\n        }\n        if column == 0 {\n            residue.fill(0);\n            residue[1] = 1;\n        } else if column != d {\n            <Dense as Polynomial<F, K>>::square_mod_into(residue, polynomial, table, vector, raw);\n            residue.copy_from_slice(vector);\n        }\n    }\n    unreachable!(\"d+1 vectors in dimension d are dependent\")\n}","attr_info":{"attributes":[{"DocComment":" Return c+sum(a_i X^(2^i)) divisible by the monic input polynomial."},{"DocComment":" `affine`, `residue`, `vector`, and `witness` need d+1,d,d,d+1 words."},{"DocComment":" Rows and witnesses together need 2*d*d+d words."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":4,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":5,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Invariant"},{"index":1,"name":"K","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[194,{"data":{"file_id":23,"beg":{"line":100,"col":26},"end":{"line":100,"col":37}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[195,{"data":{"file_id":23,"beg":{"line":100,"col":42},"end":{"line":100,"col":56}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":27},{"Deduplicated":15}],"cons