"beg":{"line":25,"col":40},"end":{"line":25,"col":44}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Value":[1604,{"data":{"file_id":11,"beg":{"line":25,"col":47},"end":{"line":25,"col":49}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Value":[1605,{"data":{"file_id":11,"beg":{"line":25,"col":52},"end":{"line":25,"col":56}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":4,"span":{"Value":[1606,{"data":{"file_id":11,"beg":{"line":25,"col":59},"end":{"line":25,"col":63}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}}],"consts":[{"name":"BITS","attr_info":{"attributes":[{"DocComment":" Extension degree over GF(2)."}],"inline":null,"rename":null,"public":true},"ty":{"Value":[1071,{"Scalar":{"Integer":{"Unsigned":"U32"}}}]},"default":null},{"name":"MODULUS_LOW","attr_info":{"attributes":[{"DocComment":" Irreducible polynomial without its leading term."}],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":9},"default":null},{"name":"WIRE_ID","attr_info":{"attributes":[{"DocComment":" Registered polynomial/basis identity."}],"inline":null,"rename":null,"public":true},"ty":{"Value":[1072,{"Adt":{"id":16,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]},"default":null},{"name":"MASK","attr_info":{"attributes":[{"DocComment":" Canonical element mask."}],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":9},"default":null}],"types":[],"methods":[],"vtable":null},{"def_id":5,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["BulkKernels",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":50,"col":0},"end":{"line":121,"col":1}},"generated_from_span":null}},"source_text":"pub(crate) trait BulkKernels<F: BinaryField>: Arithmetic<F> {\n    /// Optional monic square-mod kernel; false leaves both mutable slices untouched.\n    /// Degree d>=3, a.len<=d, table.len=d*floor(d/2), dst.len=d, raw.len>=2*d+1.\n    fn square_mod(_a: &[u64], _table: &[u64], _dst: &mut [u64], _raw: &mut [RawProduct]) -> bool {\n        false\n    }\n\n    /// Multiply an ascending polynomial in place by (1 + root*z). Its final\n    /// coefficient must initially be zero; the slice includes that spare word.\n    fn multiply_linear(coefficients: &mut [u64], root: u64) {\n        for index in (1..coefficients.len()).rev() {\n            coefficients[index] ^= Self::mul(coefficients[index - 1], root);\n        }\n    }\n\n    /// Check all odd-sequence continuation equations, after the caller has\n    /// independently verified its first d words. squared_locator is rebuilt\n    /// from roots, has d+1 ascending words and constant coefficient one.\n    fn odd_recurrence_matches(odd: &[u64], squared_locator: &[u64]) -> bool {\n        let degree = squared_locator.len() - 1;\n        for index in degree..odd.len() {\n            let mut sum = RawProduct::default();\n            for lag in 1..=degree {\n                let product = Self::raw_mul(odd[index - lag], squared_locator[lag]);\n                sum.lo ^= product.lo;\n                sum.hi ^= product.hi;\n            }\n            if Self::reduce(sum) != odd[index] {\n                return false;\n            }\n        }\n        true\n    }\n\n    /// Toggle nonzero canonical IDs into S1,S3,... in arrival order. Parity semantics.\n    /// Caller handles routing/zero and validates every input. No post-final multiply.\n    fn insert_nonzero(odd: &mut [u64], ids: &[u64]);\n    /// Overwrite all odd syndromes with the direct encoding of these IDs.\n    fn encode_nonzero(odd: &mut [u64], ids: &[u64]) {\n        odd.fill(0);\n        if ids.len() <= 2 {\n            for id in ids {\n                Self::insert_nonzero(odd, std::slice::from_ref(id));\n            }\n        } else {\n            Self::insert_nonzero(odd, ids);\n        }\n    }\n\n    /// Equal lengths; XOR algebraic words only, never wire metadata.\n    fn xor_assign(dst: &mut [u64], src: &[u64]);\n    /// XOR canonical local words with unaligned little-endian remote words.\n    /// Equal word lengths; returns whether any output word is nonzero.\n    fn difference(dst: &mut [u64], local: &[u64], remote: &[u8]) -> bool {\n        #[cfg(test)]\n        super::test_observer::difference();\n        assert_eq!(dst.len(), local.len(), \"difference length mismatch\");\n        assert_eq!(\n            remote.len(),\n            8 * dst.len(),\n            \"difference byte length mismatch\"\n        );\n        let mut any = 0;\n        for ((out, &word), bytes) in dst.iter_mut().zip(local).zip(remote.chunks_exact(8)) {\n            *out = word ^ u64::from_le_bytes(bytes.try_into().expect(\"complete word\"));\n            any |= *out;\n        }\n        any != 0\n    }\n    /// Ascending coefficients; empty polynomial evaluates to zero. out.len=points.len.\n    fn horner_many(coefficients: &[u64], points: &[u64], out: &mut [u64]);\n}","attr_info":{"attributes":[{"DocComment":" Bulk arithmetic, without shape, wire, request, job or complete-operation types."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"F","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[1607,{"data":{"file_id":13,"beg":{"line":50,"col":46},"end":{"line":50,"col":59}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[1608,{"data":{"file_id":13,"beg":{"line":50,"col":32},"end":{"line":50,"col":43}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"square_mod","item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["BulkKernels",0]},{"Ident":["square_mod",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":53,"col":4},"end":{"line":55,"col":5}},"generated_from_span":null}},"source_text":"fn square_mod(_a: &[u64], _table: &[u64], _dst: &mut [u64], _raw: &mut [RawProduct]) -> bool {\n        false\n    }","attr_info":{"attributes":[{"DocComment":" Optional monic square-mod kernel; false leaves both mutable slices untouched."},{"DocComment":" Degree d>=3, a.len<=d, table.len=d*floor(d/2), dst.len=d, raw.len>=2*d+1."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[1073,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":30},"Shared"]}]},{"Value":[1074,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":30},"Shared"]}]},{"Value":[1075,{"Ref":[{"Var":{"Bound":[0,2]}},{"Deduplicated":30},"Mut"]}]},{"Value":[1076,{"Ref":[{"Var":{"Bound":[0,3]}},{"Deduplicated":36},"Mut"]}]}],"output":{"Deduplicated":16}},"default":{"id":39,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}},{"Var":{"Bound":[0,2]}},{"Var":{"Bound":[0,3]}}],"types":[{"Deduplicated":10},{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}},"kind":{"TraitMethod":[5,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"multiply_linear","item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["BulkKernels",0]},{"Ident":["multiply_linear",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":59,"col":4},"end":{"line":63,"col":5}},"generated_from_span":null}},"source_text":"fn multiply_linear(coefficients: &mut [u64], root: u64) {\n        for index in (1..coefficients.len()).rev() {\n            coefficients[index] ^= Self::mul(coefficients[index - 1], root);\n        }\n    }","attr_info":{"attributes":[{"DocComment":" Multiply an ascending polynomial in place by (1 + root*z). Its final"},{"DocComment":" coefficient must initially be zero; the slice includes that spare word."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[1077,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":30},"Mut"]}]},{"Deduplicated":9}],"output":{"Deduplicated":55}},"default":{"id":40,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":10},{"Deduplicated":13}],"const_generics":[],"trait_refs":[{"regions":[],"outlives":[],"skip_binder":{"Value":[132,{"kind":"SelfId","trait_decl_ref":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}]}}]}}},"kind":{"TraitMethod":[5,1]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"name":"odd_recurrence_matches","item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["backend",0]},{"Ident":["contract",0]},{"Ident":["BulkKernels",0]},{"Ident":["odd_recurrence_matches",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":68,"col":4},"end":{"line":82,"col":5}},"generated_from_span":null}},"source_text":"fn odd_recurrence_matches(odd: &[u64], squared_locator: &[u64]) -> bool {\n        let degree = squared_locator.len() - 1;\n        for index in degree..odd.len() {\n            let mut sum = RawProduct::default();\n            for lag in 1..=degree {\n                let product = Self::raw_mul(odd[index - lag], squared_locator[lag]);\n                sum.lo ^= product.lo;\n                sum.hi ^= product.hi;\n            }\n            if Self::reduce(sum) != odd[index] {\n                return false;\n            }\n        }\n        true\n    }","attr_info":{"attributes":[{"DocComment":" Check all odd-sequence continuation equations, after the caller has"},{"DocComment":" i