               continue;\n            }\n            if factor == 1 {\n                for (slot, &coefficient) in raw[offset..top].iter_mut().zip(&b[..degree]) {\n                    slot.lo ^= coefficient;\n                }\n                continue;\n            }\n            for (slot, &coefficient) in raw[offset..top].iter_mut().zip(&b[..degree]) {\n                let product = K::raw_mul(factor, coefficient);\n                slot.lo ^= product.lo;\n                slot.hi ^= product.hi;\n            }\n        }\n        let remainder_size = degree.min(a.len());\n        for (target, &product) in rem[..remainder_size].iter_mut().zip(raw.iter()) {\n            *target = K::reduce(product);\n        }\n        (\n            normalized_len(&q[..size]),\n            normalized_len(&rem[..remainder_size]),\n        )\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":4,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Unknown"},{"index":1,"name":"K","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":345},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Deduplicated":346},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binde