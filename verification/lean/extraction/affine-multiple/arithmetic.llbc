"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["step_by",0]}],"span":{"Untagged":{"data":{"file_id":26,"beg":{"line":453,"col":4},"end":{"line":455,"col":20}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator starting at the same point, but stepping by"},{"DocComment":" the given amount at each iteration."},{"DocComment":""},{"DocComment":" Note 1: The first element of the iterator will always be returned,"},{"DocComment":" regardless of the step given."},{"DocComment":""},{"DocComment":" Note 2: The time at which ignored elements are pulled is not fixed."},{"DocComment":" `StepBy` behaves like the sequence `self.next()`, `self.nth(step-1)`,"},{"DocComment":" `self.nth(step-1)`, …, but is also free to behave like the sequence"},{"DocComment":" `advance_n_and_return_first(&mut self, step)`,"},{"DocComment":" `advance_n_and_return_first(&mut self, step)`, …"},{"DocComment":" Which way is used may change for some iterators for performance reasons."},{"DocComment":" The second way will advance the iterator earlier and may consume more items."},{"DocComment":""},{"DocComment":" `advance_n_and_return_first` is the equivalent of:"},{"DocComment":" ```"},{"DocComment":" fn advance_n_and_return_first<I>(iter: &mut I, n: usize) -> Option<I::Item>"},{"DocComment":" where"},{"DocComment":"     I: Iterator,"},{"DocComment":" {"},{"DocComment":"     let next = iter.next();"},{"DocComment":"     if n > 1 {"},{"DocComment":"         iter.nth(n - 2);"},{"DocComment":"     }"},{"DocComment":"     next"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" The method will panic if the given step is `0`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [0, 1, 2, 3, 4, 5];"},{"DocComment":" let mut iter = a.into_iter().step_by(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":259},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10},{"Deduplicated":0}],"output":{"Value":[457,{"Adt":{"id":22,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":{"TraitDefault":{"trait_ref":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}},"item_id":7}},"body":"Opaque"},null,null,null,null,null,null,null,{"def_id":65,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["enumerate",0]}],"span":{"Untagged":{"data":{"file_id":26,"beg":{"line":1058,"col":4},"end":{"line":1060,"col":20}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator which gives the current iteration count as well as"},{"DocComment":" the next value."},{"DocComment":""},{"DocComment":" The iterator returned yields pairs `(i, val)`, where `i` is the"},{"DocComment":" current index of iteration and `val` is the value returned by the"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" `enumerate()` keeps its count as a [`usize`]. If you want to count by a"},{"DocComment":" different sized integer, the [`zip`] function provides similar"},{"DocComment":" functionality."},{"DocComment":""},{"DocComment":" # Overflow Behavior"},{"DocComment":""},{"DocComment":" The method does no guarding against overflows, so enumerating more than"},{"DocComment":" [`usize::MAX`] elements either produces the wrong result or panics. If"},{"DocComment":" overflow checks are enabled, a panic is guaranteed."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" The returned iterator might panic if the to-be-returned index would"},{"DocComment":" overflow a [`usize`]."},{"DocComment":""},{"DocComment":" [`zip`]: Iterator::zip"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = ['a', 'b', 'c'];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().enumerate();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some((0, 'a')));"},{"DocComment":" assert_eq!(iter.next(), Some((1, 'b')));"},{"DocComment":" assert_eq!(iter.next(), Some((2, 'c')));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"enumerate_method","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":259},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":13}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_vari