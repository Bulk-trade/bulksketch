the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1, 2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.rposition(|x| x >= 2), Some(3));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":" assert_eq!(iter.next_back(), Some(3));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"P","variance":"Contravariant"},{"index":2,"name":"Clause0_Item","variance":"Invariant"},{"index":3,"name":"Clause2_Clause0_Item","variance":"Invariant"},{"index":4,"name":"Clause3_Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":259},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":23}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[578,{"data":{"file_id":26,"beg":{"line":3214,"col":11},"end":{"line":3214,"col":36}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":13},{"Value":[459,{"Adt":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":23}],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}]},{"Deduplicated":16}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Value":[579,{"data":{"file_id":26,"beg":{"line":3215,"col":22},"end":{"line":3215,"col":39}},"generated_from_span":null}]},"origin":"WhereClauseO