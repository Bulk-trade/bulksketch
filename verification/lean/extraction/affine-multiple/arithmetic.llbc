ocComment":" without the requirement that subtypes / supertypes implement `TrustedRandomAccessNoCoerce`."},{"DocComment":""},{"DocComment":" This trait was created in PR #85874 to fix soundness issue #85873 without performance regressions."},{"DocComment":" It is subject to change as we might want to build a more generally useful (for performance"},{"DocComment":" optimizations) and more sophisticated trait or trait hierarchy that replaces or extends"},{"DocComment":" [`TrustedRandomAccess`] and `TrustedRandomAccessNoCoerce`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[{"name":"MAY_HAVE_SIDE_EFFECT","attr_info":{"attributes":[{"DocComment":" `true` if getting an iterator element may have side effects."},{"DocComment":" Remember to take inner iterators into account."}],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":16},"default":null}],"types":[],"methods":[null],"vtable":null},{"def_id":32,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["poly",0]},{"Ident":["Polynomial",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":32,"col":0},"end":{"line":74,"col":1}},"generated_from_span":null}},"source_text":"pub(crate) trait Polynomial<F: BinaryField, K: BulkKernels<F>> {\n    /// dst and raw each have at least a.len+b.len words (zero inputs need zero words).\n    fn mul_into(a: &[u64], b: &[u64], dst: &mut [u64], raw: &mut [RawProduct]) -> usize;\n    /// dst/raw each have at least 2*a.len words.\n    fn square_into(a: &[u64], dst: &mut [u64], raw: &mut [RawProduct]) -> usize;\n    /// q, rem and raw each have at least a.len+1 words. Returns `(q_len, rem_len)`.\n    fn div_rem_into(\n        a: &[u64],\n        b: &[u64],\n        q: &mut [u64],\n        rem: &mut [u64],\n        raw: &mut [RawProduct],\n    ) -> (usize, usize);\n    /// Same storage as `div_rem_into`; None if remainder is nonzero. No provisional q is published.\n    fn exact_divide_into(\n        a: &[u64],\n        b: &[u64],\n        q: &mut [u64],\n        rem: &mut [u64],\n        raw: &mut [RawProduct],\n    ) -> Option<usize>;\n    /// dst has max(a.len,b.len) words; work has `4*(max_len+1)`, raw has `2*(max_len+1)`.\n    fn monic_gcd_into(\n        a: &[u64],\n        b: &[u64],\n        dst: &mut [u64],\n        work: &mut [u64],\n        raw: &mut [RawProduct],\n    ) -> usize;\n    fn eval_many_into(coefficients: &[u64], points: &[u64], out: &mut [u64]);\n    /// Extend with zeros through index, XOR value, normalize. dst has index+1 capacity.\n    fn xor_coefficient(dst: &mut [u64], len: usize, index: usize, value: u64) -> usize;\n    /// Monic degree d>=3; table needs d*floor(d/2), work needs 4*(d+1) words.\n    fn prepare_square_table(modulus: &[u64], table: &mut [u64], work: &mut [u64]);\n    /// dst has d words; raw has 2*d+1; table is the exact table for this modulus.\n    fn square_mod_into(\n        a: &[u64],\n        modulus: &[u64],\n        table: &[u64],\n        dst: &mut [u64],\n        raw: &mut [RawProduct],\n    ) -> usize;\n}","attr_info":{"attributes":[{"DocComment":" Canonical ascending slices: empty is zero; nonempty has no trailing zero."},{"DocComment":" Output slices are caller-owned, sufficiently sized, and return their normalized length."},{"DocComment":" Input/output aliasing follows Rust borrows. Zero divisors violate internal invariants."},{"DocComment":" The row driver charges `WorkScheduleV1` *before* invoking these unmetered kernels."},{"Unknown":{"path":"expect","args":"dead_code, reason =\n\"test polynomial oracles consume the remaining private primitives\""}}],"inline":null,"rename":null,"public":false},"is_local":true,"started