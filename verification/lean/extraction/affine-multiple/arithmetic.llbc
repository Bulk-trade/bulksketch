,"beg":{"line":167,"col":4},"end":{"line":186,"col":5}},"generated_from_span":null}},"source_text":"fn prepare_square_table(modulus: &[u64], table: &mut [u64], work: &mut [u64]) {\n        assert!(modulus.len() >= 4 && modulus.last() == Some(&1));\n        let degree = modulus.len() - 1;\n        let rows = degree / 2;\n        assert!(table.len() >= degree * rows && work.len() >= 4 * (degree + 1));\n        let current = &mut work[..degree];\n        current.copy_from_slice(&modulus[..degree]);\n        // X^d = f's low coefficients modulo monic f. The first stored\n        // exponent is d for even d, d+1 for odd d; successive rows add two.\n        if !degree.is_multiple_of(2) {\n            times_x_mod::<F, K>(current, modulus);\n        }\n        for row in 0..rows {\n            table[row * degree..(row + 1) * degree].copy_from_slice(current);\n            if row + 1 != rows {\n                times_x_mod::<F, K>(current, modulus);\n                times_x_mod::<F, K>(current, modulus);\n            }\n        }\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Unknown"},{"index":1,"name":"K","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":345},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Deduplicated":346},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"