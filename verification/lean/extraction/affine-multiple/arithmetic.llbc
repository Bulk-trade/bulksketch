he `Option` should be `Some`."},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" # let slice: &[u8] = &[];"},{"DocComment":" let item = slice.get(0)"},{"DocComment":"     .expect(\"slice should not be empty\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" **Hint**: If you're having trouble remembering how to phrase expect"},{"DocComment":" error messages remember to focus on the word \"should\" as in \"env"},{"DocComment":" variable should be set by blah\" or \"the given binary should be available"},{"DocComment":" and executable by the current user\"."},{"DocComment":""},{"DocComment":" For more detail on expect message styles and the reasoning behind our"},{"DocComment":" recommendation please refer to the section on [\"Common Message"},{"DocComment":" Styles\"](../../std/error/index.html#common-message-styles) in the [`std::error`](../../std/error/index.html) module docs."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":15,"beg":{"line":963,"col":4},"end":{"line":963,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"option_expect","has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":255},{"Value":[262,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":110},"Shared"]}]}],"output":{"Deduplicated":10}},"src":"Normal","body":"Opaque"},{"def_id":34,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":3},"kind":"InherentImplBlock"}}},{"Ident":["iter_mut",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":1061,"col":4},"end":{"line":1061,"col":54}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator that allows modifying each value."},{"DocComment":""},{"DocComment":" The iterator yields all items from start to end."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = &mut [1, 2, 4];"},{"DocComment":" for elem in x.iter_mut() {"},{"DocComment":"     *elem += 2;"},{"DocComment":" }"},{"DocComment":" assert_eq!(x, &[3, 4, 6]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Lub":{"Deduplicated":10}},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":22}],"output":{"Value":[263,{"Adt":{"id":13,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":10}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":"Normal","body":"Opaque"},{"def_id":35,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["zip",0]}],"span":{"Untagged":{"data":{"file_id":26,"beg":{"line":643,"col":4},"end":{"line":646,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" 'Zips up' two iterators into a single iterator of pairs."},{"DocComment":""},{"DocComment":" `zip()` returns a new iterator that will iterate over two other"},{"DocComment":" iterators, returning a tuple where the first element comes from the"},{"DocComment":" first iterator, and the second element comes from the second iterator."},{"DocComment":""},{"DocComment":" In other words, it zips two iterators together, into a single one."},{"DocComment":""},{"DocComment":" If either iterator returns [`None`], [`next`] from the zipped iterator"},{"DocComment":" will return [`None`]."},{"DocComment":" If the zipped iterator has no more elements to return then each further attempt to advance"},{"DocComment":" it will first try to advance the first iterator at most one time and if it still yielded an item"},{"DocComment":" try to advance the second iterator at most one time."},{"DocComment":""},{"DocComment":" To 'undo' the result of zipping up two iterators, see [`unzip`]."},{"DocComment":""},{"DocComment":" [`unzip`]: Iterator::unzip"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s1 = \"abc\".chars();"},{"DocComment":" let s2 = \"def\".chars();"},{"DocComment":""},{"DocComment":" let mut iter = s1.zip(s2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(('a', 'd')));"},{"DocComment":" assert_eq!(iter.next(), Some(('b', 'e')));"},{"DocComment":" assert_eq!(iter.next(), Some(('c', 'f')));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the argument to `zip()` uses [`IntoIterator`], we can pass"},{"DocComment":" anything that can be converted into an [`Iterator`], not just an"},{"DocComment":" [`Iterator`] itself. For example, arrays (`[T]`) implement"},{"DocComment":" [`IntoIterator`], and so can be passed to `zip()` directly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a1 = [1, 2, 3];"},{"DocComment":" let a2 = [4, 5, 6];"},{"DocComment":""},{"DocComment":" let mut iter = a1.into_iter().zip(a2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some((1, 4)));"},{"DocComment":" assert_eq!(iter.next(), Some((2, 5)));"},{"DocComment":" assert_eq!(iter.next(), Some((3, 6)));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `zip()` is often used to zip an infinite iterator to a finite one."},{"DocComment":" This works because the finite iterator will eventually return [`None`],"},{"DocComment":" ending the zipper. Zipping with `(0..)` can look a lot like [`enumerate`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let enumerate: Vec<_> = \"foo\".chars().enumerate().collect();"},{"DocComment":""},{"DocComment":" let zipper: Vec<_> = (0..).zip(\"foo\".chars()).collect();"},{"DocComment":""},{"DocComment":" assert_eq!((0, 'f'), enumerate[0]);"},{"DocComment":" assert_eq!((0, 'f'), zipper[0]);"},{"DocComment":""},{"DocComment":" assert_eq!((1, 'o'), enumerate[1]);"},{"DocComment":" assert_eq!((1, 'o'), zipper[1]);"},{"DocComment":""},{"DocComment":" assert_eq!((2, 'o'), enumerate[2]);"},{"DocComment":" assert_eq!((2, 'o'), zipper[2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If both iterators have roughly equivalent syntax, it may be more readable to use [`zip`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::iter::zip;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let b = [2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut zipped = zip("},{"DocComment":"     a.into_iter().map(|x| x * 2).skip(1),"},{"DocComment":"     b.into_iter().map(|x| x * 2).skip(1),"},{"DocComment":" );"},{"DocComment":""},{"DocComment":" assert_eq!(zipped.next(), Some((4, 6)));"},{"DocComment":" assert_eq!(zipped.next(), Some((6, 8)));"},{"DocComment":" assert_eq!(zipped.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" compared to:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # let a = [1, 2, 3];"},{"DocComment":" # let b = [2, 3, 4];"},{"DocComment":" #"},{"DocComment":" let mut zipped = a"},{"DocComment":"     .into_iter()"},{"DocComment":"     .map(|x| x * 2)"},{"DocComment":"     .skip(1)"},{"DocComment":"     .zip(b.into_iter().map(|x| x * 2).skip(1));"},{"DocComment":" #"},{"DocComment":" # assert_eq!(zipped.next(), Some((4, 6)));"},{"DocComment":" # assert_eq!(zipped.next(), Some((6, 8)));"},{"DocComment":" # assert_eq!(zipped.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`enumerate`]: Iterator::enumerate"},{"DocComment":" [`next`]: Iterator::next"},{"DocComment":" [`zip`]: crate::iter::zip"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"U","variance":"Invariant"},{"index":2,"name":"Clause0_Item","variance":"Invariant"},{"index":3,"name":"Clause1_Item","variance":"Invariant"},{"index":4,"name":"Clause1_IntoIter","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":259},"origin":"TraitSelf","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":23}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[342,{"data":{"file_id":26,"beg":{"line":646,"col":11},"end":{"line":646,"col":23}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":13},{"Value":[264,{"TypeVar":{"Free":3}}]},{"Value":[265,{"TypeVar":{"Free":4}}]}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10},{"Deduplicated":13}],"output":{"Value":[266,{"Adt":{"id"