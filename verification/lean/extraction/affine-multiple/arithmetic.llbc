pivot * d + pivot..(pivot + 1) * d]\n            .iter_mut()\n            .zip(&vector[pivot..])\n        {\n            *dst = K::mul(value, inverse);\n        }\n        for (dst, &value) in witnesses[pivot * width..pivot * width + column + 1]\n            .iter_mut()\n            .zip(&witness[..=column])\n        {\n            *dst = K::mul(value, inverse);\n        }\n        if column == 0 {\n            residue.fill(0);\n            residue[1] = 1;\n        } else if column != d {\n            <Dense as Polynomial<F, K>>::square_mod_into(residue, polynomial, table, vector, raw);\n            residue.copy_from_slice(vector);\n        }\n    }\n    unreachable!(\"d+1 vectors in dimension d are dependent\")\n}","attr_info":{"attributes":[{"DocComment":" Return c+sum(a_i X^(2^i)) divisible by the monic input polynomial."},{"DocComment":" `affine`, `residue`, `vector`, and `witness` need d+1,d,d,d+1 words."},{"DocComment":" Rows and witnesses together need 2*d*d+d words."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":4,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":5,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Invariant"},{"index":1,"name":"K","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[5,{"data":{"file_id":6,"beg":{"line":100,"col":26},"end":{"line":100,"col":37}},"generated_from_span":n