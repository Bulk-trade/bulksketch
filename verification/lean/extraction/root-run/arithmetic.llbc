valid = deg34::certificate::<F, K>(&values[..=degree], roots, &mut product[..5]);\n        #[cfg(test)]\n        crate::types::small_degree_observer::certificate(valid);\n        if !valid {\n            return Ok(Ok(Stage::ReducerPreparation));\n        }\n        workspace.roots[self.count..self.count + degree].copy_from_slice(roots);\n        self.count += degree;\n        Ok(Ok(self.advance(workspace)))\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Invariant"},{"index":1,"name":"K","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[278,{"data":{"file_id":5,"beg":{"line":237,"col":22},"end":{"line":237,"col":33}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":16}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[279,{"data":{"file_id":5,"beg":{"line":237,"col":38},"end":{"line":237,"col":52}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":28},{"Deduplicated":16}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[{"regions":[],"outlives":[],"skip_binder":[{"Var":{"Free":2}},{"Var":{"Free":1}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false