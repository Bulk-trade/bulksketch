K::mul(workspace.polynomials[0], K::square(inverse));\n                let Some(solution) = K::solve_quadratic(target) else {\n                    return Ok(Err(DecodeFailure::NotSplit));\n                };\n                let root = K::mul(linear, solution);\n                [root, root ^ linear]\n            }\n            _ => unreachable!(\"leaf degree at most two\"),\n        };\n        if roots[..self.degree].contains(&0) {\n            return Ok(Err(DecodeFailure::InvalidLocator));\n        }\n        workspace.roots[self.count..self.count + self.degree]\n            .copy_from_slice(&roots[..self.degree]);\n        self.count += self.degree;\n        Ok(Ok(self.advance(workspace)))\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Invariant"},{"index":1,"name":"K","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[283,{"data":{"file_id":5,"beg":{"line":347,"col":15},"end":{"line":347,"col":26}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":16}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[284,{"data":{"file_id":5,"beg":{"line":347,"col":31},"end":{"line":347,"col":45}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"