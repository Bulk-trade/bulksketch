_default":false}},"body":"Opaque"},{"def_id":11,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["decode",0]},{"Ident":["roots",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":3},"kind":"InherentImplBlock"}}},{"Ident":["run",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":128,"col":4},"end":{"line":236,"col":5}},"generated_from_span":null}},"source_text":"pub(super) fn run<F: BinaryField, K: BulkKernels<F>>(\n        &mut self,\n        stage: Stage,\n        workspace: &mut RowWorkspace<'_>,\n        meter: &mut WorkMeter,\n    ) -> Result<Result<Stage, DecodeFailure>, DecodeError> {\n        #[cfg(test)]\n        crate::types::small_degree_observer::stage(stage, true);\n        if matches!(\n            stage,\n            Stage::LeafThree | Stage::LeafFour | Stage::FactorVerification\n        ) {\n            return self.closed_leaf::<F, K>(stage, workspace, meter);\n        }\n        if stage == Stage::Leaf {\n            return self.leaf::<F, K>(workspace, meter);\n        }\n        if stage == Stage::AffinePreparation {\n            return self.prepare_affine::<F, K>(workspace, meter);\n        }\n        if stage == Stage::AffineEnumeration {\n            return self.enumerate_affine::<F, K>(workspace, meter);\n        }\n        let degree = self.degree;\n        let mut buffers = FactorWork::new(\n            degree,\n            workspace.polynomials,\n            workspace.square_table,\n            workspace.raw,\n            workspace.basis,\n        );\n        match stage {\n            Stage::ReducerPreparation => {\n                charge(meter, Charge::Table { degree })?;\n                <Dense as Polynomial<F, K>>::prepare_square_table(\n                    buffers.modulus,\n                    buffers.table,\n                    buffers.work,\n                );\n                Ok(Ok(if self.affine {\n                    if self.affine_ready {\n                        Stage::AffineSplit\n                    } else {\n                        Stage::AffinePreparation\n                    }\n                } else {\n                    Stage::Trace\n                }))\n            }\n            Stage::AffineSplit => {\n                charge(\n                    meter,\n                    Charge::AffineSplit {\n                        degree,\n                        rank: self.affine_rank,\n                    },\n                )?;\n                if self.affine_rank == 0 {\n                    return Ok(Err(DecodeFailure::NotSplit));\n                }\n                let rank = self.affine_rank - 1;\n                let start = self.stride * self.stride + affine::subspace_start(rank);\n                self.trace_len = affine::splitter::<F, K>(\n                    buffers.modulus,\n                    buffers.table,\n                    &workspace.factors[start..start + rank + 1],\n                    self.affine_base,\n                    buffers.trace,\n                    buffers.work,\n                    buffers.raw,\n                );\n                Ok(Ok(Stage::Gcd))\n            }\n            Stage::Trace => self.trace::<F, K>(&mut buffers, meter),\n            Stage::Gcd => {\n                charge(meter, Charge::Gcd { degree })?;\n                self.gcd_len = <Dense as Polynomial<F, K>>::monic_gcd_into(\n                    buffers.modulus,\n                    &buffers.trace[..self.trace_len],\n                    buffers.gcd,\n                    buffers.work,\n                    buffers.raw,\n                );\n                self.gcd_degree = self.gcd_len - 1;\n                if self.gcd_degree > 0 && self.gcd_degree < degree {\n                    return Ok(Ok(Stage::FactorDivision));\n                }\n                if self.affine {\n                    self.affine_rank -= 1;\n                    if self.gcd_len == 1 {\n                        self.affine_base ^=\n                            buffers.basis.directions.as_ref().expect(\"affine basis\")\n                                [self.affine_rank];\n                    }\n                    return Ok(Ok(Stage::AffineSplit));\n                }\n                self.direction += 1;\n                if self.direction == F::BITS {\n                    Ok(Err(DecodeFailure::NotSplit))\n                } else {\n                    Ok(Ok(Stage::Trace))\n                }\n            }\n            Stage::FactorDivision => {\n                self.divide::<F, K>(&mut buffers, workspace.factors, workspace.stack, meter)\n            }\n            _ => unreachable!(\"root traversal stage\"),\n        }\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Invariant"},{"index":1,"name":"K","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[5,{"data":{"file_id":5,"beg":{"line":128,"col":25},"end":{"line":128,"col":36}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":16}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[6,{"data":{"file_id":5,"beg":{"line":128,"col":41},"end":{"line":128,"col":55}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"ski