1178,"col":4},"end":{"line":1180,"col":22}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the contained [`Ok`] value, consuming the `self` value."},{"DocComment":""},{"DocComment":" Because this function may panic, its use is generally discouraged."},{"DocComment":" Instead, prefer to use pattern matching and handle the [`Err`]"},{"DocComment":" case explicitly, or call [`unwrap_or`], [`unwrap_or_else`], or"},{"DocComment":" [`unwrap_or_default`]."},{"DocComment":""},{"DocComment":" [`unwrap_or`]: Result::unwrap_or"},{"DocComment":" [`unwrap_or_else`]: Result::unwrap_or_else"},{"DocComment":" [`unwrap_or_default`]: Result::unwrap_or_default"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the value is an [`Err`], with a panic message including the"},{"DocComment":" passed message, and the content of the [`Err`]."},{"DocComment":""},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let x: Result<u32, &str> = Err(\"emergency failure\");"},{"DocComment":" x.expect(\"Testing expect\"); // panics with `Testing expect: emergency failure`"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Recommended Message Style"},{"DocComment":""},{"DocComment":" We recommend that `expect` messages are used to describe the reason you"},{"DocComment":" _expect_ the `Result` should be `Ok`."},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let path = std::env::var(\"IMPORTANT_PATH\")"},{"DocComment":"     .expect(\"env variable `IMPORTANT_PATH` should be set by `wrapper_script.sh`\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" **Hint**: If you're having trouble remembering how to phrase expect"},{"DocComment":" error messages remember to focus on the word \"should\" as in \"env"},{"DocComment":" variable should be set by blah\" or \"the given binary should be available"},{"DocComment":" a