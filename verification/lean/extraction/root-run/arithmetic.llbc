; no released parent reducer can ever be resumed.\n        let start = self\n            .pending\n            .checked_mul(self.stride)\n            .ok_or(DecodeError::ScratchTooSmall)?;\n        let end = start.checked_add(len).ok_or(DecodeError::ScratchTooSmall)?;\n        factors[start..end].copy_from_slice(&quotient[..len]);\n        stack[self.pending] = FactorFrame {\n            coefficient_start: u64::try_from(start).expect(\"admitted offset\"),\n            coefficient_len: u64::try_from(len).expect(\"admitted degree\"),\n            next_direction: self.direction + 1,\n            split_checked: 1,\n        };\n        if self.affine {\n            self.affine_rank -= 1;\n            factors[start + self.stride - 1] = self.affine_base\n                ^ buffers.basis.directions.as_ref().expect(\"affine basis\")[self.affine_rank];\n            stack[self.pending].next_direction = self.affine_rank as u32;\n        }\n        self.pending += 1;\n        buffers.modulus[..self.gcd_len].copy_from_slice(&buffers.gcd[..self.gcd_len]);\n        self.degree = self.gcd_degree;\n        self.direction += 1;\n        self.checked = true;\n        Ok(Ok(self.stage()))\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":4,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":5,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Inva