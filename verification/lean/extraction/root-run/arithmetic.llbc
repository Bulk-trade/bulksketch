ed {\n            charge(meter, Charge::SplitCheck { degree })?;\n            <Dense as Polynomial<F, K>>::square_mod_into(\n                &buffers.trace[..self.trace_len],\n                buffers.modulus,\n                buffers.table,\n                buffers.gcd,\n                buffers.raw,\n            );\n            // Modular squaring writes all d output words. Pad the normalized trace\n            // to compare T^2+T, including coefficients above either normalized end.\n            buffers.trace[self.trace_len..].fill(0);\n            if buffers.gcd[..degree] != *buffers.trace {\n                return Ok(Err(DecodeFailure::NotSplit));\n            }\n            self.checked = true;\n        }\n        Ok(Ok(Stage::Gcd))\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Invariant"},{"index":1,"name":"K","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[358,{"data":{"file_id":5,"beg":{"line":384,"col":16},"end":{"line":384,"col":27}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":16}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[359,{"data":{"file_id":5,"beg":{"line":384,"col":32},"end":{"line":384,"col":46}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outl