0; 64]);\n        let Some((base, rank)) = affine::solve_map::<F, K>(&coefficients[..len], basis) else {\n            return Ok(Err(DecodeFailure::NotSplit));\n        };\n        if rank >= len - 1\n            || 1_u64\n                .checked_shl(rank as u32)\n                .is_some_and(|n| n < degree as u64)\n        {\n            return Ok(Err(DecodeFailure::NotSplit));\n        }\n        workspace.basis.len = rank as u32;\n        self.affine_base = base;\n        self.affine_rank = rank;\n        self.affine_ready = true;\n        if affine::enumerate_preferred(degree, rank) {\n            Ok(Ok(Stage::AffineEnumeration))\n        } else {\n            let offset = self.stride * self.stride;\n            affine::subspaces::<F, K>(&basis[..rank], &mut workspace.factors[offset..]);\n            Ok(Ok(Stage::AffineSplit))\n        }\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Invariant"},{"index":1,"name":"K","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[285,{"data":{"file_id":5,"beg":{"line":274,"col":25},"end":{"line":274,"col":36}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":16}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[286,{"data":{"file_id":5,"beg":{"line":274,"col":41},"end":