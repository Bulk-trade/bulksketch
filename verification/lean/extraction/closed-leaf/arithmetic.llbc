).\n    AffinePreparation,\n    /// Enumerate and evaluate the recovered affine solution coset (V3).\n    AffineEnumeration,\n    /// Form an annihilator splitter for the current affine coset (V3).\n    AffineSplit,\n    /// Try the next canonical trace direction and the internal split check.\n    Trace,\n    /// Compute a monic polynomial GCD.\n    Gcd,\n    /// Divide a factor exactly after a proper split.\n    FactorDivision,\n    /// Solve degree-one or degree-two leaves.\n    Leaf,\n    /// Verify every stored odd syndrome by re-encoding or rebuilt recurrence.\n    Verification,\n    /// Sort and validate the final original IDs.\n    Canonicalization,\n}","attr_info":{"attributes":[{"DocComment":" Deterministic stage order. Repeated trace/GCD/division/leaf stages follow factor traversal."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":192,"col":4},"end":{"line":192,"col":13}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Propose the nonzero root S1 before general decoding."}],"inline":null,"rename":null,"public":true},"name":"DirectOne","fields":[],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":194,"col":4},"end":{"line":194,"col":13}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Derive a distinct nonzero pair from S1 and S3 before general decoding."}],"inline":null,"rename":null,"public":true},"name":"DirectTwo","fields":[],"discriminant":{"Signed":["Isize","1"]}},{"id":2,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":196,"col":4},"end":{"line":196,"col":14}},"generated_from_span":null}},"attr_info":{"