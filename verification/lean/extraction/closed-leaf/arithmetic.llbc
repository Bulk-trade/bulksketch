ee];\n        for j in (1..=degree).rev() {\n            product[j] = product[j - 1] ^ K::mul(root, product[j]);\n        }\n        product[0] = K::mul(root, product[0]);\n    }\n    product == factor\n}","attr_info":{"attributes":[{"DocComment":" The single complete product certificate, also used privately for a quartic's kernel."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[{"index":0,"name":"F","variance":"Invariant"},{"index":1,"name":"K","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[178,{"data":{"file_id":24,"beg":{"line":112,"col":29},"end":{"line":112,"col":40}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[179,{"data":{"file_id":24,"beg":{"line":112,"col":45},"end":{"line":112,"col":59}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":27},{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":146},{"Value":[148,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":17},"Shared"]}]},{"Value":[149,{"Ref":[{"Var":{"Free":2}},{"Deduplicated":17},"Mut"]}]}],"output":{"Deduplicated":14}},"src":"Normal","body":"Opaque"},{"def_id":28,"item_meta":{"name":[{"Ide