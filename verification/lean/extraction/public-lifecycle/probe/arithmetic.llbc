| K::square(solution) ^ solution != target {\n        return None;\n    }\n    let first = K::mul(s, solution);\n    let roots = [first, first ^ s];\n    #[cfg(test)]\n    let roots = match fault {\n        Fault::EqualRoots => [first, first],\n        Fault::ZeroRoot => [0, roots[1]],\n        Fault::None | Fault::BadMap => roots,\n    };\n    if roots[0] == roots[1] || roots.iter().any(|&root| root == 0 || root & !F::MASK != 0) {\n        return None;\n    }\n    Some(Pair {\n        roots,\n        #[cfg(test)]\n        algebra: (product, target, solution),\n    })\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"F","variance":"Invariant"},{"index":1,"name":"K","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[1115,{"data":{"file_id":27,"beg":{"line":22,"col":21},"end":{"line":22,"col":32}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":17}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[1116,{"data":{"file_id":27,"beg":{"line":22,"col":37},"end":{"line":22,"col":51}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"outlives":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":19},{"Deduplicated":17}],"const_generics":[],"trait_refs":[]}}}}],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":12},{"Deduplicated":12}],"output":{"Deduplicated":93}},"src":"Normal","body":"Opaque"},{"def_id":38,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"U