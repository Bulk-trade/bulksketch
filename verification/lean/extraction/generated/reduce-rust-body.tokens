{ if F :: BITS == 64 { let high = product . hi ; let overflow = (high >> 63) ^ (high >> 61) ^ (high >> 60) ; product . lo ^ high ^ (high << 1) ^ (high << 3) ^ (high << 4) ^ overflow ^ (overflow << 1) ^ (overflow << 3) ^ (overflow << 4) } else { let mut remainder = 0 ; for word in [product . hi , product . lo] { for bit in (0 .. 64) . rev () { let carry = remainder >> (F :: BITS - 1) ; remainder = ((remainder << 1) & F :: MASK) | ((word >> bit) & 1) ; remainder ^= F :: MODULUS_LOW & 0_u64 . wrapping_sub (carry) ; } } remainder } }