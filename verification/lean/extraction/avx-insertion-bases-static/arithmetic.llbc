:{"Deduplicated":123},"id":457,"kind":{"StorageDead":62},"comments_before":[]},{"span":{"Deduplicated":123},"id":458,"kind":{"StorageDead":61},"comments_before":[]},{"span":{"Deduplicated":123},"id":459,"kind":{"StorageDead":60},"comments_before":[]},{"span":{"Deduplicated":123},"id":460,"kind":{"StorageDead":59},"comments_before":[]},{"span":{"Deduplicated":123},"id":461,"kind":{"StorageDead":58},"comments_before":[]},{"span":{"Deduplicated":123},"id":327,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":22,"item_meta":{"name":[{"Ident":["bulksketch",0]},{"Ident":["field",0]},{"Ident":["frobenius",0]},{"Ident":["square",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":55,"col":0},"end":{"line":77,"col":1}},"generated_from_span":null}},"source_text":"pub(crate) const fn square(word: u64) -> u64 {\n    let mut square = 0_u128;\n    let mut bit = 0;\n    while bit < 64 {\n        if word & (1_u64 << bit) != 0 {\n            square ^= 1_u128 << (2 * bit);\n        }\n        bit += 1;\n    }\n    let polynomial = (1_u128 << 64) | 0x1b;\n    bit = 128;\n    while bit > 64 {\n        bit -= 1;\n        if square & (1_u128 << bit) != 0 {\n            square ^= polynomial << (bit - 64);\n        }\n    }\n    // The long division above leaves exactly one canonical field word.\n    let bytes = square.to_le_bytes();\n    u64::from_le_bytes([\n        bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7],\n    ])\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":7}],"output":{"Deduplicated":7}},"src":"Normal","body":"Opaque"},{"def_id":23,"item_meta":{"name":[{"