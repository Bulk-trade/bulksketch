 (** Projector kind *)
 type proj_kind = LoanProj | BorrowProj
 
+(** A shared expansion may encounter an unrelated borrow projector carrying
+    loans from an ended ancestor. Preserve that owner and traverse its children
+    so the checked visitor still rejects a target hidden inside its payload.
+    Matching owners and unchecked or non-shared expansions retain the existing
+    empty-loans requirement. *)
+let check_borrow_projection_loans span ~shared_expansion target owner loans =
+  [%cassert] span
+    (loans = []
+    || (!Config.sanity_checks && shared_expansion && owner <> target))
+    "Unreachable"
