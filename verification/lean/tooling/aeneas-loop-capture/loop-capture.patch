+  (* Keep a concrete immutable capture graph on its original frozen loans.
+     Follow every shared-borrow edge: an owner must be frozen, the graph must
+     be acyclic, and every referent must be concrete or an opaque type-variable
+     leaf. Type variables cannot be expanded; symbolic ADTs are deliberately
+     excluded because projection could expand their fields. No mutable or
+     reserved borrow, loan or endable referent is admitted. Original IDs are
+     preserved. Enable this case only with sanity checks: the existing join
+     and fixed-point matching must check equality of every frozen abstraction.
+     All other values retain the existing reborrow path and collapse guard. *)
+  let rec concrete_shared_only (visited : BorrowId.Set.t) (sv : tvalue) : bool =
+    match sv.value with
+    | VLiteral _ -> true
+    | VAdt { fields; _ } -> List.for_all (concrete_shared_only visited) fields
+    | VSymbolic { sv_ty = TVar _; _ } -> true
+    | VBorrow (VSharedBorrow (bid, _)) ->
+        if BorrowId.Set.mem bid visited then false
+        else (
+          match BorrowId.Map.find_opt bid !loan_to_shared_value with
+          | Some (owner, referent, _) ->
+              (not owner.can_end)
+              && concrete_shared_only (BorrowId.Set.add bid visited) referent
+          | None -> false)
+    | _ -> false
+  in
+
