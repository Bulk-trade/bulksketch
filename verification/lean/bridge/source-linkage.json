      "source_fragment": "pub(crate) fn charge(&mut self, charge: WorkUnits) -> Result<(), DecodeError> {\n        let next = self.used.0.checked_add(charge.0);\n        if self.exhausted || next.is_none_or(|n| n > self.limit.0) {\n            self.exhausted = true;\n            return Err(DecodeError::WorkLimitExceeded);\n        }\n        self.used = WorkUnits(next.expect(\"checked work charge\"));\n        Ok(())\n    }",
      "source_fragment_sha256": "920d51d7c82633ef60b5bb8b7578553bbecac1a10e3559772544843c3a629f01",
